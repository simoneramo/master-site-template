{
  "name": "Falcon 1 Master Site Template",
  "version": "2.0.0",
  "description": "A production-ready Astro template with TinaCMS integration",
  "pages": {
    "tier1": {
      "name": "Core Page (Always Included)",
      "description": "Your homepage — always included",
      "pages": [
        {
          "path": "src/pages/index.astro",
          "name": "Homepage",
          "required": true
        }
      ]
    },
    "tier2": {
      "name": "Common Pages (Usually Included)",
      "description": "Standard business pages that most clients need",
      "pages": [
        {
          "path": "src/pages/about/index.astro",
          "name": "About",
          "default": true
        },
        {
          "path": "src/pages/contact.astro",
          "name": "Contact",
          "default": true,
          "requires": ["src/pages/contact-thankyou.astro"]
        },
        {
          "path": "src/pages/contact-thankyou.astro",
          "name": "Contact Thank You",
          "default": true
        },
        {
          "path": "src/pages/home-thankyou.astro",
          "name": "Home Thank You",
          "default": true
        },
        {
          "path": "src/pages/privacy-policy.astro",
          "name": "Privacy Policy",
          "default": true
        },
        {
          "path": "src/pages/terms-and-conditions.astro",
          "name": "Terms & Conditions",
          "default": true
        },
        {
          "path": "src/pages/404.astro",
          "name": "404 Error Page",
          "default": true
        },
        {
          "path": "src/pages/quote.astro",
          "name": "Get a Quote",
          "default": false,
          "requires": ["src/pages/quote-thankyou.astro"]
        },
        {
          "path": "src/pages/quote-thankyou.astro",
          "name": "Quote Thank You",
          "default": false
        },
        {
          "path": "src/pages/services/index.astro",
          "name": "Services",
          "default": true
        },
        {
          "path": "src/pages/services/[slug].astro",
          "name": "Service Detail Pages",
          "default": true
        },
        {
          "path": "src/pages/pricing/index.astro",
          "name": "Pricing",
          "default": false
        },
        {
          "path": "src/pages/insights/index.astro",
          "name": "Blog/Insights",
          "default": true
        },
        {
          "path": "src/pages/insights/[...slug].astro",
          "name": "Blog Post Pages",
          "default": true
        },
        {
          "path": "src/pages/faq.astro",
          "name": "FAQ Page",
          "default": true
        },
        {
          "path": "src/pages/team/index.astro",
          "name": "Team Page",
          "default": false
        },
        {
          "path": "src/pages/process/index.astro",
          "name": "Process Overview",
          "default": true
        },
        {
          "path": "src/pages/process/[slug].astro",
          "name": "Process Step Pages",
          "default": true
        }
      ]
    },
    "tier3": {
      "name": "Optional Pages (Toggle as Needed)",
      "description": "Specialized pages that may not be needed for every project",
      "pages": [
        {
          "path": "src/pages/landing-page.astro",
          "name": "Landing Page",
          "description": "High-conversion landing page with Hero and CTA sections",
          "default": false
        },
        {
          "path": "src/pages/work/index.astro",
          "name": "Portfolio / Work",
          "description": "Showcase of projects and case studies",
          "default": false
        },
        {
          "path": "src/pages/work/[slug].astro",
          "name": "Portfolio Detail Pages",
          "description": "Individual project case study pages",
          "default": false,
          "hidden": true
        },
        {
          "path": "src/pages/reviews/index.astro",
          "name": "Reviews / Testimonials",
          "description": "Client testimonials and ratings showcase",
          "default": false
        },
        {
          "path": "src/pages/careers/index.astro",
          "name": "Careers / Jobs",
          "description": "Job listings and company culture",
          "default": false
        },
        {
          "path": "src/pages/careers/[slug].astro",
          "name": "Job Detail Pages",
          "description": "Individual job posting pages",
          "default": false,
          "hidden": true
        },
        {
          "path": "src/pages/partners/index.astro",
          "name": "Partners / Integrations",
          "description": "Technology partners and integrations",
          "default": false
        },
        {
          "path": "src/pages/partners/[slug].astro",
          "name": "Partner Detail Pages",
          "description": "Individual partner pages",
          "default": false,
          "hidden": true
        },
        {
          "path": "src/pages/events/index.astro",
          "name": "Events / Webinars",
          "description": "Workshops, webinars, and events",
          "default": false
        },
        {
          "path": "src/pages/events/[slug].astro",
          "name": "Event Detail Pages",
          "description": "Individual event pages",
          "default": false,
          "hidden": true
        },
        {
          "path": "src/pages/book/index.astro",
          "name": "Book / Schedule",
          "description": "Appointment booking and scheduling",
          "default": false
        }
      ]
    }
  },
  "contentCollections": {
    "required": [
      "homepage",
      "about",
      "globals",
      "contact",
      "legalPages",
      "notFoundPage"
    ],
    "optional": [
      "insights",
      "insightsPage",
      "services",
      "offerings",
      "process",
      "processSteps",
      "templates",
      "templatesPage",
      "jobs",
      "careersPage",
      "events",
      "eventsPage",
      "partners",
      "partnersPage",
      "testimonials",
      "reviewsPage",
      "portfolio",
      "workPosts",
      "work",
      "components",
      "quote",
      "bookPage",
      "teamPage",
      "faqPage",
      "pricingPage",
      "landingPage"
    ]
  },
  "pageContentMapping": {
    "src/pages/services/index.astro": [
      "src/content/services",
      "src/content/offerings"
    ],
    "src/pages/insights/index.astro": [
      "src/content/insights"
    ],
    "src/pages/process/index.astro": [
      "src/content/process",
      "src/content/processSteps"
    ],
    "src/pages/tech/index.astro": [
      "src/content/tech"
    ],
    "src/pages/resources/glossary.astro": [
      "src/content/common-web-terms"
    ],
    "src/pages/work/index.astro": [
      "src/content/portfolio"
    ],
    "src/pages/careers/index.astro": [
      "src/content/jobs"
    ],
    "src/pages/events/index.astro": [
      "src/content/events"
    ],
    "src/pages/partners/index.astro": [
      "src/content/partners"
    ],
    "src/pages/reviews/index.astro": [
      "src/content/testimonials"
    ],
    "src/pages/quote.astro": [
      "src/content/quote"
    ],
    "src/pages/landing-page.astro": [
      "src/content/landingPage"
    ],
    "src/pages/services/[slug].astro": [
      "src/content/offerings"
    ],
    "src/pages/process/[slug].astro": [
      "src/content/processSteps"
    ]
  },
  "pageConfigMapping": {
    "src/pages/services/index.astro": "src/content/pages/services.md",
    "src/pages/insights/index.astro": "src/content/pages/insights.md",
    "src/pages/process/index.astro": "src/content/pages/process.md",
    "src/pages/pricing/index.astro": "src/content/pages/pricing.md",
    "src/pages/faq.astro": "src/content/pages/faq.md",
    "src/pages/careers/index.astro": "src/content/pages/careers.md",
    "src/pages/events/index.astro": "src/content/pages/events.md",
    "src/pages/partners/index.astro": "src/content/pages/partners.md",
    "src/pages/reviews/index.astro": "src/content/pages/reviews.md",
    "src/pages/work/index.astro": "src/content/pages/work.md",
    "src/pages/book/index.astro": "src/content/bookPage/book.md",
    "src/pages/team/index.astro": "src/content/teamPage/team.md"
  },
  "navigation": {
    "_comment": "Default site nav/footer used by Project Starter. Each leaf references the owning page via `page`; the scaffolder keeps only links whose page is selected. A nav group survives if its own page is selected OR it has >=1 surviving child. Links with no `page` are always kept.",
    "header": {
      "logo": "Your Brand",
      "cta": { "text": "Get a Quote", "url": "/quote", "page": "src/pages/quote.astro", "fallbackUrl": "/contact", "fallbackPage": "src/pages/contact.astro" },
      "groups": [
        { "label": "Home", "url": "/", "page": "src/pages/index.astro" },
        {
          "label": "Services", "url": "/services", "page": "src/pages/services/index.astro",
          "children": [
            { "label": "All Services", "url": "/services", "page": "src/pages/services/index.astro" }
          ]
        },
        {
          "label": "Process", "url": "/process", "page": "src/pages/process/index.astro",
          "children": [
            { "label": "Our Process", "url": "/process", "page": "src/pages/process/index.astro" }
          ]
        },
        { "label": "Work", "url": "/work", "page": "src/pages/work/index.astro" },
        {
          "label": "About", "url": "/about", "page": "src/pages/about/index.astro",
          "children": [
            { "label": "About Us", "url": "/about", "page": "src/pages/about/index.astro" },
            { "label": "Team", "url": "/team", "page": "src/pages/team/index.astro" },
            { "label": "Pricing", "url": "/pricing", "page": "src/pages/pricing/index.astro" },
            { "label": "Careers", "url": "/careers", "page": "src/pages/careers/index.astro" }
          ]
        },
        {
          "label": "Insights", "url": "/insights", "page": "src/pages/insights/index.astro",
          "children": [
            { "label": "Blog", "url": "/insights", "page": "src/pages/insights/index.astro" },
            { "label": "Events", "url": "/events", "page": "src/pages/events/index.astro" },
            { "label": "Reviews", "url": "/reviews", "page": "src/pages/reviews/index.astro" }
          ]
        },
        {
          "label": "Contact", "url": "/contact", "page": "src/pages/contact.astro",
          "children": [
            { "label": "Contact Us", "url": "/contact", "page": "src/pages/contact.astro" },
            { "label": "FAQ", "url": "/faq", "page": "src/pages/faq.astro" },
            { "label": "Book a Call", "url": "/book", "page": "src/pages/book/index.astro" },
            { "label": "Partners", "url": "/partners", "page": "src/pages/partners/index.astro" }
          ]
        }
      ]
    },
    "footer": {
      "logo": "Your Brand",
      "tagline": "Built to help your business grow online.",
      "columns": [
        {
          "heading": "Services",
          "links": [
            { "label": "All Services", "url": "/services", "page": "src/pages/services/index.astro" },
            { "label": "Pricing", "url": "/pricing", "page": "src/pages/pricing/index.astro" }
          ]
        },
        {
          "heading": "Company",
          "links": [
            { "label": "About", "url": "/about", "page": "src/pages/about/index.astro" },
            { "label": "Team", "url": "/team", "page": "src/pages/team/index.astro" },
            { "label": "Work", "url": "/work", "page": "src/pages/work/index.astro" },
            { "label": "Careers", "url": "/careers", "page": "src/pages/careers/index.astro" }
          ]
        },
        {
          "heading": "Resources",
          "links": [
            { "label": "Insights", "url": "/insights", "page": "src/pages/insights/index.astro" },
            { "label": "FAQ", "url": "/faq", "page": "src/pages/faq.astro" },
            { "label": "Events", "url": "/events", "page": "src/pages/events/index.astro" },
            { "label": "Reviews", "url": "/reviews", "page": "src/pages/reviews/index.astro" },
            { "label": "Partners", "url": "/partners", "page": "src/pages/partners/index.astro" }
          ]
        },
        {
          "heading": "Get in Touch",
          "links": [
            { "label": "Contact", "url": "/contact", "page": "src/pages/contact.astro" },
            { "label": "Book a Call", "url": "/book", "page": "src/pages/book/index.astro" },
            { "label": "Get a Quote", "url": "/quote", "page": "src/pages/quote.astro" }
          ]
        }
      ],
      "legal": [
        { "label": "Privacy Policy", "url": "/privacy-policy", "page": "src/pages/privacy-policy.astro" },
        { "label": "Terms & Conditions", "url": "/terms-and-conditions", "page": "src/pages/terms-and-conditions.astro" }
      ],
      "socials": [
        { "platform": "Twitter", "url": "#", "icon": "𝕏" },
        { "platform": "LinkedIn", "url": "#", "icon": "in" },
        { "platform": "Instagram", "url": "#", "icon": "📷" },
        { "platform": "Facebook", "url": "#", "icon": "f" }
      ]
    }
  },
  "features": {
    "darkMode": true,
    "cms": "tinacms",
    "contactForm": true,
    "blog": true,
    "analytics": false
  },
  "projectStarter": {
    "prompts": [
      {
        "id": "projectName",
        "type": "text",
        "message": "What is the project name?",
        "placeholder": "Acme Corp"
      },
      {
        "id": "domain",
        "type": "text",
        "message": "What is the domain?",
        "placeholder": "https://acme.com"
      },
      {
        "id": "pages",
        "type": "checkbox",
        "message": "Select optional pages to include:",
        "source": "tier3"
      },
      {
        "id": "includeBlog",
        "type": "confirm",
        "message": "Include blog/insights section?",
        "default": true
      },
      {
        "id": "includeTeam",
        "type": "confirm",
        "message": "Include team page?",
        "default": true
      }
    ]
  }
}