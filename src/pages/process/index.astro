---
import MainLayout from "../../layouts/MainLayout.astro";
import PageHeroSection from "../../components/PageHeroSection.astro";
import CardGrid from "@/components/CardGrid.astro";
import FAQ from "../../components/FAQ.astro";
import CTASection from "../../components/CTASection.astro";

import { getEntry } from "astro:content";

const processPage = await getEntry("process", "index");

if (!processPage) {
    return Astro.redirect("/404");
}

const { hero, steps, difference, faq, cta } = processPage.data;
---

<MainLayout title="Process">
    <!-- Hero Section -->
    {hero && <PageHeroSection variant="center" data={hero} />}

    <!-- Process Steps -->
    <CardGrid id="steps" data={steps} variant="center" columns={3} />

    <!-- Values Section -->
    <CardGrid id="values" data={difference} variant="left" columns={3} />

    {faq && <FAQ data={faq} />}

    {cta && <CTASection variant="center" data={cta} />}
</MainLayout>
