---
import MainLayout from "../../layouts/MainLayout.astro";
import Footer from "../../components/Footer.astro";
import FAQ from "../../components/FAQ.astro";
import { getEntry } from "astro:content";

// 🔘 Page Settings: toggle isActive in TinaCMS > Page Settings > process
const pageConfig = await getEntry("pages", "process");
if (pageConfig?.data?.isActive === false) return Astro.redirect("/404");

const processPage = await getEntry("process", "index");

if (!processPage) {
    return Astro.redirect("/404");
}

const { hero, steps, difference, faq, cta } = processPage.data;
const aboutpageData = await getEntry("about", "index");

if (!aboutpageData) {
    return Astro.redirect("/404");
}

const values = aboutpageData.data.values;
---

<MainLayout title="Process">
    <!-- Hero Section -->
    <section class="py-20 dark:bg-zinc-900">
        <div class="mx-auto px-6 max-w-4xl text-center">
            <p
                class="text-xs font-bold uppercase tracking-widest text-black dark:text-white mb-4"
            >
                {hero.label}
            </p>
            <h1 class="text-5xl md:text-6xl font-bold mb-8">
                {hero.heading}
            </h1>
            <p
                class="text-lg md:text-xl font-medium mb-10 text-neutral-600 dark:text-neutral-400"
            >
                {hero.description}
            </p>
        </div>
    </section>

    <!-- Process Steps -->
    <section class="py-20">
        <div class="container mx-auto px-4 md:px-0">
            <div class="text-center mb-8">
                <p
                    class="text-xs font-bold uppercase tracking-widest text-black dark:text-white mb-4"
                >
                    {steps.sectionLabel}
                </p>
                <h2 class="text-5xl font-bold mb-4">
                    {steps.heading}
                </h2>
                <p
                    class="text-lg font-medium text-neutral-600 dark:text-neutral-400 max-w-3xl mx-auto"
                >
                    {steps.description}
                </p>
            </div>
            <div class="grid md:grid-cols-3 gap-8">
                {
                    steps.items.map((step) => {
                        return (
                            <article class="relative border-2 border-zinc-200 dark:border-zinc-900 hover:border-pink-500 dark:hover:bg-black dark:hover:border-green-900  p-8 rounded-xl transition-colors group">
                                <div class="text-4xl mb-6">{step.icon}</div>
                                <h3 class="text-xl font-bold mb-2">
                                    {step.title}
                                </h3>
                                <p class="leading-relaxed text-neutral-600 dark:text-neutral-400 font-medium mb-6">
                                    {step.description}
                                </p>
                                <div class="">
                                    {step.linkUrl && (
                                        <a
                                            href={step.linkUrl}
                                            class="inline-block font-bold border-b-2 border-black dark:border-white hover:border-transparent after:absolute after:inset-0 text-black dark:text-white"
                                        >
                                            {step.linkText || "Learn more"}{" "}
                                            &rarr;
                                        </a>
                                    )}
                                </div>
                            </article>
                        );
                    })
                }
            </div>
        </div>
    </section>

    <!-- Values Section -->
    <section class="py-20">
        <div class="container mx-auto px-4 md:px-0">
            <p
                class="text-xs font-bold uppercase tracking-widest text-black dark:text-white mb-4"
            >
                {values.sectionLabel}
            </p>
            <h2 class="text-5xl font-bold mb-2">{values.heading}</h2>
            <p
                class="text-lg leading-relaxed mb-6 max-w-4xl text-neutral-700 dark:text-neutral-400"
            >
                {values.description}
            </p>

            <div class="grid md:grid-cols-2 lg:grid-cols-2 gap-8">
                {
                    values.items.map((values) => (
                        <article class="border-2 bg-white dark:bg-zinc-950 border-zinc-200 dark:border-zinc-900 p-8 rounded-xl">
                            <div class="text-4xl mb-6">{values.icon}</div>
                            <h3 class="text-lg md:text-xl font-bold mb-4">
                                {values.title}
                            </h3>
                            <p class="leading-relaxed font-medium text-neutral-700 dark:text-neutral-300">
                                {values.description}
                            </p>
                        </article>
                    ))
                }
            </div>
        </div>
    </section>

    {faq && <FAQ data={faq} />}

    <!-- CTA Section -->
    <section class="pb-32 container mx-auto px-4 md:px-0">
        <div
            class="bg-zinc-200 dark:bg-zinc-900 p-16 md:p-32 text-center rounded-xl"
        >
            <p
                class="text-xs font-bold uppercase tracking-widest text-black dark:text-white mb-4"
            >
                Get started
            </p>
            <h2 class="text-4xl md:text-5xl font-bold mb-6">
                {cta.heading}
            </h2>
            <p class="text-lg font-medium mb-10">
                {cta.description}
            </p>
            <a
                href={cta.primaryBtn.link}
                class="group relative inline-flex items-center justify-center overflow-hidden h-14 px-10 font-bold text-black bg-white dark:bg-green-600 dark:text-white transition-all duration-300 text-lg rounded-md hover:bg-white dark:hover:bg-black"
            >
                <span
                    class="transform transition-transform duration-300 group-hover:-translate-x-4"
                >
                    {cta.primaryBtn.text}
                </span>
                <span
                    class="absolute right-6 transform translate-x-4 opacity-0 transition-all duration-300 group-hover:translate-x-0 group-hover:opacity-100"
                >
                    &rarr;
                </span>
            </a>
        </div>
    </section>
</MainLayout>
