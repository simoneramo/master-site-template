---
import { getEntry, render } from "astro:content";
import MainLayout from "../layouts/MainLayout.astro";

const entry = await getEntry("legalPages", "privacy-policy");

if (!entry) {
    throw new Error("Privacy policy entry not found.");
}

const { Content } = await render(entry);
---

<MainLayout title={entry.data.title}>
    <!-- Privacy Policy Content -->
    <section class="py-20 bg-white dark:bg-black">
        <div class="container mx-auto px-4 md:px-0 max-w-4xl">
            <h1 class="text-4xl md:text-5xl font-bold mb-4">{entry.data.title}</h1>
            <p
                class="text-lg font-bold text-neutral-600 dark:text-neutral-400 mb-12"
            >
                Last Updated: {entry.data.lastUpdated}
            </p>

            <div class="prose prose-lg dark:prose-invert">
                <Content />
            </div>
        </div>
    </section>
</MainLayout>
