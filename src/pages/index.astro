---
import MainLayout from "../layouts/MainLayout.astro";
import HeroSection from "../components/HeroSection.astro";
import FAQ from "../components/FAQ.astro";
import parallaxLandingPage from "../assets/patterns-parallax-landing-page.svg";
import parallaxOnePager from "../assets/patterns-parallax-one-pager.svg";
import parallaxFullSite from "../assets/patterns-parallax-full-site.svg";
import ScrollReveal from "../components/ScrollReveal.astro";
import Breakout from "../components/Breakout.astro";
import Testimonials from "../components/Testimonials.astro";
import TestimonialsMarquee from "../components/TestimonialsMarquee.astro";
import ComparisonTable from "../components/sections/comparison/ComparisonTable.astro";
import CarouselSection from "../components/CarouselSection.astro";
import CardGrid from "../components/CardGrid.astro";
import WorkGrid from "../components/WorkGrid.astro";
import ContactForm from "../components/ContactForm.astro";

import { getCollection, getEntry } from "astro:content";

const homepageData = await getEntry("homepage", "index");
if (!homepageData) {
    throw new Error("Homepage data not found");
}
const contactForm = homepageData.data.contactForm;
const hero = homepageData.data.hero;
const proofPoints = homepageData.data.proofPoints;
const problems = homepageData.data.problems;
const features = homepageData.data.features;
const calloutsData = await getEntry("globals", "callouts");
const solutionsData = await getEntry("globals", "solutions");
const testimonialsData = await getEntry("globals", "testimonials");

const process = homepageData.data.process;

const comparison = homepageData.data.comparison;
const testimonials = homepageData.data.testimonials;
const workGrid = homepageData.data.workGrid;
const allWorkPosts = await getCollection("workPosts");
const workProjects = allWorkPosts
    .filter((p) => p.data.isActive !== false)
    .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0))
    .slice(0, 3)
    .map((post) => ({
        slug: post.data.slug ?? post.id,
        data: {
            title: post.data.title,
            description: post.data.description,
            category: post.data.category,
            image: post.data.image,
        },
    }));
const faq = homepageData.data.faq;
---

<MainLayout>
    <HeroSection variant="centered" data={hero} showSocialProof={true} />

    <!-- 💡 To switch layout, change variant to: "centered" or "bold" -->

    <!-- Key Proof Points -->
    <section
        class="py-2 md:py-4 bg-white dark:bg-zinc-900 overflow-hidden"
        aria-label="Key Proof Points"
    >
        <div class="relative flex overflow-x-hidden">
            <div
                class="animate-marquee whitespace-nowrap flex items-center gap-12 pr-12 py-2"
            >
                {
                    Array(4)
                        .fill(proofPoints.items)
                        .flat()
                        .map((item) => (
                            <div class="flex items-center gap-3">
                                <span class="text-2xl">{item.icon}</span>
                                <span class="text-md font-bold capitalize">
                                    {item.text}
                                </span>
                            </div>
                        ))
                }
            </div>

            <div
                class="absolute top-0 animate-marquee2 whitespace-nowrap flex items-center gap-12 pr-12 py-2"
            >
                {
                    Array(4)
                        .fill(proofPoints.items)
                        .flat()
                        .map((item) => (
                            <div class="flex items-center gap-3">
                                <span class="text-2xl">{item.icon}</span>
                                <span class="text-md font-bold capitalize">
                                    {item.text}
                                </span>
                            </div>
                        ))
                }
            </div>
        </div>
    </section>

    <style>
        @keyframes marquee {
            0% {
                transform: translateX(0%);
            }
            100% {
                transform: translateX(-100%);
            }
        }

        @keyframes marquee2 {
            0% {
                transform: translateX(100%);
            }
            100% {
                transform: translateX(0%);
            }
        }

        .animate-marquee {
            animation: marquee 60s linear infinite;
        }

        .animate-marquee2 {
            animation: marquee2 60s linear infinite;
        }

        /* Pause on hover */
        section:hover .animate-marquee,
        section:hover .animate-marquee2 {
            animation-play-state: paused;
        }
    </style>

    <!-- Benefits Features Grid (Carousel) -->
    <CarouselSection
        id="features"
        data={features}
        variant="center"
        ctaText="Explore our full range of features"
        ctaLink="/services"
    />

    <Breakout />

    <!-- Problem Section (Carousel) -->
    <CarouselSection
        id="problems"
        data={problems}
        variant="left"
        ctaText="Learn more"
        ctaLink="/problem"
    />

    <ScrollReveal
        label="The Landing Page"
        heading="Laser-focused conversion"
        description="Specific campaigns, lead magnets, or early access pages. We build high-converting landing pages designed to do one thing: turn your visitors into customers."
        ctaText="Learn about Landing Pages"
        ctaLink="/pricing/landing-page"
        image={parallaxLandingPage.src}
        alt="Landing page visual"
    />

    <!-- Process Section -->
    <CardGrid
        id="process"
        data={process}
        variant="left"
        columns={3}
    />

    <ScrollReveal
        label="The One-Pager"
        heading="Everything in one place."
        description="Perfect for new startups and trades needing a professional digital business card. A multi-section scrolling page that concisely tells your story and captures leads."
        ctaText="Learn about One Pagers"
        ctaLink="/pricing/one-pager"
        image={parallaxOnePager.src}
        alt="One pager visual"
        reverse={true}
    />

    <!-- Scrolling Testimonials Section -->
    {testimonials && <TestimonialsMarquee data={testimonials} />}

    <ScrollReveal
        label="The Full Website"
        heading="Build authority and scale."
        description="For growing businesses requiring a comprehensive web presence. A multi-page structure with full CMS integration, specialized service pages, and extreme performance."
        ctaText="Learn about Full Websites"
        ctaLink="/pricing/full-website"
        image={parallaxFullSite.src}
        alt="Full website visual"
    />

    <!-- Comparison Table Section -->
    <ComparisonTable
        data={comparison}
        ctaText="Read all about our tech stack"
        ctaLink="/tech"
    />

    <!-- Work Grid Section -->
    {workGrid && <WorkGrid data={workGrid} projects={workProjects} variant="center" />

    <!-- FAQ Section -->
    <FAQ data={faq} />

    <!-- Contact Form Section -->
    <ContactForm data={contactForm} variant="center" />
</MainLayout>
