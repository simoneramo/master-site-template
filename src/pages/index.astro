---
import MainLayout from "../layouts/MainLayout.astro";
import HeroSection from "../components/HeroSection.astro";
import FAQ from "../components/FAQ.astro";
import parallaxLandingPage from "../assets/patterns-parallax-landing-page.svg";
import parallaxOnePager from "../assets/patterns-parallax-one-pager.svg";
import parallaxFullSite from "../assets/patterns-parallax-full-site.svg";
import ScrollReveal from "../components/ScrollReveal.astro";
import Testimonials from "../components/Testimonials.astro";

import { getCollection, getEntry } from "astro:content";

const homepageData = await getEntry("homepage", "index");
if (!homepageData) {
    throw new Error("Homepage data not found");
}
const contactForm = homepageData.data.contactForm;
const hero = homepageData.data.hero;
const proofPoints = homepageData.data.proofPoints;
const problems = homepageData.data.problems;
const features = homepageData.data.features;
const calloutsData = await getEntry("globals", "callouts");
const solutionsData = await getEntry("globals", "solutions");
const testimonialsData = await getEntry("globals", "testimonials");

const process = homepageData.data.process;

const comparison = homepageData.data.comparison;
const templatesSection = homepageData.data.templates;
const templates = (await getCollection("templates"))
    .sort((a, b) => (a.data.order || 999) - (b.data.order || 999))
    .slice(0, 3);
const faq = homepageData.data.faq;
---

<MainLayout>
    <HeroSection
        variant="bold"
        data={hero}
        showSocialProof={true}
    />

    <!-- 💡 To switch layout, change variant to: "centered" or "bold" -->

    <!-- Key Proof Points -->
    <section
        class="py-2 md:py-4 bg-white dark:bg-zinc-900 overflow-hidden"
        aria-label="Key Proof Points"
    >
        <div class="relative flex overflow-x-hidden">
            <div
                class="animate-marquee whitespace-nowrap flex items-center gap-12 pr-12 py-2"
            >
                {
                    Array(4)
                        .fill(proofPoints.items)
                        .flat()
                        .map((item) => (
                            <div class="flex items-center gap-3">
                                <span class="text-2xl">{item.icon}</span>
                                <span class="text-md font-bold capitalize">
                                    {item.text}
                                </span>
                            </div>
                        ))
                }
            </div>

            <div
                class="absolute top-0 animate-marquee2 whitespace-nowrap flex items-center gap-12 pr-12 py-2"
            >
                {
                    Array(4)
                        .fill(proofPoints.items)
                        .flat()
                        .map((item) => (
                            <div class="flex items-center gap-3">
                                <span class="text-2xl">{item.icon}</span>
                                <span class="text-md font-bold capitalize">
                                    {item.text}
                                </span>
                            </div>
                        ))
                }
            </div>
        </div>
    </section>

    <style>
        @keyframes marquee {
            0% {
                transform: translateX(0%);
            }
            100% {
                transform: translateX(-100%);
            }
        }

        @keyframes marquee2 {
            0% {
                transform: translateX(100%);
            }
            100% {
                transform: translateX(0%);
            }
        }

        .animate-marquee {
            animation: marquee 60s linear infinite;
        }

        .animate-marquee2 {
            animation: marquee2 60s linear infinite;
        }

        /* Pause on hover */
        section:hover .animate-marquee,
        section:hover .animate-marquee2 {
            animation-play-state: paused;
        }
    </style>

    <!-- Benefits Features Grid (Carousel) -->
    <section id="features" class="py-20 overflow-hidden">
        <div
            class="container mx-auto px-4 md:px-0"
            x-data={`{
            currentIndex: 0,
            totalItems: ${features.items.length},
            visibleItems: 3,
            swipeTolerance: 30,
            wheelTimer: null,
            updateVisible() {
                if (window.innerWidth < 768) {
                    this.visibleItems = 1;
                } else if (window.innerWidth < 1024) {
                    this.visibleItems = 2;
                } else {
                    this.visibleItems = 3;
                }
                // Reset index if out of bounds when resizing
                 if (this.currentIndex > this.totalItems - Math.floor(this.visibleItems)) {
                    this.currentIndex = Math.max(0, this.totalItems - Math.floor(this.visibleItems));
                }
            },
            init() {
                this.updateVisible();
            },
            next() {
                if (this.currentIndex < this.totalItems - Math.floor(this.visibleItems)) {
                    this.currentIndex++;
                }
            },
            prev() {
                if (this.currentIndex > 0) {
                    this.currentIndex--;
                }
            },
            handleWheel(e) {
                // Only handle horizontal scrolling
                if (Math.abs(e.deltaX) < Math.abs(e.deltaY)) return;
                
                // Debounce
                if (this.wheelTimer) return;

                if (e.deltaX > this.swipeTolerance) {
                    this.next();
                    this.wheelTimer = setTimeout(() => { this.wheelTimer = null; }, 500); // 500ms cooldown
                } else if (e.deltaX < -this.swipeTolerance) {
                    this.prev();
                    this.wheelTimer = setTimeout(() => { this.wheelTimer = null; }, 500);
                }
            }
        }`}
            @resize.window.debounce="updateVisible()"
            @wheel.passive="handleWheel($event)"
        >
            <div class="mb-12 text-center">
                <p
                    class="text-xs font-bold uppercase tracking-widest text-black dark:text-white mb-4"
                >
                    {features.sectionLabel}
                </p>
                <h2 class="text-4xl md:text-5xl font-bold mb-4 dark:text-zinc-200">
                    {features.heading}
                </h2>
                <p
                    class="text-lg text-neutral-600 dark:text-neutral-400 max-w-3xl mx-auto font-medium"
                >
                    {features.description}
                </p>
            </div>

            <!-- Carousel Window -->
            <div class="relative overflow-hidden -mx-4">
                <!-- Track -->
                <div
                    class="flex transition-transform duration-500 ease-in-out will-change-transform"
                    :style="`transform: translateX(-${currentIndex * (100 / visibleItems)}%)`"
                >
                    {
                        features.items.map((feature) => (
                            <div :class="'shrink-0 px-4'" :style="'width: ' + (100 / visibleItems) + '%'">
                                <article class="h-full border-2 bg-white dark:bg-black border-zinc-200 dark:border-zinc-800 p-4 md:p-8 rounded-xl flex flex-col transition-colors">
                                    <div class="text-4xl mb-4">
                                        {feature.icon}
                                    </div>
                                    <h3 class="text-xl lg:text-2xl font-bold mb-4 dark:text-zinc-200">
                                        {feature.title}
                                    </h3>
                                    <p class="text-lg text-neutral-600 dark:text-zinc-400 leading-relaxed font-medium grow">
                                        {feature.description}
                                    </p>
                                </article>
                            </div>
                        ))
                    }
                </div>
            </div>

            <div class="mt-12 flex flex-col md:flex-row justify-between items-start md:items-center gap-6 md:gap-0">
                <a
                    href="/services"
                    class="order-2 md:order-1 font-bold border-b-2 border-black dark:border-white hover:border-transparent transition-colors text-black dark:text-white"
                >
                    Explore our full range of features &rarr;
                </a>

                <!-- Navigation Arrows -->
                <div class="flex gap-4 order-1 md:order-2">
                    <button
                        @click="prev()"
                        class="w-12 h-12 rounded-full cursor-pointer bg-zinc-200 dark:bg-zinc-800 text-black dark:text-white flex items-center justify-center transition-colors hover:bg-black hover:text-white dark:hover:bg-white dark:hover:text-black disabled:opacity-30 disabled:cursor-not-allowed disabled:hover:bg-zinc-200 disabled:hover:text-black dark:disabled:hover:bg-zinc-800 dark:disabled:hover:text-white"
                        :disabled="currentIndex === 0"
                        aria-label="Previous slide"
                    >
                        &larr;
                    </button>
                    <button
                        @click="next()"
                        class="w-12 h-12 rounded-full cursor-pointer bg-zinc-200 dark:bg-zinc-800 text-black dark:text-white flex items-center justify-center transition-colors hover:bg-black hover:text-white dark:hover:bg-white dark:hover:text-black disabled:opacity-30 disabled:cursor-not-allowed disabled:hover:bg-zinc-200 disabled:hover:text-black dark:disabled:hover:bg-zinc-800 dark:disabled:hover:text-white"
                        :disabled="currentIndex >= totalItems - Math.floor(visibleItems)"
                        aria-label="Next slide"
                    >
                        &rarr;
                    </button>
                </div>
            </div>
        </div>
    </section>

    <!-- Breakout Section -->
    <section id="breakout" class="py-20 container mx-auto px-4 md:px-0">
        <div
            class="bg-zinc-200 dark:bg-zinc-900 p-16 md:p-32 text-center rounded-xl"
        >
            <p
                class="text-xs font-bold uppercase tracking-widest text-black dark:text-white mb-4"
            >
                Why "WeMakeSmall"?
            </p>
            <h2
                class="text-4xl md:text-5xl font-bold dark:text-zinc-200 mb-4 leading-tight"
            >
                Built for the Businesses
            </h2>
            <p
                class="mb-8 text-xl md:text-2xl font-medium text-neutral-600 dark:text-neutral-400 leading-relaxed"
            >
                I got tired of seeing small business owners get stuck between
                slow, broken DIY sites and overpriced city agencies. I’m
                bringing 10 years of enterprise-grade engineering to give you a
                high-performance asset you actually own and <span
                    class="text-black dark:text-neutral-300 font-bold"
                    >delivered in 28</span
                >.
            </p>

             <a
                href="/contact"
                class="group relative inline-flex items-center justify-center overflow-hidden h-14 px-10 font-bold text-white bg-black transition-all duration-300 text-lg rounded-md"
            >
                <span
                    class="transform transition-transform duration-300 group-hover:-translate-x-4"
                >
                    Let's chat
                </span>
                <span
                    class="absolute right-6 transform translate-x-4 opacity-0 transition-all duration-300 group-hover:translate-x-0 group-hover:opacity-100"
                >
                    &rarr;
                </span>
            </a>
        </div>
    </section>

    <!-- Problem Section (Carousel) -->
    <section id="problems" class="py-20 overflow-hidden">
        <div
            class="container mx-auto px-4 md:px-0"
            x-data={`{
            currentIndex: 0,
            totalItems: ${problems.items.length},
            visibleItems: 3,
            swipeTolerance: 30, // threshold for swipe
            wheelTimer: null,
            updateVisible() {
                if (window.innerWidth < 768) {
                    this.visibleItems = 1;
                } else if (window.innerWidth < 1024) {
                    this.visibleItems = 2;
                } else {
                    this.visibleItems = 3;
                }
                // Reset index if out of bounds when resizing
                 if (this.currentIndex > this.totalItems - Math.floor(this.visibleItems)) {
                    this.currentIndex = Math.max(0, this.totalItems - Math.floor(this.visibleItems));
                }
            },
            init() {
                this.updateVisible();
            },
            next() {
                if (this.currentIndex < this.totalItems - Math.floor(this.visibleItems)) {
                    this.currentIndex++;
                }
            },
            prev() {
                if (this.currentIndex > 0) {
                    this.currentIndex--;
                }
            },
            handleWheel(e) {
                // Only handle horizontal scrolling
                if (Math.abs(e.deltaX) < Math.abs(e.deltaY)) return;
                
                // Debounce
                if (this.wheelTimer) return;

                if (e.deltaX > this.swipeTolerance) {
                    this.next();
                    this.wheelTimer = setTimeout(() => { this.wheelTimer = null; }, 500); // 500ms cooldown
                } else if (e.deltaX < -this.swipeTolerance) {
                    this.prev();
                    this.wheelTimer = setTimeout(() => { this.wheelTimer = null; }, 500);
                }
            }
        }`}
            @resize.window.debounce="updateVisible()"
            @wheel.passive="handleWheel($event)"
        >
            <div class="mb-12">
                <p
                    class="text-xs font-bold uppercase tracking-widest text-black dark:text-white mb-4"
                >
                    {problems.sectionLabel}
                </p>
                <h2 class="text-4xl md:text-5xl font-bold dark:text-zinc-200 mb-4">
                    {problems.heading}
                </h2>
                <p
                    class="text-lg text-neutral-600 dark:text-zinc-400 max-w-3xl font-medium"
                >
                    {problems.description}
                </p>
            </div>

            <!-- Carousel Window -->
            <div class="relative overflow-hidden -mx-4">
                <!-- Track -->
                <div
                    class="flex transition-transform duration-500 ease-in-out will-change-transform"
                    :style="`transform: translateX(-${currentIndex * (100 / visibleItems)}%)`"
                >
                    {
                        problems.items.map((problem) => (
                            <div :class="'shrink-0 px-4'" :style="'width: ' + (100 / visibleItems) + '%'">
                                <article class="h-full border-2 bg-white dark:bg-black border-zinc-200 dark:border-zinc-800 p-4 md:p-8 rounded-xl flex flex-col transition-colors">
                                    <div class="text-4xl mb-4">
                                        {problem.icon}
                                    </div>
                                    <h3 class="text-xl lg:text-2xl font-bold mb-4 dark:text-zinc-200">
                                        {problem.title}
                                    </h3>
                                    <p class="text-lg text-neutral-600 dark:text-zinc-400 font-medium leading-relaxed grow">
                                        {problem.description}
                                    </p>
                                </article>
                            </div>
                        ))
                    }
                </div>
            </div>

            <div class="mt-8 flex flex-col md:flex-row justify-between items-start md:items-center gap-6 md:gap-0">
                <a
                    href="/problem"
                    class="order-2 md:order-1 font-bold border-b-2 border-black dark:border-white hover:border-transparent transition-colors text-black dark:text-white"
                >
                    Learn more &rarr;
                </a>

                <!-- Navigation Arrows -->
                <div class="flex gap-4 order-1 md:order-2">
                    <button
                        @click="prev()"
                        class="w-12 h-12 rounded-full cursor-pointer bg-zinc-200 dark:bg-zinc-800 text-black dark:text-white flex items-center justify-center transition-colors hover:bg-black hover:text-white dark:hover:bg-white dark:hover:text-black disabled:opacity-30 disabled:cursor-not-allowed disabled:hover:bg-zinc-200 disabled:hover:text-black dark:disabled:hover:bg-zinc-800 dark:disabled:hover:text-white"
                        :disabled="currentIndex === 0"
                        aria-label="Previous slide"
                    >
                        &larr;
                    </button>
                    <button
                        @click="next()"
                        class="w-12 h-12 rounded-full cursor-pointer bg-zinc-200 dark:bg-zinc-800 text-black dark:text-white flex items-center justify-center transition-colors hover:bg-black hover:text-white dark:hover:bg-white dark:hover:text-black disabled:opacity-30 disabled:cursor-not-allowed disabled:hover:bg-zinc-200 disabled:hover:text-black dark:disabled:hover:bg-zinc-800 dark:disabled:hover:text-white"
                        :disabled="currentIndex >= totalItems - Math.floor(visibleItems)"
                        aria-label="Next slide"
                    >
                        &rarr;
                    </button>
                </div>
            </div>
        </div>
    </section>

    <ScrollReveal
        label="The Landing Page"
        heading="Laser-focused conversion"
        description="Specific campaigns, lead magnets, or early access pages. We build high-converting landing pages designed to do one thing: turn your visitors into customers."
        ctaText="Learn about Landing Pages"
        ctaLink="/pricing/landing-page"
        image={parallaxLandingPage.src}
        alt="Landing page visual"
    />

    <!-- Process Section -->
    <section id="process" class="py-20">
        <div class="container mx-auto px-4 md:px-0">
            <p
                class="text-xs font-bold uppercase tracking-widest text-black dark:text-white mb-4"
            >
                {process.sectionLabel}
            </p>
            <h2 class="text-5xl font-bold mb-4">{process.heading}</h2>
            <p
                class="text-lg text-neutral-600 dark:text-zinc-400 mb-12 max-w-3xl font-medium"
            >
                {process.description}
            </p>

            <div class="relative">
                <!-- Adjusted top position to top-12 to align with the center of the w-12 icons inside p-6 padding -->

                <div class="grid md:grid-cols-3 gap-8 relative z-10">
                    {
                        process.steps.map((step) => (
                            <div class="bg-white dark:bg-black p-4 md:p-8 border-2 border-zinc-200 dark:border-zinc-800 rounded-lg flex flex-col items-start transition-transform duration-300">
                                <div class="text-4xl mb-4">
                                    {step.icon}
                                </div>
                                <h3 class="text-xl md:text-2xl dark:text-zinc-200 font-bold mb-2">
                                    {step.title}
                                </h3>
                                <p class="text-lg text-neutral-600 dark:text-zinc-400 leading-relaxed font-medium">
                                    {step.description}
                                </p>
                            </div>
                        ))
                    }
                </div>
            </div>

            <div class="mt-6">
                <a
                    href="/process"
                    class="font-bold border-b-2 border-black dark:border-white hover:border-transparent transition-colors text-black dark:text-white"
                >
                    Learn more about our process &rarr;
                </a>
            </div>
        </div>
    </section>

    <ScrollReveal
        label="The One-Pager"
        heading="Everything in one place."
        description="Perfect for new startups and trades needing a professional digital business card. A multi-section scrolling page that concisely tells your story and captures leads."
        ctaText="Learn about One Pagers"
        ctaLink="/pricing/one-pager"
        image={parallaxOnePager.src}
        alt="One pager visual"
        reverse={true}
    />

  

    <!-- Scrolling Testimonials Section -->
    <section class="py-20 bg-white dark:bg-black overflow-hidden">
        <div class="px-8 mb-12 text-center">
            <p
                class="text-xs font-bold uppercase tracking-widest text-black dark:text-white mb-4"
            >
                Expert Endorsement
            </p>
            <h2 class="text-5xl font-bold mb-4">Backed by Industry Peers</h2>
            <p
                class="text-lg text-neutral-600 dark:text-zinc-400 mb-12 max-w-3xl font-medium mx-auto"
            >
                Don't just take my word for it. Here's what industry peers have
                to say about working with me. 10+ years of delivering
                high-performance sites that DIY builders can't match.
            </p>
        </div>

        <div class="relative w-full overflow-hidden group">
            <div
                class="flex animate-scroll hover:[animation-play-state:paused] gap-8 w-max"
            >
                {
                    /* Create 4 sets of testimonials to ensure smooth infinite scroll even on wide screens */
                    [...Array(4)].map(() => (
                        <div class="flex gap-8 shrink-0">
                            {testimonialsData?.data?.items?.map(
                                (t: any, index: number) => {
                                    const colors = [
                                        "bg-blue-200 text-blue-800 dark:bg-blue-900/40 dark:text-blue-300",
                                        "bg-emerald-200 text-emerald-800 dark:bg-emerald-900/40 dark:text-emerald-300",
                                        "bg-amber-200 text-amber-800 dark:bg-amber-900/40 dark:text-amber-300",
                                        "bg-purple-200 text-purple-800 dark:bg-purple-900/40 dark:text-purple-300",
                                        "bg-pink-200 text-pink-800 dark:bg-pink-900/40 dark:text-pink-300",
                                        "bg-rose-200 text-rose-800 dark:bg-rose-900/40 dark:text-rose-300",
                                        "bg-indigo-200 text-indigo-800 dark:bg-indigo-900/40 dark:text-indigo-300",
                                    ];
                                    const colorClass = colors[index % colors.length];
                                    const names = t.authorName ? t.authorName.split(" ") : ["?"];
                                    const initials = names.length > 1 
                                        ? (names[0][0] + names[names.length - 1][0]).toUpperCase() 
                                        : names[0][0].toUpperCase();

                                    return (
                                        <div class="w-[400px] shrink-0 bg-white dark:bg-zinc-900/50 p-8 rounded-xl border-2 border-stone-200 dark:border-zinc-800">
                                            <div class="flex gap-1 mb-4 text-yellow-500">
                                                {Array.from({
                                                    length: t.rating,
                                                }).map(() => (
                                                    <svg
                                                        class="w-5 h-5 fill-current"
                                                        viewBox="0 0 20 20"
                                                    >
                                                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                                                    </svg>
                                                ))}
                                            </div>
                                            <p class="text-lg font-medium mb-6 line-clamp-4">
                                                "{t.quote}"
                                            </p>
                                            <div class="flex items-center gap-4 mt-auto">
                                                <div
                                                    class={`w-12 h-12 flex items-center justify-center rounded-full font-bold text-lg ${colorClass}`}
                                                >
                                                    {initials}
                                                </div>
                                                <div>
                                                    <div class="font-bold text-lg dark:text-white">
                                                        {t.authorName}
                                                    </div>
                                                    <div class="text-sm font-medium text-neutral-500 dark:text-neutral-400">
                                                        {t.authorTitle}
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    );
                                },
                            )}
                        </div>
                    ))
                }
            </div>
        </div>
    </section>



      <ScrollReveal
        label="The Full Website"
        heading="Build authority and scale."
        description="For growing businesses requiring a comprehensive web presence. A multi-page structure with full CMS integration, specialized service pages, and extreme performance."
        ctaText="Learn about Full Websites"
        ctaLink="/pricing/full-website"
        image={parallaxFullSite.src}
        alt="Full website visual"
    />

    <!-- Comparison Table Section -->
    <section id="comparison" class="py-20">
        <div class="container mx-auto px-4 md:px-0">
            <p
                class="text-xs font-bold uppercase tracking-widest text-black dark:text-white mb-4"
            >
                {comparison.sectionLabel}
            </p>
            <h2 class="text-5xl font-bold mb-4">{comparison.heading}</h2>
            <p
                class="text-lg text-neutral-600 dark:text-neutral-400 mb-12 max-w-3xl font-medium"
            >
                {comparison.description}
            </p>

            <!-- Responsive Table Wrapper -->
            <div class="overflow-x-auto rounded-lg">
                <table
                    class="min-w-full divide-y-2 divide-neutral-200 dark:divide-zinc-700 border-collapse"
                >
                    <thead
                        class="bg-black dark:bg-white text-white dark:text-black"
                    >
                        <tr
                            class="divide-x-2 divide-neutral-700 dark:divide-neutral-200"
                        >
                            {
                                comparison.columnHeaders.map(
                                    (header, index) => (
                                        <th
                                            class={`p-4 text-lg font-extrabold ${index === 0 ? "text-left sticky left-0 z-20 bg-black dark:bg-white text-white dark:text-black" : "text-center"} ${index === comparison.columnHeaders.length - 1 ? "rounded-tr-lg" : ""}`}
                                        >
                                            {header}
                                        </th>
                                    ),
                                )
                            }
                        </tr>
                    </thead>
                    <tbody
                        class="divide-y-2 divide-neutral-200 dark:divide-zinc-700 border-x-2 border-b-2 border-zinc-200 dark:border-zinc-800"
                    >
                        {
                            comparison.rows.map((row, rowIndex) => (
                                <tr
                                    class={`bg-white text-md font-medium dark:bg-black divide-x-2 divide-neutral-200 dark:divide-zinc-700 ${rowIndex === comparison.rows.length - 1 ? "rounded-b-lg" : ""}`}
                                >
                                    <td
                                        class={`p-4 sticky left-0 bg-white dark:bg-black font-bold ${rowIndex === comparison.rows.length - 1 ? "rounded-bl-lg" : ""}`}
                                    >
                                        {row.feature}
                                        <p class="text-md text-neutral-600 dark:text-neutral-400 font-normal mt-1">
                                            {row.subtitle}
                                        </p>
                                    </td>
                                    <td class="p-4 bg-zinc-100 dark:bg-zinc-800 text-center font-bold">
                                        <Fragment set:html={row.weMakeSmall} />
                                    </td>
                                    <td class="p-4 text-center">
                                        {row.webAgency}
                                    </td>
                                    <td
                                        class={`p-4 text-center ${rowIndex === comparison.rows.length - 1 ? "rounded-br-lg" : ""}`}
                                    >
                                        {row.websiteBuilder}
                                    </td>
                                </tr>
                            ))
                        }
                    </tbody>
                </table>
            </div>

            <div class="mt-10">
                <a
                    href="/tech"
                    class="font-bold border-b-2 border-black dark:border-white hover:border-transparent transition-colors text-black dark:text-white"
                >
                    Read all about our tech stack &rarr;
                </a>
            </div>
        </div>
    </section>

    <!-- Template Library Section -->
    <section id="library" class="py-20 bg-white dark:bg-black">
        <div class="container mx-auto px-4 md:px-0">
            <div class="text-center">
                <p
                    class="text-xs font-bold uppercase tracking-widest text-black dark:text-white mb-4"
                >
                    {templatesSection.sectionLabel}
                </p>
                <h2 class="text-5xl font-bold mb-4">
                    {templatesSection.heading}
                </h2>
                <p
                    class="text-lg text-neutral-600 dark:text-neutral-400 mb-12 max-w-3xl mx-auto font-medium"
                >
                    {templatesSection.description}
                </p>
            </div>

            <!-- Template Grid -->
            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
                {
                    templates.map((template) => (
                        <a
                            href={`/design-blueprints/${template.slug}`}
                            class="group bg-white relative flex flex-col overflow-hidden rounded-lg h-full"
                        >
                            <div class="relative aspect-6/5 overflow-hidden bg-stone-100 dark:bg-zinc-800">
                                <img
                                    alt={template.data.title}
                                    src={template.data.image}
                                    class="h-full w-full object-cover object-top transition duration-500 group-hover:scale-110"
                                    loading="lazy"
                                />
                                <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(0,0,0,0.85)_0%,transparent_50%)] pointer-events-none z-0" />
                            </div>
                            <div class="p-6 bg-white dark:bg-black border-x-2 border-b-2 border-zinc-200 dark:border-zinc-800 rounded-b-lg flex flex-col grow">
                                <span class="template-category-tag absolute top-4 right-4 bg-pink-600 text-white text-xs font-bold px-3 py-1 rounded-full z-10 capitalize">
                                    {Array.isArray(template.data.category)
                                        ? template.data.category[0]
                                        : template.data.category}
                                </span>
                                <h3 class="text-lg font-bold text-black dark:text-white mb-3 transition-colors">
                                    {template.data.title}
                                </h3>
                                <p class="text-neutral-600 dark:text-neutral-400 font-medium line-clamp-2 mb-6">
                                    {template.data.subtitle}
                                </p>
                                <div class="mt-auto flex items-center font-bold text-black dark:text-white">
                                    <span class="inline-block border-b-2 border-current group-hover:border-transparent transition-colors">
                                        View designs
                                    </span>
                                    <span class="ml-2 transform transition-transform duration-300 group-hover:translate-x-2">
                                        &rarr;
                                    </span>
                                </div>
                            </div>
                        </a>
                    ))
                }
            </div>

            <div class="mt-10">
                <a
                    href={templatesSection.ctaLink}
                    class="font-bold border-b-2 border-black dark:border-white hover:border-transparent transition-colors text-black dark:text-white"
                >
                    {templatesSection.ctaText} &rarr;
                </a>
            </div>
        </div>
    </section>

    <!-- FAQ Section -->
    <FAQ data={faq} />


    <section id="contact" class="py-20">
        <div class="container mx-auto max-w-2xl px-8 text-center">
            <p
                class="text-xs font-bold uppercase tracking-widest text-black dark:text-white mb-4"
            >
                {contactForm.sectionLabel}
            </p>
            <h2
                id="contact-heading"
                class="text-6xl font-bold mb-4 dark:text-white"
            >
                {contactForm.heading}
            </h2>

            <p
                class="text-lg text-neutral-600 dark:text-neutral-400 mb-6 font-medium"
            >
                {contactForm.description}
            </p>
            <p class="mb-6 font-medium text-neutral-800 dark:text-neutral-400">
                Avg. response time: {contactForm.responseTime}
            </p>

            <form
                class="text-left space-y-6 dark:bg-black"
                x-data="{
                        name: '',
                        email: '',
                        subject: '',
                        projectType: '',
                        message: '',
                        isSubmitting: false,
                        showSuccess: false,
                        showError: false,
                        errorMessage: '',
                        touched: {
                            name: false,
                            email: false,
                            subject: false,
                            projectType: false,
                            message: false
                        },
                        errors: {
                            name: false,
                            email: false,
                            subject: false,
                            projectType: false,
                            message: false
                        },

                        validateName() {
                            this.errors.name = this.touched.name && this.name.trim().length < 2;
                        },

                        validateEmail() {
                            if (!this.touched.email) return;
                            const isValid = this.email && this.email.includes('@') && this.email.includes('.') && this.email.length > 5;
                            this.errors.email = !isValid;
                        },

                        validateSubject() {
                            this.errors.subject = this.touched.subject && this.subject.trim().length < 3;
                            if (this.subject !== 'New Project') {
                                this.projectType = '';
                                this.touched.projectType = false;
                                this.errors.projectType = false;
                            }
                        },

                        validateProjectType() {
                            if (this.subject !== 'New Project') return;
                            this.errors.projectType = this.touched.projectType && this.projectType === '';
                        },

                        validateMessage() {
                            this.errors.message = this.touched.message && this.message.trim().length < 40;
                        },

                        isValid(field) {
                            return this.touched[field] && !this.errors[field];
                        },

                        formIsValid() {
                            const nameOk = this.name.trim().length >= 2;
                            const emailOk = this.email && this.email.includes('@') && this.email.includes('.') && this.email.length > 5;
                            const subjectOk = this.subject.trim().length >= 3;
                            const projectTypeOk = this.subject !== 'New Project' || this.projectType !== '';
                            const messageOk = this.message.trim().length >= 40;
                            return nameOk && emailOk && subjectOk && projectTypeOk && messageOk;
                        },

                        async submitForm() {
                            this.touched.name = true;
                            this.touched.email = true;
                            this.touched.subject = true;
                            this.touched.message = true;
                            if (this.subject === 'New Project') this.touched.projectType = true;

                            this.validateName();
                            this.validateEmail();
                            this.validateSubject();
                            this.validateProjectType();
                            this.validateMessage();

                            if (this.errors.name || this.errors.email || this.errors.subject || this.errors.projectType || this.errors.message) {
                                return;
                            }

                            this.isSubmitting = true;
                            this.showError = false;

                            try {
                                const response = await fetch('/api/contact', {
                                    method: 'POST',
                                    headers: {
                                        'Content-Type': 'application/json',
                                    },
                                    body: JSON.stringify({
                                        name: this.name,
                                        email: this.email,
                                        subject: this.subject,
                                        projectType: this.projectType,
                                        message: this.message
                                    })
                                });

                                const data = await response.json();

                                if (response.ok) {
                                    this.showSuccess = true;
                                    this.name = '';
                                    this.email = '';
                                    this.subject = '';
                                    this.projectType = '';
                                    this.message = '';
                                    this.touched = { name: false, email: false, subject: false, projectType: false, message: false };
                                    this.errors = { name: false, email: false, subject: false, projectType: false, message: false };

                                    // Redirect to thank you page after success
                                    window.location.href = '/home-thankyou';
                                } else {
                                    this.showError = true;
                                    this.errorMessage = data.error || 'Failed to send message. Please try again.';
                                    setTimeout(() => this.showError = false, 5000);
                                }
                            } catch (error) {
                                this.showError = true;
                                this.errorMessage = 'Network error. Please check your connection and try again.';
                                setTimeout(() => this.showError = false, 5000);
                            } finally {
                                this.isSubmitting = false;
                            }
                        }
                    }"
                @submit.prevent="submitForm()"
            >
                <div
                    x-show="showSuccess"
                    x-transition
                    class="p-4 bg-green-100 border-l-4 border-green-500 text-green-700 mb-6 rounded-md"
                    role="alert"
                >
                    <p class="font-bold">
                        {contactForm.successMessage.title}
                    </p>
                    <p>{contactForm.successMessage.description}</p>
                </div>

                <div
                    x-show="showError"
                    x-transition
                    class="p-4 bg-red-100 border-l-4 border-red-600 text-red-700 mb-6 rounded-md"
                    role="alert"
                >
                    <p class="font-bold">Error sending message</p>
                    <p x-text="errorMessage"></p>
                </div>

                <div>
                    <label for="name" class="block font-bold mb-2"
                        >{contactForm.nameField.label}</label
                    >
                    <input
                        type="text"
                        id="name"
                        x-model="name"
                        @blur="touched.name = true; validateName()"
                        @input="touched.name && validateName()"
                        class="w-full p-4 border-2 focus:text-black focus:border-zinc-400 dark:focus:border-zinc-500 dark:focus:text-white font-medium transition-colors outline-none focus:ring-0 placeholder-neutral-500 rounded-md"
                        :class="errors.name ? 'border-red-500 bg-red-50 dark:bg-red-950/30' : isValid('name') ? 'border-green-500 bg-green-50 dark:bg-green-950/30' : 'border-zinc-200 dark:border-zinc-800 bg-white dark:bg-black'"
                        :aria-invalid="errors.name"
                        aria-describedby="name-error"
                        placeholder={contactForm.nameField.placeholder}
                    />
                    <span
                        id="name-error"
                        x-show="errors.name"
                        class="text-red-600 dark:text-red-600 font-medium mt-1 block"
                        role="alert"
                    >
                        {contactForm.nameField.errorMessage}
                    </span>
                </div>

                <div>
                    <label for="email" class="block font-bold mb-2"
                        >{contactForm.emailField.label}</label
                    >
                    <input
                        type="email"
                        id="email"
                        x-model="email"
                        @blur="touched.email = true; validateEmail()"
                        @input="touched.email && validateEmail()"
                        class="w-full p-4 border-2 focus:text-black focus:border-zinc-400 dark:focus:border-zinc-500 dark:focus:text-white font-medium transition-colors outline-none focus:ring-0 placeholder-neutral-500 rounded-md"
                        :class="errors.email ? 'border-red-500 bg-red-50 dark:bg-red-950/30' : isValid('email') ? 'border-green-500 bg-green-50 dark:bg-green-950/30' : 'border-zinc-200 dark:border-zinc-800 bg-white dark:bg-black'"
                        :aria-invalid="errors.email"
                        aria-describedby="email-error"
                        placeholder={contactForm.emailField.placeholder}
                    />
                    <span
                        id="email-error"
                        x-show="errors.email"
                        class="text-red-600 dark:text-red-600 font-medium mt-1 block"
                        role="alert"
                    >
                        {contactForm.emailField.errorMessage}
                    </span>
                </div>

                <!-- Subject -->
                <div>
                    <label for="hp-subject" class="block font-bold mb-2">
                        Subject <abbr title="required">*</abbr>
                    </label>
                    <div class="relative">
                        <select
                            id="hp-subject"
                            name="subject"
                            x-model="subject"
                            @blur="touched.subject = true; validateSubject()"
                            @change="touched.subject = true; validateSubject()"
                            required
                            class="w-full p-4 border-2 focus:text-black focus:border-black dark:focus:border-zinc-500 dark:focus:text-white transition-colors outline-none focus:ring-0 placeholder-neutral-500 rounded-md dark:text-white appearance-none"
                            :class="errors.subject ? 'border-red-500 bg-red-50 dark:bg-red-950/30' : isValid('subject') ? 'border-green-500 bg-green-50 dark:bg-green-950/30' : 'border-zinc-200 dark:border-zinc-800 bg-white dark:bg-black'"
                        >
                            <option value="" disabled selected>Select a topic...</option>
                            <option value="New Project">New Project Inquiry</option>
                            <option value="Existing Project">Existing Project</option>
                            <option value="General Inquiry">General Inquiry</option>
                            <option value="Partnership">Partnership / Collaboration</option>
                            <option value="Support">Support / Maintenance</option>
                            <option value="Other">Other</option>
                        </select>
                        <div class="absolute inset-y-0 right-0 flex items-center px-4 pointer-events-none text-neutral-500">
                            <svg class="w-5 h-5 fill-current" viewBox="0 0 20 20">
                                <path d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" fill-rule="evenodd"></path>
                            </svg>
                        </div>
                    </div>
                    <p x-show="errors.subject" class="text-red-600 mt-1 font-medium">
                        Please select a subject.
                    </p>
                </div>

                <!-- Conditional: Project Type -->
                <div x-show="subject === 'New Project'" x-transition>
                    <label for="hp-projectType" class="block font-bold mb-2">
                        Project Type <abbr title="required">*</abbr>
                    </label>
                    <div class="relative">
                        <select
                            id="hp-projectType"
                            name="projectType"
                            x-model="projectType"
                            @blur="touched.projectType = true; validateProjectType()"
                            @change="touched.projectType = true; validateProjectType()"
                            class="w-full p-4 border-2 focus:text-black focus:border-black dark:focus:border-zinc-500 dark:focus:text-white transition-colors outline-none focus:ring-0 placeholder-neutral-500 rounded-md dark:text-white appearance-none"
                            :class="errors.projectType ? 'border-red-500 bg-red-50 dark:bg-red-950/30' : (touched.projectType && projectType !== '') ? 'border-green-500 bg-green-50 dark:bg-green-950/30' : 'border-zinc-200 dark:border-zinc-800 bg-white dark:bg-black'"
                        >
                            <option value="" disabled selected>Select a project type...</option>
                            <option value="Landing Page">Landing Page</option>
                            <option value="One-Pager">One-Pager</option>
                            <option value="Full Website">Full Website</option>
                            <option value="Other">Other</option>
                        </select>
                        <div class="absolute inset-y-0 right-0 flex items-center px-4 pointer-events-none text-neutral-500">
                            <svg class="w-5 h-5 fill-current" viewBox="0 0 20 20">
                                <path d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" fill-rule="evenodd"></path>
                            </svg>
                        </div>
                    </div>
                    <p x-show="errors.projectType" class="text-red-600 mt-1 font-medium">
                        Please select a project type.
                    </p>
                </div>

                <div>
                    <label for="message" class="block font-bold mb-2"
                        >{contactForm.messageField.label}</label
                    >
                    <textarea
                        id="message"
                        rows="4"
                        x-model="message"
                        @blur="touched.message = true; validateMessage()"
                        @input="touched.message && validateMessage()"
                        class="w-full p-4 border-2 focus:text-black focus:border-zinc-400 dark:focus:border-zinc-500 dark:focus:text-white font-medium transition-colors outline-none focus:ring-0 placeholder-neutral-500 rounded-md"
                        :class="errors.message ? 'border-red-500 bg-red-50 dark:bg-red-950/30' : isValid('message') ? 'border-green-500 bg-green-50 dark:bg-green-950/30' : 'border-zinc-200 dark:border-zinc-800 bg-white dark:bg-black'"
                        :aria-invalid="errors.message"
                        aria-describedby="message-error"
                        placeholder={contactForm.messageField.placeholder}
                    ></textarea>
                    <span
                        id="message-error"
                        x-show="errors.message"
                        class="text-red-600 dark:text-red-600 font-medium mt-1 block"
                        role="alert"
                    >
                        {contactForm.messageField.errorMessage}
                    </span>
                </div>

                <button
                    type="submit"
                    :disabled="isSubmitting || !formIsValid()"
                    class="w-full py-4 group relative overflow-hidden bg-black text-white dark:bg-white dark:text-black font-bold tracking-wider transition-all duration-300 disabled:opacity-40 disabled:cursor-not-allowed disabled:saturate-0 flex justify-center items-center rounded-md cursor-pointer"
                >
                    <div
                        x-show="!isSubmitting"
                        class="relative flex items-center justify-center px-10"
                    >
                        <span
                            class="transform transition-transform duration-300 group-hover:-translate-x-4"
                        >
                            {contactForm.submitButton.text}
                        </span>
                        <span
                            class="absolute right-6 transform -translate-x-4 opacity-0 transition-all duration-300 group-hover:translate-x-0 group-hover:opacity-100"
                        >
                            &rarr;
                        </span>
                    </div>

                    <span x-show="isSubmitting"
                        >{contactForm.submitButton.loadingText}</span
                    >
                </button>
                <p
                    class="text-sm text-center font-medium text-black dark:text-neutral-600 mt-4"
                >
                    {contactForm.privacyNote}
                </p>
            </form>
        </div>
    </section>
</MainLayout>
