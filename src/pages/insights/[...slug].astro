---
import { getCollection } from "astro:content";
import MainLayout from "../../layouts/MainLayout.astro";
import Footer from "../../components/Footer.astro";

export const prerender = true;

export async function getStaticPaths() {
	const posts = await getCollection("insights");
	return posts.map((post) => ({
		params: { slug: post.slug },
		props: post,
	}));
}

const post = Astro.props;
const { Content } = await post.render();
---

<MainLayout title={post.data.title}>
	<article class="pb-24">
		<!-- Progress Bar -->
		<div
			class="fixed top-0 left-0 w-full h-1.5 z-50 bg-gray-100 dark:bg-gray-800"
		>
			<div
				id="progress-bar"
				class="h-full bg-black dark:bg-white origin-left transform scale-x-0 transition-transform duration-100 ease-out"
			>
			</div>
		</div>

		<div class="container max-w-5xl px-6 mx-auto pt-12 md:pt-24">
			<header class="text-center mb-16 md:mb-24">
				<a
					href="/insights"
					class="inline-flex items-center gap-2 text-sm font-bold uppercase tracking-widest text-neutral-500 dark:text-neutral-400 hover:text-black dark:hover:text-white transition-colors mb-12 border-b-2 border-transparent hover:border-black dark:hover:border-white pb-1"
				>
					&larr; Back to Insights
				</a>

				<div class="max-w-4xl mx-auto">
					{
						post.data.tags && post.data.tags.length > 0 && (
							<div class="flex flex-wrap justify-center gap-3 mb-8">
								{post.data.tags.map((tag) => (
									<span class="insight-tag-pill inline-block px-4 py-1.5 text-xs font-bold tracking-widest uppercase bg-gray-100 dark:bg-zinc-800 text-black dark:text-white rounded-full">
										{tag}
									</span>
								))}
							</div>
						)
					}

					<h1
						class="text-4xl md:text-6xl lg:text-7xl font-bold tracking-tight mb-8 leading-tight text-balance"
					>
						{post.data.title}
					</h1>

					<p
						class="text-xl md:text-2xl font-medium text-neutral-600 dark:text-neutral-300 mb-10 leading-relaxed max-w-2xl mx-auto text-balance"
					>
						{post.data.description}
					</p>

					<div
						class="flex items-center justify-center gap-4 text-sm font-bold text-neutral-500 dark:text-neutral-400 border-t border-b border-zinc-200 dark:border-gray-800 py-6 w-full max-w-xl mx-auto"
					>
						<time
							datetime={post.data.pubDate.toISOString()}
							class="flex items-center gap-2"
						>
							<svg
								xmlns="http://www.w3.org/2000/svg"
								width="18"
								height="18"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"
								class="lucide lucide-calendar"
								><rect
									width="18"
									height="18"
									x="3"
									y="4"
									rx="2"
									ry="2"></rect><line
									x1="16"
									x2="16"
									y1="2"
									y2="6"></line><line
									x1="8"
									x2="8"
									y1="2"
									y2="6"></line><line
									x1="3"
									x2="21"
									y1="10"
									y2="10"></line></svg
							>
							{
								post.data.pubDate.toLocaleDateString("en-US", {
									year: "numeric",
									month: "long",
									day: "numeric",
								})
							}
						</time>
						<span class="text-neutral-300 dark:text-neutral-700"
							>&bull;</span
						>
						<span class="flex items-center gap-2">
							<svg
								xmlns="http://www.w3.org/2000/svg"
								width="18"
								height="18"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
								stroke-linecap="round"
								stroke-linejoin="round"
								class="lucide lucide-clock"
								><circle cx="12" cy="12" r="10"
								></circle><polyline points="12 6 12 12 16 14"
								></polyline></svg
							>
							5 min read
						</span>
					</div>
				</div>
			</header>

			{
				post.data.heroImage && (
					<div class="mb-16 md:mb-24 rounded-2xl overflow-hidden dark:border-zinc-800 bg-gray-100 dark:bg-zinc-800">
						<img
							src={post.data.heroImage}
							alt={post.data.title}
							class="w-full h-auto object-cover max-h-[600px]"
						/>
					</div>
				)
			}

			<div class="max-w-3xl mx-auto">
				<div
					class="prose prose-lg md:prose-xl dark:prose-invert max-w-none
                        prose-headings:font-bold prose-headings:tracking-tight
                        prose-p:text-neutral-700 dark:prose-p:text-neutral-300 prose-p:leading-relaxed
                        prose-a:font-bold prose-a:text-black dark:prose-a:text-white prose-a:underline hover:prose-a:no-underline prose-a:decoration-2 prose-a:decoration-black dark:prose-a:decoration-white prose-a:underline-offset-4
                        prose-strong:font-bold prose-strong:text-black dark:prose-strong:text-white
                        prose-code:font-bold prose-code:bg-gray-100 dark:prose-code:bg-zinc-800 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded-md prose-code:text-black dark:prose-code:text-white prose-code:before:content-none prose-code:after:content-none
                        prose-pre:bg-black dark:prose-pre:bg-zinc-900 prose-pre:rounded-xl prose-pre:border border-gray-800 dark:border-zinc-700
                        prose-blockquote:border-l-4 prose-blockquote:border-black dark:prose-blockquote:border-white prose-blockquote:pl-6 prose-blockquote:font-medium prose-blockquote:italic prose-blockquote:text-xl
                        prose-img:rounded-xl prose-img:shadow-lg prose-img:my-12
                        prose-hr:border-neutral-100 dark:prose-hr:border-gray-800 prose-hr:my-16"
				>
					<Content />
				</div>

				<footer
					class="mt-24 pt-12 border-t-2 border-neutral-100 dark:border-zinc-800 flex justify-center"
				>
					<a
						href="/insights"
						class="group relative inline-flex items-center justify-center overflow-hidden h-14 px-10 font-bold text-white bg-black dark:bg-white dark:text-black transition-all duration-300 text-lg rounded-md hover:bg-black dark:hover:bg-white"
					>
						<span
							class="absolute left-6 transform translate-x-4 opacity-0 transition-all duration-300 group-hover:translate-x-0 group-hover:opacity-100"
						>
							&larr;
						</span>

						<span
							class="transform transition-transform duration-300 group-hover:translate-x-4"
						>
							Back to all posts
						</span>
					</a>
				</footer>
			</div>
		</div>
	</article>

	<script>
		// Simple Scroll Progress Bar
		window.addEventListener("scroll", () => {
			const winScroll =
				document.body.scrollTop || document.documentElement.scrollTop;
			const height =
				document.documentElement.scrollHeight -
				document.documentElement.clientHeight;
			const scrolled = winScroll / height;
			const progressBar = document.getElementById("progress-bar");
			if (progressBar) {
				progressBar.style.transform = `scaleX(${scrolled})`;
			}
		});
	</script>
</MainLayout>
