---
import MainLayout from "../../layouts/MainLayout.astro";
import PageHeroSection from "../../components/PageHeroSection.astro";
import CTASection from "../../components/CTASection.astro";
import TeamThreeCol from "../../components/sections/team/TeamThreeCol.astro";
import { adaptTeam } from "../../lib/adapters";
import { getEntry } from "astro:content";

// Get team page content from TinaCMS
const teamPage = await getEntry("teamPage", "team");
const hero = teamPage?.data?.hero;
const valuesSection = teamPage?.data?.values;
const cta = teamPage?.data?.cta;

// Transform CMS data to TeamData format
const teamData = adaptTeam(teamPage?.data || {});
const hasTeamMembers = teamData && teamData.members && teamData.members.length > 0;
---

<MainLayout
    title="Meet the Team"
    description="Get to know the people behind the work. Our small, experienced team brings together design, development, and strategy to deliver results."
>
    <!-- Breadcrumbs -->
    <nav aria-label="Breadcrumb" class="py-4">
        <div class="px-8 mx-auto flex items-center gap-2 text-md font-bold">
            <a
                href="/"
                class="text-neutral-500 hover:text-black dark:text-neutral-400 dark:hover:text-white transition-colors"
            >
                Home
            </a>
            <span class="text-neutral-300 dark:text-neutral-700">/</span>
            <a
                href="/about"
                class="text-neutral-500 hover:text-black dark:text-neutral-400 dark:hover:text-white transition-colors"
            >
                About
            </a>
            <span class="text-neutral-300 dark:text-neutral-700">/</span>
            <span class="text-black dark:text-white">Team</span>
        </div>
    </nav>

    <PageHeroSection variant="center" data={hero} />

    <!-- Team Members Grid -->
    {hasTeamMembers && (
        <TeamThreeCol data={teamData} />
    )}

    <!-- Team Values Section -->
    <section class="py-20 bg-zinc-50 dark:bg-zinc-900/50">
        <div class="container mx-auto px-4 md:px-0">
            <div class="text-center mb-14">
                {
                    valuesSection?.sectionLabel && (
                        <p class="text-xs font-bold uppercase tracking-widest text-black dark:text-white mb-4">
                            {valuesSection.sectionLabel}
                        </p>
                    )
                }
                <h2 class="text-4xl md:text-5xl font-bold mb-4">
                    {valuesSection?.heading || "What drives us"}
                </h2>
                <p
                    class="text-lg text-neutral-600 dark:text-neutral-400 max-w-2xl mx-auto font-medium"
                >
                    {
                        valuesSection?.description ||
                            "The values that guide how we collaborate, communicate, and deliver."
                    }
                </p>
            </div>

            <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
                {
                    valuesSection?.items?.map((v) => (
                        <article class="border-2 border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-950 p-8 rounded-xl">
                            <div class="text-4xl mb-6">{v.icon}</div>
                            <h3 class="text-lg font-bold mb-3">{v.title}</h3>
                            <p class="text-neutral-600 dark:text-neutral-400 leading-relaxed font-medium">
                                {v.description}
                            </p>
                        </article>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- CTA Section -->
    <CTASection variant="center" data={cta} />
</MainLayout>
