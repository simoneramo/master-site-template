---
// 💡 OPTIONAL PAGE - Delete this file if not needed for your project
// Individual portfolio project page (Case Study)

export const prerender = true;

import { getCollection, getEntry } from "astro:content";
import MainLayout from "../../layouts/MainLayout.astro";
import CTASection from "../../components/CTASection.astro";

export async function getStaticPaths() {
    const posts = await getCollection("workPosts");

    return posts
        .filter((post) => post.data.isActive !== false)
        .map((post) => ({
            params: { slug: post.data.slug ?? post.id },
            props: { post: post.data },
        }));
}

const { post } = Astro.props;

// Get CTA from work page content (already fetched in getStaticPaths, but needed here too)
const workPage = await getEntry("work", "index");
const cta = workPage?.data?.cta;
---

<MainLayout title={`${post.title} | Work`} description={post.description}>
    <!-- Hero -->
    <section class="py-16 lg:py-24">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
            <a
                href="/work"
                class="text-sm font-medium text-neutral-500 hover:text-black dark:hover:text-white mb-6 inline-block"
            >
                ← Back to Work
            </a>

            <div class="flex flex-wrap gap-3 mb-6">
                <span
                    class="px-3 py-1 bg-neutral-100 dark:bg-neutral-800 text-neutral-700 dark:text-neutral-300 text-sm font-medium rounded-full"
                >
                    {post.category}
                </span>
                {
                    post.industry && (
                        <span class="px-3 py-1 bg-neutral-100 dark:bg-neutral-800 text-neutral-700 dark:text-neutral-300 text-sm font-medium rounded-full">
                            {post.industry}
                        </span>
                    )
                }
            </div>

            <h1
                class="text-4xl md:text-5xl lg:text-6xl font-black text-black dark:text-white mb-6"
            >
                {post.title}
            </h1>

            {
                post.client && (
                    <p class="text-xl text-neutral-600 dark:text-neutral-400">
                        Client: {post.client}
                    </p>
                )
            }
        </div>
    </section>

    <!-- Project Image -->
    {
        post.image && (
            <section class="pb-16">
                <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
                    <div class="aspect-video rounded-lg overflow-hidden">
                        <img
                            src={post.image}
                            alt={post.title}
                            class="w-full h-full object-cover"
                        />
                    </div>
                </div>
            </section>
        )
    }

    <!-- Project Content -->
    <section class="pb-16 lg:pb-24">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
                <!-- Main Content -->
                <div class="lg:col-span-2 space-y-12">
                    <!-- Overview -->
                    <div>
                        <h2
                            class="text-2xl font-bold text-black dark:text-white mb-4"
                        >
                            Project Overview
                        </h2>
                        <p
                            class="text-neutral-600 dark:text-neutral-400 leading-relaxed text-lg"
                        >
                            {post.description}
                        </p>
                    </div>

                    <!-- Project Link -->
                    {
                        post.link && (
                            <div class="pt-8">
                                <a
                                    href={post.link}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="inline-flex items-center gap-2 px-8 py-4 bg-black dark:bg-white text-white dark:text-black font-bold rounded-md hover:opacity-80 transition-opacity"
                                >
                                    View Live Project
                                    <span>→</span>
                                </a>
                            </div>
                        )
                    }
                </div>

                <!-- Sidebar -->
                <div class="lg:col-span-1">
                    <div class="sticky top-24 space-y-6">
                        <!-- Project Details -->
                        <div
                            class="p-6 bg-neutral-100 dark:bg-neutral-800 rounded-lg"
                        >
                            <h3
                                class="text-lg font-bold text-black dark:text-white mb-4"
                            >
                                Project Details
                            </h3>
                            <dl class="space-y-4">
                                {
                                    post.client && (
                                        <div>
                                            <dt class="text-sm text-neutral-500 dark:text-neutral-400">
                                                Client
                                            </dt>
                                            <dd class="font-medium text-black dark:text-white">
                                                {post.client}
                                            </dd>
                                        </div>
                                    )
                                }
                                <div>
                                    <dt
                                        class="text-sm text-neutral-500 dark:text-neutral-400"
                                    >
                                        Category
                                    </dt>
                                    <dd
                                        class="font-medium text-black dark:text-white"
                                    >
                                        {post.category}
                                    </dd>
                                </div>
                                {
                                    post.industry && (
                                        <div>
                                            <dt class="text-sm text-neutral-500 dark:text-neutral-400">
                                                Industry
                                            </dt>
                                            <dd class="font-medium text-black dark:text-white">
                                                {post.industry}
                                            </dd>
                                        </div>
                                    )
                                }
                            </dl>
                        </div>

                        <!-- CTA -->
                        <div
                            class="p-6 bg-neutral-100 dark:bg-neutral-800 rounded-lg"
                        >
                            <h3
                                class="text-lg font-bold text-black dark:text-white mb-3"
                            >
                                Have a similar project?
                            </h3>
                            <p
                                class="text-sm text-neutral-600 dark:text-neutral-400 mb-4"
                            >
                                Let's discuss how we can help bring your vision
                                to life.
                            </p>
                            <a
                                href="/contact"
                                class="block w-full px-6 py-3 bg-black dark:bg-white text-white dark:text-black font-bold rounded-md text-center hover:opacity-80 transition-opacity"
                            >
                                Start a Project
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    {cta && <CTASection variant={cta.variant || "center"} data={cta} />}
</MainLayout>
