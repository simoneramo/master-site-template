---
// 💡 OPTIONAL PAGE - Delete this file if not needed for your project
// This is a stub page for the Portfolio/Work showcase
// Customize or remove based on client needs

import { getEntry, getCollection } from "astro:content";
import PageHeroSection from "../../components/PageHeroSection.astro";
import WorkGrid from "../../components/WorkGrid.astro";
import CTASection from "../../components/CTASection.astro";
import MainLayout from "../../layouts/MainLayout.astro";

// Get work page content from TinaCMS (hero, grid section data, cta)
const workContent = await getEntry("work", "index");
const hero = workContent?.data?.hero;
const workGrid = workContent?.data?.workGrid;
const cta = workContent?.data?.cta;

// Get work posts from TinaCMS workPosts collection
const allWorkPosts = await getCollection("workPosts");
const workProjects = allWorkPosts
    .filter((p) => p.data.isActive !== false)
    .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0))
    .map((post) => ({
        slug: post.data.slug ?? post.id,
        data: {
            title: post.data.title,
            description: post.data.description,
            category: post.data.category,
            image: post.data.image,
        },
    }));
---

<MainLayout
    title="Our Work | Project Portfolio Showcase"
    description="Explore our portfolio of successful projects and see how we've helped businesses achieve their goals."
>
    <!-- Page Hero Section -->
    {hero && <PageHeroSection variant="center" data={hero} />}

    <!-- Work Grid Section -->
    {workGrid && <WorkGrid data={workGrid} projects={workProjects} />}

    <!-- CTA Section -->
    {cta && <CTASection variant="center" data={cta} />}
</MainLayout>
