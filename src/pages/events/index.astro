---
// 💡 OPTIONAL PAGE - Delete this file if not needed for your project
// This is a stub page for Events/Workshops/Webinars
// Customize or remove based on client needs

import { getCollection, getEntry } from "astro:content";
import MainLayout from "../../layouts/MainLayout.astro";

// 🔘 Page Settings: toggle isActive in TinaCMS > Page Settings > events
const pageConfig = await getEntry("pages", "events");
if (pageConfig?.data?.isActive === false) return Astro.redirect("/404");

const allEvents = await getCollection("events", ({ data }) => data.isActive !== false);
const upcomingEvents = allEvents
    .filter((e) => e.data.isUpcoming)
    .sort((a, b) => a.data.date.getTime() - b.data.date.getTime());
const pastEvents = allEvents
    .filter((e) => !e.data.isUpcoming)
    .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<MainLayout
    title="Events | Workshops & Webinars"
    description="Join our upcoming events, workshops, and webinars. Learn from industry experts and connect with peers."
>
    <!-- Hero Section -->
    <section class="py-24 lg:py-32">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="max-w-3xl">
                <span
                    class="text-sm font-bold tracking-wider text-neutral-500 uppercase mb-4 block"
                >
                    Events
                </span>
                <h1
                    class="text-4xl md:text-5xl lg:text-6xl font-black text-black dark:text-white mb-6"
                >
                    Upcoming Events
                </h1>
                <p
                    class="text-xl text-neutral-600 dark:text-neutral-400 leading-relaxed"
                >
                    Join us for workshops, webinars, and networking events.
                    Learn from experts, share ideas, and grow your skills.
                </p>
            </div>
        </div>
    </section>

    <!-- Featured Event -->
    <section class="pb-16">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div
                class="border-2 border-black dark:border-white rounded-lg overflow-hidden"
            >
                <div class="grid grid-cols-1 lg:grid-cols-2">
                    <div
                        class="aspect-video lg:aspect-auto bg-neutral-100 dark:bg-neutral-800 flex items-center justify-center"
                    >
                        <span class="text-6xl">🎤</span>
                    </div>
                    <div class="p-8 lg:p-12 flex flex-col justify-center">
                        <span
                            class="inline-block px-3 py-1 bg-black dark:bg-white text-white dark:text-black text-xs font-bold uppercase tracking-wider rounded-full w-fit mb-4"
                        >
                            Featured Event
                        </span>
                        <h2
                            class="text-2xl md:text-3xl lg:text-4xl font-bold text-black dark:text-white mb-4"
                        >
                            Event Title Goes Here
                        </h2>
                        <p
                            class="text-neutral-600 dark:text-neutral-400 mb-6"
                        >
                            Join us for an in-depth exploration of key industry
                            topics. This session will cover best practices,
                            emerging trends, and actionable insights you can
                            apply immediately.
                        </p>
                        <div
                            class="flex flex-wrap gap-4 text-sm text-neutral-600 dark:text-neutral-400 mb-8"
                        >
                            <span class="flex items-center gap-2">
                                <span>📅</span> Date TBD
                            </span>
                            <span class="flex items-center gap-2">
                                <span>🕐</span> Time TBD
                            </span>
                            <span class="flex items-center gap-2">
                                <span>📍</span> Location TBD
                            </span>
                        </div>
                        <div>
                            <button
                                class="px-8 py-3 bg-black dark:bg-white text-white dark:text-black font-bold rounded-md hover:opacity-80 transition-opacity"
                            >
                                Register Now
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Upcoming Events from CMS -->
    <section class="pb-16">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <h2 class="text-2xl md:text-3xl font-bold text-black dark:text-white mb-8">
                Upcoming Events
            </h2>

            {upcomingEvents.length > 0 ? (
                <div class="space-y-6">
                    {upcomingEvents.map((event) => {
                        const date = event.data.date;
                        const day = date.getDate();
                        const month = date.toLocaleDateString('en-US', { month: 'short' }).toUpperCase();
                        
                        return (
                            <div class="border-2 border-neutral-200 dark:border-neutral-800 rounded-lg p-6 hover:border-black dark:hover:border-white transition-colors">
                                <div class="flex flex-col md:flex-row md:items-center gap-6">
                                    <div class="w-20 h-20 bg-neutral-100 dark:bg-neutral-800 rounded-lg flex flex-col items-center justify-center shrink-0">
                                        <span class="text-xs font-bold text-neutral-500 uppercase">{month}</span>
                                        <span class="text-2xl font-black text-black dark:text-white">{day}</span>
                                    </div>
                                    <div class="flex-1">
                                        <span class="text-xs font-bold text-neutral-500 uppercase tracking-wider">
                                            {event.data.eventType}
                                        </span>
                                        <h3 class="text-xl font-bold text-black dark:text-white mt-1 mb-2">
                                            {event.data.title}
                                        </h3>
                                        <p class="text-neutral-600 dark:text-neutral-400 text-sm">
                                            {event.data.time} • {event.data.duration} • {event.data.location}
                                        </p>
                                    </div>
                                    <a
                                        href={`/events/${event.slug}`}
                                        class="px-6 py-2 border-2 border-black dark:border-white text-black dark:text-white font-bold rounded-md hover:bg-black hover:text-white dark:hover:bg-white dark:hover:text-black transition-colors shrink-0 text-center"
                                    >
                                        Learn More
                                    </a>
                                </div>
                            </div>
                        );
                    })}
                </div>
            ) : (
                <p class="text-neutral-600 dark:text-neutral-400">No upcoming events scheduled.</p>
            )}
        </div>
    </section>

    <!-- Past Events -->
    {pastEvents.length > 0 && (
        <section class="pb-24 lg:pb-32">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <h3 class="text-xl font-bold text-black dark:text-white mb-6">
                    Past Events
                </h3>
                <div class="space-y-4">
                    {pastEvents.slice(0, 3).map((event) => (
                        <div class="border border-neutral-200 dark:border-neutral-800 rounded-lg p-4 opacity-70">
                            <div class="flex items-center gap-4">
                                <span class="text-sm font-bold text-neutral-500">{event.data.date.toLocaleDateString()}</span>
                                <span class="text-sm text-neutral-600 dark:text-neutral-400">{event.data.title}</span>
                            </div>
                        </div>
                    ))}
                </div>
                {pastEvents.length > 3 && (
                    <a href="#" class="inline-block mt-4 text-black dark:text-white font-bold underline underline-offset-4">
                        View All Past Events →
                    </a>
                )}
            </div>
        </section>
    )}

            <!-- Developer Note -->
            <div
                class="mt-16 p-6 bg-amber-50 dark:bg-amber-900/20 border-2 border-amber-200 dark:border-amber-800 rounded-lg"
            >
                <p class="text-amber-800 dark:text-amber-200 font-medium">
                    <strong>💡 Developer Note:</strong> This page uses TinaCMS content.
                </p>
                <ul
                    class="mt-2 ml-4 list-disc text-amber-700 dark:text-amber-300"
                >
                    <li>Manage events in TinaCMS under "Events"</li>
                    <li>Create individual event pages at <code>src/pages/events/[slug].astro</code></li>
                    <li>Toggle isUpcoming to move events to "Past Events"</li>
                    <li>Add registration links or embed forms</li>
                </ul>
            </div>
        </div>
    </section>
</MainLayout>
