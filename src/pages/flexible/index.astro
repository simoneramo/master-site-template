---
import { getCollection } from "astro:content";
import MainLayout from "../../layouts/MainLayout.astro";

const pages = await getCollection("flexiblePages");
---

<MainLayout title="Flexible Pages">
  <div class="container mx-auto px-4 py-20">
    <h1 class="text-4xl font-bold mb-8">Flexible Pages</h1>
    
    <p class="mb-4">Found {pages?.length || 0} pages</p>
    
    <ul class="space-y-4">
      {pages?.map((page) => (
        <li>
          <a 
            href={`/flexible/${page.id}`} 
            class="text-blue-600 hover:underline font-medium"
          >
            {page.data?.title || page.id} ({page.id})
          </a>
        </li>
      ))}
    </ul>
  </div>
</MainLayout>
