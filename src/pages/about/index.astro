---
import MainLayout from "../../layouts/MainLayout.astro";
import FAQ from "../../components/FAQ.astro";
import { getEntry } from "astro:content";

const aboutpageData = await getEntry("about", "index");

if (!aboutpageData) {
    return Astro.redirect("/404");
}

const hero = aboutpageData.data.hero;

const values = aboutpageData.data.values;
const story = aboutpageData.data.story;
const faq = aboutpageData.data.faq;
const cta = aboutpageData.data.cta;
---

<MainLayout title="About">
    <!-- Hero Section -->
    <section class="py-32">
        <div class="container mx-auto max-w-4xl px-4 md:px-0 text-center">
            <p
                class="text-xs font-bold uppercase tracking-widest text-black dark:text-white mb-4"
            >
                {hero.label}
            </p>
            <h1 class="text-5xl md:text-7xl font-bold mb-8">
                {hero.heading}
            </h1>
            <p
                class="text-lg md:text-xl font-medium mb-10 text-neutral-600 dark:text-neutral-400 max-w-3xl mx-auto"
            >
                {hero.description}
            </p>
        </div>
    </section>

    <!-- Values Section -->
    <section class="py-20">
        <div class="container mx-auto px-4 md:px-0">
            <p
                class="text-xs font-bold uppercase tracking-widest text-black dark:text-white mb-4"
            >
                {values.sectionLabel}
            </p>
            <h2 class="text-5xl font-bold mb-2">{values.heading}</h2>
            <p
                class="text-lg leading-relaxed mb-6 max-w-4xl text-neutral-700 dark:text-neutral-300"
            >
                {values.description}
            </p>

            <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
                {
                    values.items.map((values) => (
                        <article class="border-2 bg-white dark:bg-zinc-950 border-zinc-200 dark:border-zinc-800 p-8 rounded-xl">
                            <div class="text-4xl mb-6">{values.icon}</div>
                            <h3 class="text-lg md:text-xl font-bold mb-4">
                                {values.title}
                            </h3>
                            <p class="leading-relaxed font-medium text-neutral-700 dark:text-neutral-300">
                                {values.description}
                            </p>
                        </article>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- Story Section -->
    <section class="pb-32 container mx-auto px-4 md:px-0">
        <div class="bg-zinc-200 dark:bg-zinc-900 p-8 md:p-16 rounded-xl">
            <div class="grid md:grid-cols-2 gap-12 items-center">
                <div class="text-left">
                    <p
                        class="text-xs font-bold uppercase tracking-widest text-black dark:text-white mb-4"
                    >
                        {story.sectionLabel}
                    </p>
                    <h2
                        class="text-4xl md:text-6xl font-bold dark:text-zinc-200 mb-6 leading-tight"
                    >
                        {story.heading}
                    </h2>
                    {
                        story.items.map((item) => (
                            <p class="text-lg leading-relaxed mb-6 last:mb-0 font-medium text-neutral-700 dark:text-neutral-300">
                                {item.description}
                            </p>
                        ))
                    }
                </div>
                <div
                    class="relative aspect-square md:aspect-4/3 rounded-lg overflow-hidden bg-zinc-300 dark:bg-zinc-800"
                >
                    <img
                        src="https://placehold.co/800x600"
                        alt="Our Story"
                        class="w-full h-full object-cover"
                    />
                </div>
            </div>
        </div>
    </section>

    <!-- FAQ Section -->
    {faq && <FAQ data={faq} />}

    <!-- CTA Section -->
    <section class="pb-32 container mx-auto px-4 md:px-0">
        <div
            class="bg-zinc-200 dark:bg-zinc-900 p-16 md:p-32 text-center rounded-xl"
        >
            <p
                class="text-xs font-bold uppercase tracking-widest text-black dark:text-white mb-4"
            >
                Get started
            </p>
            <h2 class="text-4xl md:text-5xl font-bold mb-6">
                Ready to build something great?
            </h2>
            <p class="text-lg mb-10">
                Join thousands of developers building accessible,
                high-performance websites!.
            </p>
            <a
                href="/audit"
                class="group relative inline-flex items-center justify-center overflow-hidden h-14 px-10 font-bold text-black bg-white dark:bg-green-600 dark:text-white transition-all duration-300 text-lg rounded-md hover:bg-white dark:hover:bg-black"
            >
                <span
                    class="transform transition-transform duration-300 group-hover:-translate-x-4"
                >
                    Get your free audit
                </span>
                <span
                    class="absolute right-6 transform translate-x-4 opacity-0 transition-all duration-300 group-hover:translate-x-0 group-hover:opacity-100"
                >
                    &rarr;
                </span>
            </a>
        </div>
    </section>
</MainLayout>
