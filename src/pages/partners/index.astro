---
// 💡 OPTIONAL PAGE - Delete this file if not needed for your project
// This is a stub page for Partners/Integrations/Technology Partners
// Customize or remove based on client needs

import { getCollection, getEntry } from "astro:content";
import PageHeroSection from "../../components/PageHeroSection.astro";
import CTASection from "../../components/CTASection.astro";
import MainLayout from "../../layouts/MainLayout.astro";

// Get partners page hero content from TinaCMS
const partnersPage = await getEntry("partnersPage", "partners");
const hero = partnersPage?.data?.hero;
const categories = partnersPage?.data?.categories;
const ecosystem = partnersPage?.data?.ecosystem;
const cta = partnersPage?.data?.cta;
const partners = await getCollection(
    "partners",
    ({ data }) => data.isActive !== false,
);
partners.sort((a, b) => a.data.order - b.data.order);
const featuredPartners = partners.filter((p) => p.data.isFeatured);
---

<MainLayout
    title="Partners | Our Technology Partners"
    description="Discover our network of trusted partners and integrations that help us deliver exceptional results."
>
    {hero && <PageHeroSection variant="center" data={hero} />}

    <!-- Partner Categories -->
    {
        categories && categories.length > 0 && (
            <section class="pb-16">
                <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
                        {categories.map((category: any) => (
                            <div class="p-6 border-2 border-neutral-200 dark:border-neutral-800 rounded-lg text-center">
                                <div class="text-4xl mb-4">{category.icon}</div>
                                <h3 class="text-lg font-bold text-black dark:text-white mb-2">
                                    {category.title}
                                </h3>
                                <p class="text-sm text-neutral-600 dark:text-neutral-400">
                                    {category.description}
                                </p>
                            </div>
                        ))}
                    </div>
                </div>
            </section>
        )
    }

    <!-- Featured Partners Grid -->
    <section class="pb-24 lg:pb-32">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <h2
                class="text-2xl md:text-3xl font-bold text-black dark:text-white mb-8 text-center"
            >
                {ecosystem?.heading || "Our Partner Ecosystem"}
            </h2>

            <!-- Partner Logos Grid from CMS -->
            {
                partners.length > 0 ? (
                    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-8 mb-16">
                        {partners.map((partner) => (
                            <a
                                href={partner.data.website}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="aspect-[3/2] border-2 border-neutral-200 dark:border-neutral-800 rounded-lg flex items-center justify-center p-6 hover:border-black dark:hover:border-white transition-colors group"
                            >
                                <div class="text-center">
                                    {partner.data.logo ? (
                                        <img
                                            src={partner.data.logo}
                                            alt={partner.data.name}
                                            class="max-h-12 max-w-full object-contain opacity-70 group-hover:opacity-100 transition-opacity"
                                        />
                                    ) : (
                                        <div class="text-3xl mb-2">🏢</div>
                                    )}
                                    <span class="text-sm font-medium text-neutral-500 dark:text-neutral-400 group-hover:text-black dark:group-hover:text-white transition-colors">
                                        {partner.data.name}
                                    </span>
                                </div>
                            </a>
                        ))}
                    </div>
                ) : (
                    <div class="text-center py-16 border-2 border-dashed border-neutral-300 dark:border-neutral-700 rounded-lg mb-16">
                        <p class="text-neutral-500">No partners added yet.</p>
                    </div>
                )
            }

            <!-- Become a Partner CTA -->
            {
                ecosystem?.becomePartner && (
                    <div class="bg-neutral-100 dark:bg-neutral-900 rounded-lg p-8 md:p-12 text-center">
                        <h3 class="text-2xl md:text-3xl font-bold text-black dark:text-white mb-4">
                            {ecosystem.becomePartner.heading}
                        </h3>
                        <p class="text-lg text-neutral-600 dark:text-neutral-400 mb-8 max-w-2xl mx-auto">
                            {ecosystem.becomePartner.description}
                        </p>
                        <div class="flex flex-col sm:flex-row gap-4 justify-center">
                            <a
                                href={ecosystem.becomePartner.primaryButtonLink}
                                class="px-8 py-3 bg-black dark:bg-white text-white dark:text-black font-bold rounded-md hover:opacity-80 transition-opacity"
                            >
                                {ecosystem.becomePartner.primaryButtonText}
                            </a>
                            <a
                                href={
                                    ecosystem.becomePartner.secondaryButtonLink
                                }
                                class="px-8 py-3 border-2 border-black dark:border-white text-black dark:text-white font-bold rounded-md hover:bg-black hover:text-white dark:hover:bg-white dark:hover:text-black transition-colors"
                            >
                                {ecosystem.becomePartner.secondaryButtonText}
                            </a>
                        </div>
                    </div>
                )
            }

            <!-- Developer Note -->
            <div
                class="mt-16 p-6 bg-amber-50 dark:bg-amber-900/20 border-2 border-amber-200 dark:border-amber-800 rounded-lg"
            >
                <p class="text-amber-800 dark:text-amber-200 font-medium">
                    <strong>💡 Developer Note:</strong> This page uses TinaCMS content.
                </p>
                <ul
                    class="mt-2 ml-4 list-disc text-amber-700 dark:text-amber-300"
                >
                    <li>Manage partners in TinaCMS under "Partners"</li>
                    <li>Upload logos via TinaCMS media manager</li>
                    <li>Mark partners as "Featured" to highlight them</li>
                    <li>
                        Create partner detail pages at <code
                            >src/pages/partners/[slug].astro</code
                        >
                    </li>
                </ul>
            </div>
        </div>
    </section>

    {cta && <CTASection variant="center" data={cta} />}
</MainLayout>
