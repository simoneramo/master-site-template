---
// 💡 OPTIONAL PAGE - Delete this file if not needed for your project
// This is a stub page for Booking/Appointment Scheduling
// Customize or remove based on client needs

import { getEntry } from "astro:content";
import PageHeroSection from "../../components/PageHeroSection.astro";
import CTASection from "../../components/CTASection.astro";
import MainLayout from "../../layouts/MainLayout.astro";

const bookPage = await getEntry("bookPage", "book");
const hero = bookPage?.data?.hero;
const bookingOptions = bookPage?.data?.bookingOptions;
const calendarEmbed = bookPage?.data?.calendarEmbed;
const cta = bookPage?.data?.cta;
---

<MainLayout
    title="Book a Consultation | Schedule a Meeting"
    description="Book a free consultation or schedule a meeting with our team. Find a time that works for you."
>
    <!-- Hero Section -->
    {hero && <PageHeroSection variant="center" data={hero} />}

    <!-- Booking Options -->
    {
        bookingOptions && bookingOptions.length > 0 && (
            <section class="pb-16">
                <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                        {bookingOptions.map((option) => (
                            <div
                                class={`rounded-lg p-8 text-center relative transition-colors ${
                                    option.isPopular
                                        ? "border-2 border-black dark:border-white"
                                        : "border-2 border-neutral-200 dark:border-neutral-800 hover:border-black dark:hover:border-white"
                                }`}
                            >
                                {option.isPopular && (
                                    <span class="absolute -top-3 left-1/2 -translate-x-1/2 px-3 py-1 bg-black dark:bg-white text-white dark:text-black text-xs font-bold uppercase tracking-wider rounded-full">
                                        Popular
                                    </span>
                                )}
                                <div class="text-4xl mb-4">{option.icon}</div>
                                <h3 class="text-xl font-bold text-black dark:text-white mb-2">
                                    {option.title}
                                </h3>
                                <p class="text-neutral-600 dark:text-neutral-400 mb-6">
                                    {option.description}
                                </p>
                                <span class="inline-block px-4 py-2 bg-neutral-100 dark:bg-neutral-800 text-sm font-bold rounded-full">
                                    {option.duration}
                                </span>
                            </div>
                        ))}
                    </div>
                </div>
            </section>
        )
    }

    <!-- Calendar Embed Placeholder -->
    {
        calendarEmbed && (
            <section class="pb-24 lg:pb-32">
                <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                    <div class="border-2 border-neutral-200 dark:border-neutral-800 rounded-lg p-8 md:p-12">
                        <div class="text-center mb-8">
                            <h2 class="text-2xl md:text-3xl font-bold text-black dark:text-white mb-4">
                                {calendarEmbed.heading || "Select a Date & Time"}
                            </h2>
                            <p class="text-neutral-600 dark:text-neutral-400">
                                {calendarEmbed.description || "Choose a meeting type above, then pick an available slot below."}
                            </p>
                        </div>

                        <!-- Calendar Placeholder -->
                        <div class="aspect-4/3 max-w-3xl mx-auto bg-neutral-100 dark:bg-neutral-800 rounded-lg flex items-center justify-center">
                            <div class="text-center p-8">
                                <div class="text-6xl mb-4">{calendarEmbed.placeholderIcon || "📅"}</div>
                                <p class="text-neutral-600 dark:text-neutral-400 font-medium mb-2">
                                    {calendarEmbed.placeholderTitle || "Calendar Integration"}
                                </p>
                                <p class="text-sm text-neutral-500 dark:text-neutral-500">
                                    {calendarEmbed.placeholderText || "Replace this placeholder with your booking platform embed (Calendly, Cal.com, etc.)"}
                                </p>
                            </div>
                        </div>

                        <!-- Alternative Booking Methods -->
                        {calendarEmbed.alternativeMethods && calendarEmbed.alternativeMethods.length > 0 && (
                            <div class="mt-12 text-center">
                                <p class="text-neutral-600 dark:text-neutral-400 mb-4">
                                    {calendarEmbed.alternativeLabel || "Prefer to book another way?"}
                                </p>
                                <div class="flex flex-wrap gap-4 justify-center">
                                    {calendarEmbed.alternativeMethods.map((method) => (
                                        <a
                                            href={method.link}
                                            class="px-6 py-3 border-2 border-neutral-300 dark:border-neutral-700 text-neutral-700 dark:text-neutral-300 font-bold rounded-md hover:border-black dark:hover:border-white hover:text-black dark:hover:text-white transition-colors"
                                        >
                                            {method.label}
                                        </a>
                                    ))}
                                </div>
                            </div>
                        )}
                    </div>
                </div>
            </section>
        )
    }

            <!-- What to Expect -->
            <div class="mt-16">
                <h2
                    class="text-2xl md:text-3xl font-bold text-black dark:text-white mb-8 text-center"
                >
                    What to Expect
                </h2>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                    <div class="text-center">
                        <div
                            class="w-16 h-16 mx-auto mb-4 bg-neutral-100 dark:bg-neutral-800 rounded-full flex items-center justify-center text-2xl font-bold text-black dark:text-white"
                        >
                            1
                        </div>
                        <h3
                            class="text-lg font-bold text-black dark:text-white mb-2"
                        >
                            Book Your Slot
                        </h3>
                        <p class="text-neutral-600 dark:text-neutral-400">
                            Choose a time that works for your schedule
                        </p>
                    </div>
                    <div class="text-center">
                        <div
                            class="w-16 h-16 mx-auto mb-4 bg-neutral-100 dark:bg-neutral-800 rounded-full flex items-center justify-center text-2xl font-bold text-black dark:text-white"
                        >
                            2
                        </div>
                        <h3
                            class="text-lg font-bold text-black dark:text-white mb-2"
                        >
                            Confirmation
                        </h3>
                        <p class="text-neutral-600 dark:text-neutral-400">
                            Receive calendar invite and meeting details
                        </p>
                    </div>
                    <div class="text-center">
                        <div
                            class="w-16 h-16 mx-auto mb-4 bg-neutral-100 dark:bg-neutral-800 rounded-full flex items-center justify-center text-2xl font-bold text-black dark:text-white"
                        >
                            3
                        </div>
                        <h3
                            class="text-lg font-bold text-black dark:text-white mb-2"
                        >
                            Let's Talk
                        </h3>
                        <p class="text-neutral-600 dark:text-neutral-400">
                            We meet, discuss your needs, and outline next steps
                        </p>
                    </div>
                </div>
            </div>

           
        </div>
    </section>


   {cta && <CTASection variant="center" data={cta} />}
</MainLayout>
