---
import MainLayout from "../layouts/MainLayout.astro";
import HeroSection from "../components/HeroSection.astro";
import CTASection from "../components/CTASection.astro";
import { getEntry } from "astro:content";

const landingPage = await getEntry("landingPage", "index");
if (!landingPage) {
    throw new Error("Landing page data is missing");
}
const { hero, cta } = landingPage.data;
---

<MainLayout title="Landing Page" hideMenu={true} showPhoneButton={true}>
    {hero && <HeroSection variant="bold" data={hero} showSocialProof={true} />}

    {cta && <CTASection variant={cta.variant || "center"} data={cta} />}
</MainLayout>
