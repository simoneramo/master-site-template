---
import MainLayout from "../layouts/MainLayout.astro";
import { getEntry, getCollection } from "astro:content";

import ServiceAreas from "../components/ServiceAreas.astro";
import Reviews from "../components/Reviews.astro";

const servicesPage = await getEntry("services", "index");
const reviewsData = await getEntry("globals", "google-reviews");
const contactPage = await getEntry("contact", "index");
if (!servicesPage) {
    throw new Error("Services page data is missing");
}
const { hero, mainServices, additionalServices, industryFocus, cta } =
    servicesPage.data;

interface ServiceItem {
    icon: string;
    title: string;
    description: string;
    features: string[];
    linkText: string;
    linkUrl: string;
}
---

<MainLayout title="Landing Page" hideMenu={true} showPhoneButton={true}>
    <!-- Hero Section -->
    <section class="py-20 md:py-32">
        <div class="mx-auto px-8">
            <div class="grid md:grid-cols-2 gap-12 items-center">
                <div class="text-center md:text-left">
                    <p
                        class="text-xs font-bold uppercase tracking-widest dark:text-white mb-2"
                    >
                        Web Design Frankston
                    </p>
                    <h1
                        id="hero-heading"
                        class="text-5xl md:text-7xl font-bold mb-4"
                    >
                        Ship faster with Accessibility
                    </h1>
                    <p
                        class="text-lg md:text-xl mb-10 max-w-xl text-neutral-800 dark:text-neutral-200"
                    >
                        The seo-optimized, wcag-compliant skeleton designed to
                        save you 20+ hours of setup time. Launch
                        high-performance sites without the audit headaches.
                    </p>
                    <div
                        class="flex flex-col sm:flex-row md:justify-start justify-center gap-4"
                    >
                        <a
                            href="#contact"
                            class="group relative inline-flex items-center justify-center overflow-hidden h-14 px-8 font-bold text-white bg-black dark:bg-white dark:text-black transition-all duration-300 text-lg rounded-md hover:bg-black dark:hover:bg-white"
                        >
                            <span
                                class="transform transition-transform duration-300 group-hover:-translate-x-4"
                            >
                                Get a Quote
                            </span>
                            <span
                                class="absolute right-6 transform translate-x-4 opacity-0 transition-all duration-300 group-hover:translate-x-0 group-hover:opacity-100"
                            >
                                →
                            </span>
                        </a>
                    </div>
                    <p class="mt-8 text-sm font-bold dark:text-white">
                        Trusted by 1,000+ developers for reliable, clean code!
                    </p>
                </div>

                <div
                    class="relative aspect-video bg-zinc-200 dark:bg-zinc-800 rounded-lg overflow-hidden flex items-center justify-center mt-12 md:mt-0"
                >
                    <span
                        class="text-neutral-500 dark:text-neutral-400 font-bold text-xl"
                        >Hero visual</span
                    >
                </div>
            </div>
        </div>
    </section>

    <!-- Google Review Section (Social Proof) -->
    {reviewsData && <Reviews data={reviewsData.data} />}

    <!-- Main Services -->
    <section class="py-20 bg-stone-50 dark:bg-zinc-900">
        <div class="px-8">
            <p
                class="text-xs font-bold uppercase tracking-widest dark:text-white mb-2"
            >
                OUR SERVICES
            </p>
            <h2 class="text-5xl font-bold mb-4">
                {mainServices.heading}
            </h2>

            <p class="text-lg font-medium mb-12">
                Comprehensive web solutions for modern businesses.
            </p>

            <div class="grid md:grid-cols-3 gap-8">
                {
                    mainServices.items.map((service: ServiceItem) => (
                        <article class="border-2 border-zinc-200 dark:border-zinc-700 p-10 rounded-lg bg-white dark:bg-black hover:border-black dark:hover:border-white transition-colors duration-300 group">
                            <div class="w-16 h-16 bg-black dark:bg-white mb-6 flex items-center justify-center rounded-md text-white dark:text-black">
                                {service.icon === "templates" && (
                                    <svg
                                        class="w-8 h-8 fill-current"
                                        viewBox="0 0 24 24"
                                    >
                                        <path d="M9 11H7v2h2v-2zm4 0h-2v2h2v-2zm4 0h-2v2h2v-2zm2-7h-1V2h-2v2H8V2H6v2H5c-1.11 0-1.99.9-1.99 2L3 20c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V9h14v11z" />
                                    </svg>
                                )}
                                {service.icon === "custom" && (
                                    <svg
                                        class="w-8 h-8 fill-current"
                                        viewBox="0 0 24 24"
                                    >
                                        <path d="M22.7 19l-9.1-9.1c.9-2.3.4-5-1.5-6.9-2-2-5-2.4-7.4-1.3L9 6 6 9 1.6 4.7C.4 7.1.9 10.1 2.9 12.1c1.9 1.9 4.6 2.4 6.9 1.5l9.1 9.1c.4.4 1 .4 1.4 0l2.3-2.3c.5-.4.5-1.1.1-1.4z" />
                                    </svg>
                                )}
                                {service.icon === "audit" && (
                                    <svg
                                        class="w-8 h-8 fill-current"
                                        viewBox="0 0 24 24"
                                    >
                                        <path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z" />
                                    </svg>
                                )}
                            </div>
                            <h3 class="text-3xl font-bold mb-4">
                                {service.title}
                            </h3>
                            <p class="text-lg leading-relaxed font-medium mb-6">
                                {service.description}
                            </p>
                            <ul class="space-y-3 mb-6">
                                {service.features.map((feature: string) => (
                                    <li class="flex items-start gap-2">
                                        <span class="block w-1.5 h-1.5 mt-2 bg-black dark:bg-white rounded-full shrink-0" />
                                        {feature}
                                    </li>
                                ))}
                            </ul>
                        </article>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- Why Work With A Local Partner (SEO) -->
    <section class="py-20 dark:bg-black">
        <div class="px-8 max-w-7xl mx-auto">
            <div class="grid md:grid-cols-2 gap-16 items-center">
                <div>
                    <p
                        class="text-xs font-bold uppercase tracking-widest text-black dark:text-white mb-4"
                    >
                        LOCAL EXPERTISE
                    </p>
                    <h2 class="text-4xl font-bold mb-6">
                        Why choose a Mornington Peninsula web partner?
                    </h2>
                    <div class="prose dark:prose-invert text-lg">
                        <p class="mb-4">
                            Understanding the <strong
                                >Mornington Peninsula</strong
                            > and <strong>Bayside</strong> market requires more than
                            just digital skills—it requires local context.
                        </p>
                        <p class="mb-6">
                            We're not an offshore agency. We're your neighbors
                            in <strong>Frankston</strong> and <strong
                                >Mount Eliza</strong
                            >. We understand the local business landscape, from
                            seasonal tourism trends to the specific needs of
                            local service providers. When you work with us, you
                            get a partner who is available for a real coffee,
                            not just a Zoom call.
                        </p>
                    </div>
                    <ul class="space-y-4 font-bold mt-8">
                        <li class="flex items-center gap-3">
                            <span
                                class="w-6 h-6 rounded-full bg-green-100 text-green-600 flex items-center justify-center"
                                >✓</span
                            >
                            Deep understanding of the local market
                        </li>
                        <li class="flex items-center gap-3">
                            <span
                                class="w-6 h-6 rounded-full bg-green-100 text-green-600 flex items-center justify-center"
                                >✓</span
                            >
                            Available for in-person strategy sessions
                        </li>
                        <li class="flex items-center gap-3">
                            <span
                                class="w-6 h-6 rounded-full bg-green-100 text-green-600 flex items-center justify-center"
                                >✓</span
                            >
                            Supporting the local economy
                        </li>
                    </ul>
                </div>
                <div
                    class="relative bg-gray-100 dark:bg-zinc-800 rounded-lg aspect-square flex items-center justify-center border-2 border-zinc-200 dark:border-zinc-700 overflow-hidden"
                >
                    <!-- Placeholder for a local image -->
                    <span
                        class="text-2xl font-bold opacity-20 transform -rotate-12"
                        >Local Photo</span
                    >
                </div>
            </div>
        </div>
    </section>

    <!-- Industry Focus -->
    <section class="py-20 bg-stone-50 dark:bg-zinc-900">
        <div class="container mx-auto px-8 max-w-5xl">
            <div class="text-center">
                <p
                    class="text-xs font-bold uppercase tracking-widest dark:text-white mb-4"
                >
                    Industries
                </p>
                <h2 class="text-5xl font-bold mb-6">
                    {industryFocus.heading}
                </h2>
                <p class="text-lg dark:text-white mb-12 max-w-2xl mx-auto">
                    {industryFocus.description}
                </p>
            </div>

            <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
                {
                    industryFocus.items.map((industry: string) => (
                        <div class="border-2 border-zinc-200 dark:border-zinc-700 p-6 rounded-lg text-center font-bold bg-white dark:bg-black">
                            {industry}
                        </div>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- Location Map & Service Areas -->
    {
        contactPage?.data?.serviceAreas && (
            <ServiceAreas data={contactPage.data.serviceAreas} />
        )
    }

    <!-- Final CTA Section -->
    <section
        id="contact"
        class="py-20 bg-black text-white dark:bg-white dark:text-black"
    >
        <div class="container mx-auto px-8 max-w-3xl text-center">
            <p
                class="text-xs font-bold uppercase tracking-widest dark:text-white mb-4"
            >
                Ready to start?
            </p>
            <h2 class="text-5xl font-bold mb-6">{cta.heading}</h2>
            <p class="text-lg mb-10 text-neutral-300 dark:text-neutral-700">
                {cta.description}
            </p>
            <div class="flex flex-col sm:flex-row gap-4 justify-center">
                <a
                    href={cta.primaryBtn.link}
                    class="group relative inline-flex items-center justify-center overflow-hidden h-14 px-8 font-bold text-black bg-white dark:bg-black dark:text-white transition-all duration-300 text-lg rounded-md hover:bg-transparent hover:text-white dark:hover:bg-transparent dark:hover:text-black"
                >
                    <span
                        class="transform transition-transform duration-300 group-hover:-translate-x-4"
                    >
                        {cta.primaryBtn.text}
                    </span>
                    <span
                        class="absolute right-6 transform translate-x-4 opacity-0 transition-all duration-300 group-hover:translate-x-0 group-hover:opacity-100"
                    >
                        &rarr;
                    </span>
                </a>
            </div>
        </div>
    </section>
</MainLayout>
