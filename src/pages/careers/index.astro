---
// 💡 OPTIONAL PAGE - Delete this file if not needed for your project
// This is a stub page for the Careers/Job Board
// Customize or remove based on client needs

import { getCollection, getEntry } from "astro:content";
import PageHeroSection from "../../components/PageHeroSection.astro";
import CardGrid from "../../components/CardGrid.astro";
import CTASection from "../../components/CTASection.astro";
import MainLayout from "../../layouts/MainLayout.astro";

// Get careers page hero content from TinaCMS
const careersPage = await getEntry("careersPage", "careers");
const hero = careersPage?.data?.hero;
const values = careersPage?.data?.values;
const generalApplication = careersPage?.data?.generalApplication;
const cta = careersPage?.data?.cta;

const jobs = await getCollection("careers", ({ data }) => data.isActive !== false);
jobs.sort((a, b) => a.data.order - b.data.order);
---

<MainLayout
    title="Careers | Join Our Team"
    description="Explore career opportunities and join a team that's passionate about making a difference."
>


    <PageHeroSection variant="center" data={hero} />

 
     <!-- Values Section -->
    <CardGrid data={values} variant="left" columns={3} />



    <!-- Job Listings -->
    <section class="pb-24 lg:pb-32">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <h2
                class="text-2xl md:text-3xl font-bold text-black dark:text-white mb-8"
            >
                Open Positions
            </h2>

            <!-- Job Listings from CMS -->
            {jobs.length > 0 ? (
                <div class="space-y-4">
                    {jobs.map((job) => (
                        <div class="border-2 border-neutral-200 dark:border-neutral-800 rounded-lg p-6 hover:border-black dark:hover:border-white transition-colors">
                            <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
                                <div>
                                    <h3 class="text-xl font-bold text-black dark:text-white">
                                        {job.data.title}
                                    </h3>
                                    <p class="text-neutral-600 dark:text-neutral-400 mt-1">
                                        {job.data.department} • {job.data.type} • {job.data.location}
                                        {job.data.salary && <span> • {job.data.salary}</span>}
                                    </p>
                                </div>
                                <a
                                    href={`/careers/${job.slug}`}
                                    class="px-6 py-3 bg-black dark:bg-white text-white dark:text-black font-bold rounded-md hover:opacity-80 transition-opacity whitespace-nowrap text-center"
                                >
                                    View Details
                                </a>
                            </div>
                        </div>
                    ))}
                </div>
            ) : (
                <!-- No Jobs State -->
                <div class="p-8 text-center border-2 border-dashed border-neutral-300 dark:border-neutral-700 rounded-lg">
                    <p class="text-neutral-600 dark:text-neutral-400">
                        No open positions at the moment.
                    </p>
                </div>
            )}

            <!-- General Application -->
            {generalApplication && (
                <div class="mt-12 p-8 text-center border-2 border-dashed border-neutral-300 dark:border-neutral-700 rounded-lg">
                    <p class="text-neutral-600 dark:text-neutral-400">
                        {generalApplication.description}
                    </p>
                    <a
                        href={generalApplication.buttonLink}
                        class="inline-block mt-4 text-black dark:text-white font-bold underline underline-offset-4"
                    >
                        {generalApplication.buttonText}
                    </a>
                </div>
            )}

        </div>
    </section>

 
    {cta && <CTASection variant="center" data={cta} />}
    
</MainLayout>
