---
/**
 * Component Library — Index Page
 * Browse all 17 section types and their available layout patterns.
 * URL: /component-library/
 */
import MainLayout from '../../layouts/MainLayout.astro';
import { PATTERN_REGISTRY, getStats } from '../../data/pattern-registry';

const stats = getStats();
---

<MainLayout
  title="Component Library — Pattern Browser"
  description="Browse all section patterns and layout variants available in the master site template."
  hideHeader
  hideFooter
>
  <section class="py-16">
    <div class="container mx-auto px-4 md:px-8">

      <!-- Header -->
      <div class="mb-12">
        <div class="flex items-center gap-3 mb-4">
          <span class="text-4xl">🧩</span>
          <h1 class="text-4xl md:text-5xl font-bold">Component Library</h1>
        </div>
        <p class="text-lg text-neutral-600 dark:text-neutral-400 max-w-2xl">
          Browse all section patterns and layout variants. Click a section to see live-rendered previews of every variant.
        </p>

        <!-- Stats Bar -->
        <div class="flex flex-wrap gap-6 mt-8 text-sm font-bold">
          <div class="flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-neutral-300 dark:bg-neutral-700"></span>
            <span>{stats.totalSections} Sections</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-neutral-300 dark:bg-neutral-700"></span>
            <span>{stats.totalPatterns} Total Patterns</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-green-500"></span>
            <span>{stats.ready} Ready</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-yellow-500"></span>
            <span>{stats.wip} In Progress</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-neutral-400"></span>
            <span>{stats.planned} Planned</span>
          </div>
        </div>
      </div>

      <!-- Section Grid -->
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {PATTERN_REGISTRY.map((section) => {
          const readyCount = section.variants.filter(v => v.status === 'ready').length;
          const totalCount = section.variants.length;
          const progressPercent = totalCount > 0 ? Math.round((readyCount / totalCount) * 100) : 0;

          return (
            <a
              href={`/component-library/${section.slug}`}
              class="group block border-2 border-zinc-200 dark:border-zinc-800 rounded-xl p-6 hover:border-black dark:hover:border-white transition-all duration-200 hover:shadow-lg"
            >
              <div class="flex items-start justify-between mb-4">
                <span class="text-3xl">{section.icon}</span>
                <span class="text-xs font-bold uppercase tracking-wider text-neutral-400 dark:text-neutral-500">
                  {totalCount} variants
                </span>
              </div>

              <h2 class="text-xl font-bold mb-2 group-hover:underline underline-offset-4">
                {section.label}
              </h2>

              <!-- Variant pills -->
              <div class="flex flex-wrap gap-1.5 mb-4">
                {section.variants.slice(0, 4).map((variant) => (
                  <span
                    class:list={[
                      'text-[11px] font-medium px-2 py-0.5 rounded-full',
                      variant.status === 'ready'
                        ? 'bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-400'
                        : variant.status === 'wip'
                          ? 'bg-yellow-100 text-yellow-700 dark:bg-yellow-900/30 dark:text-yellow-400'
                          : 'bg-zinc-100 text-zinc-500 dark:bg-zinc-800 dark:text-zinc-400',
                    ]}
                  >
                    {variant.label}
                  </span>
                ))}
                {totalCount > 4 && (
                  <span class="text-[11px] font-medium px-2 py-0.5 rounded-full bg-zinc-100 text-zinc-500 dark:bg-zinc-800 dark:text-zinc-400">
                    +{totalCount - 4} more
                  </span>
                )}
              </div>

              <!-- Progress bar -->
              <div class="mt-auto">
                <div class="flex justify-between text-xs font-medium text-neutral-500 dark:text-neutral-400 mb-1.5">
                  <span>{readyCount} / {totalCount} built</span>
                  <span>{progressPercent}%</span>
                </div>
                <div class="w-full h-1.5 bg-zinc-100 dark:bg-zinc-800 rounded-full overflow-hidden">
                  <div
                    class="h-full bg-green-500 rounded-full transition-all duration-500"
                    style={`width: ${progressPercent}%`}
                  />
                </div>
              </div>

              <!-- Arrow -->
              <div class="mt-4 flex items-center gap-1 text-sm font-bold text-neutral-400 group-hover:text-black dark:group-hover:text-white transition-colors">
                <span>Browse variants</span>
                <span class="transform group-hover:translate-x-1 transition-transform">→</span>
              </div>
            </a>
          );
        })}
      </div>

    </div>
  </section>
</MainLayout>
