---
/**
 * Component Library — Visual Gallery
 * Shows all components as thumbnail cards for quick visual selection.
 * Useful for Design Prompt Builder or client presentations.
 */
import MainLayout from '../../layouts/MainLayout.astro';
import { PATTERN_REGISTRY, getAllPatternsWithPreviews } from '../../data/pattern-registry';

const allPatterns = getAllPatternsWithPreviews();
const readyPatterns = allPatterns.filter(p => p.status === 'ready');
---

<MainLayout
  title="Component Gallery — Visual Preview"
  description="Browse all 103 component variants as thumbnail cards."
  headerVariant="simple"
  footerVariant="simple"
>
  <section class="py-16">
    <div class="container mx-auto px-4 md:px-8">
      
      <!-- Header -->
      <div class="mb-12">
        <h1 class="text-4xl md:text-5xl font-bold mb-4">Component Gallery</h1>
        <p class="text-lg text-neutral-600 dark:text-neutral-400">
          Visual thumbnails of all {readyPatterns.length} ready component variants.
          Click any card to view the live preview.
        </p>
      </div>

      <!-- Filter by Section -->
      <div class="flex flex-wrap gap-2 mb-8">
        <a 
          href="#all" 
          class="px-4 py-2 rounded-full bg-zinc-950 text-white dark:bg-white dark:text-black font-bold text-sm"
        >
          All
        </a>
        {PATTERN_REGISTRY.map(section => (
          <a 
            href={`#${section.slug}`}
            class="px-4 py-2 rounded-full bg-surface dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 font-bold text-sm hover:border-zinc-400 transition-colors"
          >
            {section.icon} {section.label}
          </a>
        ))}
      </div>

      <!-- Gallery Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
        {readyPatterns.map((pattern) => (
          <a
            href={`/component-library/${pattern.sectionSlug}#${pattern.key}`}
            class="group block bg-white dark:bg-zinc-950 rounded-xl border-2 border-zinc-200 dark:border-zinc-800 overflow-hidden hover:border-accent transition-colors"
          >
            {/* Thumbnail */}
            <div class="aspect-[16/10] bg-zinc-100 dark:bg-zinc-900 relative overflow-hidden">
              <img
                src={pattern.preview}
                alt={pattern.label}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
                onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
              />
              <div style="display: none;" class="absolute inset-0 bg-zinc-100 dark:bg-zinc-800 flex items-center justify-center">
                <span class="text-neutral-400 text-sm">Preview not captured</span>
              </div>
              {/* Hover Overlay */}
              <div class="absolute inset-0 bg-zinc-950/0 group-hover:bg-zinc-950/10 transition-colors flex items-center justify-center">
                <span class="opacity-0 group-hover:opacity-100 bg-zinc-950 text-white px-4 py-2 rounded-full text-sm font-bold transform translate-y-2 group-hover:translate-y-0 transition-all">
                  View Live →
                </span>
              </div>
            </div>
            
            {/* Info */}
            <div class="p-4">
              <div class="flex items-center gap-2 mb-1">
                <span class="text-xs font-bold text-accent uppercase tracking-wider">
                  {pattern.sectionSlug}
                </span>
                <span class="text-neutral-300">·</span>
                <span class="text-xs text-neutral-500">{pattern.component}</span>
              </div>
              <h3 class="font-bold group-hover:text-accent transition-colors">
                {pattern.label}
              </h3>
              <p class="text-sm text-neutral-500 dark:text-neutral-400 line-clamp-2 mt-1">
                {pattern.brief}
              </p>
            </div>
          </a>
        ))}
      </div>

      <!-- Empty State (if no captures yet) -->
      {readyPatterns.length > 0 && (
        <div class="mt-12 p-8 bg-surface dark:bg-zinc-900/50 rounded-xl border-2 border-dashed border-zinc-200 dark:border-zinc-800 text-center">
          <p class="text-neutral-500 dark:text-neutral-400">
            <strong>Missing thumbnails?</strong> Run{' '}
            <code class="bg-zinc-200 dark:bg-zinc-800 px-2 py-1 rounded text-sm">pnpm capture-previews</code>
            {' '}to generate them.
          </p>
        </div>
      )}

    </div>
  </section>
</MainLayout>
