---
import MainLayout from "../layouts/MainLayout.astro";
import PageHeroSection from "../components/PageHeroSection.astro";
import FAQ from "../components/FAQ.astro";
import CTASection from "../components/CTASection.astro";
import { getEntry } from "astro:content";

// Get FAQ page content from TinaCMS
const faqPage = await getEntry("faqPage", "faq");
const hero = faqPage?.data?.hero;
const faq = faqPage?.data?.faq;
const cta = faqPage?.data?.cta;
---

<MainLayout title="Frequently Asked Questions">
    <PageHeroSection variant="center" data={hero} />

    {faq && <FAQ data={faq} initialVisibleCount={12} />}

    <!-- CTA Section -->
    {cta && <CTASection variant={cta.variant || "left"} data={cta} />}
</MainLayout>
