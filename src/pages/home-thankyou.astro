---
import { getEntry } from "astro:content";
import MainLayout from "../layouts/MainLayout.astro";
import PageHeroSection from "../components/PageHeroSection.astro";

const entry = await getEntry("homepage", "index");

if (!entry || !entry.data.thankYou) {
    throw new Error("Homepage thank you content not found.");
}

const thankYou = entry.data.thankYou;
const { heading, description, buttonText, buttonLink } = thankYou;
---

<MainLayout title={heading}>
    <PageHeroSection variant="center" data={thankYou} />
</MainLayout>

<script>
    import confetti from "canvas-confetti";

    const count = 600;
    const defaults = {
        origin: { x: 0.5, y: 0.5 },
    };

    function fire(particleRatio, opts) {
        confetti(
            Object.assign({}, defaults, opts, {
                particleCount: Math.floor(count * particleRatio),
            }),
        );
    }

    fire(0.25, {
        spread: 26,
        startVelocity: 55,
    });
    fire(0.2, {
        spread: 60,
    });
    fire(0.35, {
        spread: 100,
        decay: 0.91,
        scalar: 0.8,
    });
    fire(0.1, {
        spread: 120,
        startVelocity: 25,
        decay: 0.92,
        scalar: 1.2,
    });
    fire(0.1, {
        spread: 120,
        startVelocity: 45,
    });
</script>
