---
import MainLayout from "../../layouts/MainLayout.astro";
import PageHeroSection from "../../components/PageHeroSection.astro";
import CardGrid from "../../components/CardGrid.astro";
import PricingTiers from "../../components/PricingTiers.astro";
import CTASection from "../../components/CTASection.astro";
import { getEntry } from "astro:content";

// Get pricing page content from TinaCMS
const pricingPage = await getEntry("pricingPage", "pricing");
const hero = pricingPage?.data?.hero;
const pricingTiers = pricingPage?.data?.pricingTiers;
const features = pricingPage?.data?.features;
const cta = pricingPage?.data?.cta;
---

<MainLayout title="Pricing - WeMakeSmall">
    <!-- Breadcrumbs -->
    <nav aria-label="Breadcrumb" class="py-4">
        <div class="px-8 mx-auto flex items-center gap-2 text-md font-bold">
            <a
                href="/"
                class="text-neutral-500 hover:text-black dark:text-neutral-400 dark:hover:text-white transition-colors"
                >Home</a
            >
            <span class="text-neutral-300 dark:text-neutral-700">/</span>
            <span class="text-black dark:text-white">Pricing</span>
        </div>
    </nav>

    {hero && <PageHeroSection variant="center" data={hero} />}

    <!-- Pricing Tiers -->
    {pricingTiers && <PricingTiers data={pricingTiers} />}

    <!-- Features Section -->
    {features && <CardGrid data={features} variant="center" columns={3} />}

    <!-- CTA Section -->
    {cta && <CTASection variant="center" data={cta} />}
</MainLayout>
