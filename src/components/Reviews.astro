---
interface Props {
    data: {
        sectionLabel?: string;
        heading?: string;
        averageRating?: number;
        totalReviews?: number;
        items?: {
            author: string;
            date: string;
            avatar?: string;
            rating: number;
            content: string;
        }[];
    };
}

const { data } = Astro.props;

if (!data) return null;

const {
    sectionLabel = "Reviews",
    heading = "What our clients say",
    averageRating = 5,
    totalReviews = 0,
    items = [],
} = data;
---

<section class="py-20 bg-white dark:bg-black">
    <div class="px-8 max-w-7xl mx-auto">
        <div class="text-center mb-16">
            <p
                class="text-xs font-bold uppercase tracking-widest text-black dark:text-white mb-4 bg-pink-500"
            >
                {sectionLabel}
            </p>
            <h2 class="text-5xl font-bold mb-6">
                {heading}
            </h2>
            <div class="flex justify-center items-center gap-2">
                <span class="text-xl font-bold">{averageRating.toFixed(1)}</span
                >
                <div class="flex text-yellow-400">
                    {
                        Array.from({ length: 5 }).map((_, i) => (
                            <span>
                                {i < Math.round(averageRating) ? "★" : "☆"}
                            </span>
                        ))
                    }
                </div>
                <span class="text-sm font-medium opacity-60"
                    >based on {totalReviews} reviews</span
                >
                <svg class="h-6 w-6" viewBox="0 0 24 24">
                    <path
                        d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"
                        fill="#4285F4"></path>
                    <path
                        d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
                        fill="#34A853"></path>
                    <path
                        d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.26.81-.58z"
                        fill="#FBBC05"></path>
                    <path
                        d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"
                        fill="#EA4335"></path>
                </svg>
            </div>
        </div>

        <div class="grid md:grid-cols-3 gap-8">
            {
                items.map((review) => (
                    <div class="p-8 border-2 border-zinc-200 dark:border-zinc-700 rounded-lg bg-white dark:bg-black">
                        <div class="flex items-center gap-4 mb-6">
                            <div class="w-12 h-12 rounded-full bg-gray-200 overflow-hidden">
                                {review.avatar && (
                                    <img
                                        src={review.avatar}
                                        alt="User avatar"
                                    />
                                )}
                            </div>
                            <div>
                                <h3 class="font-bold">{review.author}</h3>
                                <div class="text-xs opacity-60">
                                    {review.date}
                                </div>
                            </div>
                            <img
                                src="/google-logo.svg"
                                onerror="this.style.display='none'"
                                class="h-6 w-6 ml-auto"
                                alt="Google"
                            />
                        </div>
                        <div class="flex text-yellow-400 mb-4 text-lg">
                            {Array.from({ length: 5 }).map((_, i) => (
                                <span>{i < review.rating ? "★" : "☆"}</span>
                            ))}
                        </div>
                        <p class="leading-relaxed font-medium">
                            "{review.content}"
                        </p>
                    </div>
                ))
            }
        </div>
    </div>
</section>
