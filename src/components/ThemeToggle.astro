---
/**
 * ThemeToggle — animated sun/moon dark-mode toggle button.
 *
 * Drop <ThemeToggle /> into any header. Uses `currentColor` so it inherits the
 * surrounding text colour (works on light, dark, and transparent headers).
 * Persists the choice in localStorage and syncs with the OS preference.
 */
---

<button
  class="theme-toggle relative group p-2 rounded-full transition-all duration-300 hover:bg-transparent focus:outline-none text-current cursor-pointer"
  aria-label="Toggle Theme"
  title="Toggle Theme"
>
  <svg
    width="24"
    height="24"
    viewBox="0 0 24 24"
    fill="none"
    stroke="none"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="transform origin-center theme-toggle-svg"
  >
    <defs>
      <mask id="moon-mask">
        <rect x="0" y="0" width="100%" height="100%" fill="white"></rect>
        <circle cx="30" cy="0" r="9" fill="black" class="theme-toggle-mask"></circle>
      </mask>
    </defs>

    <!-- Sun Center / Moon Body -->
    <circle cx="12" cy="12" r="5" mask="url(#moon-mask)" fill="currentColor" class="theme-toggle-center"></circle>

    <!-- Sun Rays -->
    <g style="transform-origin: center center" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="theme-toggle-rays">
      <line x1="12" y1="1" x2="12" y2="3"></line>
      <line x1="12" y1="21" x2="12" y2="23"></line>
      <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
      <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
      <line x1="1" y1="12" x2="3" y2="12"></line>
      <line x1="21" y1="12" x2="23" y2="12"></line>
      <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
      <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
    </g>
  </svg>
</button>

<style>
  .theme-toggle-svg {
    transition: transform 1.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }
  .theme-toggle-mask {
    transition:
      cx 0.5s ease-in-out,
      cy 0.5s ease-in-out;
  }
  .theme-toggle-center {
    transition: r 0.5s ease-in-out;
  }
  .theme-toggle-rays {
    transition:
      transform 0.5s ease-in-out,
      opacity 0.5s ease-in-out;
    transform-origin: center center;
  }

  :global(.dark) .theme-toggle-svg {
    transform: rotate(40deg);
  }
  :global(.dark) .theme-toggle-mask {
    cx: 12px;
    cy: 4px;
  }
  :global(.dark) .theme-toggle-center {
    r: 9px;
  }
  :global(.dark) .theme-toggle-rays {
    opacity: 0;
    transform: scale(0.5);
  }
</style>

<script is:inline>
  (function () {
    function syncTheme() {
      const saved = localStorage.getItem("theme");
      const systemDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
      if (saved === "dark" || (!saved && systemDark)) {
        document.documentElement.classList.add("dark");
      } else {
        document.documentElement.classList.remove("dark");
      }
    }

    function bindToggles() {
      syncTheme();
      document.querySelectorAll(".theme-toggle").forEach((btn) => {
        if (btn.dataset.themeBound) return;
        btn.dataset.themeBound = "true";
        btn.addEventListener("click", () => {
          const isDark = document.documentElement.classList.toggle("dark");
          localStorage.setItem("theme", isDark ? "dark" : "light");
        });
      });

      if (!window.__themeMediaBound) {
        window.__themeMediaBound = true;
        window
          .matchMedia("(prefers-color-scheme: dark)")
          .addEventListener("change", (e) => {
            localStorage.removeItem("theme");
            document.documentElement.classList.toggle("dark", e.matches);
          });
      }
    }

    document.addEventListener("DOMContentLoaded", bindToggles);
    document.addEventListener("astro:page-load", bindToggles);
    bindToggles();
  })();
</script>
