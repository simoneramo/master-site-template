---
import { getEntry } from "astro:content";

interface Props {
    data?: {
        sectionLabel: string;
        heading: string;
        description: string;
        items: {
            rating: number;
            quote: string;
            authorName: string;
            authorTitle: string;
            authorImage: string;
        }[];
    };
}

let { data } = Astro.props;

// If no data passed, fetch from global components collection
if (!data) {
    const components = await getEntry("components", "index");
    if (components && components.data.testimonials) {
        data = components.data.testimonials;
    }
}
---

{
    data && (
        <section class="py-20 bg-white dark:bg-black">
            <div class="mx-auto px-4 md:px-0">
                <p class="text-xs font-bold uppercase tracking-widest text-black dark:text-white mb-4 bg-pink-500">
                    {data.sectionLabel}
                </p>
                <h2 class="text-5xl font-bold mb-4">{data.heading}</h2>
                <p class="text-lg font-medium text-neutral-600 dark:text-neutral-400 mb-12 max-w-3xl">
                    {data.description}
                </p>

                <div class="grid md:grid-cols-3 gap-8">
                    {data.items.map((t, index: number) => {
                        const colors = [
                            "bg-blue-200 text-blue-800 dark:bg-blue-900/40 dark:text-blue-300",
                            "bg-emerald-200 text-emerald-800 dark:bg-emerald-900/40 dark:text-emerald-300",
                            "bg-amber-200 text-amber-800 dark:bg-amber-900/40 dark:text-amber-300",
                            "bg-purple-200 text-purple-800 dark:bg-purple-900/40 dark:text-purple-300",
                            "bg-pink-200 text-pink-800 dark:bg-pink-900/40 dark:text-pink-300",
                            "bg-rose-200 text-rose-800 dark:bg-rose-900/40 dark:text-rose-300",
                            "bg-indigo-200 text-indigo-800 dark:bg-indigo-900/40 dark:text-indigo-300",
                        ];
                        const colorClass = colors[index % colors.length];
                        const names = t.authorName
                            ? t.authorName.split(" ")
                            : ["?"];
                        const initials =
                            names.length > 1
                                ? (
                                      names[0][0] + names[names.length - 1][0]
                                  ).toUpperCase()
                                : names[0][0].toUpperCase();

                        return (
                            <figure class="border-2 bg-white dark:bg-black border-stone-200 dark:border-zinc-700 p-4 md:p-8 rounded-lg transition-colors group flex flex-col h-full">
                                <div class="flex gap-1 mb-4 text-yellow-500 dark:text-yellow-400">
                                    {Array.from({ length: t.rating }).map(
                                        () => (
                                            <svg
                                                class="w-6 h-6 fill-current"
                                                viewBox="0 0 20 20"
                                            >
                                                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                                            </svg>
                                        ),
                                    )}
                                </div>
                                <blockquote class="grow mb-6">
                                    <p class="font-medium text-lg">
                                        "{t.quote}"
                                    </p>
                                </blockquote>
                                <figcaption class="flex items-center gap-4 mt-auto">
                                    <div
                                        class={`w-12 h-12 flex items-center justify-center rounded-md font-bold text-lg ${colorClass}`}
                                    >
                                        {initials}
                                    </div>
                                    <div>
                                        <div class="font-bold text-lg">
                                            {t.authorName}
                                        </div>
                                        <div class="text-sm font-bold text-neutral-500 dark:text-neutral-400">
                                            {t.authorTitle}
                                        </div>
                                    </div>
                                </figcaption>
                            </figure>
                        );
                    })}
                </div>
            </div>
        </section>
    )
}
