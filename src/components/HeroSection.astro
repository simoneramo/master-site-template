---
/**
 * HeroSection — supports 3 layout variants, same Tina data shape for all.
 *
 * variant="split"    → text left, visual right (current homepage style)
 * variant="centered" → everything centered, large heading, no image
 * variant="bold"     → full-width dark background, oversized text, accent bar
 */

interface Props {
    variant?: "split" | "centered" | "bold";
    data: {
        label?: string;
        heading: string;
        description: string;
        buttonText: string;
        buttonLink: string;
        trustBadge?: string;
    };
    /** Optional: show social proof avatars + stars (split variant only) */
    showSocialProof?: boolean;
}

const { variant = "split", data, showSocialProof = true } = Astro.props;
const { label, heading, description, buttonText, buttonLink, trustBadge } =
    data;

const avatars = [
    "https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=100&h=100",
    "https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?auto=format&fit=crop&w=100&h=100",
    "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=100&h=100",
    "https://images.unsplash.com/photo-1494790108377-be9c29b29330?auto=format&fit=crop&w=100&h=100",
    "https://images.unsplash.com/photo-1500648767791-00dcc994a43e?auto=format&fit=crop&w=100&h=100",
];
---

{
    /* ─────────────────────────────────────────────
    VARIANT: SPLIT (text left, graphic right)
    ───────────────────────────────────────────── */
}
{
    variant === "split" && (
        <section class="py-20 md:py-32">
            <div class="container mx-auto px-4 md:px-0">
                <div class="grid md:grid-cols-5 gap-12 items-center">
                    <div class="col-span-5 md:col-span-3 text-center md:text-left">
                        {label && (
                            <p class="text-xs font-bold uppercase tracking-widest text-black dark:text-white mb-4">
                                {label}
                            </p>
                        )}
                        <h1
                            id="hero-heading"
                            class="text-5xl md:text-6xl max-w-xl font-bold mb-8"
                        >
                            {heading}
                        </h1>
                        <p class="text-lg font-medium mb-10 max-w-xl text-neutral-600 dark:text-neutral-200">
                            {description}
                        </p>
                        <div class="flex flex-col sm:flex-row md:justify-start justify-center gap-4">
                            <a
                                href={buttonLink}
                                class="group relative inline-flex items-center justify-center overflow-hidden h-14 px-10 font-bold text-white bg-black dark:bg-white dark:text-black transition-all duration-300 text-lg rounded-md hover:bg-zinc-800 dark:hover:bg-zinc-200"
                            >
                                <span class="transform transition-transform duration-300 group-hover:-translate-x-4">
                                    {buttonText}
                                </span>
                                <span class="absolute right-6 transform -translate-x-4 opacity-0 transition-all duration-300 group-hover:translate-x-0 group-hover:opacity-100">
                                    &rarr;
                                </span>
                            </a>
                        </div>

                        {showSocialProof && (
                            <div class="mt-10 flex flex-col md:items-start items-center gap-4">
                                <div class="flex -space-x-3">
                                    {avatars.map((src) => (
                                        <img
                                            class="w-10 h-10 rounded-full border-2 border-stone-100 dark:border-black object-cover"
                                            src={src}
                                            alt="Happy client"
                                        />
                                    ))}
                                </div>
                                <div class="flex items-center gap-2">
                                    <div class="flex text-yellow-400">
                                        {Array.from({ length: 5 }).map(() => (
                                            <svg
                                                class="w-5 h-5 fill-current"
                                                viewBox="0 0 20 20"
                                            >
                                                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                                            </svg>
                                        ))}
                                    </div>
                                    <span class="font-bold text-md text-neutral-800 dark:text-neutral-200">
                                        5 out of 5 (12)
                                    </span>
                                </div>
                            </div>
                        )}

                        {trustBadge && (
                            <p class="mt-8 text-md font-bold text-purple-500 dark:text-purple-400">
                                {trustBadge}
                            </p>
                        )}
                    </div>

                    {/* Abstract geometric visual */}
                    <div class="col-span-12 md:col-span-2 relative h-64 md:h-96 flex items-center justify-center">
                        <div class="relative w-full h-full">
                            <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-48 h-48 rounded-full bg-gradient-to-br from-indigo-500/20 to-purple-600/20 dark:from-indigo-400/10 dark:to-purple-500/10 blur-xl" />
                            <div class="absolute top-1/3 left-1/3 w-24 h-24 bg-gradient-to-br from-zinc-200 to-zinc-300 dark:from-zinc-700 dark:to-zinc-600 rotate-12 rounded-2xl" />
                            <div class="absolute bottom-1/4 right-1/4 w-16 h-16 bg-gradient-to-br from-indigo-400 to-indigo-600 dark:from-indigo-500 dark:to-indigo-700 rounded-full" />
                            <div class="absolute top-1/4 right-1/3 w-32 h-1 bg-gradient-to-r from-transparent via-zinc-400 to-transparent dark:via-zinc-500 rotate-45" />
                            <div class="absolute bottom-1/3 left-1/4 w-8 h-8 bg-gradient-to-br from-purple-400 to-pink-500 dark:from-purple-500 dark:to-pink-600 rotate-45 rounded-lg" />
                            <div class="absolute top-1/2 right-1/4 grid grid-cols-3 gap-2">
                                {Array.from({ length: 9 }).map(() => (
                                    <div class="w-2 h-2 rounded-full bg-zinc-300 dark:bg-zinc-600" />
                                ))}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    )
}

{
    /* ─────────────────────────────────────────────
    VARIANT: CENTERED (everything centered, no image)
    Best for: professional services, consultants, law firms
    ───────────────────────────────────────────── */
}
{
    variant === "centered" && (
        <section class="py-24 md:py-40">
            <div class="container mx-auto px-4 text-center max-w-4xl">
                {label && (
                    <span class="inline-block text-xs font-bold uppercase tracking-widest border border-zinc-300 dark:border-zinc-700 px-4 py-1.5 rounded-full mb-8 text-neutral-600 dark:text-neutral-400">
                        {label}
                    </span>
                )}
                <h1
                    id="hero-heading"
                    class="text-5xl md:text-7xl font-bold mb-8 leading-tighter"
                >
                    {heading}
                </h1>
                <p class="text-xl font-medium mb-12 text-neutral-600 dark:text-neutral-400 max-w-2xl mx-auto leading-relaxed">
                    {description}
                </p>
                <div class="flex flex-col sm:flex-row gap-4 justify-center">
                    <a
                        href={buttonLink}
                        class="group relative inline-flex items-center justify-center overflow-hidden h-14 px-12 font-bold text-white bg-black dark:bg-white dark:text-black transition-all duration-300 text-lg rounded-full hover:bg-zinc-800 dark:hover:bg-zinc-200"
                    >
                        <span class="transform transition-transform duration-300 group-hover:-translate-x-4">
                            {buttonText}
                        </span>
                        <span class="absolute right-8 transform -translate-x-4 opacity-0 transition-all duration-300 group-hover:translate-x-0 group-hover:opacity-100">
                            &rarr;
                        </span>
                    </a>
                    <a
                        href="/about"
                        class="inline-flex items-center justify-center h-14 px-10 font-bold border-2 border-zinc-300 dark:border-zinc-700 rounded-full hover:border-black dark:hover:border-white transition-colors"
                    >
                        Learn more
                    </a>
                </div>
                {trustBadge && (
                    <p class="mt-10 text-sm font-bold text-neutral-400 dark:text-neutral-500 uppercase tracking-wider">
                        {trustBadge}
                    </p>
                )}
                {/* Subtle divider */}
                <div class="mt-20 flex items-center gap-6 justify-center">
                    <div class="h-px bg-zinc-200 dark:bg-zinc-800 flex-1 max-w-24" />
                    <span class="text-xs font-bold uppercase tracking-widest text-neutral-400">
                        Trusted by local businesses
                    </span>
                    <div class="h-px bg-zinc-200 dark:bg-zinc-800 flex-1 max-w-24" />
                </div>
            </div>
        </section>
    )
}

{
    /* ─────────────────────────────────────────────
    VARIANT: BOLD (dark full-width, oversized text)
    Best for: gyms, trades, food, high-energy brands
    ───────────────────────────────────────────── */
}
{
    variant === "bold" && (
        <section class="bg-black dark:bg-zinc-950 text-white min-h-[85vh] flex items-center relative overflow-hidden">
            {/* Background texture */}
            <div class="absolute inset-0 opacity-5">
                <div
                    class="absolute top-0 left-0 w-full h-full"
                    style="background-image: radial-gradient(circle, #fff 1px, transparent 1px); background-size: 32px 32px;"
                />
            </div>
            {/* Accent blobs */}
            <div class="absolute top-1/4 right-1/4 w-96 h-96 bg-indigo-600/20 rounded-full blur-3xl pointer-events-none" />
            <div class="absolute bottom-1/4 left-1/3 w-64 h-64 bg-purple-600/20 rounded-full blur-3xl pointer-events-none" />

            <div class="container mx-auto px-4 md:px-0 relative z-10 py-24 md:py-32">
                {label && (
                    <div class="flex items-center gap-3 mb-8">
                        <div class="w-8 h-0.5 bg-indigo-500" />
                        <span class="text-xs font-bold uppercase tracking-widest text-indigo-400">
                            {label}
                        </span>
                    </div>
                )}
                <h1
                    id="hero-heading"
                    class="text-5xl md:text-7xl font-bold mb-8 leading-none tracking-tight max-w-4xl"
                >
                    {heading}
                </h1>
                <p class="text-xl font-medium mb-12 text-zinc-400 max-w-2xl leading-relaxed">
                    {description}
                </p>
                <div class="flex flex-col sm:flex-row gap-4">
                    <a
                        href={buttonLink}
                        class="group relative inline-flex items-center justify-center overflow-hidden h-16 px-12 font-bold text-black bg-white transition-all duration-300 text-lg rounded-md hover:bg-zinc-100"
                    >
                        <span class="transform transition-transform duration-300 group-hover:-translate-x-4">
                            {buttonText}
                        </span>
                        <span class="absolute right-8 transform -translate-x-4 opacity-0 transition-all duration-300 group-hover:translate-x-0 group-hover:opacity-100">
                            &rarr;
                        </span>
                    </a>
                    <a
                        href="/contact"
                        class="inline-flex items-center justify-center h-16 px-10 font-bold border-2 border-zinc-700 text-white rounded-md hover:border-white transition-colors"
                    >
                        Get in touch
                    </a>
                </div>
                {trustBadge && (
                    <p class="mt-10 text-sm font-bold text-zinc-500 uppercase tracking-wider">
                        {trustBadge}
                    </p>
                )}
            </div>
        </section>
    )
}
