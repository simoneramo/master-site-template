---
const { data } = Astro.props;
---

<section class="py-20 bg-white dark:bg-zinc-900">
    <div class="container mx-auto px-4 md:px-0">
        <div class="text-center mb-16">
            <h2 class="text-4xl md:text-5xl font-bold mb-4">
                {data.heading}
            </h2>
        </div>

        <div class="grid md:grid-cols-3 gap-8">
            {
                data.items &&
                    data.items.map((item: any) => (
                        <div class="p-8 rounded-xl bg-stone-50 dark:bg-black border-2 border-transparent hover:border-black dark:hover:border-white transition-colors">
                            <div class="text-4xl mb-4">{item.icon}</div>
                            <h3 class="text-2xl font-bold mb-2">
                                {item.title}
                            </h3>
                            <p class="text-neutral-600 dark:text-neutral-400 font-medium">
                                {item.description}
                            </p>
                        </div>
                    ))
            }
        </div>
    </div>
</section>
