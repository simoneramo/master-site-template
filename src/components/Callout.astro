---
interface Props {
    data: {
        label: string;
        heading: string;
        description: string;
        image: string;
        buttonText: string;
        buttonLink: string;
    };
    flip?: boolean;
}

const { data, flip = false } = Astro.props;
---

<section class="py-20">
    <div class="mx-auto px-4 md:px-0">
        <div class="grid md:grid-cols-2 gap-12 items-center">
            <!-- Text Content -->
            <div class={`text-left ${flip ? "md:order-last" : ""}`}>
                <p
                    class="text-xs font-bold uppercase tracking-widest text-black dark:text-white mb-4 bg-pink-500"
                >
                    {data.label}
                </p>
                <h2 class="text-5xl font-bold mb-4">{data.heading}</h2>
                <p
                    class="text-lg text-neutral-600 dark:text-neutral-400 mb-8 font-medium"
                >
                    {data.description}
                </p>
                <a
                    href={data.buttonLink}
                    class="group relative inline-flex items-center justify-center overflow-hidden h-14 px-10 font-bold text-white bg-black dark:bg-white dark:text-black transition-all duration-300 text-lg rounded-md hover:bg-black dark:hover:bg-white"
                >
                    <span
                        class="transform transition-transform duration-300 group-hover:-translate-x-4"
                    >
                        {data.buttonText}
                    </span>
                    <span
                        class="absolute right-6 transform -translate-x-4 opacity-0 transition-all duration-300 group-hover:translate-x-0 group-hover:opacity-100"
                    >
                        &rarr;
                    </span>
                </a>
            </div>

            <!-- Image -->
            <div
                class={`relative aspect-video rounded-lg overflow-hidden ${flip ? "md:order-first" : ""}`}
            >
                <img
                    src={data.image}
                    alt={data.heading}
                    class="w-full h-full object-cover"
                />
            </div>
        </div>
    </div>
</section>
