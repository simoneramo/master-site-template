---
interface Props {
    image: string;
    alt: string;
    label: string;
    heading: string;
    description: string;
    ctaText?: string;
    ctaLink?: string;
    reverse?: boolean;
}

const {
    image,
    alt,
    label,
    heading,
    description,
    ctaText,
    ctaLink,
    reverse = false,
} = Astro.props as Props;
---

<section
    class="relative z-10 h-[250vh] bg-white dark:bg-black"
    x-data="{ 
            progress: 0,
            calculateProgress() {
                const rect = $el.getBoundingClientRect();
                const windowHeight = window.innerHeight;
                const elementHeight = $el.offsetHeight;
                
                // Calculate how far we are through the section
                // When rect.top is 0, we are at start (locked).
                // As we scroll down, rect.top becomes negative.
                const scrolled = -rect.top;
                const scrollableDistance = elementHeight - windowHeight;
                
                if (scrollableDistance > 0) {
                    this.progress = Math.max(0, Math.min(1, scrolled / scrollableDistance));
                }
            }
        }"
    @scroll.window="calculateProgress()"
    x-init="calculateProgress()"
>
    <div class="sticky top-0 h-screen flex items-center overflow-hidden">
        <div class="container mx-auto px-4 md:px-0 w-full">
            <div class={`grid md:grid-cols-2 gap-16 items-center`}>
                <!-- Content Side -->
                <div class={`${reverse ? "md:order-last" : ""}`}>
                    <p
                        class="text-xs font-bold uppercase tracking-widest text-black dark:text-white mb-4"
                    >
                        {label}
                    </p>
                    <h2 class="text-5xl font-bold mb-6">
                        {heading}
                    </h2>
                    <p
                        class="text-lg text-neutral-600 dark:text-neutral-400 font-medium leading-relaxed mb-8"
                    >
                        {description}
                    </p>
                    {
                        ctaText && ctaLink && (
                            <div class="mt-6">
                                <a
                                    href={ctaLink}
                                    class="font-bold border-b-2 border-black dark:border-white hover:border-transparent transition-colors text-black dark:text-white"
                                >
                                    {ctaText} &rarr;
                                </a>
                            </div>
                        )
                    }
                </div>

                <!-- Image Side — Browser Chrome Mockup -->
                <div
                    class="relative w-full rounded-xl overflow-hidden border-2 border-zinc-200 dark:border-zinc-700 shadow-2xl bg-white dark:bg-zinc-900"
                >
                    <!-- Browser Chrome Bar -->
                    <div
                        class="flex items-center gap-3 px-4 py-3 bg-zinc-100 dark:bg-zinc-800 border-b border-zinc-200 dark:border-zinc-700 shrink-0"
                    >
                        <!-- Traffic Lights -->
                        <div class="flex items-center gap-1.5">
                            <div class="w-3 h-3 rounded-full bg-red-400"></div>
                            <div class="w-3 h-3 rounded-full bg-yellow-400">
                            </div>
                            <div class="w-3 h-3 rounded-full bg-green-400">
                            </div>
                        </div>
                        <!-- URL Bar -->
                        <div
                            class="flex-1 flex items-center gap-2 bg-white dark:bg-zinc-700 rounded-md px-3 py-1.5 text-xs font-medium text-neutral-400 dark:text-zinc-400 border border-zinc-200 dark:border-zinc-600"
                        >
                            <svg
                                class="w-3 h-3 shrink-0 text-green-500"
                                fill="currentColor"
                                viewBox="0 0 20 20"
                            >
                                <path
                                    fill-rule="evenodd"
                                    d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z"
                                    clip-rule="evenodd"></path>
                            </svg>
                            sitename.com.au
                        </div>
                    </div>
                    <!-- Scrolling Image -->
                    <div class="relative h-[560px] w-full overflow-hidden">
                        <img
                            src={image}
                            alt={alt}
                            class="absolute inset-0 w-full h-full object-cover will-change-[object-position]"
                            :style="`object-position: 50% ${progress * 100}%`"
                        />
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
