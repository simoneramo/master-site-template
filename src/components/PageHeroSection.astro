---
/**
 * PageHeroSection — Simple page hero with two layout variants
 *
 * variant="center"  → centered text, max-width container (default)
 * variant="left"    → left-aligned text
 */

interface Props {
  variant?: "center" | "left";
  data: {
    label?: string;
    heading: string;
    description: string;
  };
}

const { variant = "center", data } = Astro.props;
const { label, heading, description } = data;
---

{
  /* ─────────────────────────────────────────────
  VARIANT: CENTER (centered text)
  ───────────────────────────────────────────── */
}
{
  variant === "center" && (
    <section class="py-20">
      <div class="container mx-auto max-w-4xl text-center">
        {label && (
          <p class="text-xs font-bold uppercase tracking-widest text-neutral-600 dark:text-white mb-4">
            {label}
          </p>
        )}
        <h1 class="text-5xl md:text-6xl font-bold mb-8">{heading}</h1>
        <p class="text-lg md:text-xl font-medium mb-10 text-neutral-600 dark:text-neutral-400 max-w-2xl mx-auto">
          {description}
        </p>
      </div>
    </section>
  )
}

{
  /* ─────────────────────────────────────────────
  VARIANT: LEFT (left-aligned text)
  ───────────────────────────────────────────── */
}
{
  variant === "left" && (
    <section class="py-20">
      <div class="container mx-auto px-4 md:px-0">
        {label && (
          <p class="text-xs font-bold uppercase tracking-widest text-neutral-600 dark:text-white mb-4">
            {label}
          </p>
        )}
        <h1 class="text-5xl md:text-6xl font-bold mb-8">{heading}</h1>
        <p class="text-lg md:text-xl font-medium mb-10 text-neutral-600 dark:text-neutral-400">
          {description}
        </p>
      </div>
    </section>
  )
}
