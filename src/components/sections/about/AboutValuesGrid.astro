---
/**
 * AboutValuesGrid — Mission + Values
 * Pattern key: valuesGrid
 * Section: About
 *
 * Centered eyebrow/heading/description above a grid of value cards, each
 * with an icon, title, and description.
 */
import type { AboutData } from "../../../data/sample-data";

interface Props {
  data: AboutData;
  /** Section ID for anchor links */
  id?: string;
}

const { data, id } = Astro.props;
const { eyebrow, heading, description, values = [] } = data;
---

<section {id} class="py-20 md:py-32 bg-neutral-50 dark:bg-zinc-900">
  <div class="container mx-auto px-4 md:px-8">
    <div class="text-center max-w-2xl mx-auto mb-14">
      {eyebrow && (
        <span class="inline-flex items-center text-xs font-bold uppercase tracking-widest px-4 py-1.5 rounded-full border border-zinc-300 dark:border-zinc-700 text-neutral-600 dark:text-neutral-400 mb-6">
          {eyebrow}
        </span>
      )}
      <h2 class="text-4xl md:text-5xl font-bold mb-4">{heading}</h2>
      {description && <p class="text-lg text-neutral-600 dark:text-neutral-400">{description}</p>}
    </div>

    {values.length > 0 && (
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {values.map((value) => (
          <div class="bg-white dark:bg-zinc-950 p-8 rounded-2xl border border-zinc-200 dark:border-zinc-800">
            {value.icon && <div class="text-3xl mb-4">{value.icon}</div>}
            <h3 class="text-lg font-bold mb-2">{value.title}</h3>
            <p class="text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">{value.description}</p>
          </div>
        ))}
      </div>
    )}
  </div>
</section>
