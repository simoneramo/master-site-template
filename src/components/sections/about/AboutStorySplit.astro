---
/**
 * AboutStorySplit — Image + Story
 * Pattern key: storySplit
 * Section: About
 *
 * Two-column layout: a feature image on one side, the company story
 * (eyebrow, heading, rich-text body) on the other, with an optional
 * stats row beneath.
 */
import type { AboutData } from "../../../data/sample-data";

interface Props {
  data: AboutData;
  /** Section ID for anchor links */
  id?: string;
}

const { data, id } = Astro.props;
const { eyebrow, heading, description, body, image, metrics = [] } = data;
---

<section {id} class="py-20 md:py-32">
  <div class="container mx-auto px-4 md:px-8">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <!-- Image -->
      {
        image?.src && (
          <div class="relative aspect-4/3 rounded-2xl overflow-hidden bg-zinc-100 dark:bg-zinc-900">
            <img src={image.src} alt={image.alt || heading} class="w-full h-full object-cover" loading="lazy" />
          </div>
        )
      }

      <!-- Story -->
      <div>
        {eyebrow && (
          <span class="inline-flex items-center text-xs font-bold uppercase tracking-widest px-4 py-1.5 rounded-full border border-zinc-300 dark:border-zinc-700 text-neutral-600 dark:text-neutral-400 mb-6">
            {eyebrow}
          </span>
        )}
        <h2 class="text-3xl md:text-4xl font-bold mb-5 dark:text-white">{heading}</h2>
        {description && (
          <p class="text-lg text-neutral-600 dark:text-neutral-400 mb-6">{description}</p>
        )}
        {body && (
          <div class="prose prose-lg dark:prose-invert prose-zinc max-w-none" set:html={body} />
        )}
      </div>
    </div>

    {metrics.length > 0 && (
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 mt-16 pt-12 border-t border-zinc-200 dark:border-zinc-800 text-center">
        {metrics.map((stat) => (
          <div>
            <div class="text-4xl md:text-5xl font-extrabold tracking-tight text-accent mb-1">{stat.value}</div>
            <div class="text-sm font-medium text-neutral-500 dark:text-neutral-400">{stat.label}</div>
          </div>
        ))}
      </div>
    )}
  </div>
</section>
