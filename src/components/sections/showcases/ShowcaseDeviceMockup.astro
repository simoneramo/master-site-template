---
/**
 * ShowcaseDeviceMockup — Centered Laptop Mockup
 * Pattern key: deviceMockup
 * Section: Showcase
 *
 * Centered heading and copy with a large laptop-frame mockup of the
 * product below. Good for hero-style product reveals.
 */
import type { ShowcaseData } from '../../../data/sample-data';

interface Props {
  data: ShowcaseData;
  /** Section ID for anchor links */
  id?: string;
}

const { data, id } = Astro.props;
const { eyebrow, heading, description, cta, image } = data;
---

<section {id} class="py-20 md:py-32 bg-white dark:bg-black overflow-hidden">
  <div class="container mx-auto px-4 md:px-8">
    <!-- Copy -->
    <div class="text-center max-w-2xl mx-auto mb-14">
      {eyebrow && (
        <span class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-widest px-4 py-1.5 rounded-full border border-zinc-300 dark:border-zinc-700 text-neutral-600 dark:text-neutral-400 mb-6">
          <span class="w-1.5 h-1.5 rounded-full bg-green-500 animate-pulse" />
          {eyebrow}
        </span>
      )}
      <h2 class="text-4xl sm:text-5xl font-bold leading-tight mb-6 dark:text-white">
        {heading}
      </h2>
      <p class="text-lg md:text-xl text-neutral-600 dark:text-neutral-300 font-medium leading-relaxed mb-8">
        {description}
      </p>
      {cta?.text && cta?.url && (
        <a
          href={cta.url}
          class="inline-flex items-center justify-center h-14 px-10 font-bold text-white bg-black dark:bg-white dark:text-black transition-colors text-lg rounded-lg hover:bg-zinc-800 dark:hover:bg-zinc-200"
        >
          {cta.text}
        </a>
      )}
    </div>

    <!-- Laptop Mockup -->
    <div class="max-w-4xl mx-auto">
      <!-- Screen -->
      <div class="relative rounded-t-2xl border-[10px] border-zinc-800 dark:border-zinc-700 bg-zinc-800 dark:bg-zinc-700 shadow-2xl">
        <div class="relative aspect-video w-full overflow-hidden rounded-md bg-white dark:bg-zinc-900">
          {image?.src && (
            <img
              src={image.src}
              alt={image.alt || heading}
              class="absolute inset-0 w-full h-full object-cover object-top"
              loading="lazy"
            />
          )}
        </div>
      </div>
      <!-- Base / hinge -->
      <div class="relative mx-auto h-4 w-[112%] -ml-[6%] rounded-b-xl bg-zinc-300 dark:bg-zinc-700">
        <div class="absolute left-1/2 top-0 h-1.5 w-24 -translate-x-1/2 rounded-b-md bg-zinc-400 dark:bg-zinc-600"></div>
      </div>
    </div>
  </div>
</section>
