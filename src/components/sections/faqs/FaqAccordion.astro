---
/**
 * FaqAccordion — Accordion FAQ
 * Vertical accordion list, one answer open at a time.
 */
import type { FaqData } from '../../../data/sample-data';

interface Props { data: FaqData; }

const { data } = Astro.props;
const { eyebrow, heading, description, contactCta, items } = data;
---

<section class="py-20 md:py-32">
  <div class="container mx-auto px-4 md:px-8 max-w-3xl">
    <div class="text-center mb-16">
      {eyebrow && (
        <span class="inline-flex items-center text-xs font-bold uppercase tracking-widest px-4 py-1.5 rounded-full border border-zinc-300 dark:border-zinc-700 text-neutral-600 dark:text-neutral-400 mb-6">{eyebrow}</span>
      )}
      <h2 class="text-4xl md:text-5xl font-bold mb-4">{heading}</h2>
      {description && <p class="text-lg text-neutral-600 dark:text-neutral-400">{description}</p>}
    </div>

    <div class="space-y-3" x-data="{ active: null }">
      {items.map((item, i) => (
        <div class="border-2 border-zinc-200 dark:border-zinc-800 rounded-xl overflow-hidden transition-all" :class={`active === ${i} ? 'border-black dark:border-white' : ''`}>
          <button
            @click={`active = active === ${i} ? null : ${i}`}
            class="w-full flex items-center justify-between px-6 py-5 text-left font-bold hover:bg-zinc-50 dark:hover:bg-zinc-900 transition-colors"
          >
            <span>{item.question}</span>
            <svg class="w-5 h-5 shrink-0 ml-4 transition-transform duration-300" :class={`active === ${i} ? 'rotate-180' : ''`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </button>
          <div x-show={`active === ${i}`} x-collapse>
            <div class="px-6 pb-6 text-neutral-600 dark:text-neutral-400 leading-relaxed">
              {item.answer}
            </div>
          </div>
        </div>
      ))}
    </div>

    {contactCta && (
      <div class="text-center mt-12">
        <p class="text-neutral-500 dark:text-neutral-400 mb-4">Still have questions?</p>
        <a href={contactCta.url} class="inline-flex items-center justify-center h-12 px-8 font-bold border-2 border-zinc-300 dark:border-zinc-700 rounded-lg hover:border-black dark:hover:border-white transition-colors">
          {contactCta.text}
        </a>
      </div>
    )}
  </div>
</section>
