---
/**
 * FaqSideBySide — Side-by-Side FAQ
 * Heading + CTA left, accordion right.
 */
import type { FaqData } from '../../../data/sample-data';

interface Props { data: FaqData; }

const { data } = Astro.props;
const { eyebrow, heading, description, contactCta, items } = data;
---

<section class="py-20 md:py-32">
  <div class="container mx-auto px-4 md:px-8">
    <div class="grid lg:grid-cols-12 gap-12 lg:gap-16">
      <!-- Left: Heading -->
      <div class="lg:col-span-4 lg:sticky lg:top-32 lg:self-start">
        {eyebrow && (
          <span class="inline-flex items-center text-xs font-bold uppercase tracking-widest px-4 py-1.5 rounded-full border border-zinc-300 dark:border-zinc-700 text-neutral-600 dark:text-neutral-400 mb-6">{eyebrow}</span>
        )}
        <h2 class="text-4xl font-bold mb-4">{heading}</h2>
        {description && <p class="text-neutral-600 dark:text-neutral-400 leading-relaxed mb-8">{description}</p>}
        {contactCta && (
          <a href={contactCta.url} class="inline-flex items-center justify-center h-12 px-8 font-bold bg-black dark:bg-white text-white dark:text-black rounded-lg hover:bg-zinc-800 dark:hover:bg-zinc-200 transition-colors">
            {contactCta.text} →
          </a>
        )}
      </div>

      <!-- Right: Accordion -->
      <div class="lg:col-span-8 space-y-3" x-data="{ active: 0 }">
        {items.map((item, i) => (
          <div class="border-b-2 border-zinc-200 dark:border-zinc-800">
            <button
              @click={`active = active === ${i} ? null : ${i}`}
              class="w-full flex items-center justify-between py-5 text-left font-bold hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors"
            >
              <span>{item.question}</span>
              <svg class="w-5 h-5 shrink-0 ml-4 transition-transform duration-300" :class={`active === ${i} ? 'rotate-180' : ''`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
            <div x-show={`active === ${i}`} x-collapse>
              <p class="pb-6 text-neutral-600 dark:text-neutral-400 leading-relaxed">{item.answer}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
