---
/**
 * FaqTwoColGrid — Two-Column Grid FAQ
 * All Q&As visible in a 2-column card grid. No collapsing.
 */
import type { FaqData } from '../../../data/sample-data';

interface Props { data: FaqData; }

const { data } = Astro.props;
const { eyebrow, heading, description, items } = data;
---

<section class="py-20 md:py-32">
  <div class="container mx-auto px-4 md:px-8 max-w-5xl">
    <div class="text-center mb-16">
      {eyebrow && (
        <span class="inline-flex items-center text-xs font-bold uppercase tracking-widest px-4 py-1.5 rounded-full border border-zinc-300 dark:border-zinc-700 text-neutral-600 dark:text-neutral-400 mb-6">{eyebrow}</span>
      )}
      <h2 class="text-4xl md:text-5xl font-bold mb-4">{heading}</h2>
      {description && <p class="text-lg text-neutral-600 dark:text-neutral-400">{description}</p>}
    </div>

    <div class="grid md:grid-cols-2 gap-6">
      {items.map((item) => (
        <div class="p-6 rounded-xl border-2 border-zinc-200 dark:border-zinc-800 hover:border-zinc-400 dark:hover:border-zinc-600 transition-colors">
          <h3 class="font-bold text-lg mb-3">{item.question}</h3>
          <p class="text-neutral-600 dark:text-neutral-400 leading-relaxed text-sm">{item.answer}</p>
        </div>
      ))}
    </div>
  </div>
</section>
