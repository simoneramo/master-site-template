---
/**
 * FaqCategorised — Categorised FAQ
 * Category tabs/pills at top filtering different sets of Q&As.
 */
import type { FaqData } from '../../../data/sample-data';

interface Props { data: FaqData; }

const { data } = Astro.props;
const { eyebrow, heading, description, categories = [], items } = data;

const cats = categories.length > 0 ? categories : [...new Set(items.map(i => i.category).filter(Boolean))];
---

<section class="py-20 md:py-32">
  <div class="container mx-auto px-4 md:px-8 max-w-3xl">
    <div class="text-center mb-12">
      {eyebrow && (
        <span class="inline-flex items-center text-xs font-bold uppercase tracking-widest px-4 py-1.5 rounded-full border border-zinc-300 dark:border-zinc-700 text-neutral-600 dark:text-neutral-400 mb-6">{eyebrow}</span>
      )}
      <h2 class="text-4xl md:text-5xl font-bold mb-4">{heading}</h2>
      {description && <p class="text-lg text-neutral-600 dark:text-neutral-400">{description}</p>}
    </div>

    <div x-data={`{ activeCategory: '${cats[0] ?? 'All'}', active: null }`}>
      <!-- Category pills -->
      <div class="flex flex-wrap justify-center gap-2 mb-10">
        {cats.map((cat) => (
          <button
            @click={`activeCategory = '${cat}'; active = null`}
            class="text-xs font-bold px-4 py-2 rounded-full border-2 transition-all"
            :class={`activeCategory === '${cat}' ? 'border-black dark:border-white bg-black dark:bg-white text-white dark:text-black' : 'border-zinc-300 dark:border-zinc-700 hover:border-black dark:hover:border-white'`}
          >
            {cat}
          </button>
        ))}
      </div>

      <!-- FAQ Items -->
      <div class="space-y-3">
        {items.map((item, i) => (
          <div
            x-show={item.category ? `activeCategory === '${item.category}'` : 'true'}
            class="border-2 border-zinc-200 dark:border-zinc-800 rounded-xl overflow-hidden"
          >
            <button
              @click={`active = active === ${i} ? null : ${i}`}
              class="w-full flex items-center justify-between px-6 py-5 text-left font-bold hover:bg-zinc-50 dark:hover:bg-zinc-900 transition-colors"
            >
              <span>{item.question}</span>
              <svg class="w-5 h-5 shrink-0 ml-4 transition-transform duration-300" :class={`active === ${i} ? 'rotate-180' : ''`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
            <div x-show={`active === ${i}`} x-collapse>
              <div class="px-6 pb-6 text-neutral-600 dark:text-neutral-400 leading-relaxed">{item.answer}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
