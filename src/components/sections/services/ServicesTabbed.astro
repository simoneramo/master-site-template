---
/**
 * ServicesTabbed — Tabbed Services
 * Tab navigation at top, each tab reveals service content below.
 */
import type { ServicesData } from '../../../data/sample-data';

interface Props { data: ServicesData; }

const { data } = Astro.props;
const { eyebrow, heading, description, services } = data;
---

<section class="py-20 md:py-32 bg-surface dark:bg-zinc-900/50">
  <div class="container mx-auto px-4 md:px-8">
    <div class="text-center max-w-2xl mx-auto mb-12">
      {eyebrow && (
        <span class="inline-flex items-center text-xs font-bold uppercase tracking-widest px-4 py-1.5 rounded-full border border-zinc-300 dark:border-zinc-700 text-neutral-600 dark:text-neutral-400 mb-6">
          {eyebrow}
        </span>
      )}
      <h2 class="text-4xl md:text-5xl font-bold mb-4">{heading}</h2>
      {description && <p class="text-lg text-neutral-600 dark:text-neutral-400">{description}</p>}
    </div>

    <!-- Alpine.js Tabs -->
    <div x-data="{ activeTab: 0 }">
      <!-- Tab Navigation -->
      <div class="flex flex-wrap justify-center gap-2 mb-12">
        {services.map((service, index) => (
          <button
            @click={`activeTab = ${index}`}
            class="px-6 py-3 rounded-full font-bold text-sm transition-all"
            :class={`activeTab === ${index} ? 'bg-zinc-950 text-white dark:bg-white dark:text-black' : 'bg-white dark:bg-zinc-950 border-2 border-zinc-200 dark:border-zinc-800 hover:border-zinc-300 dark:hover:border-zinc-700'`}
          >
            <span class="flex items-center gap-2">
              {service.icon && <span>{service.icon}</span>}
              <span class="hidden sm:inline">{service.heading}</span>
            </span>
          </button>
        ))}
      </div>

      <!-- Tab Content -->
      <div class="relative min-h-[400px]">
        {services.map((service, index) => (
          <div
            x-show={`activeTab === ${index}`}
            x-transition:enter="transition ease-out duration-300"
            x-transition:enter-start="opacity-0 translate-y-4"
            x-transition:enter-end="opacity-100 translate-y-0"
            x-transition:leave="transition ease-in duration-200"
            x-transition:leave-start="opacity-100 translate-y-0"
            x-transition:leave-end="opacity-0 -translate-y-4"
            class="grid lg:grid-cols-2 gap-8 lg:gap-16 items-center"
            style={`display: ${index === 0 ? 'grid' : 'none'}`}
            x-cloak
          >
            {/* Image */}
            <div class="order-2 lg:order-1">
              {service.image ? (
                <div class="aspect-4/3 rounded-2xl overflow-hidden bg-zinc-200 dark:bg-zinc-800">
                  <img 
                    src={service.image.src} 
                    alt={service.image.alt}
                    class="w-full h-full object-cover"
                  />
                </div>
              ) : (
                <div class="aspect-4/3 rounded-2xl bg-zinc-200 dark:bg-zinc-800 flex items-center justify-center">
                  {service.icon && <span class="text-8xl">{service.icon}</span>}
                </div>
              )}
            </div>

            {/* Content */}
            <div class="order-1 lg:order-2">
              {service.icon && (
                <div class="w-16 h-16 rounded-2xl bg-zinc-950 dark:bg-white text-white dark:text-black flex items-center justify-center text-3xl mb-6">
                  {service.icon}
                </div>
              )}
              <h3 class="text-3xl md:text-4xl font-bold mb-4">{service.heading}</h3>
              <p class="text-lg text-neutral-600 dark:text-neutral-400 mb-8 leading-relaxed">
                {service.description}
              </p>
              {service.link && (
                <a 
                  href={service.link.url}
                  class="inline-flex items-center justify-center h-14 px-10 font-bold bg-zinc-950 text-white dark:bg-white dark:text-black rounded-lg hover:bg-zinc-800 dark:hover:bg-zinc-200 transition-all"
                >
                  {service.link.text}
                </a>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
