---
/**
 * ServicesThreeCol — 3-Column Cards
 * Three cards per row with icon, heading, description, and optional link.
 */
import type { ServicesData } from '../../../data/sample-data';

interface Props { data: ServicesData; }

const { data } = Astro.props;
const { eyebrow, heading, description, services } = data;
---

<section class="py-20 md:py-32">
  <div class="container mx-auto px-4 md:px-8">
    <div class="text-center max-w-2xl mx-auto mb-16">
      {eyebrow && (
        <span class="inline-flex items-center text-xs font-bold uppercase tracking-widest px-4 py-1.5 rounded-full border border-zinc-300 dark:border-zinc-700 text-neutral-600 dark:text-neutral-400 mb-6">
          {eyebrow}
        </span>
      )}
      <h2 class="text-4xl md:text-5xl font-bold mb-4">{heading}</h2>
      {description && <p class="text-lg text-neutral-600 dark:text-neutral-400">{description}</p>}
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
      {services.map((service) => (
        <div class="group bg-surface dark:bg-zinc-900/50 rounded-2xl p-6 lg:p-8 transition-all hover:shadow-lg border-2 border-transparent hover:border-zinc-200 dark:hover:border-zinc-800">
          {service.icon && (
            <div class="w-14 h-14 rounded-xl bg-zinc-950 dark:bg-white text-white dark:text-black flex items-center justify-center text-2xl mb-6">
              {service.icon}
            </div>
          )}
          <h3 class="text-xl font-bold mb-3">{service.heading}</h3>
          <p class="text-neutral-600 dark:text-neutral-400 mb-6 leading-relaxed">{service.description}</p>
          {service.link && (
            <a 
              href={service.link.url}
              class="inline-flex items-center gap-2 font-bold text-sm hover:gap-3 transition-all"
            >
              {service.link.text}
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
              </svg>
            </a>
          )}
        </div>
      ))}
    </div>
  </div>
</section>
