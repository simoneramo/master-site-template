---
/**
 * ServicesAltRows — Alternating Rows
 * Full-width rows alternating image position left/right.
 */
import type { ServicesData } from '../../../data/sample-data';

interface Props { data: ServicesData; }

const { data } = Astro.props;
const { eyebrow, heading, description, services } = data;
---

<section class="py-20 md:py-32">
  <div class="container mx-auto px-4 md:px-8">
    <div class="text-center max-w-2xl mx-auto mb-16">
      {eyebrow && (
        <span class="inline-flex items-center text-xs font-bold uppercase tracking-widest px-4 py-1.5 rounded-full border border-zinc-300 dark:border-zinc-700 text-neutral-600 dark:text-neutral-400 mb-6">
          {eyebrow}
        </span>
      )}
      <h2 class="text-4xl md:text-5xl font-bold mb-4">{heading}</h2>
      {description && <p class="text-lg text-neutral-600 dark:text-neutral-400">{description}</p>}
    </div>

    <div class="space-y-16 lg:space-y-24">
      {services.map((service, index) => {
        const isEven = index % 2 === 0;
        return (
          <div class="grid lg:grid-cols-2 gap-8 lg:gap-16 items-center">
            {/* Image */}
            <div class:list={["relative", isEven ? "lg:order-1" : "lg:order-2"]}>
              {service.image ? (
                <div class="aspect-4/3 rounded-2xl overflow-hidden bg-zinc-200 dark:bg-zinc-800">
                  <img 
                    src={service.image.src} 
                    alt={service.image.alt}
                    class="w-full h-full object-cover"
                  />
                </div>
              ) : (
                <div class="aspect-4/3 rounded-2xl bg-surface dark:bg-zinc-900 flex items-center justify-center">
                  {service.icon && <span class="text-6xl">{service.icon}</span>}
                </div>
              )}
            </div>
            
            {/* Content */}
            <div class:list={[isEven ? "lg:order-2" : "lg:order-1"]}>
              <div class="flex items-center gap-4 mb-4">
                {service.icon && (
                  <span class="w-12 h-12 rounded-xl bg-zinc-950 dark:bg-white text-white dark:text-black flex items-center justify-center text-xl">
                    {service.icon}
                  </span>
                )}
                <span class="text-sm font-bold text-neutral-500 dark:text-neutral-400 uppercase tracking-wider">
                  0{index + 1}
                </span>
              </div>
              <h3 class="text-3xl md:text-4xl font-bold mb-4">{service.heading}</h3>
              <p class="text-lg text-neutral-600 dark:text-neutral-400 mb-6 leading-relaxed">
                {service.description}
              </p>
              {service.link && (
                <a 
                  href={service.link.url}
                  class="inline-flex items-center gap-2 font-bold hover:gap-3 transition-all"
                >
                  {service.link.text}
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                  </svg>
                </a>
              )}
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>
