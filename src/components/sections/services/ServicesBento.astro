---
/**
 * ServicesBento — Bento Grid
 * Asymmetric grid with one large tile spanning 2 columns/rows.
 */
import type { ServicesData } from '../../../data/sample-data';

interface Props { data: ServicesData; }

const { data } = Astro.props;
const { eyebrow, heading, description, services } = data;

// Ensure we have at least 5 services for the bento layout
const displayServices = services.slice(0, Math.max(5, services.length));
---

<section class="py-20 md:py-32">
  <div class="container mx-auto px-4 md:px-8">
    <div class="text-center max-w-2xl mx-auto mb-16">
      {eyebrow && (
        <span class="inline-flex items-center text-xs font-bold uppercase tracking-widest px-4 py-1.5 rounded-full border border-zinc-300 dark:border-zinc-700 text-neutral-600 dark:text-neutral-400 mb-6">
          {eyebrow}
        </span>
      )}
      <h2 class="text-4xl md:text-5xl font-bold mb-4">{heading}</h2>
      {description && <p class="text-lg text-neutral-600 dark:text-neutral-400">{description}</p>}
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-4 lg:gap-6 auto-rows-[200px] md:auto-rows-[240px]">
      {/* Large Feature Card - Spans 2x2 */}
      {displayServices[0] && (
        <div class="md:col-span-2 md:row-span-2 group relative rounded-2xl overflow-hidden bg-surface dark:bg-zinc-900 border-2 border-zinc-200 dark:border-zinc-800">
          {displayServices[0].image ? (
            <img 
              src={displayServices[0].image.src} 
              alt={displayServices[0].image.alt}
              class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
            />
          ) : (
            <div class="absolute inset-0 bg-linear-to-br from-zinc-100 to-zinc-200 dark:from-zinc-800 dark:to-zinc-900" />
          )}
          <div class="absolute inset-0 bg-linear-to-t from-black/80 via-black/20 to-transparent dark:from-white/80 dark:via-white/20 dark:to-transparent" />
          <div class="absolute inset-0 p-6 lg:p-8 flex flex-col justify-end">
            {displayServices[0].icon && <span class="text-4xl mb-3">{displayServices[0].icon}</span>}
            <h3 class="text-2xl lg:text-3xl font-bold mb-2 text-white dark:text-black">{displayServices[0].heading}</h3>
            <p class="text-white/80 dark:text-black/80 text-sm lg:text-base">{displayServices[0].description}</p>
          </div>
        </div>
      )}

      {/* Standard Cards */}
      {displayServices.slice(1, 5).map((service) => (
        <div class="group relative rounded-2xl overflow-hidden bg-surface dark:bg-zinc-900 border-2 border-zinc-200 dark:border-zinc-800 p-6 flex flex-col justify-between hover:border-zinc-300 dark:hover:border-zinc-700 transition-all">
          <div>
            {service.icon && (
              <div class="w-12 h-12 rounded-xl bg-zinc-950 dark:bg-white text-white dark:text-black flex items-center justify-center text-xl mb-4">
                {service.icon}
              </div>
            )}
            <h3 class="text-lg font-bold mb-2">{service.heading}</h3>
            <p class="text-sm text-neutral-600 dark:text-neutral-400 line-clamp-2">{service.description}</p>
          </div>
          {service.link && (
            <a 
              href={service.link.url}
              class="inline-flex items-center gap-1 text-sm font-bold mt-4 hover:gap-2 transition-all"
            >
              {service.link.text}
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </a>
          )}
        </div>
      ))}
    </div>
  </div>
</section>
