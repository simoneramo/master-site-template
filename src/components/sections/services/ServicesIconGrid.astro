---
/**
 * ServicesIconGrid — Compact Icon Grid
 * Dense 4-column grid of icon + label tiles. Hover reveals description.
 */
import type { ServicesData } from '../../../data/sample-data';

interface Props { data: ServicesData; }

const { data } = Astro.props;
const { eyebrow, heading, description, services } = data;
---

<section class="py-20 md:py-32">
  <div class="container mx-auto px-4 md:px-8">
    <div class="text-center max-w-2xl mx-auto mb-16">
      {eyebrow && (
        <span class="inline-flex items-center text-xs font-bold uppercase tracking-widest px-4 py-1.5 rounded-full border border-zinc-300 dark:border-zinc-700 text-neutral-600 dark:text-neutral-400 mb-6">
          {eyebrow}
        </span>
      )}
      <h2 class="text-4xl md:text-5xl font-bold mb-4">{heading}</h2>
      {description && <p class="text-lg text-neutral-600 dark:text-neutral-400">{description}</p>}
    </div>

    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4 lg:gap-6">
      {services.map((service) => (
        <div class="group relative">
          {/* Default State - Icon + Title */}
          <div class="aspect-square bg-surface dark:bg-zinc-900 rounded-2xl border-2 border-zinc-200 dark:border-zinc-800 p-6 flex flex-col items-center justify-center text-center transition-all group-hover:opacity-0 group-hover:scale-95">
            {service.icon && (
              <span class="text-4xl mb-3">{service.icon}</span>
            )}
            <h3 class="font-bold text-sm">{service.heading}</h3>
          </div>
          
          {/* Hover State - Description */}
          <div class="absolute inset-0 bg-zinc-950 text-white dark:bg-white dark:text-black rounded-2xl p-6 flex flex-col items-center justify-center text-center opacity-0 scale-95 group-hover:opacity-100 group-hover:scale-100 transition-all">
            {service.icon && (
              <span class="text-2xl mb-2">{service.icon}</span>
            )}
            <h3 class="font-bold text-sm mb-2">{service.heading}</h3>
            <p class="text-xs text-white/80 dark:text-black/80 line-clamp-3">{service.description}</p>
            {service.link && (
              <a 
                href={service.link.url}
                class="mt-3 text-xs font-bold underline underline-offset-2 hover:no-underline"
              >
                {service.link.text}
              </a>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
