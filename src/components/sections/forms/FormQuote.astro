---
/**
 * FormQuote — Long Quote Form
 * Comprehensive quote request form with multiple sections for detailed project requirements.
 */
import type { FormData } from "../../../data/sample-data";

interface Props {
  data: FormData;
}

const { data } = Astro.props;
const {
  eyebrow,
  heading,
  description,
  submitText = "Request Quote",
  privacyNote,
} = data || {};
---

<section class="py-20 md:py-32 bg-zinc-50 dark:bg-zinc-900">
  <div class="container mx-auto px-4 md:px-8 max-w-3xl">
    <div class="text-center mb-12">
      {
        eyebrow && (
          <span class="inline-flex items-center text-xs font-bold uppercase tracking-widest px-4 py-1.5 rounded-full border border-zinc-300 dark:border-zinc-700 text-neutral-600 dark:text-neutral-400 mb-6">
            {eyebrow}
          </span>
        )
      }
      <h2 class="text-4xl md:text-5xl font-bold mb-4">{heading}</h2>
      {
        description && (
          <p class="text-lg text-neutral-600 dark:text-neutral-400">
            {description}
          </p>
        )
      }
    </div>

    <div
      class="bg-white dark:bg-zinc-950 border-2 border-zinc-200 dark:border-zinc-800 rounded-2xl p-8 md:p-12 shadow-xl"
    >
      <form
        class="space-y-10"
        x-data="{ submitting: false, submitted: false }"
        @submit.prevent="submitting = true; setTimeout(() => { submitting = false; submitted = true }, 1500)"
      >
        {/* Section 1: Contact Information */}
        <div>
          <h3 class="text-lg font-bold mb-6 flex items-center gap-3">
            <span
              class="w-8 h-8 rounded-full bg-zinc-950 dark:bg-white text-white dark:text-black flex items-center justify-center text-sm"
              >1</span
            >
            Contact Information
          </h3>
          <div class="grid md:grid-cols-2 gap-5">
            <div>
              <label for="firstName" class="block text-sm font-bold mb-2">
                First Name <span class="text-red-500">*</span>
              </label>
              <input
                id="firstName"
                name="firstName"
                type="text"
                placeholder="John"
                required
                class="w-full px-4 py-3 rounded-md border-2 border-zinc-200 dark:border-zinc-700 bg-zinc-50 dark:bg-zinc-800 focus:outline-none focus:border-zinc-950 dark:focus:border-white transition-colors text-sm"
              />
            </div>
            <div>
              <label for="lastName" class="block text-sm font-bold mb-2">
                Last Name <span class="text-red-500">*</span>
              </label>
              <input
                id="lastName"
                name="lastName"
                type="text"
                placeholder="Smith"
                required
                class="w-full px-4 py-3 rounded-md border-2 border-zinc-200 dark:border-zinc-700 bg-zinc-50 dark:bg-zinc-800 focus:outline-none focus:border-zinc-950 dark:focus:border-white transition-colors text-sm"
              />
            </div>
            <div>
              <label for="email" class="block text-sm font-bold mb-2">
                Email Address <span class="text-red-500">*</span>
              </label>
              <input
                id="email"
                name="email"
                type="email"
                placeholder="john@company.com"
                required
                class="w-full px-4 py-3 rounded-md border-2 border-zinc-200 dark:border-zinc-700 bg-zinc-50 dark:bg-zinc-800 focus:outline-none focus:border-zinc-950 dark:focus:border-white transition-colors text-sm"
              />
            </div>
            <div>
              <label for="phone" class="block text-sm font-bold mb-2">
                Phone Number
              </label>
              <input
                id="phone"
                name="phone"
                type="tel"
                placeholder="0400 000 000"
                class="w-full px-4 py-3 rounded-md border-2 border-zinc-200 dark:border-zinc-700 bg-zinc-50 dark:bg-zinc-800 focus:outline-none focus:border-zinc-950 dark:focus:border-white transition-colors text-sm"
              />
            </div>
            <div class="md:col-span-2">
              <label for="company" class="block text-sm font-bold mb-2">
                Company / Organization
              </label>
              <input
                id="company"
                name="company"
                type="text"
                placeholder="Acme Inc."
                class="w-full px-4 py-3 rounded-md border-2 border-zinc-200 dark:border-zinc-700 bg-zinc-50 dark:bg-zinc-800 focus:outline-none focus:border-zinc-950 dark:focus:border-white transition-colors text-sm"
              />
            </div>
          </div>
        </div>

        {/* Section 2: Project Details */}
        <div class="pt-10 border-t border-zinc-200 dark:border-zinc-800">
          <h3 class="text-lg font-bold mb-6 flex items-center gap-3">
            <span
              class="w-8 h-8 rounded-full bg-zinc-950 dark:bg-white text-white dark:text-black flex items-center justify-center text-sm"
              >2</span
            >
            Project Details
          </h3>
          <div class="space-y-5">
            <div>
              <label for="projectType" class="block text-sm font-bold mb-2">
                What type of project do you need? <span class="text-red-500"
                  >*</span
                >
              </label>
              <select
                id="projectType"
                name="projectType"
                required
                class="w-full px-4 py-3 rounded-md border-2 border-zinc-200 dark:border-zinc-700 bg-zinc-50 dark:bg-zinc-800 focus:outline-none focus:border-zinc-950 dark:focus:border-white transition-colors text-sm appearance-none cursor-pointer"
              >
                <option value="">Select a project type</option>
                <option value="new-website">New Website</option>
                <option value="redesign">Website Redesign</option>
                <option value="ecommerce">E-commerce Store</option>
                <option value="web-app">Web Application</option>
                <option value="branding">Branding & Identity</option>
                <option value="seo">SEO & Marketing</option>
                <option value="maintenance">Website Maintenance</option>
                <option value="other">Other</option>
              </select>
            </div>
            <div class="grid md:grid-cols-2 gap-5">
              <div>
                <label for="budget" class="block text-sm font-bold mb-2">
                  Estimated Budget <span class="text-red-500">*</span>
                </label>
                <select
                  id="budget"
                  name="budget"
                  required
                  class="w-full px-4 py-3 rounded-md border-2 border-zinc-200 dark:border-zinc-700 bg-zinc-50 dark:bg-zinc-800 focus:outline-none focus:border-zinc-950 dark:focus:border-white transition-colors text-sm appearance-none cursor-pointer"
                >
                  <option value="">Select your budget</option>
                  <option value="2.5k-5k">$2,500 - $5,000</option>
                  <option value="5k-10k">$5,000 - $10,000</option>
                  <option value="10k-25k">$10,000 - $25,000</option>
                  <option value="25k-50k">$25,000 - $50,000</option>
                  <option value="50k+">$50,000+</option>
                </select>
              </div>
              <div>
                <label for="timeline" class="block text-sm font-bold mb-2">
                  Preferred Timeline
                </label>
                <select
                  id="timeline"
                  name="timeline"
                  class="w-full px-4 py-3 rounded-md border-2 border-zinc-200 dark:border-zinc-700 bg-zinc-50 dark:bg-zinc-800 focus:outline-none focus:border-zinc-950 dark:focus:border-white transition-colors text-sm appearance-none cursor-pointer"
                >
                  <option value="">Select timeline</option>
                  <option value="asap">ASAP</option>
                  <option value="1-month">Within 1 month</option>
                  <option value="2-3-months">2-3 months</option>
                  <option value="3-6-months">3-6 months</option>
                  <option value="flexible">Flexible</option>
                </select>
              </div>
            </div>
            <div>
              <label class="block text-sm font-bold mb-3">
                What services do you need? (Select all that apply)
              </label>
              <div class="grid sm:grid-cols-2 gap-3">
                {
                  [
                    { id: "design", label: "Web Design" },
                    { id: "development", label: "Web Development" },
                    { id: "copywriting", label: "Copywriting" },
                    { id: "photography", label: "Photography" },
                    { id: "seo", label: "SEO" },
                    { id: "branding", label: "Branding" },
                    { id: "cms", label: "CMS Integration" },
                    { id: "hosting", label: "Hosting Setup" },
                  ].map((service) => (
                    <label class="flex items-center gap-3 p-3 rounded-md border-2 border-zinc-200 dark:border-zinc-700 cursor-pointer hover:border-zinc-400 dark:hover:border-zinc-500 transition-colors">
                      <input
                        type="checkbox"
                        name="services"
                        value={service.id}
                        class="w-5 h-5 rounded border-zinc-300 dark:border-zinc-600 text-zinc-950 dark:text-white focus:ring-zinc-500"
                      />
                      <span class="text-sm font-medium">{service.label}</span>
                    </label>
                  ))
                }
              </div>
            </div>
          </div>
        </div>

        {/* Section 3: Current Situation */}
        <div class="pt-10 border-t border-zinc-200 dark:border-zinc-800">
          <h3 class="text-lg font-bold mb-6 flex items-center gap-3">
            <span
              class="w-8 h-8 rounded-full bg-zinc-950 dark:bg-white text-white dark:text-black flex items-center justify-center text-sm"
              >3</span
            >
            Current Situation
          </h3>
          <div class="space-y-5">
            <div>
              <label for="currentWebsite" class="block text-sm font-bold mb-2">
                Do you have an existing website?
              </label>
              <input
                id="currentWebsite"
                name="currentWebsite"
                type="url"
                placeholder="https://example.com"
                class="w-full px-4 py-3 rounded-md border-2 border-zinc-200 dark:border-zinc-700 bg-zinc-50 dark:bg-zinc-800 focus:outline-none focus:border-zinc-950 dark:focus:border-white transition-colors text-sm"
              />
            </div>
            <div>
              <label class="block text-sm font-bold mb-3">
                How did you hear about us?
              </label>
              <div class="flex flex-wrap gap-3">
                {
                  [
                    { value: "google", label: "Google Search" },
                    { value: "social", label: "Social Media" },
                    { value: "referral", label: "Referral" },
                    { value: "advertisement", label: "Advertisement" },
                    { value: "other", label: "Other" },
                  ].map((source) => (
                    <label class="flex items-center gap-2 px-4 py-2 rounded-full border-2 border-zinc-200 dark:border-zinc-700 cursor-pointer hover:border-zinc-400 dark:hover:border-zinc-500 transition-colors has-[:checked]:bg-zinc-950 dark:has-[:checked]:bg-white has-[:checked]:text-white dark:has-[:checked]:text-black has-[:checked]:border-zinc-950 dark:has-[:checked]:border-white">
                      <input
                        type="radio"
                        name="referral"
                        value={source.value}
                        class="sr-only"
                      />
                      <span class="text-sm font-medium">{source.label}</span>
                    </label>
                  ))
                }
              </div>
            </div>
          </div>
        </div>

        {/* Section 4: Project Description */}
        <div class="pt-10 border-t border-zinc-200 dark:border-zinc-800">
          <h3 class="text-lg font-bold mb-6 flex items-center gap-3">
            <span
              class="w-8 h-8 rounded-full bg-zinc-950 dark:bg-white text-white dark:text-black flex items-center justify-center text-sm"
              >4</span
            >
            Tell Us About Your Project
          </h3>
          <div class="space-y-5">
            <div>
              <label for="projectGoals" class="block text-sm font-bold mb-2">
                What are your main goals? <span class="text-red-500">*</span>
              </label>
              <textarea
                id="projectGoals"
                name="projectGoals"
                placeholder="e.g., Increase sales, generate leads, showcase portfolio, improve brand awareness..."
                rows={4}
                required
                class="w-full px-4 py-3 rounded-md border-2 border-zinc-200 dark:border-zinc-700 bg-zinc-50 dark:bg-zinc-800 focus:outline-none focus:border-zinc-950 dark:focus:border-white transition-colors text-sm resize-none"
              ></textarea>
            </div>
            <div>
              <label for="projectDetails" class="block text-sm font-bold mb-2">
                Project Details & Requirements
              </label>
              <textarea
                id="projectDetails"
                name="projectDetails"
                placeholder="Tell us more about your project, target audience, competitors, design preferences, features needed, etc."
                rows={6}
                class="w-full px-4 py-3 rounded-md border-2 border-zinc-200 dark:border-zinc-700 bg-zinc-50 dark:bg-zinc-800 focus:outline-none focus:border-zinc-950 dark:focus:border-white transition-colors text-sm resize-none"
              ></textarea>
            </div>
            <div>
              <label for="inspiration" class="block text-sm font-bold mb-2">
                Websites you like (for inspiration)
              </label>
              <textarea
                id="inspiration"
                name="inspiration"
                placeholder="List any websites you like and tell us what you like about them..."
                rows={3}
                class="w-full px-4 py-3 rounded-md border-2 border-zinc-200 dark:border-zinc-700 bg-zinc-50 dark:bg-zinc-800 focus:outline-none focus:border-zinc-950 dark:focus:border-white transition-colors text-sm resize-none"
              ></textarea>
            </div>
          </div>
        </div>

        {/* Success Message */}
        <div x-show="submitted" x-cloak class="text-center py-12">
          <div
            class="w-20 h-20 bg-green-100 dark:bg-green-900/30 text-green-600 dark:text-green-400 rounded-full flex items-center justify-center mx-auto mb-6"
          >
            <svg
              class="w-10 h-10"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M5 13l4 4L19 7"></path>
            </svg>
          </div>
          <h3 class="text-3xl font-bold mb-3">Quote Request Received!</h3>
          <p class="text-neutral-600 dark:text-neutral-400 text-lg">
            Thank you for your detailed request. Our team will review it and get
            back to you within 24-48 hours with a customized quote.
          </p>
        </div>

        {/* Submit Button */}
        <div
          x-show="!submitted"
          class="pt-6 border-t border-zinc-200 dark:border-zinc-800"
        >
          <button
            type="submit"
            class="w-full h-16 bg-zinc-950 dark:bg-white text-white dark:text-black font-bold text-lg rounded-md hover:bg-zinc-800 dark:hover:bg-zinc-200 transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
            :disabled="submitting"
          >
            <span
              x-show="!submitting"
              class="flex items-center justify-center gap-2"
            >
              {submitText}
              <svg
                class="w-5 h-5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
              </svg>
            </span>
            <span
              x-show="submitting"
              class="flex items-center justify-center gap-2"
            >
              <svg class="animate-spin h-5 w-5" fill="none" viewBox="0 0 24 24">
                <circle
                  class="opacity-25"
                  cx="12"
                  cy="12"
                  r="10"
                  stroke="currentColor"
                  stroke-width="4"></circle>
                <path
                  class="opacity-75"
                  fill="currentColor"
                  d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
                ></path>
              </svg>
              Sending your request...
            </span>
          </button>

          {
            privacyNote && (
              <p class="text-xs text-center text-neutral-400 mt-4">
                {privacyNote}
              </p>
            )
          }
        </div>
      </form>
    </div>
  </div>
</section>

<style>
  [x-cloak] {
    display: none !important;
  }
</style>
