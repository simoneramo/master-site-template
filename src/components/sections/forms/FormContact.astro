---
/**
 * FormContact — Contact Form
 * Clean contact form with name, email, phone, and message fields.
 */
import type { FormData } from "../../../data/sample-data";

interface Props {
  data: FormData;
}

const { data } = Astro.props;
const {
  eyebrow,
  heading,
  description,
  submitText = "Send Message",
  privacyNote,
  fields = [],
} = data || {};

const defaultFields = [
  {
    label: "Name",
    type: "text",
    name: "name",
    placeholder: "Your name",
    required: true,
  },
  {
    label: "Email",
    type: "email",
    name: "email",
    placeholder: "you@example.com",
    required: true,
  },
  {
    label: "Phone",
    type: "tel",
    name: "phone",
    placeholder: "0400 000 000",
    required: false,
  },
  {
    label: "Message",
    type: "textarea",
    name: "message",
    placeholder: "Tell us about your project...",
    required: true,
    rows: 4,
  },
];

const formFields = fields.length > 0 ? fields : defaultFields;
---

<section class="py-20 md:py-32">
  <div class="container mx-auto px-4 md:px-8 max-w-2xl">
    <div class="text-center mb-12">
      {
        eyebrow && (
          <span class="inline-flex items-center text-xs font-bold uppercase tracking-widest px-4 py-1.5 rounded-full border border-zinc-300 dark:border-zinc-700 text-neutral-600 dark:text-neutral-400 mb-6">
            {eyebrow}
          </span>
        )
      }
      <h2 class="text-4xl md:text-5xl font-bold mb-4">{heading}</h2>
      {
        description && (
          <p class="text-lg text-neutral-600 dark:text-neutral-400">
            {description}
          </p>
        )
      }
    </div>

    <div
      class="bg-white dark:bg-zinc-950 border-2 border-zinc-200 dark:border-zinc-800 rounded-2xl p-8 md:p-10 shadow-xl"
    >
      <form
        class="space-y-5"
        x-data="{ submitting: false, submitted: false }"
        @submit.prevent="submitting = true; setTimeout(() => { submitting = false; submitted = true }, 1000)"
      >
        {
          formFields.map((field) => (
            <div>
              <label for={field.name} class="block text-sm font-bold mb-2">
                {field.label}
                {field.required && <span class="text-red-500 ml-0.5">*</span>}
              </label>
              {field.type === "textarea" ? (
                <textarea
                  id={field.name}
                  name={field.name}
                  placeholder={field.placeholder}
                  rows={field.rows || 4}
                  required={field.required}
                  class="w-full px-4 py-3 rounded-md border-2 border-zinc-200 dark:border-zinc-700 bg-zinc-50 dark:bg-zinc-800 focus:outline-none focus:border-zinc-950 dark:focus:border-white transition-colors text-sm resize-none"
                />
              ) : (
                <input
                  id={field.name}
                  name={field.name}
                  type={field.type}
                  placeholder={field.placeholder}
                  required={field.required}
                  class="w-full px-4 py-3 rounded-md border-2 border-zinc-200 dark:border-zinc-700 bg-zinc-50 dark:bg-zinc-800 focus:outline-none focus:border-zinc-950 dark:focus:border-white transition-colors text-sm"
                />
              )}
            </div>
          ))
        }

        <button
          type="submit"
          class="w-full h-14 bg-zinc-950 dark:bg-white text-white dark:text-black font-bold text-lg rounded-md hover:bg-zinc-800 dark:hover:bg-zinc-200 transition-colors mt-4 disabled:opacity-50 disabled:cursor-not-allowed"
          :disabled="submitting"
        >
          <span x-show="!submitting && !submitted">{submitText}</span>
          <span
            x-show="submitting"
            class="flex items-center justify-center gap-2"
          >
            <svg class="animate-spin h-5 w-5" fill="none" viewBox="0 0 24 24">
              <circle
                class="opacity-25"
                cx="12"
                cy="12"
                r="10"
                stroke="currentColor"
                stroke-width="4"></circle>
              <path
                class="opacity-75"
                fill="currentColor"
                d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
              ></path>
            </svg>
            Sending...
          </span>
          <span
            x-show="submitted && !submitting"
            class="flex items-center justify-center gap-2"
          >
            <svg
              class="h-5 w-5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M5 13l4 4L19 7"></path>
            </svg>
            Sent!
          </span>
        </button>

        {
          privacyNote && (
            <p class="text-xs text-center text-neutral-400 mt-4">
              {privacyNote}
            </p>
          )
        }
      </form>
    </div>
  </div>
</section>
