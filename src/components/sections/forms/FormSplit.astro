---
/**
 * FormSplit — Two-column Contact
 * Heading, copy and contact details on the left; the full form on the
 * right. Stacks on mobile. Reuses the standard field set.
 */
import type { FormData } from "../../../data/sample-data";

interface Props {
  data: FormData;
}

const { data } = Astro.props;
const {
  eyebrow,
  heading,
  description,
  submitText = "Send Message",
  privacyNote,
  fields = [],
} = data || {};

const defaultFields = [
  { label: "Name", type: "text", name: "name", placeholder: "Your name", required: true },
  { label: "Email", type: "email", name: "email", placeholder: "you@example.com", required: true },
  { label: "Message", type: "textarea", name: "message", placeholder: "Tell us about your project...", required: true, rows: 4 },
];

const formFields = fields.length > 0 ? fields : defaultFields;
---

<section class="py-20 md:py-32">
  <div class="container mx-auto px-4 md:px-8">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-start max-w-5xl mx-auto">
      <!-- Left: copy + contact details -->
      <div class="lg:pt-4">
        {eyebrow && (
          <span class="inline-flex items-center text-xs font-bold uppercase tracking-widest px-4 py-1.5 rounded-full border border-zinc-300 dark:border-zinc-700 text-neutral-600 dark:text-neutral-400 mb-6">
            {eyebrow}
          </span>
        )}
        <h2 class="text-4xl md:text-5xl font-bold mb-4">{heading}</h2>
        {description && (
          <p class="text-lg text-neutral-600 dark:text-neutral-400 mb-8">{description}</p>
        )}

        <ul class="space-y-4 text-sm">
          <li class="flex items-center gap-3">
            <span class="w-10 h-10 rounded-full bg-zinc-100 dark:bg-zinc-800 flex items-center justify-center shrink-0">✉️</span>
            <a href="mailto:hello@example.com" class="font-medium hover:underline">hello@example.com</a>
          </li>
          <li class="flex items-center gap-3">
            <span class="w-10 h-10 rounded-full bg-zinc-100 dark:bg-zinc-800 flex items-center justify-center shrink-0">📞</span>
            <a href="tel:0400000000" class="font-medium hover:underline">0400 000 000</a>
          </li>
          <li class="flex items-center gap-3">
            <span class="w-10 h-10 rounded-full bg-zinc-100 dark:bg-zinc-800 flex items-center justify-center shrink-0">📍</span>
            <span class="font-medium text-neutral-600 dark:text-neutral-400">Sydney, Australia</span>
          </li>
        </ul>
      </div>

      <!-- Right: form -->
      <div class="bg-white dark:bg-zinc-950 border-2 border-zinc-200 dark:border-zinc-800 rounded-2xl p-8 md:p-10 shadow-xl">
        <form
          class="space-y-5"
          x-data="{ submitting: false, submitted: false }"
          @submit.prevent="submitting = true; setTimeout(() => { submitting = false; submitted = true }, 1000)"
        >
          {formFields.map((field) => (
            <div>
              <label for={`split-${field.name}`} class="block text-sm font-bold mb-2">
                {field.label}
                {field.required && <span class="text-red-500 ml-0.5">*</span>}
              </label>
              {field.type === "textarea" ? (
                <textarea
                  id={`split-${field.name}`}
                  name={field.name}
                  placeholder={field.placeholder}
                  rows={field.rows || 4}
                  required={field.required}
                  class="w-full px-4 py-3 rounded-md border-2 border-zinc-200 dark:border-zinc-700 bg-zinc-50 dark:bg-zinc-800 focus:outline-none focus:border-zinc-950 dark:focus:border-white transition-colors text-sm resize-none"
                />
              ) : (
                <input
                  id={`split-${field.name}`}
                  name={field.name}
                  type={field.type as "text" | "email" | "tel"}
                  placeholder={field.placeholder}
                  required={field.required}
                  class="w-full px-4 py-3 rounded-md border-2 border-zinc-200 dark:border-zinc-700 bg-zinc-50 dark:bg-zinc-800 focus:outline-none focus:border-zinc-950 dark:focus:border-white transition-colors text-sm"
                />
              )}
            </div>
          ))}

          <button
            type="submit"
            class="w-full h-14 bg-zinc-950 dark:bg-white text-white dark:text-black font-bold text-lg rounded-md hover:bg-zinc-800 dark:hover:bg-zinc-200 transition-colors mt-4 disabled:opacity-50 disabled:cursor-not-allowed"
            :disabled="submitting"
          >
            <span x-show="!submitting && !submitted">{submitText}</span>
            <span x-show="submitting">Sending...</span>
            <span x-show="submitted && !submitting">Sent! ✓</span>
          </button>

          {privacyNote && (
            <p class="text-xs text-center text-neutral-400 mt-4">{privacyNote}</p>
          )}
        </form>
      </div>
    </div>
  </div>
</section>
