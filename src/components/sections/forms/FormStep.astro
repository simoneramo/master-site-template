---
/**
 * FormStep — Step Form
 * Multi-step form with progress indicator and step navigation.
 */
import type { FormData } from '../../../data/sample-data';

interface Props { data: FormData; }

const { data } = Astro.props;
const { eyebrow, heading, description, submitText = 'Submit', privacyNote } = data || {};

const steps = [
  {
    title: 'Personal Info',
    fields: [
      { label: 'First Name', type: 'text', name: 'firstName', placeholder: 'John', required: true },
      { label: 'Last Name', type: 'text', name: 'lastName', placeholder: 'Smith', required: true },
      { label: 'Email', type: 'email', name: 'email', placeholder: 'john@example.com', required: true },
      { label: 'Phone', type: 'tel', name: 'phone', placeholder: '0400 000 000', required: false },
    ],
  },
  {
    title: 'Project Details',
    fields: [
      { label: 'Company', type: 'text', name: 'company', placeholder: 'Your company name', required: false },
      { label: 'Project Type', type: 'select', name: 'projectType', required: true, options: [
        { label: 'Select a project type', value: '' },
        { label: 'Website Design', value: 'website' },
        { label: 'Web Development', value: 'development' },
        { label: 'Branding', value: 'branding' },
        { label: 'SEO & Marketing', value: 'marketing' },
        { label: 'Other', value: 'other' },
      ]},
      { label: 'Budget Range', type: 'select', name: 'budget', required: true, options: [
        { label: 'Select your budget', value: '' },
        { label: '$2,500 - $5,000', value: '2.5k-5k' },
        { label: '$5,000 - $10,000', value: '5k-10k' },
        { label: '$10,000 - $25,000', value: '10k-25k' },
        { label: '$25,000+', value: '25k+' },
      ]},
    ],
  },
  {
    title: 'Additional Info',
    fields: [
      { label: 'Tell us about your project', type: 'textarea', name: 'message', placeholder: 'Describe your project, goals, timeline...', required: true, rows: 5 },
      { label: 'How did you hear about us?', type: 'select', name: 'referral', required: false, options: [
        { label: 'Select an option', value: '' },
        { label: 'Google Search', value: 'google' },
        { label: 'Social Media', value: 'social' },
        { label: 'Referral', value: 'referral' },
        { label: 'Other', value: 'other' },
      ]},
    ],
  },
];
---

<section class="py-20 md:py-32">
  <div class="container mx-auto px-4 md:px-8 max-w-3xl">
    <div class="text-center mb-12">
      {eyebrow && (
        <span class="inline-flex items-center text-xs font-bold uppercase tracking-widest px-4 py-1.5 rounded-full border border-zinc-300 dark:border-zinc-700 text-neutral-600 dark:text-neutral-400 mb-6">
          {eyebrow}
        </span>
      )}
      <h2 class="text-4xl md:text-5xl font-bold mb-4">{heading}</h2>
      {description && <p class="text-lg text-neutral-600 dark:text-neutral-400">{description}</p>}
    </div>

    <div 
      class="bg-white dark:bg-zinc-950 border-2 border-zinc-200 dark:border-zinc-800 rounded-2xl p-8 md:p-10 shadow-xl"
      x-data={`{ 
        currentStep: 1, 
        totalSteps: ${steps.length},
        submitting: false,
        submitted: false,
        nextStep() { if (this.currentStep < this.totalSteps) this.currentStep++ },
        prevStep() { if (this.currentStep > 1) this.currentStep-- },
      }`}
    >
      {/* Progress Pills */}
      <div class="mb-10">
        <div class="flex flex-wrap items-center justify-center gap-3">
          {steps.map((step, index) => (
            <button
              type="button"
              @click={`currentStep = ${index + 1}`}
              class="flex items-center gap-2 px-4 py-2 rounded-full border-2 text-sm font-medium transition-colors"
              :class={`currentStep === ${index + 1} 
                ? 'bg-black text-white border-black dark:bg-white dark:text-black dark:border-white' 
                : 'bg-zinc-200 text-black border-zinc-200 dark:bg-zinc-700 dark:text-white dark:border-zinc-700 hover:border-zinc-400 dark:hover:border-zinc-500'`}
            >
              <span 
                class="w-5 h-5 rounded-full flex items-center justify-center text-xs font-bold"
                :class={`currentStep === ${index + 1}
                  ? 'bg-white text-black dark:bg-black dark:text-white'
                  : 'bg-zinc-300 text-black dark:bg-zinc-600 dark:text-zinc-200'`}
              >
                {index + 1}
              </span>
              {step.title}
            </button>
          ))}
        </div>
      </div>

      {/* Form Steps */}
      <form 
        class="space-y-5" 
        @submit.prevent="submitting = true; setTimeout(() => { submitting = false; submitted = true }, 1500)"
      >
        {steps.map((step, stepIndex) => (
          <div x-show={`currentStep === ${stepIndex + 1}`} x-cloak class="space-y-5">
            <h3 class="text-lg font-bold mb-6 pb-4 border-b border-zinc-200 dark:border-zinc-800 flex items-center gap-3">
              <span class="w-8 h-8 rounded-full bg-zinc-950 dark:bg-white text-white dark:text-black flex items-center justify-center text-sm">{stepIndex + 1}</span>
              {step.title}
            </h3>
            
            <div class="space-y-5">
              {step.fields.map((field) => (
                <div>
                  <label for={`${field.name}-${stepIndex}`} class="block text-sm font-bold mb-2">
                    {field.label}
                    {field.required && <span class="text-red-500 ml-0.5">*</span>}
                  </label>
                  {field.type === 'textarea' ? (
                    <textarea 
                      id={`${field.name}-${stepIndex}`}
                      name={field.name}
                      placeholder={field.placeholder}
                      rows={field.rows || 4}
                      required={field.required}
                      class="w-full px-4 py-3 rounded-lg border-2 border-zinc-200 dark:border-zinc-700 bg-zinc-50 dark:bg-zinc-800 focus:outline-none focus:border-zinc-950 dark:focus:border-white transition-colors text-sm resize-none"
                    />
                  ) : field.type === 'select' ? (
                    <select
                      id={`${field.name}-${stepIndex}`}
                      name={field.name}
                      required={field.required}
                      class="w-full px-4 py-3 rounded-lg border-2 border-zinc-200 dark:border-zinc-700 bg-zinc-50 dark:bg-zinc-800 focus:outline-none focus:border-zinc-950 dark:focus:border-white transition-colors text-sm appearance-none cursor-pointer"
                    >
                      {field.options?.map((opt) => (
                        <option value={opt.value}>{opt.label}</option>
                      ))}
                    </select>
                  ) : (
                    <input 
                      id={`${field.name}-${stepIndex}`}
                      name={field.name}
                      type={field.type}
                      placeholder={field.placeholder}
                      required={field.required}
                      class="w-full px-4 py-3 rounded-lg border-2 border-zinc-200 dark:border-zinc-700 bg-zinc-50 dark:bg-zinc-800 focus:outline-none focus:border-zinc-950 dark:focus:border-white transition-colors text-sm"
                    />
                  )}
                </div>
              ))}
            </div>
          </div>
        ))}

        {/* Success Message */}
        <div x-show="submitted" x-cloak class="text-center py-12">
          <div class="w-16 h-16 bg-green-100 dark:bg-green-900/30 text-green-600 dark:text-green-400 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
          </div>
          <h3 class="text-2xl font-bold mb-2">Thank You!</h3>
          <p class="text-neutral-600 dark:text-neutral-400">We've received your message and will get back to you soon.</p>
        </div>

        {/* Navigation Buttons */}
        <div x-show="!submitted" class="flex items-center justify-between pt-6 border-t border-zinc-200 dark:border-zinc-800 mt-8">
          <button 
            type="button"
            @click="prevStep()"
            x-show="currentStep > 1"
            x-cloak
            class="px-6 py-3 border-2 border-zinc-200 dark:border-zinc-700 font-bold rounded-lg hover:border-zinc-400 dark:hover:border-zinc-500 transition-colors"
          >
            ← Back
          </button>
          
          <div x-show="currentStep === 1" class="w-24"></div>

          <button 
            type="button"
            @click="nextStep()"
            x-show="currentStep < totalSteps"
            class="px-8 py-3 bg-zinc-950 dark:bg-white text-white dark:text-black font-bold rounded-lg hover:bg-zinc-800 dark:hover:bg-zinc-200 transition-colors"
          >
            Next →
          </button>

          <button 
            type="submit"
            x-show="currentStep === totalSteps"
            class="px-8 py-3 bg-zinc-950 dark:bg-white text-white dark:text-black font-bold rounded-lg hover:bg-zinc-800 dark:hover:bg-zinc-200 transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
            :disabled="submitting"
          >
            <span x-show="!submitting">{submitText}</span>
            <span x-show="submitting" class="flex items-center gap-2">
              <svg class="animate-spin h-5 w-5" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>
              Submitting...
            </span>
          </button>
        </div>
        
        {privacyNote && (
          <p x-show="!submitted" class="text-xs text-center text-neutral-400 mt-4">{privacyNote}</p>
        )}
      </form>
    </div>
  </div>
</section>

<style>
  [x-cloak] { display: none !important; }
</style>
