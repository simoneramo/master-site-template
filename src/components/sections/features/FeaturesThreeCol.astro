---
/**
 * FeaturesThreeCol — 3-Column Grid
 * Three features per row with icon, heading, and description.
 */
import type { FeaturesData } from '../../../data/sample-data';

interface Props { data: FeaturesData; }

const { data } = Astro.props;
const { eyebrow, heading, description, features } = data;
---

<section class="py-20 md:py-32">
  <div class="container mx-auto px-4 md:px-8">
    <div class="text-center max-w-2xl mx-auto mb-16">
      {eyebrow && (
        <span class="inline-flex items-center text-xs font-bold uppercase tracking-widest px-4 py-1.5 rounded-full border border-zinc-300 dark:border-zinc-700 text-neutral-600 dark:text-neutral-400 mb-6">
          {eyebrow}
        </span>
      )}
      <h2 class="text-4xl md:text-5xl font-bold mb-4">{heading}</h2>
      {description && <p class="text-lg text-neutral-600 dark:text-neutral-400">{description}</p>}
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 lg:gap-12">
      {features.map((feature) => (
        <div class="group">
          {feature.icon && (
            <div class="w-14 h-14 rounded-2xl bg-surface dark:bg-zinc-900 border-2 border-zinc-200 dark:border-zinc-800 flex items-center justify-center text-3xl mb-5 group-hover:border-zinc-400 dark:group-hover:border-zinc-600 transition-colors">
              {feature.icon}
            </div>
          )}
          <h3 class="text-xl font-bold mb-3">{feature.heading}</h3>
          <p class="text-neutral-600 dark:text-neutral-400 leading-relaxed">
            {feature.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
