---
/**
 * FeaturesTabbed — Tabbed Features
 * Tab row at top, each tab shows mockup + feature list.
 */
import type { FeaturesData } from '../../../data/sample-data';

interface Props { data: FeaturesData; }

const { data } = Astro.props;
const { eyebrow, heading, description, features, tabs } = data;

// Use tabs if available, otherwise create single tab from features
const displayTabs = tabs || [{ label: 'Features', features, image: data.image }];
---

<section class="py-20 md:py-32">
  <div class="container mx-auto px-4 md:px-8">
    <div class="text-center max-w-2xl mx-auto mb-12">
      {eyebrow && (
        <span class="inline-flex items-center text-xs font-bold uppercase tracking-widest px-4 py-1.5 rounded-full border border-zinc-300 dark:border-zinc-700 text-neutral-600 dark:text-neutral-400 mb-6">
          {eyebrow}
        </span>
      )}
      <h2 class="text-4xl md:text-5xl font-bold mb-4">{heading}</h2>
      {description && <p class="text-lg text-neutral-600 dark:text-neutral-400">{description}</p>}
    </div>

    <!-- Alpine.js Tabs -->
    <div x-data="{ activeTab: 0 }">
      {/* Tab Navigation */}
      <div class="flex flex-wrap justify-center gap-2 mb-12">
        {displayTabs.map((tab, index) => (
          <button
            @click={`activeTab = ${index}`}
            class="px-6 py-3 rounded-full font-bold text-sm transition-all"
            :class={`activeTab === ${index} ? 'bg-zinc-950 text-white dark:bg-white dark:text-black' : 'bg-surface dark:bg-zinc-900 border-2 border-zinc-200 dark:border-zinc-800 hover:border-zinc-300 dark:hover:border-zinc-700'`}
          >
            {tab.label}
          </button>
        ))}
      </div>

      {/* Tab Content */}
      <div class="relative">
        {displayTabs.map((tab, index) => (
          <div
            x-show={`activeTab === ${index}`}
            x-transition:enter="transition ease-out duration-300"
            x-transition:enter-start="opacity-0 translate-y-4"
            x-transition:enter-end="opacity-100 translate-y-0"
            x-transition:leave="transition ease-in duration-200"
            x-transition:leave-start="opacity-100 translate-y-0"
            x-transition:leave-end="opacity-0 -translate-y-4"
            class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center"
            style={`display: ${index === 0 ? 'grid' : 'none'}`}
            x-cloak
          >
            {/* Features List */}
            <div class="order-2 lg:order-1">
              <div class="space-y-6">
                {tab.features.map((feature) => (
                  <div class="flex gap-4">
                    {feature.icon && (
                      <div class="w-12 h-12 rounded-xl bg-zinc-950 dark:bg-white text-white dark:text-black flex items-center justify-center text-xl shrink-0">
                        {feature.icon}
                      </div>
                    )}
                    <div>
                      <h3 class="text-lg font-bold mb-1">{feature.heading}</h3>
                      <p class="text-neutral-600 dark:text-neutral-400 text-sm leading-relaxed">
                        {feature.description}
                      </p>
                    </div>
                  </div>
                ))}
              </div>
            </div>

            {/* Image */}
            <div class="order-1 lg:order-2">
              {tab.image ? (
                <div class="rounded-2xl overflow-hidden bg-zinc-200 dark:bg-zinc-800">
                  <img 
                    src={tab.image.src} 
                    alt={tab.image.alt}
                    class="w-full h-auto"
                  />
                </div>
              ) : (
                <div class="aspect-square rounded-2xl bg-surface dark:bg-zinc-900 border-2 border-zinc-200 dark:border-zinc-800 flex items-center justify-center">
                  <span class="text-8xl">{tab.features[0]?.icon || '✨'}</span>
                </div>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
