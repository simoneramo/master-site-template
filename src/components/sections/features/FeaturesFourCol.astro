---
/**
 * FeaturesFourCol — 4-Column Icon Grid
 * Four features per row with centered icons on tinted backgrounds.
 */
import type { FeaturesData } from '../../../data/sample-data';

interface Props { data: FeaturesData; }

const { data } = Astro.props;
const { eyebrow, heading, description, features } = data;

// Background tints for icons
const bgColors = [
  'bg-blue-100 dark:bg-blue-900/30',
  'bg-green-100 dark:bg-green-900/30',
  'bg-purple-100 dark:bg-purple-900/30',
  'bg-amber-100 dark:bg-amber-900/30',
  'bg-rose-100 dark:bg-rose-900/30',
  'bg-cyan-100 dark:bg-cyan-900/30',
];
---

<section class="py-20 md:py-32 bg-surface dark:bg-zinc-900/50">
  <div class="container mx-auto px-4 md:px-8">
    <div class="text-center max-w-2xl mx-auto mb-16">
      {eyebrow && (
        <span class="inline-flex items-center text-xs font-bold uppercase tracking-widest px-4 py-1.5 rounded-full border border-zinc-300 dark:border-zinc-700 text-neutral-600 dark:text-neutral-400 mb-6">
          {eyebrow}
        </span>
      )}
      <h2 class="text-4xl md:text-5xl font-bold mb-4">{heading}</h2>
      {description && <p class="text-lg text-neutral-600 dark:text-neutral-400">{description}</p>}
    </div>

    <div class="grid grid-cols-2 lg:grid-cols-4 gap-6">
      {features.map((feature, index) => (
        <div class="text-center">
          {feature.icon && (
            <div class:list={["w-16 h-16 rounded-2xl flex items-center justify-center text-3xl mb-4 mx-auto", bgColors[index % bgColors.length]]}>
              {feature.icon}
            </div>
          )}
          <h3 class="text-lg font-bold mb-2">{feature.heading}</h3>
          <p class="text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">
            {feature.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
