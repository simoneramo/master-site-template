---
/**
 * FeaturesTwoColImage — 2-Column with Image
 * Large image left, stacked feature list right.
 */
import type { FeaturesData } from '../../../data/sample-data';

interface Props { data: FeaturesData; }

const { data } = Astro.props;
const { eyebrow, heading, description, features, image } = data;
---

<section class="py-20 md:py-32 bg-surface dark:bg-zinc-900/50">
  <div class="container mx-auto px-4 md:px-8">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      {/* Image */}
      <div>
        {image ? (
          <div class="rounded-2xl overflow-hidden bg-zinc-200 dark:bg-zinc-800">
            <img 
              src={image.src} 
              alt={image.alt}
              class="w-full h-auto"
            />
          </div>
        ) : (
          <div class="aspect-square rounded-2xl bg-zinc-200 dark:bg-zinc-800 flex items-center justify-center">
            <span class="text-8xl">✨</span>
          </div>
        )}
      </div>

      {/* Content */}
      <div>
        {eyebrow && (
          <span class="inline-flex items-center text-xs font-bold uppercase tracking-widest px-4 py-1.5 rounded-full border border-zinc-300 dark:border-zinc-700 text-neutral-600 dark:text-neutral-400 mb-6">
            {eyebrow}
          </span>
        )}
        <h2 class="text-4xl md:text-5xl font-bold mb-4">{heading}</h2>
        {description && <p class="text-lg text-neutral-600 dark:text-neutral-400 mb-10">{description}</p>}

        <div class="space-y-6">
          {features.map((feature) => (
            <div class="flex gap-4">
              {feature.icon && (
                <div class="w-12 h-12 rounded-xl bg-zinc-950 dark:bg-white text-white dark:text-black flex items-center justify-center text-xl shrink-0">
                  {feature.icon}
                </div>
              )}
              <div>
                <h3 class="text-lg font-bold mb-1">{feature.heading}</h3>
                <p class="text-neutral-600 dark:text-neutral-400 text-sm leading-relaxed">
                  {feature.description}
                </p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
