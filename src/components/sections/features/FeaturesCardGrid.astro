---
/**
 * FeaturesCardGrid — Bordered Icon Cards
 * Features rendered as fully-bordered cards with a large icon, heading,
 * and description. Left-aligned content, even 3-up grid.
 */
import type { FeaturesData } from '../../../data/sample-data';

interface Props { data: FeaturesData; }

const { data } = Astro.props;
const { eyebrow, heading, description, features = [] } = data;
---

<section class="py-20 md:py-32">
  <div class="container mx-auto px-4 md:px-8">
    <div class="max-w-2xl mb-12">
      {eyebrow && (
        <span class="inline-flex items-center text-xs font-bold uppercase tracking-widest px-4 py-1.5 rounded-full border border-zinc-300 dark:border-zinc-700 text-neutral-600 dark:text-neutral-400 mb-6">
          {eyebrow}
        </span>
      )}
      {heading && <h2 class="text-4xl md:text-5xl font-bold mb-4">{heading}</h2>}
      {description && (
        <p class="text-lg text-neutral-600 dark:text-neutral-400 font-medium">{description}</p>
      )}
    </div>

    {features.length > 0 && (
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8 relative z-10">
        {features.map((feature) => (
          <div class="bg-white dark:bg-black p-6 md:p-8 border-2 border-zinc-200 dark:border-zinc-800 rounded-xl flex flex-col items-start hover:border-zinc-400 dark:hover:border-zinc-600 transition-colors">
            {feature.icon && <div class="text-4xl mb-4">{feature.icon}</div>}
            <h3 class="text-xl md:text-2xl font-bold mb-2 dark:text-zinc-200">{feature.heading}</h3>
            <p class="text-lg text-neutral-600 dark:text-zinc-400 leading-relaxed font-medium grow">
              {feature.description}
            </p>
          </div>
        ))}
      </div>
    )}
  </div>
</section>
