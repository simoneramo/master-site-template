---
/**
 * CareersGrid — Openings Card Grid
 * Pattern key: grid
 * Section: Careers
 *
 * Bordered cards per opening with title, meta tags, short description,
 * and an apply link. Optional trailing CTA.
 */
import type { CareersData } from "../../../data/sample-data";

interface Props {
  data: CareersData;
  /** Section ID for anchor links */
  id?: string;
}

const { data, id } = Astro.props;
const { eyebrow, heading, description, jobs = [], cta } = data;
---

<section {id} class="py-20 md:py-32">
  <div class="container mx-auto px-4 md:px-8">
    {
      (eyebrow || heading || description) && (
        <div class="text-center max-w-2xl mx-auto mb-14">
          {eyebrow && (
            <span class="inline-flex items-center text-xs font-bold uppercase tracking-widest px-4 py-1.5 rounded-full border border-zinc-300 dark:border-zinc-700 text-neutral-600 dark:text-neutral-400 mb-6">
              {eyebrow}
            </span>
          )}
          {heading && <h2 class="text-4xl md:text-5xl font-bold mb-4">{heading}</h2>}
          {description && (
            <p class="text-lg text-neutral-600 dark:text-neutral-400">{description}</p>
          )}
        </div>
      )
    }

    {jobs.length > 0 && (
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {jobs.map((job) => (
          <div class="flex flex-col bg-white dark:bg-zinc-950 p-6 border-2 border-zinc-200 dark:border-zinc-800 rounded-xl hover:border-zinc-400 dark:hover:border-zinc-600 transition-colors">
            {job.department && (
              <span class="text-xs font-bold uppercase tracking-wider text-accent mb-3">{job.department}</span>
            )}
            <h3 class="text-lg font-bold leading-tight mb-2">{job.title}</h3>
            {job.description && (
              <p class="text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed mb-4 grow">{job.description}</p>
            )}
            <div class="flex flex-wrap items-center gap-2 mb-4">
              {job.location && (
                <span class="text-xs font-medium px-2.5 py-1 rounded-full border border-zinc-200 dark:border-zinc-700 text-neutral-500 dark:text-neutral-400">{job.location}</span>
              )}
              {job.type && (
                <span class="text-xs font-medium px-2.5 py-1 rounded-full border border-zinc-200 dark:border-zinc-700 text-neutral-500 dark:text-neutral-400">{job.type}</span>
              )}
            </div>
            {job.url && (
              <a href={job.url} class="font-bold text-sm border-b-2 border-black dark:border-white hover:border-transparent transition-colors self-start">
                Apply now &rarr;
              </a>
            )}
          </div>
        ))}
      </div>
    )}

    {cta?.text && cta?.url && (
      <div class="text-center mt-12">
        <a href={cta.url} class="inline-flex items-center justify-center h-12 px-8 font-bold text-white bg-black dark:bg-white dark:text-black rounded-lg hover:bg-zinc-800 dark:hover:bg-zinc-200 transition-colors">
          {cta.text}
        </a>
      </div>
    )}
  </div>
</section>
