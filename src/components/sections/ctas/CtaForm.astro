---
/**
 * CtaForm — Form CTA
 * Persuasive text and trust badges left, lead form right.
 */
import type { CtaData } from '../../../data/sample-data';

interface Props { data: CtaData; }

const { data } = Astro.props;
const { heading, description, trustBadges, formFields = [] } = data;

const fields = formFields.length > 0 ? formFields : [
  { label: 'Name', type: 'text', placeholder: 'Your name' },
  { label: 'Email', type: 'email', placeholder: 'you@example.com' },
  { label: 'Message', type: 'textarea', placeholder: 'Tell us about your project...' },
];
---

<section class="py-20 md:py-32 bg-zinc-50 dark:bg-zinc-900">
  <div class="container mx-auto px-4 md:px-8">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <div>
        <h2 class="text-4xl md:text-5xl font-bold leading-tight mb-6">{heading}</h2>
        <p class="text-lg text-neutral-600 dark:text-neutral-400 leading-relaxed mb-8">{description}</p>

        {trustBadges && trustBadges.length > 0 && (
          <div class="space-y-3">
            {trustBadges.map((badge) => (
              <div class="flex items-center gap-3 text-sm font-bold text-neutral-500 dark:text-neutral-400">
                <span class="w-8 h-8 rounded-lg bg-green-100 dark:bg-green-900/30 flex items-center justify-center text-green-600 dark:text-green-400">{badge.icon}</span>
                {badge.text}
              </div>
            ))}
          </div>
        )}
      </div>

      <div class="bg-white dark:bg-zinc-950 border-2 border-zinc-200 dark:border-zinc-800 rounded-2xl p-8 md:p-10 shadow-xl">
        <form class="space-y-4" x-data @submit.prevent>
          {fields.map((field) => (
            <div>
              <label class="block text-sm font-bold mb-1.5">{field.label}</label>
              {field.type === 'textarea' ? (
                <textarea placeholder={field.placeholder} rows="3" class="w-full px-4 py-3 rounded-lg border-2 border-zinc-200 dark:border-zinc-700 bg-zinc-50 dark:bg-zinc-800 focus:outline-none focus:border-indigo-500 dark:focus:border-indigo-400 transition-colors text-sm" />
              ) : (
                <input type={field.type as any} placeholder={field.placeholder} class="w-full px-4 py-3 rounded-lg border-2 border-zinc-200 dark:border-zinc-700 bg-zinc-50 dark:bg-zinc-800 focus:outline-none focus:border-indigo-500 dark:focus:border-indigo-400 transition-colors text-sm" />
              )}
            </div>
          ))}
          <button type="submit" class="w-full h-14 bg-black dark:bg-white text-white dark:text-black font-bold text-lg rounded-lg hover:bg-zinc-800 dark:hover:bg-zinc-200 transition-colors mt-2">
            Send Message →
          </button>
          <p class="text-xs text-center text-neutral-400 mt-2">🔒 Your data is safe. We never share your information.</p>
        </form>
      </div>
    </div>
  </div>
</section>
