---
/**
 * BenefitsNumbered — Numbered Benefits
 * Numbered list with large styled numbers in accent color.
 */
import type { BenefitsData } from '../../../data/sample-data';

interface Props { data: BenefitsData; }

const { data } = Astro.props;
const { eyebrow, heading, description, benefits } = data;
---

<section class="py-20 md:py-32 bg-surface dark:bg-zinc-900/50">
  <div class="container mx-auto px-4 md:px-8">
    <div class="text-center max-w-2xl mx-auto mb-16">
      {eyebrow && (
        <span class="inline-flex items-center text-xs font-bold uppercase tracking-widest px-4 py-1.5 rounded-full border border-zinc-300 dark:border-zinc-700 text-neutral-600 dark:text-neutral-400 mb-6">
          {eyebrow}
        </span>
      )}
      <h2 class="text-4xl md:text-5xl font-bold mb-4">{heading}</h2>
      {description && <p class="text-lg text-neutral-600 dark:text-neutral-400">{description}</p>}
    </div>

    <div class="max-w-3xl mx-auto space-y-8">
      {benefits.map((benefit, index) => (
        <div class="flex gap-6 md:gap-8">
          {/* Number */}
          <div class="shrink-0">
            <span class="text-5xl md:text-7xl font-bold text-accent/20">
              0{benefit.number || index + 1}
            </span>
          </div>
          
          {/* Content */}
          <div class="pt-2 md:pt-4">
            <h3 class="text-2xl md:text-3xl font-bold mb-3">{benefit.heading}</h3>
            <p class="text-lg text-neutral-600 dark:text-neutral-400 leading-relaxed">
              {benefit.description}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
