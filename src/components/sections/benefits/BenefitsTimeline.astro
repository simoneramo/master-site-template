---
/**
 * BenefitsTimeline — Benefits Timeline
 * Horizontal timeline with benefit stops alternating above/below.
 */
import type { BenefitsData } from '../../../data/sample-data';

interface Props { data: BenefitsData; }

const { data } = Astro.props;
const { eyebrow, heading, description, benefits } = data;
---

<section class="py-20 md:py-32 overflow-hidden">
  <div class="container mx-auto px-4 md:px-8">
    <div class="text-center max-w-2xl mx-auto mb-20">
      {eyebrow && (
        <span class="inline-flex items-center text-xs font-bold uppercase tracking-widest px-4 py-1.5 rounded-full border border-zinc-300 dark:border-zinc-700 text-neutral-600 dark:text-neutral-400 mb-6">
          {eyebrow}
        </span>
      )}
      <h2 class="text-4xl md:text-5xl font-bold mb-4">{heading}</h2>
      {description && <p class="text-lg text-neutral-600 dark:text-neutral-400">{description}</p>}
    </div>

    <div class="relative">
      {/* Timeline Line */}
      <div class="absolute top-1/2 left-0 right-0 h-1 bg-zinc-200 dark:bg-zinc-800 -translate-y-1/2 hidden md:block" />

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 md:gap-4">
        {benefits.map((benefit, index) => {
          const isAbove = index % 2 === 0;
          return (
            <div class="relative">
              {/* Desktop: Alternating Above/Below */}
              <div class:list={["hidden md:flex flex-col items-center text-center", isAbove ? "pb-12" : "pt-12"]}
                   style={isAbove ? "" : "margin-top: 2rem;"}>
                {isAbove ? (
                  <>
                    <div class="mb-4">
                      {benefit.icon && <div class="text-4xl mb-2">{benefit.icon}</div>}
                      <h3 class="text-lg font-bold">{benefit.heading}</h3>
                      <p class="text-sm text-neutral-600 dark:text-neutral-400 mt-1">{benefit.description}</p>
                    </div>
                    <div class="w-4 h-4 rounded-full bg-accent border-4 border-white dark:border-zinc-950 z-10" />
                    <div class="w-px h-6 bg-zinc-200 dark:bg-zinc-800" />
                  </>
                ) : (
                  <>
                    <div class="w-px h-6 bg-zinc-200 dark:bg-zinc-800" />
                    <div class="w-4 h-4 rounded-full bg-accent border-4 border-white dark:border-zinc-950 z-10" />
                    <div class="mt-4">
                      {benefit.icon && <div class="text-4xl mb-2">{benefit.icon}</div>}
                      <h3 class="text-lg font-bold">{benefit.heading}</h3>
                      <p class="text-sm text-neutral-600 dark:text-neutral-400 mt-1">{benefit.description}</p>
                    </div>
                  </>
                )}
              </div>

              {/* Mobile: Vertical Stack */}
              <div class="md:hidden flex gap-4">
                <div class="flex flex-col items-center">
                  <div class="w-10 h-10 rounded-full bg-accent text-white flex items-center justify-center font-bold text-sm shrink-0">
                    {benefit.number || index + 1}
                  </div>
                  {index !== benefits.length - 1 && (
                    <div class="w-px flex-1 bg-zinc-200 dark:bg-zinc-800 my-2" />
                  )}
                </div>
                <div class="pb-8">
                  {benefit.icon && <div class="text-3xl mb-2">{benefit.icon}</div>}
                  <h3 class="text-xl font-bold mb-2">{benefit.heading}</h3>
                  <p class="text-neutral-600 dark:text-neutral-400">{benefit.description}</p>
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </div>
</section>
