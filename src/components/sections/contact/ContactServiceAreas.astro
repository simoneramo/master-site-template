---
/**
 * ContactServiceAreas — Map + Service Areas
 * Pattern key: serviceAreas
 * Section: Contact
 *
 * Centered heading/description, an embedded map iframe, and an
 * expandable grid of service-area suburbs with a show-more toggle.
 */
import type { ContactData } from "../../../data/sample-data";

interface Props {
  data: ContactData;
}

const { data } = Astro.props;
---

<section class="py-20">
  <div class="container mx-auto px-6 max-w-5xl">
    <div class="text-center mb-12">
      {
        data.sectionLabel && (
          <p class="text-xs font-bold uppercase tracking-widest text-black dark:text-white mb-4">
            {data.sectionLabel}
          </p>
        )
      }
      {
        data.heading && (
          <h2 class="text-5xl font-bold mb-4">{data.heading}</h2>
        )
      }
      {
        data.description && (
          <p class="text-lg font-medium text-neutral-600 dark:text-white max-w-2xl mx-auto">
            {data.description}
          </p>
        )
      }
    </div>

    {
      data.mapSrc && (
        <div class="w-full h-[400px] md:h-[500px] rounded-xl overflow-hidden border-2 border-zinc-200 dark:border-zinc-700 mb-12">
          <iframe
            src={data.mapSrc}
            width="100%"
            height="100%"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            class="w-full h-full grayscale dark:invert-[.85] dark:hue-rotate-180"
          />
        </div>
      )
    }

    {
      data.suburbs && (
        <div x-data="{ visibleCount: 16, total: 0 }" x-init={`total = ${data.suburbs.length}`}>
          <ul class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-8 text-md font-bold text-neutral-600 dark:text-neutral-400">
            {data.suburbs.map((suburb, index) => (
              <li
                class={`text-center ${index >= 16 ? 'hidden' : ''}`}
                :class={`{ 'hidden': ${index} >= visibleCount }`}
              >{suburb}</li>
            ))}
          </ul>

          {data.suburbs.length > 16 && (
            <div class="mt-12 text-center">
              <button
                @click="visibleCount >= total ? visibleCount = 16 : visibleCount += 16"
                class="group relative inline-flex items-center justify-center overflow-hidden h-12 px-8 font-bold text-black bg-white border-2 border-black dark:bg-black dark:text-white dark:border-white transition-all duration-300 text-base rounded-md hover:bg-black hover:text-white dark:hover:bg-white dark:hover:text-black cursor-pointer"
              >
                <span class="mr-2" x-text="visibleCount >= total ? 'See less locations' : 'See more locations'">See more locations</span>
                <span x-text="visibleCount >= total ? '↑' : '↓'">↓</span>
              </button>
            </div>
          )}

          <div class="mt-16 text-center max-w-3xl mx-auto">
            <p class="text-lg font-medium text-neutral-600 dark:text-neutral-400">
              Don't see your area listed? No stress - I partner with small businesses everywhere! Let's jump on a quick video call to chat about getting your new website online.
            </p>
          </div>
        </div>
      )
    }
  </div>
</section>
