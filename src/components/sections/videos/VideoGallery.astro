---
/**
 * VideoGallery — Video Tabs / Gallery
 * Tab/thumbnail strip with multiple videos. Click to swap main player.
 */
import type { VideoData } from '../../../data/sample-data';

interface Props { data: VideoData; }

const { data } = Astro.props;
const { heading, description, videos } = data;

const videoList = videos || [];

const getEmbedUrl = (url: string) => {
  if (!url || url === '#') return '';
  const watchMatch = url.match(/youtube\.com\/watch\?v=([^&]+)/);
  if (watchMatch) return `https://www.youtube.com/embed/${watchMatch[1]}`;
  const shortMatch = url.match(/youtu\.be\/([^?]+)/);
  if (shortMatch) return `https://www.youtube.com/embed/${shortMatch[1]}`;
  return url;
};

// Extract YouTube thumbnail if custom image not provided
const getYoutubeThumbnail = (url: string) => {
  if (!url || url === '#') return '';
  const watchMatch = url.match(/youtube\.com\/watch\?v=([^&]+)/);
  if (watchMatch) return `https://img.youtube.com/vi/${watchMatch[1]}/maxresdefault.jpg`;
  const shortMatch = url.match(/youtu\.be\/([^?]+)/);
  if (shortMatch) return `https://img.youtube.com/vi/${shortMatch[1]}/maxresdefault.jpg`;
  return '';
};

const videosWithEmbedUrls = videoList.map((v, index) => {
  const ytThumb = getYoutubeThumbnail(v.videoUrl);
  return {
    ...v,
    index,
    embedUrl: getEmbedUrl(v.videoUrl),
    thumbSrc: v.thumbnailImage?.src || ytThumb || '',
    thumbAlt: v.thumbnailImage?.alt || v.title || 'Video thumbnail'
  };
});

const firstVideo = videosWithEmbedUrls[0];
const uniqueId = `video-gallery-${Math.random().toString(36).substr(2, 9)}`;
---

<section class="py-20 md:py-32 bg-zinc-950 text-white">
  <div class="container mx-auto px-4 md:px-8">
    <div class="text-center max-w-2xl mx-auto mb-12">
      <h2 class="text-4xl md:text-5xl font-bold mb-4">{heading}</h2>
      {description && <p class="text-lg text-white/70">{description}</p>}
    </div>

    {videosWithEmbedUrls.length > 0 ? (
      <video-gallery-player data-videos={JSON.stringify(videosWithEmbedUrls)} class="block">
        <!-- Main Video Player -->
        <div class="max-w-5xl mx-auto mb-8">
          <div class="relative aspect-video rounded-2xl overflow-hidden bg-zinc-900 main-player">
            {firstVideo ? (
              <iframe
                src={firstVideo.embedUrl}
                title={firstVideo.title}
                class="w-full h-full"
                frameborder="0"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
              />
            ) : (
              <div class="absolute inset-0 flex items-center justify-center text-white/50">
                <p>Select a video</p>
              </div>
            )}
          </div>
        </div>

        <!-- Video Thumbnails -->
        <div class="max-w-5xl mx-auto">
          <div class="flex gap-4 overflow-x-auto pb-4 scrollbar-hide" style="scrollbar-width: none;">
            {videosWithEmbedUrls.map((video) => (
              <button
                type="button"
                data-index={video.index}
                class={`video-thumb shrink-0 w-48 text-left group transition-opacity ${video.index === 0 ? 'opacity-100 active' : 'opacity-60 hover:opacity-80'}`}
                aria-label={`Play ${video.title}`}
              >
                <div class="relative aspect-video rounded-xl overflow-hidden mb-2 bg-zinc-800 thumb-wrapper">
                  <img 
                    src={video.thumbSrc} 
                    alt={video.thumbAlt}
                    class="w-full h-full object-cover"
                    loading="lazy"
                  />
                </div>
                <p class="font-bold text-sm truncate">{video.title}</p>
              </button>
            ))}
          </div>
        </div>
      </video-gallery-player>
    ) : (
      <div class="max-w-5xl mx-auto text-center text-white/50">
        <p>No videos available</p>
      </div>
    )}
  </div>
</section>

<style>
  .scrollbar-hide::-webkit-scrollbar { display: none; }
  .video-thumb.active .thumb-wrapper { box-shadow: 0 0 0 3px #6366f1; }
</style>

<script>
  class VideoGalleryPlayer extends HTMLElement {
    connectedCallback() {
      const mainPlayer = this.querySelector('.main-player');
      const thumbs = this.querySelectorAll('.video-thumb');
      const videosData = JSON.parse(this.dataset.videos || '[]');
      
      thumbs.forEach(thumb => {
        thumb.addEventListener('click', () => {
          const index = parseInt(thumb.getAttribute('data-index') || '0');
          const video = videosData[index];
          
          if (video && mainPlayer) {
            thumbs.forEach(t => {
              t.classList.remove('active', 'opacity-100');
              t.classList.add('opacity-60');
            });
            thumb.classList.add('active', 'opacity-100');
            thumb.classList.remove('opacity-60');
            
            mainPlayer.innerHTML = '<iframe src="' + video.embedUrl + '" title="' + video.title + '" class="w-full h-full" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>';
          }
        });
      });
    }
  }

  if (!customElements.get('video-gallery-player')) {
    customElements.define('video-gallery-player', VideoGalleryPlayer);
  }
</script>
