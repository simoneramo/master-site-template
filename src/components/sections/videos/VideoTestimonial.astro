---
/**
 * VideoTestimonial — Video Testimonial
 * Customer testimonial video with name, title, and star rating below.
 */
import type { VideoData } from '../../../data/sample-data';

interface Props { data: VideoData; }

const { data } = Astro.props;
const { eyebrow, heading, description, videoUrl, thumbnailImage, testimonial } = data;

const getEmbedUrl = (url: string, autoplay = false) => {
  if (!url || url === '#') return '';
  let embedUrl = url;
  const watchMatch = url.match(/youtube\.com\/watch\?v=([^&]+)/);
  if (watchMatch) embedUrl = `https://www.youtube.com/embed/${watchMatch[1]}`;
  const shortMatch = url.match(/youtu\.be\/([^?]+)/);
  if (shortMatch) embedUrl = `https://www.youtube.com/embed/${shortMatch[1]}`;
  if (autoplay && embedUrl.includes('youtube.com/embed')) {
    embedUrl = embedUrl.includes('?') ? `${embedUrl}&autoplay=1` : `${embedUrl}?autoplay=1`;
  }
  return embedUrl;
};

// Extract YouTube thumbnail if custom image not provided
const getYoutubeThumbnail = (url: string) => {
  if (!url || url === '#') return '';
  const watchMatch = url.match(/youtube\.com\/watch\?v=([^&]+)/);
  if (watchMatch) return `https://img.youtube.com/vi/${watchMatch[1]}/maxresdefault.jpg`;
  const shortMatch = url.match(/youtu\.be\/([^?]+)/);
  if (shortMatch) return `https://img.youtube.com/vi/${shortMatch[1]}/maxresdefault.jpg`;
  return '';
};

const embedUrl = getEmbedUrl(videoUrl || '');
const autoplayUrl = getEmbedUrl(videoUrl || '', true);
const ytThumbnail = getYoutubeThumbnail(videoUrl || '');
const hasThumbnail = !!((thumbnailImage && thumbnailImage.src) || ytThumbnail);
const thumbnailSrc = thumbnailImage?.src || ytThumbnail || '';
const thumbnailAlt = thumbnailImage?.alt || 'Video thumbnail';
const uniqueId = `video-test-${Math.random().toString(36).substr(2, 9)}`;
---

<section class="py-20 md:py-32 bg-surface dark:bg-zinc-900/50">
  <div class="container mx-auto px-4 md:px-8">
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-12">
        {eyebrow && (
          <span class="inline-flex items-center text-xs font-bold uppercase tracking-widest px-4 py-1.5 rounded-full border border-zinc-300 dark:border-zinc-700 text-neutral-600 dark:text-neutral-400 mb-6">
            {eyebrow}
          </span>
        )}
        <h2 class="text-4xl md:text-5xl font-bold mb-4">{heading}</h2>
        {description && <p class="text-lg text-neutral-600 dark:text-neutral-400">{description}</p>}
      </div>

      <video-player data-autoplay-url={autoplayUrl} class="block relative aspect-video rounded-2xl overflow-hidden bg-zinc-900 shadow-xl mb-8" id={uniqueId}>
        {hasThumbnail && (
          <div class="thumbnail-layer absolute inset-0 cursor-pointer z-10">
            <img 
              src={thumbnailSrc} 
              alt={thumbnailAlt}
              class="w-full h-full object-cover"
              loading="eager"
            />
            <div class="absolute inset-0 bg-black/40 flex items-center justify-center">
              <button 
                type="button"
                class="play-btn w-20 h-20 rounded-full bg-white/90 hover:bg-white flex items-center justify-center transition-all hover:scale-110"
                aria-label="Play video"
              >
                <svg class="w-8 h-8 text-zinc-950 ml-1" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M8 5v14l11-7z"/>
                </svg>
              </button>
            </div>
          </div>
        )}
        
        <div class="video-container w-full h-full">
          {!hasThumbnail && embedUrl && (
            <iframe
              src={embedUrl}
              class="w-full h-full"
              title={heading}
              frameborder="0"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
            />
          )}
        </div>
      </video-player>

      {testimonial && (
        <div class="flex flex-col items-center text-center">
          <div class="flex gap-1 mb-3">
            {Array(5).fill(0).map((_, i) => (
              <svg 
                class={`w-5 h-5 ${i < (testimonial.rating || 5) ? 'text-amber-400' : 'text-zinc-300 dark:text-zinc-700'}`}
                fill="currentColor" 
                viewBox="0 0 20 20"
              >
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
              </svg>
            ))}
          </div>
          <p class="text-xl font-bold">{testimonial.name}</p>
          <p class="text-neutral-600 dark:text-neutral-400">
            {testimonial.title}{testimonial.company && `, ${testimonial.company}`}
          </p>
        </div>
      )}
    </div>
  </div>
</section>

<script>
  class VideoPlayer extends HTMLElement {
    connectedCallback() {
      const autoplayUrl = this.dataset.autoplayUrl;
      const thumbnailLayer = this.querySelector('.thumbnail-layer') as HTMLElement;
      const playBtn = this.querySelector('.play-btn');
      const videoContainer = this.querySelector('.video-container');
      
      if (playBtn && thumbnailLayer && videoContainer && autoplayUrl) {
        playBtn.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          thumbnailLayer.style.display = 'none';
          videoContainer.innerHTML = '<iframe src="' + autoplayUrl + '" class="w-full h-full" title="Video" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>';
        });
      }
    }
  }

  if (!customElements.get('video-player')) {
    customElements.define('video-player', VideoPlayer);
  }
</script>
