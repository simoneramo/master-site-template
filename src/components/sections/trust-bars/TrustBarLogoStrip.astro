---
import type { TrustBarData } from '../../../data/sample-data';
interface Props { data: TrustBarData; }
const { data } = Astro.props;
const { logos = [] } = data;
---
<section class="py-12 border-y border-zinc-200 dark:border-zinc-800">
  <div class="container mx-auto px-4 md:px-8">
    <p class="text-center text-xs font-bold uppercase tracking-widest text-neutral-400 dark:text-neutral-500 mb-8">Trusted by leading brands</p>
    <div class="flex flex-wrap items-center justify-center gap-8 md:gap-12">
      {logos.map((logo) => (
        <img src={logo.src} alt={logo.alt} class="h-8 md:h-10 object-contain grayscale opacity-50 hover:grayscale-0 hover:opacity-100 transition-all duration-300" loading="lazy" />
      ))}
    </div>
  </div>
</section>
