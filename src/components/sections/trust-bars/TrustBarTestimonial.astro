---
import type { TrustBarData } from '../../../data/sample-data';
interface Props { data: TrustBarData; }
const { data } = Astro.props;
const { logos = [], testimonial } = data;
---
<section class="py-12 border-y border-zinc-200 dark:border-zinc-800">
  <div class="container mx-auto px-4 md:px-8">
    <div class="flex flex-col lg:flex-row items-center gap-8 lg:gap-16">
      <div class="flex flex-wrap items-center justify-center gap-8 flex-1">
        {logos.map((logo) => (
          <img src={logo.src} alt={logo.alt} class="h-8 object-contain grayscale opacity-50" loading="lazy" />
        ))}
      </div>
      {testimonial && (
        <div class="flex items-center gap-4 shrink-0 border-l-0 lg:border-l-2 border-zinc-200 dark:border-zinc-800 pl-0 lg:pl-8">
          {testimonial.photo && <img src={testimonial.photo} alt={testimonial.name} class="w-12 h-12 rounded-full object-cover" loading="lazy" />}
          <div>
            <p class="text-sm font-medium italic text-neutral-600 dark:text-neutral-400 max-w-xs">"{testimonial.quote}"</p>
            <p class="text-xs font-bold mt-1">{testimonial.name}</p>
          </div>
        </div>
      )}
    </div>
  </div>
</section>
