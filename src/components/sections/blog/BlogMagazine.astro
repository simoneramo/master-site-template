---
/**
 * BlogMagazine — Magazine Layout
 * Asymmetric magazine-style layout with varying card sizes.
 */
import type { BlogData } from '../../../data/sample-data';

interface Props { data: BlogData; }

const { data } = Astro.props;
const { eyebrow, heading, description, posts = [], cta } = data || {};

function formatDate(date: Date | string): string {
  const d = new Date(date);
  return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
}

const featured = posts[0];
const secondary = posts[1];
const gridPosts = posts.slice(2, 5);
---

<section class="py-20 md:py-32">
  <div class="container mx-auto px-4 md:px-8">
    <div class="text-center max-w-2xl mx-auto mb-16">
      {eyebrow && (
        <span class="inline-flex items-center text-xs font-bold uppercase tracking-widest px-4 py-1.5 rounded-full border border-zinc-300 dark:border-zinc-700 text-neutral-600 dark:text-neutral-400 mb-6">
          {eyebrow}
        </span>
      )}
      <h2 class="text-4xl md:text-5xl font-bold mb-4">{heading}</h2>
      {description && <p class="text-lg text-neutral-600 dark:text-neutral-400">{description}</p>}
    </div>

    {posts && posts.length > 0 && (
      <div class="grid lg:grid-cols-12 gap-6">
        {/* Featured Post - Large */}
        {featured && (
          <article class="lg:col-span-7 group">
            <a href={`/insights/${featured.slug}`} class="block h-full">
              <div class="relative h-full min-h-[400px] rounded-2xl overflow-hidden">
                {featured.heroImage ? (
                  <img 
                    src={featured.heroImage} 
                    alt={featured.title}
                    class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                  />
                ) : (
                  <div class="absolute inset-0 bg-zinc-300 dark:bg-zinc-700 flex items-center justify-center">
                    <span class="text-6xl">📝</span>
                  </div>
                )}
                <div class="absolute inset-0 bg-linear-to-t from-black/80 via-black/30 to-transparent" />
                <div class="absolute bottom-0 left-0 right-0 p-8">
                  {featured.tags && featured.tags.length > 0 && (
                    <div class="flex flex-wrap gap-2 mb-3">
                      {featured.tags.slice(0, 2).map((tag) => (
                        <span class="text-xs font-bold uppercase tracking-wider px-3 py-1 bg-white/20 backdrop-blur-sm text-white rounded-full">
                          {tag}
                        </span>
                      ))}
                    </div>
                  )}
                  <h3 class="text-2xl md:text-3xl font-bold text-white mb-2">
                    {featured.title}
                  </h3>
                  <p class="text-white/80 text-sm md:text-base line-clamp-2 mb-3">
                    {featured.description}
                  </p>
                  <div class="flex items-center gap-3 text-xs text-white/70">
                    <time datetime={String(featured.pubDate)}>{formatDate(featured.pubDate)}</time>
                    {featured.readTime && <span>· {featured.readTime}</span>}
                  </div>
                </div>
              </div>
            </a>
          </article>
        )}

        {/* Secondary Post + Grid */}
        <div class="lg:col-span-5 flex flex-col gap-6">
          {/* Secondary Post */}
          {secondary && (
            <article class="group flex-grow">
              <a href={`/insights/${secondary.slug}`} class="block h-full">
                <div class="relative h-full min-h-[200px] rounded-2xl overflow-hidden">
                  {secondary.heroImage ? (
                    <img 
                      src={secondary.heroImage} 
                      alt={secondary.title}
                      class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                    />
                  ) : (
                    <div class="absolute inset-0 bg-zinc-300 dark:bg-zinc-700 flex items-center justify-center">
                      <span class="text-4xl">📝</span>
                    </div>
                  )}
                  <div class="absolute inset-0 bg-linear-to-t from-black/80 via-black/30 to-transparent" />
                  <div class="absolute bottom-0 left-0 right-0 p-6">
                    {secondary.tags && secondary.tags.length > 0 && (
                      <span class="text-xs font-bold uppercase tracking-wider px-2.5 py-1 bg-white/20 backdrop-blur-sm text-white rounded-full">
                        {secondary.tags[0]}
                      </span>
                    )}
                    <h3 class="text-xl font-bold text-white mt-2">
                      {secondary.title}
                    </h3>
                  </div>
                </div>
              </a>
            </article>
          )}

          {/* Small Grid Posts */}
          {gridPosts.length > 0 && (
            <div class="grid grid-cols-2 gap-4">
              {gridPosts.map((post) => (
                <article class="group">
                  <a href={`/insights/${post.slug}`} class="block">
                    <div class="relative aspect-[4/3] rounded-xl overflow-hidden mb-3">
                      {post.heroImage ? (
                        <img 
                          src={post.heroImage} 
                          alt={post.title}
                          class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                        />
                      ) : (
                        <div class="absolute inset-0 bg-zinc-200 dark:bg-zinc-800 flex items-center justify-center">
                          <span class="text-2xl">📝</span>
                        </div>
                      )}
                    </div>
                    <h4 class="font-bold text-sm line-clamp-2 group-hover:text-neutral-600 dark:group-hover:text-neutral-300 transition-colors">
                      {post.title}
                    </h4>
                    <time class="text-xs text-neutral-500 dark:text-neutral-400" datetime={String(post.pubDate)}>
                      {formatDate(post.pubDate)}
                    </time>
                  </a>
                </article>
              ))}
            </div>
          )}
        </div>
      </div>
    )}

    {cta && (
      <div class="text-center mt-12">
        <a 
          href={cta.url}
          class="inline-flex items-center gap-2 px-6 py-3 bg-zinc-950 dark:bg-white text-white dark:text-black font-bold rounded-full hover:bg-zinc-800 dark:hover:bg-zinc-200 transition-colors"
        >
          {cta.text}
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
      </div>
    )}
  </div>
</section>
