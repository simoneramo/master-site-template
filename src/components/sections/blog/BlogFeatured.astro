---
/**
 * BlogFeatured — Featured Post
 * Large featured post at top, remaining posts in 3-column grid below.
 */
import type { BlogData } from '../../../data/sample-data';

interface Props { data: BlogData; }

const { data } = Astro.props;
const { eyebrow, heading, description, posts = [], cta } = data || {};

function formatDate(date: Date | string): string {
  const d = new Date(date);
  return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
}

const featuredPost = posts[0];
const otherPosts = posts.slice(1);
---

<section class="py-20 md:py-32">
  <div class="container mx-auto px-4 md:px-8">
    <div class="text-center max-w-2xl mx-auto mb-16">
      {eyebrow && (
        <span class="inline-flex items-center text-xs font-bold uppercase tracking-widest px-4 py-1.5 rounded-full border border-zinc-300 dark:border-zinc-700 text-neutral-600 dark:text-neutral-400 mb-6">
          {eyebrow}
        </span>
      )}
      <h2 class="text-4xl md:text-5xl font-bold mb-4">{heading}</h2>
      {description && <p class="text-lg text-neutral-600 dark:text-neutral-400">{description}</p>}
    </div>

    {/* Featured Post */}
    {featuredPost && (
      <article class="mb-16">
        <a href={`/insights/${featuredPost.slug}`} class="group block">
          <div class="grid lg:grid-cols-2 gap-8 lg:gap-12 items-center bg-zinc-50 dark:bg-zinc-900/50 rounded-2xl overflow-hidden">
            <div class="overflow-hidden">
              {featuredPost.heroImage ? (
                <img 
                  src={featuredPost.heroImage} 
                  alt={featuredPost.title}
                  class="w-full aspect-[16/10] lg:aspect-[4/3] object-cover transition-transform duration-700 group-hover:scale-105"
                />
              ) : (
                <div class="w-full aspect-[16/10] lg:aspect-[4/3] bg-zinc-200 dark:bg-zinc-800 flex items-center justify-center">
                  <span class="text-6xl">📝</span>
                </div>
              )}
            </div>
            <div class="p-8 lg:pr-12">
              {featuredPost.tags && featuredPost.tags.length > 0 && (
                <div class="flex flex-wrap gap-2 mb-4">
                  {featuredPost.tags.map((tag) => (
                    <span class="text-xs font-bold uppercase tracking-wider px-3 py-1.5 bg-zinc-200 dark:bg-zinc-800 text-neutral-700 dark:text-neutral-300 rounded-full">
                      {tag}
                    </span>
                  ))}
                </div>
              )}
              <h3 class="text-2xl md:text-3xl font-bold mb-4 group-hover:text-neutral-600 dark:group-hover:text-neutral-300 transition-colors">
                {featuredPost.title}
              </h3>
              <p class="text-neutral-600 dark:text-neutral-400 text-lg leading-relaxed mb-6">
                {featuredPost.description}
              </p>
              <div class="flex items-center gap-3 text-sm text-neutral-500 dark:text-neutral-400">
                {featuredPost.author?.photo ? (
                  <img src={featuredPost.author.photo} alt={featuredPost.author.name} class="w-8 h-8 rounded-full object-cover" />
                ) : (
                  <div class="w-8 h-8 rounded-full bg-zinc-200 dark:bg-zinc-700 flex items-center justify-center text-sm font-bold">
                    {featuredPost.author?.name?.charAt(0) || 'A'}
                  </div>
                )}
                <span class="font-medium">{featuredPost.author?.name || 'Anonymous'}</span>
                <span>·</span>
                <time datetime={String(featuredPost.pubDate)}>{formatDate(featuredPost.pubDate)}</time>
                {featuredPost.readTime && (
                  <><span>·</span><span>{featuredPost.readTime}</span></>
                )}
              </div>
            </div>
          </div>
        </a>
      </article>
    )}

    {/* Other Posts */}
    {otherPosts.length > 0 && (
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {otherPosts.map((post) => (
          <article class="group flex flex-col">
            <a href={`/insights/${post.slug}`} class="block mb-4 overflow-hidden rounded-xl">
              {post.heroImage ? (
                <img 
                  src={post.heroImage} 
                  alt={post.title}
                  class="w-full aspect-[16/10] object-cover transition-transform duration-500 group-hover:scale-105"
                />
              ) : (
                <div class="w-full aspect-[16/10] bg-zinc-200 dark:bg-zinc-800 rounded-xl flex items-center justify-center">
                  <span class="text-3xl">📝</span>
                </div>
              )}
            </a>
            
            <div class="flex flex-col flex-grow">
              {post.tags && post.tags.length > 0 && (
                <div class="flex flex-wrap gap-2 mb-2">
                  {post.tags.slice(0, 2).map((tag) => (
                    <span class="text-xs font-bold uppercase tracking-wider px-2 py-0.5 bg-zinc-100 dark:bg-zinc-800 text-neutral-600 dark:text-neutral-400 rounded-full">
                      {tag}
                    </span>
                  ))}
                </div>
              )}
              
              <h3 class="text-lg font-bold mb-2 group-hover:text-neutral-600 dark:group-hover:text-neutral-300 transition-colors">
                <a href={`/insights/${post.slug}`}>{post.title}</a>
              </h3>
              
              <p class="text-neutral-600 dark:text-neutral-400 text-sm leading-relaxed mb-3 flex-grow">
                {post.description}
              </p>
              
              <div class="flex items-center gap-2 text-xs text-neutral-500 dark:text-neutral-400">
                <time datetime={String(post.pubDate)}>{formatDate(post.pubDate)}</time>
                {post.readTime && <span>· {post.readTime}</span>}
              </div>
            </div>
          </article>
        ))}
      </div>
    )}

    {cta && (
      <div class="text-center mt-12">
        <a 
          href={cta.url}
          class="inline-flex items-center gap-2 px-6 py-3 bg-zinc-950 dark:bg-white text-white dark:text-black font-bold rounded-full hover:bg-zinc-800 dark:hover:bg-zinc-200 transition-colors"
        >
          {cta.text}
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
      </div>
    )}
  </div>
</section>
