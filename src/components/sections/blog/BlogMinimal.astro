---
/**
 * BlogMinimal — Minimal Cards
 * Clean minimal cards with title, excerpt, and date only.
 */
import type { BlogData } from '../../../data/sample-data';

interface Props { data: BlogData; }

const { data } = Astro.props;
const { eyebrow, heading, description, posts = [], cta } = data || {};

function formatDate(date: Date | string): string {
  const d = new Date(date);
  return d.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
}
---

<section class="py-20 md:py-32">
  <div class="container mx-auto px-4 md:px-8 max-w-5xl">
    <div class="text-center max-w-2xl mx-auto mb-16">
      {eyebrow && (
        <span class="inline-flex items-center text-xs font-bold uppercase tracking-widest px-4 py-1.5 rounded-full border border-zinc-300 dark:border-zinc-700 text-neutral-600 dark:text-neutral-400 mb-6">
          {eyebrow}
        </span>
      )}
      <h2 class="text-4xl md:text-5xl font-bold mb-4">{heading}</h2>
      {description && <p class="text-lg text-neutral-600 dark:text-neutral-400">{description}</p>}
    </div>

    {posts && posts.length > 0 && (
      <div class="space-y-0 divide-y divide-zinc-200 dark:divide-zinc-800">
        {posts.map((post) => (
          <article class="group py-8 first:pt-0">
            <a href={`/insights/${post.slug}`} class="block">
              <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
                <div class="flex-grow">
                  <h3 class="text-xl md:text-2xl font-bold mb-2 group-hover:text-neutral-600 dark:group-hover:text-neutral-300 transition-colors">
                    {post.title}
                  </h3>
                  <p class="text-neutral-600 dark:text-neutral-400 leading-relaxed max-w-2xl">
                    {post.description}
                  </p>
                </div>
                <div class="flex items-center gap-4 text-sm text-neutral-500 dark:text-neutral-400 shrink-0">
                  <time datetime={String(post.pubDate)}>{formatDate(post.pubDate)}</time>
                  <svg class="w-4 h-4 opacity-0 group-hover:opacity-100 transition-opacity transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                  </svg>
                </div>
              </div>
            </a>
          </article>
        ))}
      </div>
    )}

    {cta && (
      <div class="text-center mt-12 pt-8 border-t border-zinc-200 dark:border-zinc-800">
        <a 
          href={cta.url}
          class="inline-flex items-center gap-2 font-bold hover:gap-3 transition-all"
        >
          {cta.text}
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
      </div>
    )}
  </div>
</section>
