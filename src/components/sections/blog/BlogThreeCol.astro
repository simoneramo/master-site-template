---
/**
 * BlogThreeCol — 3-Column Grid
 * Three-column grid of blog post cards with images, titles, excerpts, and metadata.
 */
import type { BlogData } from '../../../data/sample-data';

interface Props { data: BlogData; }

const { data } = Astro.props;
const { eyebrow, heading, description, posts = [], cta } = data || {};

function formatDate(date: Date | string): string {
  const d = new Date(date);
  return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
}
---

<section class="py-20 md:py-32">
  <div class="container mx-auto px-4 md:px-8">
    <div class="text-center max-w-2xl mx-auto mb-16">
      {eyebrow && (
        <span class="inline-flex items-center text-xs font-bold uppercase tracking-widest px-4 py-1.5 rounded-full border border-zinc-300 dark:border-zinc-700 text-neutral-600 dark:text-neutral-400 mb-6">
          {eyebrow}
        </span>
      )}
      <h2 class="text-4xl md:text-5xl font-bold mb-4">{heading}</h2>
      {description && <p class="text-lg text-neutral-600 dark:text-neutral-400">{description}</p>}
    </div>

    {posts && posts.length > 0 && (
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {posts.map((post) => (
          <article class="group flex flex-col">
            <a href={`/insights/${post.slug}`} class="block mb-5 overflow-hidden rounded-xl">
              {post.heroImage ? (
                <img 
                  src={post.heroImage} 
                  alt={post.title}
                  class="w-full aspect-[16/10] object-cover transition-transform duration-500 group-hover:scale-105"
                />
              ) : (
                <div class="w-full aspect-[16/10] bg-zinc-200 dark:bg-zinc-800 rounded-xl flex items-center justify-center">
                  <span class="text-4xl">📝</span>
                </div>
              )}
            </a>
            
            <div class="flex flex-col flex-grow">
              {post.tags && post.tags.length > 0 && (
                <div class="flex flex-wrap gap-2 mb-3">
                  {post.tags.slice(0, 2).map((tag) => (
                    <span class="text-xs font-bold uppercase tracking-wider px-2.5 py-1 bg-zinc-100 dark:bg-zinc-800 text-neutral-600 dark:text-neutral-400 rounded-full">
                      {tag}
                    </span>
                  ))}
                </div>
              )}
              
              <h3 class="text-xl font-bold mb-2 group-hover:text-neutral-600 dark:group-hover:text-neutral-300 transition-colors">
                <a href={`/insights/${post.slug}`}>{post.title}</a>
              </h3>
              
              <p class="text-neutral-600 dark:text-neutral-400 text-sm leading-relaxed mb-4 flex-grow">
                {post.description}
              </p>
              
              <div class="flex items-center justify-between text-xs text-neutral-500 dark:text-neutral-400 pt-4 border-t border-zinc-200 dark:border-zinc-800">
                <div class="flex items-center gap-2">
                  {post.author?.photo ? (
                    <img src={post.author.photo} alt={post.author.name} class="w-6 h-6 rounded-full object-cover" />
                  ) : (
                    <div class="w-6 h-6 rounded-full bg-zinc-200 dark:bg-zinc-700 flex items-center justify-center text-xs">
                      {post.author?.name?.charAt(0) || 'A'}
                    </div>
                  )}
                  <span class="font-medium">{post.author?.name || 'Anonymous'}</span>
                </div>
                <div class="flex items-center gap-3">
                  <time datetime={String(post.pubDate)}>{formatDate(post.pubDate)}</time>
                  {post.readTime && <span>· {post.readTime}</span>}
                </div>
              </div>
            </div>
          </article>
        ))}
      </div>
    )}

    {cta && (
      <div class="text-center mt-12">
        <a 
          href={cta.url}
          class="inline-flex items-center gap-2 px-6 py-3 bg-zinc-950 dark:bg-white text-white dark:text-black font-bold rounded-full hover:bg-zinc-800 dark:hover:bg-zinc-200 transition-colors"
        >
          {cta.text}
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
      </div>
    )}
  </div>
</section>
