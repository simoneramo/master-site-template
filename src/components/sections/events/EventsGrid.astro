---
/**
 * EventsGrid — Event Cards
 * Pattern key: grid
 * Section: Events
 *
 * Image-topped cards with a date badge, category, title, meta, and a
 * register link. Optional trailing CTA.
 */
import type { EventsData } from "../../../data/sample-data";

interface Props {
  data: EventsData;
  /** Section ID for anchor links */
  id?: string;
}

const { data, id } = Astro.props;
const { eyebrow, heading, description, events = [], cta } = data;
---

<section {id} class="py-20 md:py-32">
  <div class="container mx-auto px-4 md:px-8">
    {
      (eyebrow || heading || description) && (
        <div class="text-center max-w-2xl mx-auto mb-14">
          {eyebrow && (
            <span class="inline-flex items-center text-xs font-bold uppercase tracking-widest px-4 py-1.5 rounded-full border border-zinc-300 dark:border-zinc-700 text-neutral-600 dark:text-neutral-400 mb-6">
              {eyebrow}
            </span>
          )}
          {heading && <h2 class="text-4xl md:text-5xl font-bold mb-4">{heading}</h2>}
          {description && (
            <p class="text-lg text-neutral-600 dark:text-neutral-400">{description}</p>
          )}
        </div>
      )
    }

    {events.length > 0 && (
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {events.map((event) => (
          <div class="group flex flex-col bg-white dark:bg-zinc-950 border-2 border-zinc-200 dark:border-zinc-800 rounded-2xl overflow-hidden hover:border-zinc-400 dark:hover:border-zinc-600 transition-colors">
            <!-- Image + date badge -->
            <div class="relative aspect-video bg-zinc-100 dark:bg-zinc-900 overflow-hidden">
              {event.image?.src && (
                <img src={event.image.src} alt={event.image.alt || event.title} class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy" />
              )}
              <div class="absolute top-3 left-3 px-3 py-1.5 rounded-lg bg-white/95 dark:bg-zinc-950/95 text-xs font-bold shadow-sm">
                {event.date}
              </div>
            </div>

            <!-- Body -->
            <div class="flex flex-col flex-1 p-6">
              <div class="flex flex-wrap items-center gap-2 mb-2">
                {event.category && (
                  <span class="text-xs font-bold uppercase tracking-wider text-accent">{event.category}</span>
                )}
                {event.time && (
                  <span class="text-xs font-medium text-neutral-500 dark:text-neutral-400">· {event.time}</span>
                )}
              </div>
              <h3 class="text-lg font-bold leading-tight mb-1">{event.title}</h3>
              {(event.location || event.speaker) && (
                <p class="text-sm text-neutral-500 dark:text-neutral-400 mb-3">
                  {[event.speaker && `with ${event.speaker}`, event.location].filter(Boolean).join(' · ')}
                </p>
              )}
              {event.description && (
                <p class="text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed grow">{event.description}</p>
              )}
              {event.url && (
                <a href={event.url} class="inline-block mt-4 font-bold text-sm border-b-2 border-black dark:border-white hover:border-transparent transition-colors self-start">
                  Register &rarr;
                </a>
              )}
            </div>
          </div>
        ))}
      </div>
    )}

    {cta?.text && cta?.url && (
      <div class="text-center mt-12">
        <a href={cta.url} class="inline-flex items-center justify-center h-12 px-8 font-bold text-white bg-black dark:bg-white dark:text-black rounded-lg hover:bg-zinc-800 dark:hover:bg-zinc-200 transition-colors">
          {cta.text}
        </a>
      </div>
    )}
  </div>
</section>
