---
/**
 * EventsList — Agenda / Schedule List
 * Pattern key: list
 * Section: Events
 *
 * Agenda-style rows with a prominent date block on the left and event
 * details (title, meta, description, register link) on the right.
 */
import type { EventsData } from "../../../data/sample-data";

interface Props {
  data: EventsData;
  /** Section ID for anchor links */
  id?: string;
}

const { data, id } = Astro.props;
const { eyebrow, heading, description, events = [], cta } = data;
---

<section {id} class="py-20 md:py-32">
  <div class="container mx-auto px-4 md:px-8 max-w-4xl">
    {
      (eyebrow || heading || description) && (
        <div class="max-w-2xl mb-12">
          {eyebrow && (
            <span class="inline-flex items-center text-xs font-bold uppercase tracking-widest px-4 py-1.5 rounded-full border border-zinc-300 dark:border-zinc-700 text-neutral-600 dark:text-neutral-400 mb-6">
              {eyebrow}
            </span>
          )}
          {heading && <h2 class="text-4xl md:text-5xl font-bold mb-4">{heading}</h2>}
          {description && (
            <p class="text-lg text-neutral-600 dark:text-neutral-400">{description}</p>
          )}
        </div>
      )
    }

    {events.length > 0 && (
      <div class="space-y-4">
        {events.map((event) => (
          <div class="group flex flex-col sm:flex-row gap-5 sm:gap-8 p-6 rounded-2xl border-2 border-zinc-200 dark:border-zinc-800 hover:border-zinc-400 dark:hover:border-zinc-600 transition-colors">
            <!-- Date block -->
            <div class="shrink-0 flex sm:flex-col items-center sm:justify-center gap-2 sm:gap-0 sm:w-28 sm:text-center sm:border-r sm:border-zinc-200 sm:dark:border-zinc-800 sm:pr-8">
              <div class="text-lg font-bold leading-tight">{event.date}</div>
              {event.time && <div class="text-sm text-neutral-500 dark:text-neutral-400">{event.time}</div>}
            </div>

            <!-- Details -->
            <div class="flex-1 min-w-0">
              <div class="flex flex-wrap items-center gap-2 mb-2">
                {event.category && (
                  <span class="text-xs font-bold uppercase tracking-wider text-accent">{event.category}</span>
                )}
                {event.location && (
                  <span class="text-xs font-medium text-neutral-500 dark:text-neutral-400">· {event.location}</span>
                )}
              </div>
              <h3 class="text-xl font-bold leading-tight mb-1">{event.title}</h3>
              {event.speaker && (
                <p class="text-sm text-neutral-500 dark:text-neutral-400 mb-2">with {event.speaker}</p>
              )}
              {event.description && (
                <p class="text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">{event.description}</p>
              )}
              {event.url && (
                <a href={event.url} class="inline-block mt-4 font-bold text-sm border-b-2 border-black dark:border-white hover:border-transparent transition-colors">
                  Register &rarr;
                </a>
              )}
            </div>
          </div>
        ))}
      </div>
    )}

    {cta?.text && cta?.url && (
      <div class="mt-10">
        <a href={cta.url} class="font-bold border-b-2 border-black dark:border-white hover:border-transparent transition-colors text-black dark:text-white">
          {cta.text} &rarr;
        </a>
      </div>
    )}
  </div>
</section>
