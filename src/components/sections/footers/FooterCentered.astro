---
/**
 * FooterCentered — Centered Simple Footer
 * Pattern key: centered
 * Section: Footer
 *
 * Everything centered: logo, nav links, socials, copyright.
 */
import type { FooterData } from '../../../data/sample-data';

interface Props {
  data: FooterData;
}

const { data } = Astro.props;
const { logo, tagline, columns, socials, copyright, legalLinks } = data;

const allLinks = columns.flatMap(c => c.links).slice(0, 8);
---

<footer class="bg-zinc-950 text-white py-16">
  <div class="container mx-auto px-4 md:px-8 text-center">

    <!-- Logo -->
    <a href="/" class="text-2xl font-bold inline-block mb-4">{logo}</a>

    {tagline && (
      <p class="text-sm text-neutral-400 max-w-md mx-auto mb-8">{tagline}</p>
    )}

    <!-- Nav Links -->
    <nav class="flex flex-wrap items-center justify-center gap-x-8 gap-y-3 mb-10">
      {allLinks.map((link) => (
        <a href={link.url} class="text-sm text-neutral-400 hover:text-white transition-colors font-medium">
          {link.label}
        </a>
      ))}
    </nav>

    <!-- Socials -->
    <div class="flex items-center justify-center gap-3 mb-10">
      {socials.map((social) => (
        <a
          href={social.url}
          class="w-10 h-10 rounded-full bg-zinc-800 flex items-center justify-center text-neutral-400 hover:bg-indigo-600 hover:text-white transition-all"
          aria-label={social.platform}
        >
          {social.icon}
        </a>
      ))}
    </div>

    <!-- Divider -->
    <div class="h-px bg-zinc-800 max-w-sm mx-auto mb-8" />

    <!-- Copyright + Legal -->
    <div class="space-y-3">
      <div class="flex flex-wrap items-center justify-center gap-4">
        {legalLinks.map((link) => (
          <a href={link.url} class="text-xs text-neutral-500 hover:text-white transition-colors">
            {link.label}
          </a>
        ))}
      </div>
      <p class="text-xs text-neutral-600">{copyright}</p>
    </div>
  </div>
</footer>
