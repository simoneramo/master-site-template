---
/**
 * FooterMinimal — Minimal Footer
 * Pattern key: minimal
 * Section: Footer
 *
 * Single row: logo left, links center, socials right. Copyright below.
 */
import type { FooterData } from '../../../data/sample-data';

interface Props {
  data: FooterData;
}

const { data } = Astro.props;
const { logo, columns, socials, copyright, legalLinks } = data;

// Flatten all links for a single row
const allLinks = columns.flatMap(c => c.links).slice(0, 6);
---

<footer class="bg-zinc-950 text-white py-12">
  <div class="container mx-auto px-4 md:px-8">

    <!-- Main Row -->
    <div class="flex flex-col md:flex-row items-center justify-between gap-8 mb-8">
      <!-- Logo -->
      <a href="/" class="text-xl font-bold shrink-0">{logo}</a>

      <!-- Links -->
      <nav class="flex flex-wrap items-center justify-center gap-6">
        {allLinks.map((link) => (
          <a href={link.url} class="text-sm text-neutral-400 hover:text-white transition-colors font-medium">
            {link.label}
          </a>
        ))}
      </nav>

      <!-- Socials -->
      <div class="flex items-center gap-3">
        {socials.map((social) => (
          <a
            href={social.url}
            class="w-9 h-9 rounded-full bg-zinc-800 flex items-center justify-center text-neutral-400 hover:bg-indigo-600 hover:text-white transition-all text-sm"
            aria-label={social.platform}
          >
            {social.icon}
          </a>
        ))}
      </div>
    </div>

    <!-- Copyright -->
    <div class="border-t border-zinc-800 pt-8 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-xs text-neutral-500">{copyright}</p>
      <div class="flex items-center gap-4">
        {legalLinks.map((link) => (
          <a href={link.url} class="text-xs text-neutral-500 hover:text-white transition-colors">
            {link.label}
          </a>
        ))}
      </div>
    </div>
  </div>
</footer>
