---
/**
 * FooterFat — Fat Footer
 * Pattern key: fatFooter
 * Section: Footer
 *
 * Large content-rich footer with 5–6 columns, certifications, payment icons.
 */
import type { FooterData } from '../../../data/sample-data';

interface Props {
  data: FooterData;
}

const { data } = Astro.props;
const { logo, tagline, columns, socials, copyright, legalLinks } = data;
---

<footer class="bg-zinc-950 text-white pt-20 pb-8">
  <div class="container mx-auto px-4 md:px-8">

    <!-- Top: Logo + Description + Contact -->
    <div class="grid lg:grid-cols-12 gap-12 mb-16">
      <div class="lg:col-span-5">
        <a href="/" class="text-3xl font-bold">{logo}</a>
        {tagline && (
          <p class="mt-4 text-neutral-400 leading-relaxed max-w-md">{tagline}</p>
        )}

        <!-- Contact Info -->
        <div class="mt-8 space-y-3">
          <div class="flex items-center gap-3 text-sm text-neutral-400">
            <span class="w-8 h-8 rounded-lg bg-zinc-800 flex items-center justify-center text-xs">📍</span>
            <span>123 Business St, Sydney NSW 2000</span>
          </div>
          <div class="flex items-center gap-3 text-sm text-neutral-400">
            <span class="w-8 h-8 rounded-lg bg-zinc-800 flex items-center justify-center text-xs">📞</span>
            <a href="tel:0400000000" class="hover:text-white transition-colors">0400 000 000</a>
          </div>
          <div class="flex items-center gap-3 text-sm text-neutral-400">
            <span class="w-8 h-8 rounded-lg bg-zinc-800 flex items-center justify-center text-xs">✉️</span>
            <a href="mailto:hello@acmestudio.com" class="hover:text-white transition-colors">hello@acmestudio.com</a>
          </div>
        </div>

        <!-- Socials -->
        <div class="flex items-center gap-3 mt-8">
          {socials.map((social) => (
            <a
              href={social.url}
              class="w-10 h-10 rounded-lg bg-zinc-800 flex items-center justify-center text-neutral-400 hover:bg-indigo-600 hover:text-white transition-all"
              aria-label={social.platform}
            >
              {social.icon}
            </a>
          ))}
        </div>
      </div>

      <!-- Nav Columns -->
      <div class="lg:col-span-7 grid sm:grid-cols-2 md:grid-cols-3 gap-8">
        {columns.map((col) => (
          <div>
            <h3 class="font-bold text-sm uppercase tracking-wider mb-4 text-white">{col.heading}</h3>
            <ul class="space-y-3">
              {col.links.map((link) => (
                <li>
                  <a href={link.url} class="text-sm text-neutral-400 hover:text-white transition-colors hover:translate-x-1 inline-block">
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>

    <!-- Trust / Certifications Bar -->
    <div class="border-t border-zinc-800 py-8 flex flex-wrap items-center justify-center gap-8 text-neutral-500 text-sm">
      <div class="flex items-center gap-2">
        <span>🛡️</span> <span>Licensed & Insured</span>
      </div>
      <div class="flex items-center gap-2">
        <span>✅</span> <span>Google Partner</span>
      </div>
      <div class="flex items-center gap-2">
        <span>⭐</span> <span>5-Star Rated</span>
      </div>
      <div class="flex items-center gap-2">
        <span>🔒</span> <span>SSL Secured</span>
      </div>
    </div>

    <!-- Copyright Bar -->
    <div class="border-t border-zinc-800 pt-8 flex flex-col md:flex-row items-center justify-between gap-4">
      <p class="text-xs text-neutral-500">{copyright}</p>
      <div class="flex items-center gap-6">
        {legalLinks.map((link) => (
          <a href={link.url} class="text-xs text-neutral-500 hover:text-white transition-colors">{link.label}</a>
        ))}
      </div>
    </div>
  </div>
</footer>
