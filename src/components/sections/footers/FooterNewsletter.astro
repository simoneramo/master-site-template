---
/**
 * FooterNewsletter — Newsletter + Links Footer
 * Pattern key: newsletterLinks
 * Section: Footer
 *
 * Newsletter signup at top, multi-column links below, copyright bar.
 */
import type { FooterData } from '../../../data/sample-data';

interface Props {
  data: FooterData;
}

const { data } = Astro.props;
const { logo, tagline, columns, socials, copyright, legalLinks, newsletterHeading, newsletterDescription } = data;
---

<footer class="bg-zinc-950 text-white">
  <!-- Newsletter Section -->
  <div class="border-b border-zinc-800">
    <div class="container mx-auto px-4 md:px-8 py-12">
      <div class="flex flex-col md:flex-row items-center justify-between gap-8 max-w-4xl mx-auto">
        <div class="text-center md:text-left">
          <h3 class="text-xl font-bold mb-2">{newsletterHeading ?? 'Stay in the loop'}</h3>
          <p class="text-sm text-neutral-400">{newsletterDescription ?? 'Get the latest tips and updates delivered to your inbox.'}</p>
        </div>
        <form class="flex gap-2 w-full md:w-auto" x-data @submit.prevent>
          <input
            type="email"
            placeholder="Enter your email"
            class="flex-1 md:w-72 px-4 py-3 rounded-lg bg-zinc-800 border-2 border-zinc-700 text-white placeholder-neutral-500 focus:outline-none focus:border-indigo-500 text-sm"
          />
          <button
            type="submit"
            class="px-6 py-3 bg-white text-black font-bold rounded-lg hover:bg-zinc-200 transition-colors text-sm shrink-0"
          >
            Subscribe
          </button>
        </form>
      </div>
    </div>
  </div>

  <!-- Links -->
  <div class="container mx-auto px-4 md:px-8 py-12">
    <div class="grid md:grid-cols-2 lg:grid-cols-12 gap-12 mb-12">
      <div class="lg:col-span-4">
        <a href="/" class="text-2xl font-bold">{logo}</a>
        {tagline && (
          <p class="mt-4 text-sm text-neutral-400 leading-relaxed max-w-xs">{tagline}</p>
        )}
        <div class="flex items-center gap-3 mt-6">
          {socials.map((social) => (
            <a
              href={social.url}
              class="w-10 h-10 rounded-lg bg-zinc-800 flex items-center justify-center text-neutral-400 hover:bg-indigo-600 hover:text-white transition-all"
              aria-label={social.platform}
            >
              {social.icon}
            </a>
          ))}
        </div>
      </div>

      {columns.map((col) => (
        <div class="lg:col-span-2">
          <h3 class="font-bold text-sm uppercase tracking-wider mb-4 text-white">{col.heading}</h3>
          <ul class="space-y-3">
            {col.links.map((link) => (
              <li>
                <a href={link.url} class="text-sm text-neutral-400 hover:text-white transition-colors">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="border-t border-zinc-800 pt-8 flex flex-col md:flex-row items-center justify-between gap-4">
      <p class="text-xs text-neutral-500">{copyright}</p>
      <div class="flex items-center gap-6">
        {legalLinks.map((link) => (
          <a href={link.url} class="text-xs text-neutral-500 hover:text-white transition-colors">{link.label}</a>
        ))}
      </div>
    </div>
  </div>
</footer>
