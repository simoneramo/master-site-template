---
/**
 * IntegrationsCompact — Dense Logo Tiles
 * Pattern key: compact
 * Section: Integrations
 *
 * A dense, even grid of icon + name tiles — ideal for showing "works with
 * 100+ tools" at a glance. No descriptions. Optional trailing CTA.
 */
import type { IntegrationsData } from "../../../data/sample-data";

interface Props {
  data: IntegrationsData;
  /** Section ID for anchor links */
  id?: string;
}

const { data, id } = Astro.props;
const { eyebrow, heading, description, integrations = [], cta } = data;
---

<section {id} class="py-20 md:py-32">
  <div class="container mx-auto px-4 md:px-8 max-w-5xl">
    {
      (eyebrow || heading || description) && (
        <div class="text-center max-w-2xl mx-auto mb-12">
          {eyebrow && (
            <span class="inline-flex items-center text-xs font-bold uppercase tracking-widest px-4 py-1.5 rounded-full border border-zinc-300 dark:border-zinc-700 text-neutral-600 dark:text-neutral-400 mb-6">
              {eyebrow}
            </span>
          )}
          {heading && <h2 class="text-4xl md:text-5xl font-bold mb-4">{heading}</h2>}
          {description && (
            <p class="text-lg text-neutral-600 dark:text-neutral-400">{description}</p>
          )}
        </div>
      )
    }

    {integrations.length > 0 && (
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-px bg-zinc-200 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-800 rounded-2xl overflow-hidden">
        {integrations.map((item) => {
          const Tag = item.url ? 'a' : 'div';
          return (
            <Tag
              href={item.url}
              class="flex items-center gap-3 bg-white dark:bg-zinc-950 p-5 hover:bg-zinc-50 dark:hover:bg-zinc-900 transition-colors"
            >
              <span class="text-2xl shrink-0">{item.icon}</span>
              <span class="font-bold text-sm truncate">{item.name}</span>
            </Tag>
          );
        })}
      </div>
    )}

    {cta?.text && cta?.url && (
      <div class="text-center mt-10">
        <a
          href={cta.url}
          class="font-bold border-b-2 border-black dark:border-white hover:border-transparent transition-colors text-black dark:text-white"
        >
          {cta.text} &rarr;
        </a>
      </div>
    )}
  </div>
</section>
