---
/**
 * IntegrationsGrid — Integration Cards
 * Pattern key: grid
 * Section: Integrations
 *
 * Grid of bordered cards, each with an app icon, name, short description,
 * and optional category tag. Optional trailing CTA.
 */
import type { IntegrationsData } from "../../../data/sample-data";

interface Props {
  data: IntegrationsData;
  /** Section ID for anchor links */
  id?: string;
}

const { data, id } = Astro.props;
const { eyebrow, heading, description, integrations = [], cta } = data;
---

<section {id} class="py-20 md:py-32">
  <div class="container mx-auto px-4 md:px-8">
    {
      (eyebrow || heading || description) && (
        <div class="text-center max-w-2xl mx-auto mb-14">
          {eyebrow && (
            <span class="inline-flex items-center text-xs font-bold uppercase tracking-widest px-4 py-1.5 rounded-full border border-zinc-300 dark:border-zinc-700 text-neutral-600 dark:text-neutral-400 mb-6">
              {eyebrow}
            </span>
          )}
          {heading && <h2 class="text-4xl md:text-5xl font-bold mb-4">{heading}</h2>}
          {description && (
            <p class="text-lg text-neutral-600 dark:text-neutral-400">{description}</p>
          )}
        </div>
      )
    }

    {integrations.length > 0 && (
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {integrations.map((item) => {
          const Tag = item.url ? 'a' : 'div';
          return (
            <Tag
              href={item.url}
              class="group block bg-white dark:bg-zinc-950 p-6 border-2 border-zinc-200 dark:border-zinc-800 rounded-xl hover:border-zinc-400 dark:hover:border-zinc-600 transition-colors"
            >
              <div class="flex items-center gap-4 mb-3">
                <div class="w-12 h-12 rounded-xl bg-zinc-100 dark:bg-zinc-900 flex items-center justify-center text-2xl shrink-0">
                  {item.icon}
                </div>
                <div class="min-w-0">
                  <h3 class="font-bold leading-tight truncate">{item.name}</h3>
                  {item.category && (
                    <span class="text-xs font-medium text-neutral-400">{item.category}</span>
                  )}
                </div>
              </div>
              {item.description && (
                <p class="text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">{item.description}</p>
              )}
            </Tag>
          );
        })}
      </div>
    )}

    {cta?.text && cta?.url && (
      <div class="text-center mt-12">
        <a
          href={cta.url}
          class="inline-flex items-center justify-center h-12 px-8 font-bold text-white bg-black dark:bg-white dark:text-black rounded-lg hover:bg-zinc-800 dark:hover:bg-zinc-200 transition-colors"
        >
          {cta.text}
        </a>
      </div>
    )}
  </div>
</section>
