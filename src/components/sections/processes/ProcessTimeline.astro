---
/**
 * ProcessTimeline — Vertical Timeline
 * Centered vertical line with steps alternating left and right.
 */
import type { ProcessData } from '../../../data/sample-data';

interface Props { data: ProcessData; }

const { data } = Astro.props;
const { eyebrow, heading, description, steps } = data;
---

<section class="py-20 md:py-32">
  <div class="container mx-auto px-4 md:px-8">
    <div class="text-center max-w-2xl mx-auto mb-16">
      {eyebrow && (
        <span class="inline-flex items-center text-xs font-bold uppercase tracking-widest px-4 py-1.5 rounded-full border border-zinc-300 dark:border-zinc-700 text-neutral-600 dark:text-neutral-400 mb-6">
          {eyebrow}
        </span>
      )}
      <h2 class="text-4xl md:text-5xl font-bold mb-4">{heading}</h2>
      {description && <p class="text-lg text-neutral-600 dark:text-neutral-400">{description}</p>}
    </div>

    <div class="relative max-w-4xl mx-auto">
      {/* Vertical Line */}
      <div class="absolute left-8 md:left-1/2 top-0 bottom-0 w-0.5 bg-zinc-200 dark:bg-zinc-800 md:-translate-x-1/2" />

      <div class="space-y-12">
        {steps.map((step, index) => {
          const isLeft = index % 2 === 0;
          return (
            <div class="relative grid md:grid-cols-2 gap-8 items-center">
              {/* Timeline Dot */}
              <div class="absolute left-8 md:left-1/2 w-4 h-4 rounded-full bg-accent border-4 border-white dark:border-zinc-950 md:-translate-x-1/2 z-10" />

              {/* Content - Alternating sides on desktop */}
              <div class:list={["pl-20 md:pl-0", isLeft ? "md:pr-12 md:text-right" : "md:col-start-2 md:pl-12"]}>
                <span class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-accent/10 dark:bg-accent/20 text-accent font-bold text-sm mb-3">
                  {step.number}
                </span>
                {step.icon && <div class="text-3xl mb-2">{step.icon}</div>}
                <h3 class="text-2xl font-bold mb-2">{step.heading}</h3>
                <p class="text-neutral-600 dark:text-neutral-400">{step.description}</p>
              </div>

              {/* Empty spacer for alternating layout */}
              <div class:list={[isLeft ? "md:col-start-2" : "md:col-start-1 md:row-start-1"]} />
            </div>
          );
        })}
      </div>
    </div>
  </div>
</section>
