---
/**
 * NewsletterSplit — Split Layout
 * Benefits list left, form inputs right.
 */
import type { NewsletterData } from '../../../data/sample-data';

interface Props { data: NewsletterData; }

const { data } = Astro.props;
const { heading, description, incentive, benefits, buttonText, trustText } = data;
---

<section class="py-20 md:py-32 bg-surface dark:bg-zinc-900/50">
  <div class="container mx-auto px-4 md:px-8">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center max-w-5xl mx-auto">
      {/* Left - Benefits */}
      <div>
        <h2 class="text-3xl md:text-4xl font-bold mb-4">{heading}</h2>
        {description && <p class="text-lg text-neutral-600 dark:text-neutral-400 mb-8">{description}</p>}
        
        {benefits && benefits.length > 0 && (
          <ul class="space-y-3">
            {benefits.map((benefit) => (
              <li class="flex items-center gap-3">
                <span class="w-6 h-6 rounded-full bg-emerald-100 dark:bg-emerald-900/30 text-emerald-600 dark:text-emerald-400 flex items-center justify-center text-sm">✓</span>
                <span>{benefit}</span>
              </li>
            ))}
          </ul>
        )}
      </div>

      {/* Right - Form */}
      <div class="bg-white dark:bg-zinc-950 rounded-2xl p-8 border-2 border-zinc-200 dark:border-zinc-800">
        {incentive && (
          <div class="text-center mb-6">
            <span class="inline-block px-4 py-2 rounded-full bg-accent/10 dark:bg-accent/20 text-accent font-bold text-sm">
              {incentive}
            </span>
          </div>
        )}
        
        <form class="space-y-4" onsubmit="event.preventDefault();">
          <div>
            <label class="block text-sm font-bold mb-2">Email Address</label>
            <input 
              type="email" 
              placeholder="you@example.com"
              class="w-full h-14 px-5 rounded-lg border-2 border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-950 focus:border-accent focus:outline-none transition-colors"
              required
            />
          </div>
          <button 
            type="submit"
            class="w-full h-14 font-bold bg-zinc-950 text-white dark:bg-white dark:text-black rounded-lg hover:bg-zinc-800 dark:hover:bg-zinc-200 transition-colors"
          >
            {buttonText || 'Subscribe'}
          </button>
        </form>
        
        {trustText && (
          <p class="text-center text-sm text-neutral-500 dark:text-neutral-500 mt-4">{trustText}</p>
        )}
      </div>
    </div>
  </div>
</section>
