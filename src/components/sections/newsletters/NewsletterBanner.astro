---
/**
 * NewsletterBanner — Banner
 * Full-width bar with contrasting background. Text left, form right.
 */
import type { NewsletterData } from '../../../data/sample-data';

interface Props { data: NewsletterData; }

const { data } = Astro.props;
const { heading, description, buttonText } = data;
---

<section class="py-12 md:py-16 bg-zinc-950 text-white dark:bg-white dark:text-black">
  <div class="container mx-auto px-4 md:px-8">
    <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6">
      <div class="lg:max-w-xl">
        <h2 class="text-2xl md:text-3xl font-bold mb-2">{heading}</h2>
        {description && <p class="text-white/70 dark:text-black/70">{description}</p>}
      </div>
      
      <form class="flex flex-col sm:flex-row gap-3 lg:w-auto w-full max-w-md" onsubmit="event.preventDefault();">
        <input 
          type="email" 
          placeholder="Enter your email"
          class="h-14 px-5 rounded-lg bg-white/10 dark:bg-black/10 border border-white/20 dark:border-black/20 text-white dark:text-black placeholder:text-white/50 dark:placeholder:text-black/50 focus:border-white dark:focus:border-black focus:outline-none transition-colors lg:w-64"
          required
        />
        <button 
          type="submit"
          class="h-14 px-8 font-bold bg-white text-black dark:bg-black dark:text-white rounded-lg hover:bg-white/90 dark:hover:bg-black/90 transition-colors whitespace-nowrap"
        >
          {buttonText || 'Subscribe'}
        </button>
      </form>
    </div>
  </div>
</section>
