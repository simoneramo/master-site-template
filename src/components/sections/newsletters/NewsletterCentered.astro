---
/**
 * NewsletterCentered — Centered
 * Centered heading, subtext, inline email input + submit button.
 */
import type { NewsletterData } from '../../../data/sample-data';

interface Props { data: NewsletterData; }

const { data } = Astro.props;
const { heading, description, buttonText, trustText } = data;
---

<section class="py-20 md:py-32">
  <div class="container mx-auto px-4 md:px-8">
    <div class="max-w-xl mx-auto text-center">
      <h2 class="text-3xl md:text-4xl font-bold mb-4">{heading}</h2>
      {description && <p class="text-neutral-600 dark:text-neutral-400 mb-8">{description}</p>}
      
      <form class="flex flex-col sm:flex-row gap-3 mb-4" onsubmit="event.preventDefault();">
        <input 
          type="email" 
          placeholder="Enter your email"
          class="flex-1 h-14 px-5 rounded-lg border-2 border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-950 focus:border-accent focus:outline-none transition-colors"
          required
        />
        <button 
          type="submit"
          class="h-14 px-8 font-bold bg-zinc-950 text-white dark:bg-white dark:text-black rounded-lg hover:bg-zinc-800 dark:hover:bg-zinc-200 transition-colors"
        >
          {buttonText || 'Subscribe'}
        </button>
      </form>
      
      {trustText && (
        <p class="text-sm text-neutral-500 dark:text-neutral-500">{trustText}</p>
      )}
    </div>
  </div>
</section>
