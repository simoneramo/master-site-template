---
/**
 * NewsletterIncentive — With Incentive
 * Strong offer heading ("Get 10% Off"), form, trust text below.
 */
import type { NewsletterData } from '../../../data/sample-data';

interface Props { data: NewsletterData; }

const { data } = Astro.props;
const { heading, description, incentive, benefits, buttonText, trustText } = data;
---

<section class="py-20 md:py-32 bg-linear-to-br from-accent/5 to-accent/10 dark:from-accent/10 dark:to-accent/5">
  <div class="container mx-auto px-4 md:px-8">
    <div class="max-w-2xl mx-auto text-center">
      {incentive && (
        <span class="inline-flex items-center text-xs font-bold uppercase tracking-widest px-4 py-1.5 rounded-full bg-accent text-white mb-6">
          {incentive}
        </span>
      )}
      
      <h2 class="text-4xl md:text-5xl font-bold mb-4">{heading}</h2>
      {description && <p class="text-lg text-neutral-600 dark:text-neutral-400 mb-8">{description}</p>}
      
      {benefits && benefits.length > 0 && (
        <div class="flex flex-wrap justify-center gap-4 mb-8">
          {benefits.map((benefit) => (
            <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white dark:bg-zinc-950 border border-zinc-200 dark:border-zinc-800 text-sm">
              <span class="text-accent">✓</span> {benefit}
            </span>
          ))}
        </div>
      )}
      
      <form class="flex flex-col sm:flex-row gap-3 max-w-md mx-auto mb-4" onsubmit="event.preventDefault();">
        <input 
          type="email" 
          placeholder="Enter your email"
          class="flex-1 h-14 px-5 rounded-lg border-2 border-zinc-200 dark:border-zinc-800 bg-white dark:bg-zinc-950 focus:border-accent focus:outline-none transition-colors"
          required
        />
        <button 
          type="submit"
          class="h-14 px-8 font-bold bg-accent text-white rounded-lg hover:bg-accent/90 transition-colors"
        >
          {buttonText || 'Subscribe'}
        </button>
      </form>
      
      {trustText && (
        <p class="text-sm text-neutral-500 dark:text-neutral-500">{trustText}</p>
      )}
    </div>
  </div>
</section>
