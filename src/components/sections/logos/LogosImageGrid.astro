---
/**
 * LogosImageGrid — Bordered Image Logo Grid
 * Pattern key: imageGrid
 * Section: Logos
 *
 * Image logos laid out in an even, bordered grid. Logos are greyscaled
 * and fade to full colour on hover. Falls back to the brand name + icon
 * when a logo has no image source.
 */
import type { LogosData } from "../../../data/sample-data";

interface Props {
  data: LogosData;
  /** Section ID for anchor links */
  id?: string;
}

const { data, id } = Astro.props;
const { eyebrow, heading, description, brands = [] } = data;
---

<section {id} class="py-16 md:py-24">
  <div class="container mx-auto px-4 md:px-8">
    {
      (eyebrow || heading || description) && (
        <div class="text-center max-w-2xl mx-auto mb-12">
          {eyebrow && (
            <p class="text-xs font-bold text-neutral-500 dark:text-neutral-400 mb-4 uppercase tracking-widest">
              {eyebrow}
            </p>
          )}
          {heading && <h2 class="text-3xl md:text-4xl font-bold mb-4 dark:text-white">{heading}</h2>}
          {description && (
            <p class="text-lg text-neutral-600 dark:text-neutral-400">{description}</p>
          )}
        </div>
      )
    }

    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-px bg-zinc-200 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-800 rounded-2xl overflow-hidden">
      {
        brands.map((logo) => {
          const inner = logo.src ? (
            <img
              src={logo.src}
              alt={logo.alt || logo.name}
              class="h-8 md:h-9 object-contain grayscale opacity-60 hover:grayscale-0 hover:opacity-100 transition-all duration-300"
              loading="lazy"
            />
          ) : (
            <span class="flex items-center gap-2 text-lg font-bold text-neutral-600 dark:text-neutral-300">
              {logo.icon && <span class="text-2xl">{logo.icon}</span>}
              {logo.name}
            </span>
          );
          return (
            <div class="flex items-center justify-center bg-white dark:bg-zinc-950 p-6 md:p-8">
              {logo.url ? (
                <a href={logo.url} aria-label={logo.name}>{inner}</a>
              ) : inner}
            </div>
          );
        })
      }
    </div>
  </div>
</section>
