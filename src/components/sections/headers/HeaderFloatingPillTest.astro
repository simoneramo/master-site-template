---
/**
 * HeaderFloatingPillTest — Direct port of reference demo
 * Pattern key: floatingPillTest
 * Section: Navigation / Header
 */
import type { HeaderData } from '../../../data/sample-data';

interface Props {
  data: HeaderData;
}

const { data } = Astro.props;
const { logo, navLinks, cta } = data;
---

<div class="h-20" />

<header
  class="fixed left-0 right-0 z-50 mx-auto bounce-transition-test flex items-center border border-gray-300"
  x-data="{ mobileMenuOpen: false, scrolled: false }"
  x-init="const c=$el.closest('.header-preview-frame');const t=c||window;t.addEventListener('scroll',()=>{scrolled=c?c.scrollTop>20:window.pageYOffset>20})"
  x-bind:class="{
    'top-6 w-[90%] max-w-5xl rounded-full shadow-xl bg-white/90 backdrop-blur-md py-2 px-6': scrolled,
    'top-6 w-[94%] max-w-7xl rounded-full bg-gray-100 py-3 px-6': !scrolled
  }"
>
  <div class="w-full relative flex items-center justify-between">

    <!-- Logo -->
    <div class="flex items-center">
      <a href="#" class="text-xl font-bold tracking-tight text-gray-900 whitespace-nowrap">
        {logo}
      </a>
    </div>

    <!-- Desktop Nav -->
    <div class="hidden lg:block">
      <nav class="flex items-center gap-8">
        {navLinks.map((link) => (
          <a href={link.url} class="text-sm font-medium text-gray-600 hover:text-gray-900 whitespace-nowrap">
            {link.label}
          </a>
        ))}
      </nav>
    </div>

    <!-- CTA + Mobile Toggle -->
    <div class="flex items-center gap-4">
      <div class="hidden lg:block">
        <a href={cta.url} class="inline-flex items-center justify-center gap-2 py-2 px-5 text-sm font-semibold rounded-full bg-blue-600 text-white hover:bg-blue-700 transition-colors whitespace-nowrap">
          {cta.text}
        </a>
      </div>

      <div class="lg:hidden ml-auto">
        <button
          type="button"
          class="p-3 inline-flex justify-center items-center gap-2 rounded-full bg-blue-600 text-white shadow-sm hover:bg-blue-700 focus:outline-none transition-all text-sm"
          :class="{ 'ring-2 ring-offset-1 ring-blue-600': mobileMenuOpen }"
          @click="mobileMenuOpen = !mobileMenuOpen"
          aria-label="Toggle navigation"
        >
          <svg x-show="!mobileMenuOpen" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
            <line x1="3" y1="12" x2="21" y2="12" /><line x1="3" y1="6" x2="21" y2="6" /><line x1="3" y1="18" x2="21" y2="18" />
          </svg>
          <svg x-show="mobileMenuOpen" x-cloak class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
            <line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Dropdown -->
  <div
    class="absolute top-full left-0 right-0 mt-3 w-full bg-white rounded-3xl shadow-xl border border-gray-100 p-6 z-50 origin-top"
    x-show="mobileMenuOpen"
    x-cloak
    x-transition:enter="animate-drop-in-test origin-top"
    x-transition:leave="transition ease-in duration-200"
    x-transition:leave-start="opacity-100 scale-100"
    x-transition:leave-end="opacity-0 scale-90"
  >
    <div class="flex flex-col gap-6">
      <nav class="flex flex-col gap-4">
        {navLinks.map((link) => (
          <a href={link.url} @click="mobileMenuOpen = false" class="text-base font-medium text-gray-800 hover:text-blue-600 transition-colors">
            {link.label}
          </a>
        ))}
      </nav>
      <div>
        <a href={cta.url} class="flex items-center justify-center w-full bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-full py-3 px-4 transition-colors">
          {cta.text}
        </a>
      </div>
    </div>
  </div>
</header>

<style is:global>
  [x-cloak] { display: none !important; }

  .bounce-transition-test {
    transition: all 0.5s cubic-bezier(0.617, 1.5, 0.68, 1);
  }

  .animate-drop-in-test {
    animation: dropInTest 0.35s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
  }

  @keyframes dropInTest {
    0%   { opacity: 0; transform: scaleY(0.9) translateY(-20px); }
    70%  { opacity: 1; transform: scaleY(1.02) translateY(10px); }
    100% { opacity: 1; transform: scaleY(1) translateY(0); }
  }
</style>
