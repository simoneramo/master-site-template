---
/**
 * HeaderTopBarNav — Top Bar + Navigation
 * Pattern key: topBarNav
 * Section: Navigation / Header
 *
 * Two-tier: thin info strip on top (phone, email, hours), main nav below.
 * Top bar hides on scroll.
 */
import type { HeaderData } from '../../../data/sample-data';

interface Props {
  data: HeaderData;
}

const { data } = Astro.props;
const { logo, navLinks, cta, topBar } = data;
---

<header
  class="w-full z-50 header-topbar-nav"
  x-data="{ scrollY: 0, mobileOpen: false }"
  @scroll.window="scrollY = window.scrollY"
>
  <!-- Top Bar -->
  <div
    class="bg-zinc-900 dark:bg-zinc-800 text-white text-xs transition-all duration-300 overflow-hidden h-10 opacity-100"
    :class="scrollY > 80 ? 'h-0 opacity-0' : 'h-10 opacity-100'"
  >
    <div class="container mx-auto px-4 md:px-8 h-10 flex items-center justify-between">
      <div class="flex items-center gap-6">
        {topBar?.phone && (
          <a href={`tel:${topBar.phone.replace(/\s/g, '')}`} class="flex items-center gap-1.5 hover:text-indigo-400 transition-colors">
            <span>📞</span> {topBar.phone}
          </a>
        )}
        {topBar?.email && (
          <a href={`mailto:${topBar.email}`} class="hidden sm:flex items-center gap-1.5 hover:text-indigo-400 transition-colors">
            <span>✉️</span> {topBar.email}
          </a>
        )}
        {topBar?.hours && (
          <span class="hidden md:flex items-center gap-1.5 text-white/60">
            <span>🕐</span> {topBar.hours}
          </span>
        )}
      </div>
      <div class="flex items-center gap-4">
        {topBar?.socials?.map((social) => (
          <a href={social.url} class="hover:text-indigo-400 transition-colors font-bold" aria-label={social.platform}>
            {social.platform === 'Facebook' ? 'f' : social.platform === 'Instagram' ? '📷' : social.platform === 'Twitter' ? '𝕏' : social.platform.charAt(0)}
          </a>
        ))}
      </div>
    </div>
  </div>

  <!-- Main Nav -->
  <div
    class="bg-white dark:bg-zinc-950 border-b border-zinc-200 dark:border-zinc-800 transition-all duration-300"
    :class="scrollY > 80 ? 'fixed top-0 left-0 right-0 shadow-sm' : ''"
  >
    <div class="container mx-auto px-4 md:px-8 h-16 flex items-center justify-between">
      <a href="/" class="text-xl font-bold text-black dark:text-white shrink-0">
        {logo}
      </a>

      <nav class="hidden md:flex items-center gap-8">
        {navLinks.map((link) => (
          <a
            href={link.url}
            class="text-sm font-bold text-neutral-600 dark:text-neutral-400 hover:text-black dark:hover:text-white transition-colors"
          >
            {link.label}
          </a>
        ))}
      </nav>

      <div class="flex items-center gap-4">
        <a
          href={cta.url}
          class="hidden md:inline-flex group relative items-center justify-center overflow-hidden bg-black dark:bg-white text-white dark:text-black font-bold px-6 py-2.5 rounded-lg transition-all"
        >
          <span class="transform transition-transform duration-300 group-hover:-translate-x-3">{cta.text}</span>
          <span class="absolute right-4 transform -translate-x-4 opacity-0 transition-all duration-300 group-hover:translate-x-0 group-hover:opacity-100">→</span>
        </a>

        <button
          @click="mobileOpen = !mobileOpen"
          class="md:hidden p-2 rounded-lg border-2 border-zinc-300 dark:border-zinc-700"
          aria-label="Toggle menu"
        >
          <div class="w-5 h-4 flex flex-col justify-between">
            <span class="block w-full h-0.5 bg-black dark:bg-white transition-transform origin-left" :class="mobileOpen ? 'rotate-45 translate-x-0.5' : ''" />
            <span class="block w-full h-0.5 bg-black dark:bg-white transition-opacity" :class="mobileOpen ? 'opacity-0' : ''" />
            <span class="block w-full h-0.5 bg-black dark:bg-white transition-transform origin-left" :class="mobileOpen ? '-rotate-45 translate-x-0.5' : ''" />
          </div>
        </button>
      </div>
    </div>

    <!-- Mobile Menu -->
    <div
      x-show="mobileOpen"
      x-transition:enter="transition ease-out duration-200"
      x-transition:enter-start="opacity-0 -translate-y-4"
      x-transition:enter-end="opacity-100 translate-y-0"
      x-transition:leave="transition ease-in duration-150"
      x-transition:leave-start="opacity-100 translate-y-0"
      x-transition:leave-end="opacity-0 -translate-y-4"
      class="md:hidden bg-white dark:bg-zinc-950 border-t border-zinc-200 dark:border-zinc-800"
    >
      <nav class="px-8 py-6 flex flex-col space-y-4">
        {navLinks.map((link) => (
          <a href={link.url} @click="mobileOpen = false" class="block py-2 font-bold text-lg hover:translate-x-1 transition-transform">
            {link.label}
          </a>
        ))}
        <a href={cta.url} class="inline-flex items-center justify-center h-12 bg-black dark:bg-white text-white dark:text-black font-bold rounded-lg mt-4">
          {cta.text}
        </a>
      </nav>
    </div>
  </div>
</header>
