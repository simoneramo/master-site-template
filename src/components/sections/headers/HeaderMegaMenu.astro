---
/**
 * HeaderMegaMenu — Mega Menu Header
 * Pattern key: megaMenu
 * Section: Navigation / Header
 *
 * Full-width mega menu dropdown with multi-column content.
 * Hovering on a nav item with children opens the mega panel.
 */
import type { HeaderData } from '../../../data/sample-data';
import ThemeToggle from '../../ThemeToggle.astro';

interface Props {
  data: HeaderData;
}

const { data } = Astro.props;
const { logo, navLinks, cta } = data;
---

<header
  class="w-full z-50 transition-all duration-300"
  x-data="{ scrollY: 0, mobileOpen: false, activeMenu: null }"
  @scroll.window="scrollY = window.scrollY"
  :class="scrollY > 100 ? 'fixed top-0 bg-white/95 dark:bg-zinc-950/95 backdrop-blur-md shadow-sm border-b border-zinc-200 dark:border-zinc-800' : 'absolute top-0 bg-white dark:bg-zinc-950 border-b border-zinc-200 dark:border-zinc-800'"
>
  <div class="container mx-auto px-4 md:px-8 h-20 flex items-center justify-between">
    <a href="/" class="text-xl font-bold text-black dark:text-white shrink-0">
      {logo}
    </a>

    <!-- Desktop Nav with Mega Menu triggers -->
    <nav class="hidden lg:flex items-center gap-1">
      {navLinks.map((link, i) => (
        <div
          class="relative"
          @mouseenter={link.children ? `activeMenu = ${i}` : ''}
          @mouseleave={link.children ? 'activeMenu = null' : ''}
        >
          <a
            href={link.url}
            class="flex items-center gap-1 px-4 py-2 text-sm font-bold text-neutral-600 dark:text-neutral-400 hover:text-black dark:hover:text-white transition-colors rounded-lg hover:bg-zinc-100 dark:hover:bg-zinc-900"
          >
            {link.label}
            {link.children && (
              <svg class="w-3.5 h-3.5 transition-transform" :class={`activeMenu === ${i} ? 'rotate-180' : ''`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            )}
          </a>

          {/* Mega Menu Dropdown */}
          {link.children && (
            <div
              x-show={`activeMenu === ${i}`}
              x-transition:enter="transition ease-out duration-150"
              x-transition:enter-start="opacity-0 translate-y-2"
              x-transition:enter-end="opacity-100 translate-y-0"
              x-transition:leave="transition ease-in duration-100"
              x-transition:leave-start="opacity-100 translate-y-0"
              x-transition:leave-end="opacity-0 translate-y-2"
              class="absolute top-full left-0 mt-0 w-80 bg-white dark:bg-zinc-900 border-2 border-zinc-200 dark:border-zinc-800 rounded-xl shadow-xl p-4"
            >
              {link.children.map((child) => (
                <a
                  href={child.url}
                  class="block p-3 rounded-lg hover:bg-zinc-50 dark:hover:bg-zinc-800 transition-colors group"
                >
                  <div class="font-bold text-sm group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors">{child.label}</div>
                  {child.description && (
                    <div class="text-xs text-neutral-500 dark:text-neutral-400 mt-0.5">{child.description}</div>
                  )}
                </a>
              ))}
            </div>
          )}
        </div>
      ))}
    </nav>

    <div class="flex items-center gap-4">
      <ThemeToggle />

      <a
        href={cta.url}
        class="hidden lg:inline-flex group relative items-center justify-center overflow-hidden bg-black dark:bg-white text-white dark:text-black font-bold px-6 py-2.5 rounded-full transition-all"
      >
        <span class="transform transition-transform duration-300 group-hover:-translate-x-3">{cta.text}</span>
        <span class="absolute right-4 transform -translate-x-4 opacity-0 transition-all duration-300 group-hover:translate-x-0 group-hover:opacity-100">→</span>
      </a>

      <button
        @click="mobileOpen = !mobileOpen"
        class="lg:hidden p-2 rounded-lg border-2 border-zinc-300 dark:border-zinc-700"
        aria-label="Toggle menu"
      >
        <div class="w-5 h-4 flex flex-col justify-between">
          <span class="block w-full h-0.5 bg-black dark:bg-white transition-transform origin-left" :class="mobileOpen ? 'rotate-45 translate-x-0.5' : ''" />
          <span class="block w-full h-0.5 bg-black dark:bg-white transition-opacity" :class="mobileOpen ? 'opacity-0' : ''" />
          <span class="block w-full h-0.5 bg-black dark:bg-white transition-transform origin-left" :class="mobileOpen ? '-rotate-45 translate-x-0.5' : ''" />
        </div>
      </button>
    </div>
  </div>

  <!-- Mobile Menu with Accordions -->
  <div
    x-show="mobileOpen"
    x-transition:enter="transition ease-out duration-200"
    x-transition:enter-start="opacity-0 -translate-y-4"
    x-transition:enter-end="opacity-100 translate-y-0"
    x-transition:leave="transition ease-in duration-150"
    x-transition:leave-start="opacity-100 translate-y-0"
    x-transition:leave-end="opacity-0 -translate-y-4"
    class="lg:hidden bg-white dark:bg-zinc-950 border-t border-zinc-200 dark:border-zinc-800 max-h-[80vh] overflow-y-auto"
  >
    <nav class="px-8 py-6 flex flex-col space-y-2">
      {navLinks.map((link, i) => (
        <div x-data={`{ open: false }`}>
          {link.children ? (
            <>
              <button
                @click="open = !open"
                class="w-full flex items-center justify-between py-3 font-bold text-lg"
              >
                <span>{link.label}</span>
                <svg class="w-4 h-4 transition-transform" :class="open ? 'rotate-180' : ''" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </button>
              <div x-show="open" x-collapse class="pl-4 pb-2 space-y-1">
                {link.children.map((child) => (
                  <a href={child.url} @click="mobileOpen = false" class="block py-2 text-neutral-600 dark:text-neutral-400 hover:text-black dark:hover:text-white transition-colors">
                    {child.label}
                  </a>
                ))}
              </div>
            </>
          ) : (
            <a href={link.url} @click="mobileOpen = false" class="block py-3 font-bold text-lg hover:translate-x-1 transition-transform">
              {link.label}
            </a>
          )}
        </div>
      ))}
      <a href={cta.url} class="inline-flex items-center justify-center h-12 bg-black dark:bg-white text-white dark:text-black font-bold rounded-full mt-4">
        {cta.text}
      </a>
    </nav>
  </div>
</header>
