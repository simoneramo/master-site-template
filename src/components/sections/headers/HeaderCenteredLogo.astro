---
/**
 * HeaderCenteredLogo — Centered Logo Header
 * Pattern key: centeredLogo
 * Section: Navigation / Header
 *
 * Logo centered, nav links split evenly on either side. CTA far right.
 */
import type { HeaderData } from '../../../data/sample-data';

interface Props {
  data: HeaderData;
}

const { data } = Astro.props;
const { logo, navLinks, cta } = data;

const midpoint = Math.ceil(navLinks.length / 2);
const leftLinks = navLinks.slice(0, midpoint);
const rightLinks = navLinks.slice(midpoint);
---

<header
  class="w-full z-50 transition-all duration-300"
  x-data="{ scrollY: 0, mobileOpen: false }"
  @scroll.window="scrollY = window.scrollY"
  :class="scrollY > 100 ? 'fixed top-0 bg-white/95 dark:bg-zinc-950/95 backdrop-blur-md shadow-sm border-b border-zinc-200 dark:border-zinc-800' : 'absolute top-0 bg-transparent'"
>
  <div class="container mx-auto px-4 md:px-8 h-20 flex items-center justify-between">

    <!-- Left Nav (desktop) -->
    <nav class="hidden lg:flex items-center gap-6 flex-1 justify-end pr-8">
      {leftLinks.map((link) => (
        <a
          href={link.url}
          class="text-sm font-bold text-neutral-600 dark:text-neutral-400 hover:text-black dark:hover:text-white transition-colors whitespace-nowrap"
        >
          {link.label}
        </a>
      ))}
    </nav>

    <!-- Centered Logo -->
    <a href="/" class="text-xl font-bold text-black dark:text-white shrink-0 text-center">
      {logo}
    </a>

    <!-- Right Nav (desktop) -->
    <nav class="hidden lg:flex items-center gap-6 flex-1 pl-8">
      {rightLinks.map((link) => (
        <a
          href={link.url}
          class="text-sm font-bold text-neutral-600 dark:text-neutral-400 hover:text-black dark:hover:text-white transition-colors whitespace-nowrap"
        >
          {link.label}
        </a>
      ))}

      <a
        href={cta.url}
        class="ml-auto group relative inline-flex items-center justify-center overflow-hidden bg-black dark:bg-white text-white dark:text-black font-bold px-6 py-2.5 rounded-lg transition-all"
      >
        <span class="transform transition-transform duration-300 group-hover:-translate-x-3">{cta.text}</span>
        <span class="absolute right-4 transform -translate-x-4 opacity-0 transition-all duration-300 group-hover:translate-x-0 group-hover:opacity-100">→</span>
      </a>
    </nav>

    <!-- Mobile Toggle -->
    <button
      @click="mobileOpen = !mobileOpen"
      class="lg:hidden p-2 rounded-lg border-2 border-zinc-300 dark:border-zinc-700"
      aria-label="Toggle menu"
    >
      <div class="w-5 h-4 flex flex-col justify-between">
        <span class="block w-full h-0.5 bg-black dark:bg-white transition-transform origin-left" :class="mobileOpen ? 'rotate-45 translate-x-0.5' : ''" />
        <span class="block w-full h-0.5 bg-black dark:bg-white transition-opacity" :class="mobileOpen ? 'opacity-0' : ''" />
        <span class="block w-full h-0.5 bg-black dark:bg-white transition-transform origin-left" :class="mobileOpen ? '-rotate-45 translate-x-0.5' : ''" />
      </div>
    </button>
  </div>

  <!-- Mobile Menu -->
  <div
    x-show="mobileOpen"
    x-transition:enter="transition ease-out duration-200"
    x-transition:enter-start="opacity-0 -translate-y-4"
    x-transition:enter-end="opacity-100 translate-y-0"
    x-transition:leave="transition ease-in duration-150"
    x-transition:leave-start="opacity-100 translate-y-0"
    x-transition:leave-end="opacity-0 -translate-y-4"
    class="lg:hidden bg-white dark:bg-zinc-950 border-t border-zinc-200 dark:border-zinc-800"
  >
    <nav class="px-8 py-6 flex flex-col space-y-4">
      {navLinks.map((link) => (
        <a href={link.url} @click="mobileOpen = false" class="block py-2 font-bold text-lg hover:translate-x-1 transition-transform">
          {link.label}
        </a>
      ))}
      <a href={cta.url} class="inline-flex items-center justify-center h-12 bg-black dark:bg-white text-white dark:text-black font-bold rounded-lg mt-4">
        {cta.text}
      </a>
    </nav>
  </div>
</header>
