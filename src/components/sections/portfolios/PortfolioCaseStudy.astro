---
/**
 * PortfolioCaseStudy — Case Study Cards
 * Two-column cards with image, title, description, and key metric.
 */
import type { PortfolioData } from '../../../data/sample-data';

interface Props { data: PortfolioData; }

const { data } = Astro.props;
const { eyebrow, heading, description, projects } = data;
---

<section class="py-20 md:py-32">
  <div class="container mx-auto px-4 md:px-8">
    <div class="text-center max-w-2xl mx-auto mb-16">
      {eyebrow && (
        <span class="inline-flex items-center text-xs font-bold uppercase tracking-widest px-4 py-1.5 rounded-full border border-zinc-300 dark:border-zinc-700 text-neutral-600 dark:text-neutral-400 mb-6">
          {eyebrow}
        </span>
      )}
      <h2 class="text-4xl md:text-5xl font-bold mb-4">{heading}</h2>
      {description && <p class="text-lg text-neutral-600 dark:text-neutral-400">{description}</p>}
    </div>

    <div class="space-y-12">
      {projects.map((project, index) => (
        <div class="group grid md:grid-cols-2 gap-8 items-center bg-surface dark:bg-zinc-900/50 rounded-2xl overflow-hidden border-2 border-zinc-200 dark:border-zinc-800">
          {/* Image */}
          <div class:list={["relative aspect-4/3 overflow-hidden", index % 2 === 1 && "md:order-2"]}>
            <img 
              src={project.image.src} 
              alt={project.image.alt}
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
              loading="lazy"
            />
            {project.metric && (
              <div class="absolute bottom-4 left-4 px-4 py-2 rounded-full bg-accent text-white font-bold text-sm">
                {project.metric}
              </div>
            )}
          </div>

          {/* Content */}
          <div class:list={["p-6 lg:p-10", index % 2 === 1 && "md:order-1"]}>
            <span class="text-accent text-sm font-bold uppercase tracking-wider">{project.category}</span>
            <h3 class="text-2xl md:text-3xl font-bold mt-2 mb-4">{project.title}</h3>
            <p class="text-neutral-600 dark:text-neutral-400 leading-relaxed mb-6">
              {project.description}
            </p>
            {project.link && (
              <a 
                href={project.link}
                class="inline-flex items-center gap-2 font-bold hover:gap-3 transition-all"
              >
                Read Case Study
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                </svg>
              </a>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
