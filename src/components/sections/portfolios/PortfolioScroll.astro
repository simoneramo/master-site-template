---
/**
 * PortfolioScroll — Horizontal Scroll
 * Large horizontally scrolling images with scroll-snap.
 */
import type { PortfolioData } from '../../../data/sample-data';

interface Props { data: PortfolioData; }

const { data } = Astro.props;
const { eyebrow, heading, description, projects } = data;
---

<section class="py-20 md:py-32 overflow-hidden">
  <div class="container mx-auto px-4 md:px-8 mb-12">
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6">
      <div class="max-w-2xl">
        {eyebrow && (
          <span class="inline-flex items-center text-xs font-bold uppercase tracking-widest px-4 py-1.5 rounded-full border border-zinc-300 dark:border-zinc-700 text-neutral-600 dark:text-neutral-400 mb-6">
            {eyebrow}
          </span>
        )}
        <h2 class="text-4xl md:text-5xl font-bold mb-4">{heading}</h2>
        {description && <p class="text-lg text-neutral-600 dark:text-neutral-400">{description}</p>}
      </div>
      
      <div class="hidden md:flex items-center gap-2">
        <button 
          class="w-12 h-12 rounded-full border-2 border-zinc-300 dark:border-zinc-700 flex items-center justify-center hover:bg-zinc-100 dark:hover:bg-zinc-900 transition-colors"
          onclick="document.getElementById('portfolio-scroll').scrollBy({ left: -500, behavior: 'smooth' })"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
          </svg>
        </button>
        <button 
          class="w-12 h-12 rounded-full border-2 border-zinc-300 dark:border-zinc-700 flex items-center justify-center hover:bg-zinc-100 dark:hover:bg-zinc-900 transition-colors"
          onclick="document.getElementById('portfolio-scroll').scrollBy({ left: 500, behavior: 'smooth' })"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </button>
      </div>
    </div>
  </div>

  {/* Scroll Container */}
  <div 
    id="portfolio-scroll"
    class="flex gap-6 overflow-x-auto snap-x snap-mandatory scrollbar-hide px-4 md:px-8 pb-4"
    style="scrollbar-width: none; -ms-overflow-style: none;"
  >
    {projects.map((project) => (
      <div class="snap-start shrink-0 w-[85vw] md:w-[500px] lg:w-[600px]">
        <div class="group relative aspect-4/3 overflow-hidden rounded-2xl bg-zinc-200 dark:bg-zinc-800">
          <img 
            src={project.image.src} 
            alt={project.image.alt}
            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-linear-to-t from-zinc-950/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300" />
          <div class="absolute bottom-0 left-0 right-0 p-6 translate-y-4 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 transition-all duration-300">
            <span class="text-accent text-xs font-bold uppercase tracking-wider">{project.category}</span>
            <h3 class="text-2xl font-bold text-white">{project.title}</h3>
            {project.metric && <p class="text-white/70 text-sm">{project.metric}</p>}
          </div>
        </div>
      </div>
    ))}
    <div class="snap-start shrink-0 w-4 md:w-8" />
  </div>
</section>

<style>
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
</style>
