---
/**
 * PortfolioUniform — Uniform Grid
 * Even grid with consistent aspect ratios and hover overlays.
 */
import type { PortfolioData } from '../../../data/sample-data';

interface Props { data: PortfolioData; }

const { data } = Astro.props;
const { eyebrow, heading, description, projects } = data;
---

<section class="py-20 md:py-32 bg-surface dark:bg-zinc-900/50">
  <div class="container mx-auto px-4 md:px-8">
    <div class="text-center max-w-2xl mx-auto mb-16">
      {eyebrow && (
        <span class="inline-flex items-center text-xs font-bold uppercase tracking-widest px-4 py-1.5 rounded-full border border-zinc-300 dark:border-zinc-700 text-neutral-600 dark:text-neutral-400 mb-6">
          {eyebrow}
        </span>
      )}
      <h2 class="text-4xl md:text-5xl font-bold mb-4">{heading}</h2>
      {description && <p class="text-lg text-neutral-600 dark:text-neutral-400">{description}</p>}
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {projects.map((project) => (
        <div class="group relative aspect-4/3 overflow-hidden rounded-2xl bg-zinc-200 dark:bg-zinc-800">
          <img 
            src={project.image.src} 
            alt={project.image.alt}
            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
            loading="lazy"
          />
          {/* Hover Overlay */}
          <div class="absolute inset-0 bg-linear-to-t from-zinc-950/90 via-zinc-950/40 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex flex-col justify-end p-6">
            <span class="text-accent text-xs font-bold uppercase tracking-wider mb-1">{project.category}</span>
            <h3 class="text-xl font-bold text-white">{project.title}</h3>
            {project.metric && <p class="text-white/70 text-sm mt-1">{project.metric}</p>}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
