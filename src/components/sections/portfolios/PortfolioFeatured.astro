---
/**
 * PortfolioFeatured — Featured + Grid
 * One large hero image at top, smaller grid below.
 */
import type { PortfolioData } from '../../../data/sample-data';

interface Props { data: PortfolioData; }

const { data } = Astro.props;
const { eyebrow, heading, description, projects } = data;

const featured = projects[0];
const gridProjects = projects.slice(1);
---

<section class="py-20 md:py-32">
  <div class="container mx-auto px-4 md:px-8">
    <div class="text-center max-w-2xl mx-auto mb-16">
      {eyebrow && (
        <span class="inline-flex items-center text-xs font-bold uppercase tracking-widest px-4 py-1.5 rounded-full border border-zinc-300 dark:border-zinc-700 text-neutral-600 dark:text-neutral-400 mb-6">
          {eyebrow}
        </span>
      )}
      <h2 class="text-4xl md:text-5xl font-bold mb-4">{heading}</h2>
      {description && <p class="text-lg text-neutral-600 dark:text-neutral-400">{description}</p>}
    </div>

    {/* Featured Project */}
    {featured && (
      <div class="group relative aspect-21/9 overflow-hidden rounded-2xl mb-6">
        <img 
          src={featured.image.src} 
          alt={featured.image.alt}
          class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
          loading="lazy"
        />
        <div class="absolute inset-0 bg-linear-to-t from-zinc-950/80 via-transparent to-transparent" />
        <div class="absolute bottom-0 left-0 right-0 p-6 md:p-10">
          <span class="inline-block px-3 py-1 rounded-full bg-accent text-white text-xs font-bold uppercase tracking-wider mb-3">
            Featured
          </span>
          <span class="text-white/70 text-sm ml-2">{featured.category}</span>
          <h3 class="text-2xl md:text-4xl font-bold text-white mb-2">{featured.title}</h3>
          {featured.description && <p class="text-white/80 max-w-xl">{featured.description}</p>}
        </div>
      </div>
    )}

    {/* Grid Projects */}
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {gridProjects.map((project) => (
        <div class="group relative aspect-video overflow-hidden rounded-xl bg-zinc-200 dark:bg-zinc-800">
          <img 
            src={project.image.src} 
            alt={project.image.alt}
            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-zinc-950/70 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex flex-col justify-end p-5">
            <span class="text-accent text-xs font-bold uppercase tracking-wider">{project.category}</span>
            <h3 class="text-lg font-bold text-white">{project.title}</h3>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
