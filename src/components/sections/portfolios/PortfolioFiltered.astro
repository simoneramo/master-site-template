---
/**
 * PortfolioFiltered — Filtered Gallery
 * Category filter pills at top, grid filters with smooth transitions.
 */
import type { PortfolioData } from '../../../data/sample-data';

interface Props { data: PortfolioData; }

const { data } = Astro.props;
const { eyebrow, heading, description, categories, projects } = data;

// Default categories if none provided
const filterCategories = categories || ['All', ...new Set(projects.map(p => p.category))];
---

<section class="py-20 md:py-32">
  <div class="container mx-auto px-4 md:px-8">
    <div class="text-center max-w-2xl mx-auto mb-12">
      {eyebrow && (
        <span class="inline-flex items-center text-xs font-bold uppercase tracking-widest px-4 py-1.5 rounded-full border border-zinc-300 dark:border-zinc-700 text-neutral-600 dark:text-neutral-400 mb-6">
          {eyebrow}
        </span>
      )}
      <h2 class="text-4xl md:text-5xl font-bold mb-4">{heading}</h2>
      {description && <p class="text-lg text-neutral-600 dark:text-neutral-400">{description}</p>}
    </div>

    <!-- Alpine.js Filter -->
    <div x-data="{ filter: 'All' }">
      {/* Filter Pills */}
      <div class="flex flex-wrap justify-center gap-2 mb-12">
        {filterCategories.map((category) => (
          <button
            @click={`filter = '${category}'`}
            class="px-5 py-2 rounded-full font-bold text-sm transition-all"
            :class={`filter === '${category}' ? 'bg-zinc-950 text-white dark:bg-white dark:text-black' : 'bg-surface dark:bg-zinc-900 border-2 border-zinc-200 dark:border-zinc-800 hover:border-zinc-400 dark:hover:border-zinc-600'`}
          >
            {category}
          </button>
        ))}
      </div>

      {/* Filtered Grid */}
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {projects.map((project) => (
          <div
            x-show={`filter === 'All' || filter === '${project.category}'`}
            x-transition:enter="transition ease-out duration-300"
            x-transition:enter-start="opacity-0 scale-95"
            x-transition:enter-end="opacity-100 scale-100"
            x-transition:leave="transition ease-in duration-200"
            x-transition:leave-start="opacity-100 scale-100"
            x-transition:leave-end="opacity-0 scale-95"
            class="group relative aspect-4/3 overflow-hidden rounded-2xl bg-zinc-200 dark:bg-zinc-800"
            x-cloak
          >
            <img 
              src={project.image.src} 
              alt={project.image.alt}
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-zinc-950/70 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex flex-col justify-end p-6">
              <span class="text-accent text-xs font-bold uppercase tracking-wider">{project.category}</span>
              <h3 class="text-xl font-bold text-white">{project.title}</h3>
              {project.metric && <p class="text-white/70 text-sm mt-1">{project.metric}</p>}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
