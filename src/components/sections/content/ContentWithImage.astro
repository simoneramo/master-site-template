---
/**
 * ContentWithImage — Prose with Image
 * A two-column marketing layout with a sticky featured image and rolling rich text.
 */
import type { ContentData } from '../../../data/sample-data';

interface Props { data: ContentData; }
const { data } = Astro.props;
const { eyebrow, heading, description, body, image } = data;
---

<section class="py-24 bg-white dark:bg-zinc-950">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-7xl">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16">

      <!-- Left side: Image -->
      <div class="lg:col-span-5 relative">
        {image && (
          <div class="sticky top-32 rounded-2xl overflow-hidden aspect-4/5 md:aspect-square lg:aspect-auto lg:h-150 shadow-xl">
            <img src={image.src} alt={image.alt || heading} class="w-full h-full object-cover" />
          </div>
        )}
      </div>
      
      <!-- Right side: Content -->
      <div class="lg:col-span-7 lg:py-12">
        <div class="mb-10">
          {eyebrow && <span class="text-accent font-bold tracking-wider uppercase text-sm mb-4 block">{eyebrow}</span>}
          <h2 class="text-3xl md:text-5xl font-bold tracking-tight text-neutral-900 dark:text-white mb-6">
            {heading}
          </h2>
          {description && (
            <p class="text-lg md:text-xl text-neutral-600 dark:text-neutral-400">
              {description}
            </p>
          )}
        </div>
        
        <div class="prose prose-lg dark:prose-invert prose-zinc max-w-none" set:html={body} />
      </div>

    </div>
  </div>
</section>
