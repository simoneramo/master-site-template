---
/**
 * ContentSplit — Split Layout Content
 * A two-column layout with heading on the left and rich text on the right.
 */
import type { ContentData } from '../../../data/sample-data';

interface Props { data: ContentData; }
const { data } = Astro.props;
const { eyebrow, heading, description, body } = data;
---

<section class="py-24 bg-white dark:bg-zinc-950">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-7xl">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8">
      <div class="lg:col-span-5 lg:pr-8">
        <div class="sticky top-32">
          {eyebrow && <span class="text-accent font-bold tracking-wider uppercase text-sm mb-4 block">{eyebrow}</span>}
          <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-neutral-900 dark:text-white mb-6">
            {heading}
          </h2>
          {description && (
            <p class="text-lg text-neutral-600 dark:text-neutral-400">
              {description}
            </p>
          )}
        </div>
      </div>
      <div class="lg:col-span-7">
        <div class="prose prose-lg dark:prose-invert prose-zinc max-w-none" set:html={body} />
      </div>
    </div>
  </div>
</section>
