---
/**
 * ContentHighlight — Boxed Prose Card
 * Centered long-form content set on a tinted card with an author byline
 * at the top. Useful for editorial notes, announcements, or letters.
 */
import type { ContentData } from '../../../data/sample-data';

interface Props { data: ContentData; }
const { data } = Astro.props;
const { eyebrow, heading, description, body, author } = data;
---

<section class="py-24 bg-neutral-50 dark:bg-zinc-900">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-3xl">
    <div class="bg-white dark:bg-zinc-950 border border-zinc-200 dark:border-zinc-800 rounded-3xl shadow-sm p-8 md:p-14">
      <div class="text-center mb-12">
        {eyebrow && (
          <span class="text-accent font-bold tracking-wider uppercase text-sm mb-4 block">{eyebrow}</span>
        )}
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-neutral-900 dark:text-white mb-6">
          {heading}
        </h2>
        {description && (
          <p class="text-lg text-neutral-600 dark:text-neutral-400 max-w-2xl mx-auto">{description}</p>
        )}

        {author && (
          <div class="flex items-center justify-center gap-3 mt-8 pt-8 border-t border-zinc-200 dark:border-zinc-800">
            {author.photo && (
              <img src={author.photo} alt={author.name} class="w-10 h-10 rounded-full object-cover" loading="lazy" />
            )}
            <div class="text-left">
              <div class="font-bold text-sm">{author.name}</div>
              <div class="text-xs text-neutral-500 dark:text-neutral-400">
                {author.role}{author.date ? ` · ${author.date}` : ''}
              </div>
            </div>
          </div>
        )}
      </div>

      <div class="prose prose-lg dark:prose-invert prose-zinc mx-auto" set:html={body} />
    </div>
  </div>
</section>
