---
/**
 * TestimonialsReviewGrid — Aggregate Rating + Review Cards
 * A platform-review style layout: an aggregate star rating and review
 * count up top, then a grid of individual review cards with avatar,
 * name, role/company, per-review stars, and the quote.
 */
import type { TestimonialsData } from '../../../data/sample-data';

interface Props { data: TestimonialsData; }

const { data } = Astro.props;
const {
  eyebrow,
  heading,
  testimonials = [],
  averageRating = 5,
  totalReviews = 0,
} = data;
---

<section class="py-20 md:py-32 bg-white dark:bg-black">
  <div class="container mx-auto px-4 md:px-8 max-w-7xl">
    <div class="text-center mb-16">
      {eyebrow && (
        <span class="inline-flex items-center text-xs font-bold uppercase tracking-widest px-4 py-1.5 rounded-full border border-zinc-300 dark:border-zinc-700 text-neutral-600 dark:text-neutral-400 mb-6">
          {eyebrow}
        </span>
      )}
      <h2 class="text-4xl md:text-5xl font-bold mb-6">{heading}</h2>

      <div class="flex flex-wrap justify-center items-center gap-2">
        <span class="text-xl font-bold">{averageRating.toFixed(1)}</span>
        <div class="flex text-yellow-400 text-lg">
          {Array.from({ length: 5 }).map((_, i) => (
            <span>{i < Math.round(averageRating) ? '★' : '☆'}</span>
          ))}
        </div>
        {totalReviews > 0 && (
          <span class="text-sm font-medium text-neutral-500 dark:text-neutral-400">
            based on {totalReviews.toLocaleString()} reviews
          </span>
        )}
      </div>
    </div>

    {testimonials.length > 0 && (
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {testimonials.map((review) => (
          <div class="p-8 border-2 border-zinc-200 dark:border-zinc-700 rounded-xl bg-white dark:bg-black flex flex-col">
            <div class="flex items-center gap-4 mb-6">
              <div class="w-12 h-12 rounded-full bg-zinc-200 dark:bg-zinc-800 overflow-hidden shrink-0">
                {review.photo && (
                  <img src={review.photo} alt={review.name} class="w-full h-full object-cover" loading="lazy" />
                )}
              </div>
              <div class="min-w-0">
                <h3 class="font-bold leading-tight truncate">{review.name}</h3>
                <div class="text-xs text-neutral-500 dark:text-neutral-400 truncate">
                  {[review.title, review.company].filter(Boolean).join(', ')}
                </div>
              </div>
              {review.platform && (
                <span class="ml-auto text-[10px] font-bold uppercase tracking-wider text-neutral-400 dark:text-neutral-500 shrink-0">
                  {review.platform}
                </span>
              )}
            </div>

            {review.rating && (
              <div class="flex text-yellow-400 mb-4 text-lg">
                {Array.from({ length: 5 }).map((_, i) => (
                  <span>{i < (review.rating ?? 0) ? '★' : '☆'}</span>
                ))}
              </div>
            )}

            <p class="leading-relaxed font-medium text-neutral-700 dark:text-neutral-300 grow">
              &ldquo;{review.quote}&rdquo;
            </p>
          </div>
        ))}
      </div>
    )}
  </div>
</section>
