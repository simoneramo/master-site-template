---
/**
 * TestimonialsFeatured — Single Featured
 * One large centered testimonial with decorative quote marks and photo.
 */
import type { TestimonialsData } from '../../../data/sample-data';

interface Props { data: TestimonialsData; }

const { data } = Astro.props;
const { eyebrow, heading, description, testimonials } = data;

// Use first testimonial as featured
const featured = testimonials[0];


---

<section class="py-20 md:py-32 bg-surface dark:bg-zinc-900/50">
  <div class="container mx-auto px-4 md:px-8">
    <div class="text-center max-w-2xl mx-auto mb-16">
      {eyebrow && (
        <span class="inline-flex items-center text-xs font-bold uppercase tracking-widest px-4 py-1.5 rounded-full border border-zinc-300 dark:border-zinc-700 text-neutral-600 dark:text-neutral-400 mb-6">
          {eyebrow}
        </span>
      )}
      <h2 class="text-4xl md:text-5xl font-bold mb-4">{heading}</h2>
      {description && <p class="text-lg text-neutral-600 dark:text-neutral-400">{description}</p>}
    </div>

    {featured && (
      <div class="max-w-4xl mx-auto text-center">
        {/* Large Quote Mark */}
        <div class="text-8xl text-zinc-200 dark:text-zinc-800 font-serif leading-none mb-6">"</div>
        
        {/* Stars */}
        <div class="flex justify-center gap-1 mb-8">
          {Array(5).fill(0).map((_, i) => (
            <svg 
              class={`w-6 h-6 ${i < (featured.rating || 5) ? 'text-amber-400' : 'text-zinc-300 dark:text-zinc-700'}`}
              fill="currentColor" 
              viewBox="0 0 20 20"
            >
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
            </svg>
          ))}
        </div>
        
        {/* Quote */}
        <blockquote class="text-2xl md:text-3xl lg:text-4xl font-medium leading-relaxed mb-10">
          {featured.quote}
        </blockquote>
        
        {/* Author */}
        <div class="flex flex-col items-center gap-4">
          {featured.photo ? (
            <img 
              src={featured.photo} 
              alt={featured.name}
              class="w-20 h-20 rounded-full object-cover ring-4 ring-zinc-200 dark:ring-zinc-800"
            />
          ) : (
            <div class="w-20 h-20 rounded-full bg-zinc-200 dark:bg-zinc-800 flex items-center justify-center font-bold text-2xl ring-4 ring-zinc-200 dark:ring-zinc-800">
              {featured.name.charAt(0)}
            </div>
          )}
          <div>
            <p class="font-bold text-lg">{featured.name}</p>
            <p class="text-neutral-600 dark:text-neutral-400">
              {featured.title}{featured.company && `, ${featured.company}`}
            </p>
          </div>
        </div>
      </div>
    )}
  </div>
</section>
