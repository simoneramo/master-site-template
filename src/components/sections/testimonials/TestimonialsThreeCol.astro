---
/**
 * TestimonialsThreeCol — 3-Column Cards
 * Three cards with star rating, quote, customer name, and optional avatar.
 */
import type { TestimonialsData } from '../../../data/sample-data';

interface Props { data: TestimonialsData; }

const { data } = Astro.props;
const { eyebrow, heading, description, testimonials } = data;


---

<section class="py-20 md:py-32">
  <div class="container mx-auto px-4 md:px-8">
    <div class="text-center max-w-2xl mx-auto mb-16">
      {eyebrow && (
        <span class="inline-flex items-center text-xs font-bold uppercase tracking-widest px-4 py-1.5 rounded-full border border-zinc-300 dark:border-zinc-700 text-neutral-600 dark:text-neutral-400 mb-6">
          {eyebrow}
        </span>
      )}
      <h2 class="text-4xl md:text-5xl font-bold mb-4">{heading}</h2>
      {description && <p class="text-lg text-neutral-600 dark:text-neutral-400">{description}</p>}
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
      {testimonials.slice(0, 6).map((testimonial) => (
        <div class="bg-surface dark:bg-zinc-900/50 rounded-2xl p-6 lg:p-8 border-2 border-zinc-200 dark:border-zinc-800">
          {/* Stars */}
          <div class="flex gap-1 mb-6">
            {Array(5).fill(0).map((_, i) => (
              <svg 
                class={`w-5 h-5 ${i < (testimonial.rating || 5) ? 'text-amber-400' : 'text-zinc-300 dark:text-zinc-700'}`}
                fill="currentColor" 
                viewBox="0 0 20 20"
              >
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
              </svg>
            ))}
          </div>
          
          {/* Quote */}
          <blockquote class="text-lg mb-6 leading-relaxed">
            "{testimonial.quote}"
          </blockquote>
          
          {/* Author */}
          <div class="flex items-center gap-4">
            {testimonial.photo ? (
              <img 
                src={testimonial.photo} 
                alt={testimonial.name}
                class="w-12 h-12 rounded-full object-cover"
              />
            ) : (
              <div class="w-12 h-12 rounded-full bg-zinc-200 dark:bg-zinc-800 flex items-center justify-center font-bold text-lg">
                {testimonial.name.charAt(0)}
              </div>
            )}
            <div>
              <p class="font-bold">{testimonial.name}</p>
              <p class="text-sm text-neutral-600 dark:text-neutral-400">
                {testimonial.title}{testimonial.company && `, ${testimonial.company}`}
              </p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
