---
/**
 * TestimonialsRatingBreakdown — Rating Breakdown
 * Large average rating with bar chart breakdown and quote snippets.
 */
import type { TestimonialsData } from '../../../data/sample-data';

interface Props { data: TestimonialsData; }

const { data } = Astro.props;
const { eyebrow, heading, description, testimonials, averageRating, totalReviews, ratingBreakdown } = data;

// Default rating breakdown if not provided
const defaultBreakdown = [
  { stars: 5, percentage: 87 },
  { stars: 4, percentage: 9 },
  { stars: 3, percentage: 3 },
  { stars: 2, percentage: 1 },
  { stars: 1, percentage: 0 },
];

const breakdown = ratingBreakdown || defaultBreakdown;
const avg = averageRating || 4.9;
const total = totalReviews || 523;
---

<section class="py-20 md:py-32">
  <div class="container mx-auto px-4 md:px-8">
    <div class="text-center max-w-2xl mx-auto mb-16">
      {eyebrow && (
        <span class="inline-flex items-center text-xs font-bold uppercase tracking-widest px-4 py-1.5 rounded-full border border-zinc-300 dark:border-zinc-700 text-neutral-600 dark:text-neutral-400 mb-6">
          {eyebrow}
        </span>
      )}
      <h2 class="text-4xl md:text-5xl font-bold mb-4">{heading}</h2>
      {description && <p class="text-lg text-neutral-600 dark:text-neutral-400">{description}</p>}
    </div>

    <div class="max-w-5xl mx-auto">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-start">
        {/* Rating Summary */}
        <div class="bg-surface dark:bg-zinc-900/50 rounded-2xl p-8 lg:p-10 border-2 border-zinc-200 dark:border-zinc-800">
          {/* Big Rating */}
          <div class="text-center mb-8">
            <div class="text-7xl md:text-8xl font-bold mb-2">{avg}</div>
            <div class="flex justify-center gap-1 mb-3">
              {Array(5).fill(0).map((_, i) => (
                <svg class={`w-6 h-6 ${i < Math.round(avg) ? 'text-amber-400' : 'text-zinc-300 dark:text-zinc-700'}`} fill="currentColor" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                </svg>
              ))}
            </div>
            <p class="text-neutral-600 dark:text-neutral-400">Based on {total.toLocaleString()} reviews</p>
          </div>

          {/* Rating Bars */}
          <div class="space-y-3">
            {breakdown.map((item) => (
              <div class="flex items-center gap-4">
                <span class="text-sm font-bold w-12">{item.stars} star</span>
                <div class="flex-1 h-3 bg-zinc-200 dark:bg-zinc-800 rounded-full overflow-hidden">
                  <div 
                    class="h-full bg-amber-400 rounded-full transition-all duration-1000"
                    style={`width: ${item.percentage}%`}
                  />
                </div>
                <span class="text-sm text-neutral-600 dark:text-neutral-400 w-12 text-right">{item.percentage}%</span>
              </div>
            ))}
          </div>
        </div>

        {/* Recent Reviews */}
        <div>
          <h3 class="text-xl font-bold mb-6">Recent Reviews</h3>
          <div class="space-y-4">
            {testimonials.slice(0, 4).map((testimonial) => (
              <div class="bg-white dark:bg-zinc-950 rounded-xl p-5 border-2 border-zinc-200 dark:border-zinc-800">
                <div class="flex items-start gap-3 mb-3">
                  {testimonial.photo ? (
                    <img 
                      src={testimonial.photo} 
                      alt={testimonial.name}
                      class="w-10 h-10 rounded-full object-cover shrink-0"
                    />
                  ) : (
                    <div class="w-10 h-10 rounded-full bg-zinc-200 dark:bg-zinc-800 flex items-center justify-center font-bold text-sm shrink-0">
                      {testimonial.name.charAt(0)}
                    </div>
                  )}
                  <div class="flex-1 min-w-0">
                    <div class="flex items-center gap-2 flex-wrap">
                      <p class="font-bold text-sm">{testimonial.name}</p>
                      {testimonial.platform && (
                        <span class="text-xs px-2 py-0.5 rounded-full bg-zinc-100 dark:bg-zinc-800 text-neutral-600 dark:text-neutral-400">
                          {testimonial.platform}
                        </span>
                      )}
                    </div>
                    <div class="flex gap-0.5">
                      {Array(5).fill(0).map((_, i) => (
                        <svg class={`w-3 h-3 ${i < (testimonial.rating || 5) ? 'text-amber-400' : 'text-zinc-300 dark:text-zinc-700'}`} fill="currentColor" viewBox="0 0 20 20">
                          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                        </svg>
                      ))}
                    </div>
                  </div>
                </div>
                <blockquote class="text-sm text-neutral-700 dark:text-neutral-300 line-clamp-2">
                  "{testimonial.quote}"
                </blockquote>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
