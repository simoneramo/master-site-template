---
interface Props {
    data?: {
        sectionLabel?: string;
        heading?: string;
        description?: string;
        items: {
            rating: number;
            quote: string;
            authorName: string;
            authorTitle: string;
        }[];
    };
}

let { data } = Astro.props;
---

{
    data && (
        <section class="py-20 bg-white dark:bg-black overflow-hidden">
            <div class="px-8 mb-12 text-center">
                {data.sectionLabel && (
                    <p class="text-xs font-bold uppercase tracking-widest text-black dark:text-white mb-4">
                        {data.sectionLabel}
                    </p>
                )}
                {data.heading && <h2 class="text-5xl font-bold mb-4">{data.heading}</h2>}
                {data.description && (
                    <p class="text-lg text-neutral-600 dark:text-zinc-400 max-w-3xl font-medium mx-auto">
                        {data.description}
                    </p>
                )}
            </div>

            <div class="relative w-full overflow-hidden group">
                <div
                    class="flex animate-scroll hover:[animation-play-state:paused] gap-8 w-max"
                >
                    {
                        /* Create 4 sets of testimonials to ensure smooth infinite scroll even on wide screens */
                        [...Array(4)].map(() => (
                            <div class="flex gap-8 shrink-0">
                                {data?.items?.map(
                                    (t: any, index: number) => {
                                        const colors = [
                                            "bg-blue-200 text-blue-800 dark:bg-blue-900/40 dark:text-blue-300",
                                            "bg-emerald-200 text-emerald-800 dark:bg-emerald-900/40 dark:text-emerald-300",
                                            "bg-amber-200 text-amber-800 dark:bg-amber-900/40 dark:text-amber-300",
                                            "bg-purple-200 text-purple-800 dark:bg-purple-900/40 dark:text-purple-300",
                                            "bg-pink-200 text-pink-800 dark:bg-pink-900/40 dark:text-pink-300",
                                            "bg-rose-200 text-rose-800 dark:bg-rose-900/40 dark:text-rose-300",
                                            "bg-indigo-200 text-indigo-800 dark:bg-indigo-900/40 dark:text-indigo-300",
                                        ];
                                        const colorClass = colors[index % colors.length];
                                        const names = t.authorName ? t.authorName.split(" ") : ["?"];
                                        const initials = names.length > 1 
                                            ? (names[0][0] + names[names.length - 1][0]).toUpperCase() 
                                            : names[0][0].toUpperCase();

                                        return (
                                            <div class="w-[400px] shrink-0 bg-white dark:bg-zinc-900/50 p-8 rounded-xl border-2 border-stone-200 dark:border-zinc-800">
                                                <div class="flex gap-1 mb-4 text-yellow-500">
                                                    {Array.from({
                                                        length: t.rating,
                                                    }).map(() => (
                                                        <svg
                                                            class="w-5 h-5 fill-current"
                                                            viewBox="0 0 20 20"
                                                        >
                                                            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                                                        </svg>
                                                    ))}
                                                </div>
                                                <p class="text-lg font-medium mb-6 line-clamp-4">
                                                    "{t.quote}"
                                                </p>
                                                <div class="flex items-center gap-4 mt-auto">
                                                    <div
                                                        class={`w-12 h-12 flex items-center justify-center rounded-full font-bold text-lg ${colorClass}`}
                                                    >
                                                        {initials}
                                                    </div>
                                                    <div>
                                                        <div class="font-bold text-lg dark:text-white">
                                                            {t.authorName}
                                                        </div>
                                                        <div class="text-sm font-medium text-neutral-500 dark:text-neutral-400">
                                                            {t.authorTitle}
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        );
                                    },
                                )}
                            </div>
                        ))
                    }
                </div>
            </div>

            <style>
                @keyframes scroll {
                    0% {
                        transform: translateX(0);
                    }
                    100% {
                        transform: translateX(-50%);
                    }
                }
                .animate-scroll {
                    animation: scroll 40s linear infinite;
                }
            </style>
        </section>
    )
}
