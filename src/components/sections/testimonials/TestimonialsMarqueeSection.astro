---
/**
 * TestimonialsMarqueeSection — Scrolling Marquee
 * Infinite horizontal scroll of testimonial cards with pause on hover.
 */
import type { TestimonialsData } from "../../../data/sample-data";

interface Props {
  data: TestimonialsData;
}

const { data } = Astro.props;
const { eyebrow, heading, description, testimonials } = data;

// Generate avatar initials from name
function getInitials(name: string): string {
  const names = name ? name.split(" ") : ["?"];
  const initials =
    names.length > 1
      ? (names[0][0] + names[names.length - 1][0]).toUpperCase()
      : names[0][0].toUpperCase();
  return initials;
}

// Avatar background colors (matching the original)
const avatarColors = [
  "bg-blue-200 text-blue-800 dark:bg-blue-900/40 dark:text-blue-300",
  "bg-emerald-200 text-emerald-800 dark:bg-emerald-900/40 dark:text-emerald-300",
  "bg-amber-200 text-amber-800 dark:bg-amber-900/40 dark:text-amber-300",
  "bg-purple-200 text-purple-800 dark:bg-purple-900/40 dark:text-purple-300",
  "bg-pink-200 text-pink-800 dark:bg-pink-900/40 dark:text-pink-300",
  "bg-rose-200 text-rose-800 dark:bg-rose-900/40 dark:text-rose-300",
  "bg-indigo-200 text-indigo-800 dark:bg-indigo-900/40 dark:text-indigo-300",
];
---

<section class="py-20 md:py-32 overflow-hidden">
  <div class="container mx-auto px-4 md:px-8">
    <div class="text-center max-w-2xl mx-auto mb-16">
      {
        eyebrow && (
          <span class="inline-flex items-center text-xs font-bold uppercase tracking-widest px-4 py-1.5 rounded-full border border-zinc-300 dark:border-zinc-700 text-neutral-600 dark:text-neutral-400 mb-6">
            {eyebrow}
          </span>
        )
      }
      <h2 class="text-4xl md:text-5xl font-bold mb-4">{heading}</h2>
      {
        description && (
          <p class="text-lg text-neutral-600 dark:text-neutral-400">
            {description}
          </p>
        )
      }
    </div>
  </div>

  {/* Marquee Container */}
  <div class="relative w-full overflow-hidden group">
    <div
      class="flex animate-scroll hover:[animation-play-state:paused] gap-8 w-max"
    >
      {
        /* Create 4 sets of testimonials to ensure smooth infinite scroll even on wide screens */
      }
      {
        [...Array(4)].map(() => (
          <div class="flex gap-8 shrink-0">
            {testimonials?.map((t, index) => {
              const colorClass = avatarColors[index % avatarColors.length];
              const initials = getInitials(t.name);
              const authorTitle = t.title
                ? t.company
                  ? `${t.title}, ${t.company}`
                  : t.title
                : t.company || "";

              return (
                <div class="w-[400px] shrink-0 bg-surface dark:bg-zinc-900/50 p-8 rounded-2xl border-2 border-zinc-200 dark:border-zinc-800">
                  {/* Stars */}
                  <div class="flex gap-1 mb-4 text-amber-400">
                    {Array.from({ length: t.rating || 5 }).map(() => (
                      <svg class="w-5 h-5 fill-current" viewBox="0 0 20 20">
                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                      </svg>
                    ))}
                  </div>

                  {/* Quote */}
                  <p class="text-lg font-medium mb-6 line-clamp-4">
                    "{t.quote}"
                  </p>

                  {/* Author */}
                  <div class="flex items-center gap-4 mt-auto">
                    {t.photo ? (
                      <img
                        src={t.photo}
                        alt={t.name}
                        class="w-12 h-12 rounded-full object-cover"
                      />
                    ) : (
                      <div
                        class={`w-12 h-12 flex items-center justify-center rounded-full font-bold text-lg ${colorClass}`}
                      >
                        {initials}
                      </div>
                    )}
                    <div>
                      <p class="font-bold text-lg dark:text-white">{t.name}</p>
                      <p class="text-sm font-medium text-neutral-500 dark:text-neutral-400">
                        {authorTitle}
                      </p>
                    </div>
                  </div>
                </div>
              );
            })}
          </div>
        ))
      }
    </div>
  </div>

  <style>
    @keyframes scroll {
      0% {
        transform: translateX(0);
      }
      100% {
        transform: translateX(-50%);
      }
    }
    .animate-scroll {
      animation: scroll 90s linear infinite;
    }
  </style>
</section>
