---
/**
 * PricingTwoCol — 2-Plan Comparison
 * Two plans side by side with optional feature comparison table below.
 */
import type { PricingData } from '../../../data/sample-data';

interface Props { data: PricingData; }

const { data } = Astro.props;
const { eyebrow, heading, description, tiers } = data;

// Use first 2 tiers for the comparison
const displayTiers = tiers.slice(0, 2);
const allFeatures = [...new Set(tiers.flatMap(t => t.features.map(f => f.text)))];
---

<section class="py-20 md:py-32">
  <div class="container mx-auto px-4 md:px-8">
    <div class="text-center max-w-2xl mx-auto mb-16">
      {eyebrow && (
        <span class="inline-flex items-center text-xs font-bold uppercase tracking-widest px-4 py-1.5 rounded-full border border-zinc-300 dark:border-zinc-700 text-neutral-600 dark:text-neutral-400 mb-6">
          {eyebrow}
        </span>
      )}
      <h2 class="text-4xl md:text-5xl font-bold mb-4">{heading}</h2>
      {description && <p class="text-lg text-neutral-600 dark:text-neutral-400">{description}</p>}
    </div>

    <!-- Two Plan Cards -->
    <div class="grid md:grid-cols-2 gap-6 lg:gap-8 max-w-4xl mx-auto mb-16">
      {displayTiers.map((tier, index) => (
        <div 
          class:list={[
            "relative flex flex-col rounded-2xl p-8 lg:p-10 transition-all",
            index === 1
              ? "bg-zinc-950 text-white dark:bg-white dark:text-black shadow-xl"
              : "bg-white dark:bg-zinc-950 border-2 border-zinc-200 dark:border-zinc-800"
          ]}
        >
          <div class="mb-6">
            <h3 class="text-2xl font-bold mb-3">{tier.name}</h3>
            <p class:list={[
              "text-base",
              index === 1 ? "text-white/70 dark:text-black/60" : "text-neutral-600 dark:text-neutral-400"
            ]}>
              {tier.description}
            </p>
          </div>

          <div class="mb-8">
            <span class="text-6xl font-bold">{tier.price}</span>
            <span class:list={[
              "text-lg",
              index === 1 ? "text-white/60 dark:text-black/50" : "text-neutral-500 dark:text-neutral-500"
            ]}>{tier.period}</span>
          </div>

          <ul class="space-y-4 mb-10 flex-1">
            {tier.features.slice(0, 5).map((feature) => (
              <li class="flex items-start gap-3">
                <span class:list={[
                  "shrink-0 w-5 h-5 rounded-full flex items-center justify-center text-sm",
                  index === 1 ? "bg-white text-black dark:bg-black dark:text-white" : "bg-zinc-950 text-white dark:bg-white dark:text-black"
                ]}>
                  ✓
                </span>
                <span class:list={[
                  "text-base",
                  index === 1 ? "text-white/90 dark:text-black/90" : "text-neutral-700 dark:text-neutral-300"
                ]}>
                  {feature.text}
                </span>
              </li>
            ))}
          </ul>

          <a 
            href={tier.cta.url}
            class:list={[
              "inline-flex items-center justify-center h-16 px-10 font-bold rounded-lg transition-all text-lg",
              index === 1
                ? "bg-white text-black dark:bg-black dark:text-white hover:bg-zinc-100 dark:hover:bg-zinc-900"
                : "bg-zinc-950 text-white dark:bg-white dark:text-black hover:bg-zinc-800 dark:hover:bg-zinc-200"
            ]}
          >
            {tier.cta.text}
          </a>
        </div>
      ))}
    </div>

    <!-- Feature Comparison Table -->
    <div class="max-w-4xl mx-auto">
      <h3 class="text-xl font-bold text-center mb-8">Compare Features</h3>
      <div class="border-2 border-zinc-200 dark:border-zinc-800 rounded-xl overflow-hidden">
        <table class="w-full">
          <thead>
            <tr class="border-b-2 border-zinc-200 dark:border-zinc-800 bg-surface dark:bg-zinc-900/50">
              <th class="text-left py-4 px-6 font-bold text-neutral-600 dark:text-neutral-400">Feature</th>
              {displayTiers.map(tier => (
                <th class="text-center py-4 px-6 font-bold">{tier.name}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {allFeatures.slice(0, 7).map((featureText, i) => (
              <tr class="border-b border-zinc-200 dark:border-zinc-800 last:border-b-0">
                <td class="py-4 px-6 font-medium">{featureText}</td>
                {displayTiers.map(tier => {
                  const feature = tier.features.find(f => f.text === featureText);
                  const included = feature?.included ?? false;
                  return (
                    <td class="text-center py-4 px-6">
                      {included ? (
                        <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-zinc-950 text-white dark:bg-white dark:text-black text-sm">✓</span>
                      ) : (
                        <span class="text-neutral-300 dark:text-neutral-600">×</span>
                      )}
                    </td>
                  );
                })}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>
