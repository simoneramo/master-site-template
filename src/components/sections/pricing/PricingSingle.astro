---
/**
 * PricingSingle — Single Plan
 * One centered plan card with feature checklist and CTA.
 */
import type { PricingData } from '../../../data/sample-data';

interface Props { data: PricingData; }

const { data } = Astro.props;
const { eyebrow, heading, description, tiers } = data;

// Use first tier or recommended tier for single display
const tier = tiers.find(t => t.recommended) || tiers[0];
---

<section class="py-20 md:py-32">
  <div class="container mx-auto px-4 md:px-8">
    <div class="max-w-xl mx-auto">
      <!-- Header -->
      <div class="text-center mb-12">
        {eyebrow && (
          <span class="inline-flex items-center text-xs font-bold uppercase tracking-widest px-4 py-1.5 rounded-full border border-zinc-300 dark:border-zinc-700 text-neutral-600 dark:text-neutral-400 mb-6">
            {eyebrow}
          </span>
        )}
        <h2 class="text-4xl md:text-5xl font-bold mb-4">{heading}</h2>
        {description && <p class="text-lg text-neutral-600 dark:text-neutral-400">{description}</p>}
      </div>

      <!-- Single Plan Card -->
      <div class="bg-zinc-950 text-white dark:bg-white dark:text-black rounded-2xl p-8 lg:p-12 shadow-2xl">
        <div class="text-center mb-8">
          <h3 class="text-2xl font-bold mb-2">{tier.name}</h3>
          <p class="text-white/70 dark:text-black/60">{tier.description}</p>
        </div>

        <div class="text-center mb-10">
          <span class="text-6xl md:text-7xl font-bold">{tier.price}</span>
          <span class="text-lg text-white/60 dark:text-black/50">{tier.period}</span>
        </div>

        <a 
          href={tier.cta.url}
          class="block w-full text-center h-16 px-10 font-bold bg-white text-black dark:bg-black dark:text-white rounded-lg hover:bg-zinc-100 dark:hover:bg-zinc-900 transition-all text-lg mb-10"
        >
          {tier.cta.text}
        </a>

        <div class="border-t border-white/20 dark:border-black/20 pt-10">
          <p class="text-sm font-bold uppercase tracking-wider text-white/50 dark:text-black/50 mb-6 text-center">
            What's included
          </p>
          <ul class="space-y-4">
            {tier.features.map((feature) => (
              <li class="flex items-start gap-4">
                <span class:list={[
                  "shrink-0 w-6 h-6 rounded-full flex items-center justify-center text-sm",
                  feature.included 
                    ? "bg-white text-black dark:bg-black dark:text-white"
                    : "bg-white/10 text-white/30 dark:bg-black/10 dark:text-black/30"
                ]}>
                  {feature.included ? '✓' : '×'}
                </span>
                <span class:list={[
                  feature.included 
                    ? "text-white/90 dark:text-black/90"
                    : "text-white/40 dark:text-black/40 line-through"
                ]}>
                  {feature.text}
                </span>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <!-- Trust badges -->
      <div class="flex flex-wrap items-center justify-center gap-6 mt-8 text-sm text-neutral-500 dark:text-neutral-400">
        <span class="flex items-center gap-1.5">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
          </svg>
          Secure payment
        </span>
        <span class="flex items-center gap-1.5">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
          </svg>
          30-day guarantee
        </span>
        <span class="flex items-center gap-1.5">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z"/>
          </svg>
          Cancel anytime
        </span>
      </div>
    </div>
  </div>
</section>
