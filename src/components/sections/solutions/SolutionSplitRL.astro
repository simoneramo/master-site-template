---
/**
 * SolutionSplitRL — Image Left / Copy Right
 * Bright image left, solution text with benefits on right.
 */
import type { SolutionData } from '../../../data/sample-data';

interface Props { data: SolutionData; }

const { data } = Astro.props;
const { eyebrow, heading, description, benefits, image, primaryCta } = data;
---

<section class="py-20 md:py-32">
  <div class="container mx-auto px-4 md:px-8">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      {/* Image */}
      <div>
        {image ? (
          <div class="rounded-2xl overflow-hidden shadow-2xl">
            <img 
              src={image.src} 
              alt={image.alt}
              class="w-full h-auto"
            />
          </div>
        ) : (
          <div class="aspect-square rounded-2xl bg-emerald-100 dark:bg-emerald-900/30 flex items-center justify-center">
            <span class="text-9xl">💡</span>
          </div>
        )}
      </div>

      {/* Content */}
      <div>
        {eyebrow && (
          <span class="inline-flex items-center text-xs font-bold uppercase tracking-widest px-4 py-1.5 rounded-full border border-zinc-300 dark:border-zinc-700 text-neutral-600 dark:text-neutral-400 mb-6">
            {eyebrow}
          </span>
        )}
        <h2 class="text-4xl md:text-5xl font-bold mb-4">{heading}</h2>
        <p class="text-lg text-neutral-600 dark:text-neutral-400 mb-10">{description}</p>

        <div class="space-y-6 mb-10">
          {benefits.map((benefit) => (
            <div class="flex gap-4">
              {benefit.icon && (
                <div class="w-12 h-12 rounded-xl bg-emerald-100 dark:bg-emerald-900/30 text-emerald-600 dark:text-emerald-400 flex items-center justify-center text-2xl shrink-0">
                  {benefit.icon}
                </div>
              )}
              <div>
                <h3 class="text-lg font-bold mb-1">{benefit.heading}</h3>
                <p class="text-neutral-600 dark:text-neutral-400 text-sm">{benefit.description}</p>
              </div>
            </div>
          ))}
        </div>

        {primaryCta && (
          <a 
            href={primaryCta.url}
            class="inline-flex items-center justify-center h-14 px-10 font-bold bg-zinc-950 text-white dark:bg-white dark:text-black rounded-lg hover:bg-zinc-800 dark:hover:bg-zinc-200 transition-all"
          >
            {primaryCta.text}
          </a>
        )}
      </div>
    </div>
  </div>
</section>
