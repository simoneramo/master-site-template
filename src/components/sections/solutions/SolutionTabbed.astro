---
/**
 * SolutionTabbed — Tabbed Solutions
 * Horizontal tabs revealing tailored content per solution aspect.
 */
import type { SolutionData } from '../../../data/sample-data';

interface Props { data: SolutionData; }

const { data } = Astro.props;
const { eyebrow, heading, description, tabs, primaryCta } = data;

// Use tabs if available, otherwise create from benefits
const displayTabs = tabs || data.benefits.map((b, i) => ({
  label: b.heading,
  heading: b.heading,
  description: b.description,
  image: data.image,
}));
---

<section class="py-20 md:py-32">
  <div class="container mx-auto px-4 md:px-8">
    <div class="text-center max-w-2xl mx-auto mb-12">
      {eyebrow && (
        <span class="inline-flex items-center text-xs font-bold uppercase tracking-widest px-4 py-1.5 rounded-full border border-zinc-300 dark:border-zinc-700 text-neutral-600 dark:text-neutral-400 mb-6">
          {eyebrow}
        </span>
      )}
      <h2 class="text-4xl md:text-5xl font-bold mb-4">{heading}</h2>
      <p class="text-lg text-neutral-600 dark:text-neutral-400">{description}</p>
    </div>

    <!-- Alpine.js Tabs -->
    <div x-data="{ activeTab: 0 }" class="max-w-5xl mx-auto">
      {/* Tab Navigation */}
      <div class="flex flex-wrap justify-center gap-2 mb-12">
        {displayTabs.map((tab, index) => (
          <button
            @click={`activeTab = ${index}`}
            class="px-6 py-3 rounded-xl font-bold text-sm transition-all"
            :class={`activeTab === ${index} ? 'bg-zinc-950 text-white dark:bg-white dark:text-black shadow-lg' : 'bg-surface dark:bg-zinc-900 border-2 border-zinc-200 dark:border-zinc-800 hover:border-zinc-400 dark:hover:border-zinc-600'`}
          >
            {tab.label}
          </button>
        ))}
      </div>

      {/* Tab Content */}
      <div class="relative min-h-[400px]">
        {displayTabs.map((tab, index) => (
          <div
            x-show={`activeTab === ${index}`}
            x-transition:enter="transition ease-out duration-300"
            x-transition:enter-start="opacity-0 translate-y-4"
            x-transition:enter-end="opacity-100 translate-y-0"
            x-transition:leave="transition ease-in duration-200"
            x-transition:leave-start="opacity-100 translate-y-0"
            x-transition:leave-end="opacity-0 -translate-y-4"
            class="grid lg:grid-cols-2 gap-8 items-center"
            style={`display: ${index === 0 ? 'grid' : 'none'}`}
            x-cloak
          >
            <div>
              <h3 class="text-3xl font-bold mb-4">{tab.heading}</h3>
              <p class="text-lg text-neutral-600 dark:text-neutral-400 leading-relaxed">
                {tab.description}
              </p>
            </div>
            <div>
              {tab.image ? (
                <div class="rounded-2xl overflow-hidden shadow-xl">
                  <img src={tab.image.src} alt={tab.image.alt} class="w-full h-auto" />
                </div>
              ) : (
                <div class="aspect-square rounded-2xl bg-surface dark:bg-zinc-900 border-2 border-zinc-200 dark:border-zinc-800 flex items-center justify-center">
                  <span class="text-8xl">💡</span>
                </div>
              )}
            </div>
          </div>
        ))}
      </div>

      {primaryCta && (
        <div class="text-center mt-12">
          <a 
            href={primaryCta.url}
            class="inline-flex items-center justify-center h-14 px-10 font-bold bg-zinc-950 text-white dark:bg-white dark:text-black rounded-lg hover:bg-zinc-800 dark:hover:bg-zinc-200 transition-all"
          >
            {primaryCta.text}
          </a>
        </div>
      )}
    </div>
  </div>
</section>
