---
/**
 * SolutionBeforeAfter — Before / After
 * Side-by-side before (muted) and after (vibrant) comparison.
 */
import type { SolutionData } from '../../../data/sample-data';

interface Props { data: SolutionData; }

const { data } = Astro.props;
const { eyebrow, heading, description, benefits, image } = data;

// Use first two benefits as before/after or default
const beforePoint = benefits[0] || { heading: 'Before', description: 'Slow and outdated' };
const afterPoint = benefits[1] || { heading: 'After', description: 'Fast and modern' };
---

<section class="py-20 md:py-32">
  <div class="container mx-auto px-4 md:px-8">
    <div class="text-center max-w-2xl mx-auto mb-16">
      {eyebrow && (
        <span class="inline-flex items-center text-xs font-bold uppercase tracking-widest px-4 py-1.5 rounded-full border border-zinc-300 dark:border-zinc-700 text-neutral-600 dark:text-neutral-400 mb-6">
          {eyebrow}
        </span>
      )}
      <h2 class="text-4xl md:text-5xl font-bold mb-4">{heading}</h2>
      <p class="text-lg text-neutral-600 dark:text-neutral-400">{description}</p>
    </div>

    <div class="grid md:grid-cols-2 gap-8 max-w-5xl mx-auto">
      {/* Before */}
      <div class="relative">
        <div class="absolute -top-4 left-6 px-4 py-1 rounded-full bg-zinc-400 text-white text-sm font-bold">
          BEFORE
        </div>
        <div class="rounded-2xl overflow-hidden bg-zinc-200 dark:bg-zinc-800 opacity-60 grayscale">
          {image ? (
            <img src={image.src} alt="Before" class="w-full h-auto" />
          ) : (
            <div class="aspect-video flex items-center justify-center">
              <span class="text-6xl">😫</span>
            </div>
          )}
        </div>
        <div class="mt-6 p-6 rounded-xl bg-zinc-100 dark:bg-zinc-900/50 border-2 border-zinc-200 dark:border-zinc-800">
          <h3 class="text-xl font-bold mb-2 text-zinc-500">{beforePoint.heading}</h3>
          <p class="text-zinc-500">{beforePoint.description}</p>
        </div>
      </div>

      {/* After */}
      <div class="relative">
        <div class="absolute -top-4 left-6 px-4 py-1 rounded-full bg-emerald-500 text-white text-sm font-bold">
          AFTER
        </div>
        <div class="rounded-2xl overflow-hidden shadow-2xl ring-4 ring-emerald-500/20">
          {image ? (
            <img src={image.src} alt="After" class="w-full h-auto" />
          ) : (
            <div class="aspect-video bg-emerald-50 dark:bg-emerald-900/20 flex items-center justify-center">
              <span class="text-6xl">😍</span>
            </div>
          )}
        </div>
        <div class="mt-6 p-6 rounded-xl bg-emerald-50 dark:bg-emerald-900/20 border-2 border-emerald-200 dark:border-emerald-900">
          <h3 class="text-xl font-bold mb-2 text-emerald-700 dark:text-emerald-400">{afterPoint.heading}</h3>
          <p class="text-emerald-700 dark:text-emerald-400">{afterPoint.description}</p>
        </div>
      </div>
    </div>
  </div>
</section>
