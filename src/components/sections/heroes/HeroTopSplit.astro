---
/**
 * HeroTopSplit — Top Split Layout
 * Pattern key: topSplit
 * Section: Hero
 *
 * Two-row layout:
 * TOP: Headline (left) / Description + CTA (right)
 * BOTTOM: Full-width image with floating card overlay
 */
import type { HeroData } from '../../../data/sample-data';

interface Props {
  data: HeroData;
}

const { data } = Astro.props;
const {
  eyebrow,
  heading,
  headingAccent,
  description,
  primaryCta,
  secondaryCta,
  image,
  trustBadge,
} = data;

// Split heading to highlight accent word(s)
let headingBefore = heading;
let headingAfter = '';
if (headingAccent && heading.includes(headingAccent)) {
  const idx = heading.indexOf(headingAccent);
  headingBefore = heading.slice(0, idx);
  headingAfter = heading.slice(idx + headingAccent.length);
}
---

<section class="min-h-screen flex flex-col py-16 md:py-24">
  <div class="container mx-auto px-4 md:px-8 flex-1 flex flex-col">
    
    <!-- TOP ROW: Headline + Copy -->
    <div class="grid lg:grid-cols-12 gap-8 lg:gap-16 items-start mb-12 lg:mb-16">
      
      <!-- LEFT: Large Headline -->
      <div class="lg:col-span-7">
        {eyebrow && (
          <span class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-neutral-500 dark:text-neutral-400 mb-4">
            <span class="w-1.5 h-1.5 rounded-full bg-indigo-500" />
            {eyebrow}
          </span>
        )}
        
        <h1 class="text-4xl lg:text-5xl xl:text-6xl font-bold leading-tighter max-w-xl">
          {headingAccent ? (
            <>
              {headingBefore}
              <span class="text-indigo-600 dark:text-indigo-500"> {headingAccent}</span>
              {headingAfter}
            </>
          ) : (
            heading
          )}
        </h1>
      </div>
      
      <!-- RIGHT: Description + CTA -->
      <div class="lg:col-span-5 flex flex-col justify-end h-full lg:pt-12">
        <p class="text-lg text-neutral-600 dark:text-neutral-300 leading-relaxed mb-8">
          {description}
        </p>
        
        {primaryCta && (
          <a
            href={primaryCta.url}
            class="inline-flex items-center justify-center h-12 px-8 font-semibold text-white bg-indigo-600 hover:bg-indigo-700 transition-colors rounded-lg w-fit"
          >
            {primaryCta.text}
          </a>
        )}
      </div>
    </div>
    
    <!-- BOTTOM ROW: Full-width Image with Floating Card -->
    <div class="relative flex-1 min-h-[400px] lg:min-h-[500px]">
      {image && (
        <div class="absolute inset-0">
          <img
            src={image.src}
            alt={image.alt}
            class="w-full h-full object-cover rounded-2xl"
            loading="eager"
          />
          
          <!-- Floating Card (bottom left) -->
          {trustBadge && (
            <div class="absolute -bottom-6 left-6 md:bottom-8 md:left-8 bg-white dark:bg-zinc-900 rounded-xl shadow-xl px-6 py-5 max-w-xs border border-zinc-100 dark:border-zinc-800">
              <div class="flex items-center gap-3 mb-2">
                {trustBadge.icon && (
                  <span class="text-2xl">{trustBadge.icon}</span>
                )}
                <span class="font-bold text-lg text-black dark:text-white">{trustBadge.title}</span>
              </div>
              <p class="text-sm text-neutral-600 dark:text-neutral-400">{trustBadge.subtitle}</p>
              
              <!-- Optional secondary CTA in card -->
              {secondaryCta && (
                <a
                  href={secondaryCta.url}
                  class="inline-flex items-center gap-2 mt-4 text-sm font-semibold text-neutral-900 dark:text-white hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors group"
                >
                  {secondaryCta.text}
                  <span class="transform transition-transform duration-200 group-hover:translate-x-1">→</span>
                </a>
              )}
            </div>
          )}
        </div>
      )}
    </div>
    
  </div>
</section>
