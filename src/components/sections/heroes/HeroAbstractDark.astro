---
/**
 * HeroAbstractDark — Dark Abstract Hero
 * Pattern key: abstractDark
 * Section: Hero
 *
 * Dark background with subtle grid and coloured blur blobs.
 */
import type { HeroData } from '../../../data/sample-data';

interface Props {
  data: HeroData;
}

const { data } = Astro.props;
const {
  eyebrow,
  heading,
  description,
  primaryCta,
  secondaryCta,
  trustBadge,
} = data;
---

<section class="bg-black dark:bg-zinc-950 text-white min-h-[85vh] flex items-center relative overflow-hidden">
  <!-- Background texture -->
  <div class="absolute inset-0 opacity-5">
      <div
          class="absolute top-0 left-0 w-full h-full"
          style="background-image: radial-gradient(circle, #fff 1px, transparent 1px); background-size: 32px 32px;"
      ></div>
  </div>
  <!-- Accent blobs -->
  <div class="absolute top-1/4 right-1/4 w-96 h-96 bg-indigo-600/20 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute bottom-1/4 left-1/3 w-64 h-64 bg-purple-600/20 rounded-full blur-3xl pointer-events-none"></div>

  <div class="container mx-auto px-4 md:px-8 relative z-10 py-24 md:py-32">
      {eyebrow && (
          <div class="flex items-center gap-3 mb-8">
              <div class="w-8 h-0.5 bg-indigo-500"></div>
              <span class="text-xs font-bold uppercase tracking-widest text-indigo-400">
                  {eyebrow}
              </span>
          </div>
      )}
      
      <h1
          id="hero-heading"
          class="text-5xl md:text-7xl font-bold mb-8 leading-none tracking-tight max-w-4xl"
      >
          {heading}
      </h1>
      
      <p class="text-xl font-medium mb-12 text-zinc-400 max-w-2xl leading-relaxed">
          {description}
      </p>
      
      <div class="flex flex-col sm:flex-row gap-4">
          {primaryCta && (
              <a
                  href={primaryCta.url}
                  class="group relative inline-flex items-center justify-center overflow-hidden h-16 px-12 font-bold text-black bg-white transition-all duration-300 text-lg rounded-md hover:bg-zinc-100"
              >
                  <span class="transform transition-transform duration-300 group-hover:-translate-x-4">
                      {primaryCta.text}
                  </span>
                  <span class="absolute right-8 transform -translate-x-4 opacity-0 transition-all duration-300 group-hover:translate-x-0 group-hover:opacity-100">
                      &rarr;
                  </span>
              </a>
          )}
          
          {secondaryCta && (
              <a
                  href={secondaryCta.url}
                  class="inline-flex items-center justify-center h-16 px-10 font-bold border-2 border-zinc-700 text-white rounded-md hover:border-white transition-colors"
              >
                  {secondaryCta.text}
              </a>
          )}
      </div>
      
      {trustBadge && (
          <div class="mt-10 flex items-center gap-2 text-sm font-bold text-zinc-500 uppercase tracking-wider">
              {trustBadge.icon && <span>{trustBadge.icon}</span>}
              <span>{trustBadge.title} {trustBadge.subtitle ? `· ${trustBadge.subtitle}` : ''}</span>
          </div>
      )}
  </div>
</section>
