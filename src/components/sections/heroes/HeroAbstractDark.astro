---
/**
 * HeroAbstractDark — Dark Abstract Hero
 * Pattern key: abstractDark
 * Section: Hero
 *
 * Dark background with subtle grid and coloured blur blobs.
 */
import type { HeroData } from '../../../data/sample-data';

interface Props {
  data: HeroData;
}

const { data } = Astro.props;
const {
  eyebrow,
  heading,
  headingAccent,
  description,
  primaryCta,
  secondaryCta,
  trustBadge,
} = data;

// Split heading to highlight accent word(s)
let headingBefore = heading;
let headingAfter = '';
if (headingAccent && heading.includes(headingAccent)) {
  const idx = heading.indexOf(headingAccent);
  headingBefore = heading.slice(0, idx);
  headingAfter = heading.slice(idx + headingAccent.length);
}
---

<section class="bg-black dark:bg-zinc-950 text-white min-h-[85vh] flex items-center relative overflow-hidden">
  <!-- Background texture -->
  <div class="absolute inset-0 opacity-5">
    <div
      class="absolute top-0 left-0 w-full h-full"
      style="background-image: radial-gradient(circle, #fff 1px, transparent 1px); background-size: 32px 32px;"
    />
  </div>
  <!-- Accent blobs -->
  <div class="absolute top-1/4 right-1/4 w-96 h-96 bg-indigo-600/20 rounded-full blur-3xl pointer-events-none" />
  <div class="absolute bottom-1/4 left-1/3 w-64 h-64 bg-rose-600/20 rounded-full blur-3xl pointer-events-none" />

  <div class="container mx-auto px-4 md:px-8 relative z-10 py-24 md:py-32">
    <!-- Eyebrow -->
    {eyebrow && (
      <span class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-indigo-400 mb-6">
        <span class="w-1.5 h-1.5 rounded-full bg-indigo-400" />
        {eyebrow}
      </span>
    )}
    
    <!-- Headline -->
    <h1 class="text-5xl md:text-7xl font-bold mb-8 leading-tight tracking-tight max-w-4xl">
      {headingAccent ? (
        <>
          {headingBefore}
          <span class="text-indigo-400"> {headingAccent}</span>
          {headingAfter}
        </>
      ) : (
        heading
      )}
    </h1>
    
    <!-- Description -->
    <p class="text-xl font-medium mb-12 text-zinc-400 max-w-2xl leading-relaxed">
      {description}
    </p>
    
    <!-- CTAs -->
    <div class="flex flex-col sm:flex-row gap-4">
      {primaryCta && (
        <a
          href={primaryCta.url}
          class="group relative inline-flex items-center justify-center overflow-hidden h-14 px-10 font-bold text-black bg-white transition-all duration-300 text-lg rounded-lg hover:bg-zinc-200"
        >
          <span class="transform transition-transform duration-300 group-hover:-translate-x-3">
            {primaryCta.text}
          </span>
          <span class="absolute right-6 transform -translate-x-4 opacity-0 transition-all duration-300 group-hover:translate-x-0 group-hover:opacity-100">
            →
          </span>
        </a>
      )}
      
      {secondaryCta && (
        <a
          href={secondaryCta.url}
          class="inline-flex items-center justify-center h-14 px-8 font-bold border-2 border-zinc-700 text-white rounded-lg hover:border-white transition-colors text-lg"
        >
          {secondaryCta.text}
        </a>
      )}
    </div>
    
    <!-- Trust Badge -->
    {trustBadge && (
      <div class="mt-10 flex items-center gap-3">
        {trustBadge.icon && <span class="text-2xl">{trustBadge.icon}</span>}
        <div>
          <div class="font-bold text-sm text-white">{trustBadge.title}</div>
          <div class="text-xs text-zinc-500">{trustBadge.subtitle}</div>
        </div>
      </div>
    )}
  </div>
</section>
