---
/**
 * HeroSocialProof — Social Proof Hero
 * Pattern key: socialProof
 * Section: Hero
 *
 * Copy and CTAs on the left. The right column is entirely devoted to stacked
 * customer review cards (avatar, name, role, stars, quote) instead of an image.
 * Maximises credibility signals above the fold — ideal for service businesses
 * where testimonials are the primary conversion driver.
 */
import type { HeroData } from '../../../data/sample-data';

interface Props {
  data: HeroData;
}

const { data } = Astro.props;
const {
  eyebrow,
  heading,
  headingAccent,
  description,
  primaryCta,
  secondaryCta,
  trustBadge,
} = data;

let headingBefore = heading;
let headingAfter = '';
if (headingAccent && heading.includes(headingAccent)) {
  const idx = heading.indexOf(headingAccent);
  headingBefore = heading.slice(0, idx);
  headingAfter = heading.slice(idx + headingAccent.length);
}

// Placeholder review cards — replace with real data in production
const reviews = [
  {
    name: 'Sarah Mitchell',
    role: 'CEO, Brightside Retail',
    avatar: 'https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=80&h=80&fit=crop&crop=face',
    quote: 'Absolutely transformed our online presence. Revenue up 40% in the first quarter alone. The team genuinely cares about results.',
    stars: 5,
  },
  {
    name: 'James Okafor',
    role: 'Director, Ironclad Legal',
    avatar: 'https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?w=80&h=80&fit=crop&crop=face',
    quote: 'Professional, fast, and they actually listen. Our new site brings in qualified leads every single week. Worth every cent.',
    stars: 5,
  },
  {
    name: 'Priya Sharma',
    role: 'Owner, Bloom & Co.',
    avatar: 'https://images.unsplash.com/photo-1438761681033-6461ffad8d80?w=80&h=80&fit=crop&crop=face',
    quote: 'From quote to launch in 3 weeks. The design is exactly what I envisioned and my customers love it.',
    stars: 5,
  },
];
---

<section class="min-h-[90vh] flex items-center py-20 md:py-28 bg-white dark:bg-zinc-950">
  <div class="container mx-auto px-4 md:px-8">
    <div class="grid lg:grid-cols-12 gap-12 lg:gap-16 items-center">

      <!-- LEFT: Copy + CTAs -->
      <div class="lg:col-span-6 text-center lg:text-left">

        <!-- Eyebrow -->
        {eyebrow && (
          <span class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-widest px-4 py-1.5 rounded-full border border-zinc-300 dark:border-zinc-700 text-neutral-600 dark:text-neutral-400 mb-6">
            <span class="w-1.5 h-1.5 rounded-full bg-green-500 animate-pulse" />
            {eyebrow}
          </span>
        )}

        <!-- Headline -->
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold leading-tight mb-6">
          {headingAccent ? (
            <>
              {headingBefore}
              <span class="text-indigo-600 dark:text-indigo-400"> {headingAccent}</span>
              {headingAfter}
            </>
          ) : (
            heading
          )}
        </h1>

        <!-- Description -->
        <p class="text-lg text-neutral-600 dark:text-neutral-300 leading-relaxed mb-8 max-w-lg mx-auto lg:mx-0">
          {description}
        </p>

        <!-- Aggregate rating strip -->
        <div class="flex items-center gap-3 justify-center lg:justify-start mb-8">
          <div class="flex items-center gap-0.5">
            {[1,2,3,4,5].map(() => (
              <svg class="w-5 h-5 text-amber-400 fill-current" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
              </svg>
            ))}
          </div>
          {trustBadge ? (
            <span class="font-bold text-sm text-zinc-900 dark:text-white">{trustBadge.title}</span>
          ) : (
            <span class="font-bold text-sm text-zinc-900 dark:text-white">5.0 Rating</span>
          )}
          <span class="text-zinc-400">·</span>
          {trustBadge ? (
            <span class="text-sm text-zinc-500 dark:text-zinc-400">{trustBadge.subtitle}</span>
          ) : (
            <span class="text-sm text-zinc-500 dark:text-zinc-400">120+ Reviews</span>
          )}
        </div>

        <!-- CTAs -->
        <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start">
          {primaryCta && (
            <a
              href={primaryCta.url}
              class="group relative inline-flex items-center justify-center overflow-hidden h-14 px-10 font-bold text-white bg-black dark:bg-white dark:text-black transition-all duration-300 text-lg rounded-lg hover:bg-zinc-800 dark:hover:bg-zinc-200"
            >
              <span class="transform transition-transform duration-300 group-hover:-translate-x-3">{primaryCta.text}</span>
              <span class="absolute right-6 transform -translate-x-4 opacity-0 transition-all duration-300 group-hover:translate-x-0 group-hover:opacity-100">→</span>
            </a>
          )}
          {secondaryCta && (
            <a
              href={secondaryCta.url}
              class="inline-flex items-center justify-center h-14 px-8 font-bold border-2 border-zinc-300 dark:border-zinc-700 rounded-lg hover:border-black dark:hover:border-white transition-colors text-lg"
            >
              {secondaryCta.text}
            </a>
          )}
        </div>
      </div>

      <!-- RIGHT: Stacked review cards -->
      <div class="lg:col-span-6 flex flex-col gap-4">
        {reviews.map((review, i) => (
          <div
            class={`bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 rounded-2xl p-6 shadow-md transition-transform duration-300 hover:-translate-y-0.5 hover:shadow-lg ${i === 1 ? 'lg:ml-8' : i === 2 ? 'lg:ml-4' : ''}`}
          >
            <!-- Header: avatar + name + stars -->
            <div class="flex items-start justify-between mb-4">
              <div class="flex items-center gap-3">
                <img
                  src={review.avatar}
                  alt={review.name}
                  class="w-11 h-11 rounded-full object-cover shrink-0"
                  loading="lazy"
                />
                <div>
                  <div class="font-bold text-sm text-zinc-900 dark:text-white leading-tight">{review.name}</div>
                  <div class="text-xs text-zinc-500 dark:text-zinc-400 mt-0.5">{review.role}</div>
                </div>
              </div>
              <!-- Stars -->
              <div class="flex items-center gap-0.5 shrink-0">
                {Array.from({ length: review.stars }).map(() => (
                  <svg class="w-4 h-4 text-amber-400 fill-current" viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                  </svg>
                ))}
              </div>
            </div>
            <!-- Quote -->
            <p class="text-sm text-zinc-600 dark:text-zinc-300 leading-relaxed">
              "{review.quote}"
            </p>
          </div>
        ))}
      </div>

    </div>
  </div>
</section>
