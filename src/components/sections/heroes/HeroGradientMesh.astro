---
/**
 * HeroGradientMesh — Gradient Mesh Hero
 * Pattern key: gradientMesh
 * Section: Hero
 *
 * Soft coloured gradient orbs create a mesh effect on a white/dark background.
 * Centered layout with gradient text accent on the headline.
 * Great for SaaS products, tech startups, creative tools.
 */
import type { HeroData } from '../../../data/sample-data';

interface Props {
  data: HeroData;
}

const { data } = Astro.props;
const {
  eyebrow,
  heading,
  headingAccent,
  description,
  primaryCta,
  secondaryCta,
  trustBadge,
} = data;

let headingBefore = heading;
let headingAfter = '';
if (headingAccent && heading.includes(headingAccent)) {
  const idx = heading.indexOf(headingAccent);
  headingBefore = heading.slice(0, idx);
  headingAfter = heading.slice(idx + headingAccent.length);
}
---

<section class="relative min-h-screen flex items-center overflow-hidden bg-white dark:bg-zinc-950">
  <!-- Gradient mesh blobs -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <div class="absolute -top-48 -left-48 w-175 h-175 rounded-full bg-rose-300/50 dark:bg-rose-800/25 blur-[160px]" />
    <div class="absolute top-1/3 -right-32 w-137.5 h-137.5 rounded-full bg-sky-200/60 dark:bg-blue-900/25 blur-[130px]" />
    <div class="absolute -bottom-32 left-1/3 w-125 h-125 rounded-full bg-rose-200/45 dark:bg-pink-900/20 blur-[110px]" />
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-87.5 h-87.5 rounded-full bg-amber-100/50 dark:bg-amber-900/10 blur-[90px]" />
  </div>

  <!-- Content -->
  <div class="relative z-10 container mx-auto px-4 md:px-8 text-center py-32 md:py-44">

    <!-- Eyebrow pill -->
    {eyebrow && (
      <div class="inline-flex items-center gap-2 bg-white/80 dark:bg-zinc-900/80 backdrop-blur-sm border border-zinc-200 dark:border-zinc-800 rounded-full px-4 py-1.5 mb-8 shadow-sm">
        <span class="w-1.5 h-1.5 rounded-full bg-linear-to-r from-rose-500 to-pink-500" />
        <span class="text-xs font-bold uppercase tracking-widest text-zinc-600 dark:text-zinc-400">{eyebrow}</span>
      </div>
    )}

    <!-- Headline with gradient accent -->
    <h1 class="text-5xl md:text-7xl lg:text-8xl font-bold leading-[1.04] tracking-tight mb-8 max-w-4xl mx-auto">
      {headingAccent ? (
        <>
          {headingBefore}
          <span class="bg-linear-to-r from-rose-600 via-pink-500 to-fuchsia-500 dark:from-rose-400 dark:via-pink-400 dark:to-fuchsia-400 bg-clip-text text-transparent">
            {" "}{headingAccent}
          </span>
          {headingAfter}
        </>
      ) : (
        heading
      )}
    </h1>

    <!-- Description -->
    <p class="text-xl text-zinc-600 dark:text-zinc-400 max-w-2xl mx-auto mb-12 leading-relaxed">
      {description}
    </p>

    <!-- CTAs -->
    <div class="flex flex-col sm:flex-row gap-4 justify-center mb-16">
      {primaryCta && (
        <a
          href={primaryCta.url}
          class="group inline-flex items-center justify-center gap-2 h-14 px-10 font-bold text-white rounded-full text-lg transition-all duration-300 bg-linear-to-r from-rose-600 to-pink-600 hover:from-rose-500 hover:to-pink-500 shadow-lg shadow-rose-500/25 hover:shadow-xl hover:shadow-rose-500/35"
        >
          <span>{primaryCta.text}</span>
          <span class="transform transition-transform duration-300 group-hover:translate-x-1">→</span>
        </a>
      )}
      {secondaryCta && (
        <a
          href={secondaryCta.url}
          class="inline-flex items-center justify-center h-14 px-10 font-bold rounded-full text-lg border-2 border-zinc-200 dark:border-zinc-700 hover:border-zinc-400 dark:hover:border-zinc-500 transition-colors bg-white/50 dark:bg-zinc-900/50 backdrop-blur-sm"
        >
          {secondaryCta.text}
        </a>
      )}
    </div>

    <!-- Trust Badge -->
    {trustBadge && (
      <div class="inline-flex items-center gap-3 bg-white/70 dark:bg-zinc-900/70 backdrop-blur-sm border border-zinc-200 dark:border-zinc-800 rounded-full px-6 py-3 shadow-sm">
        <span class="text-xl">{trustBadge.icon}</span>
        <span class="font-bold text-sm text-zinc-900 dark:text-white">{trustBadge.title}</span>
        <span class="text-zinc-300 dark:text-zinc-600">·</span>
        <span class="text-sm text-zinc-500 dark:text-zinc-400">{trustBadge.subtitle}</span>
      </div>
    )}
  </div>
</section>
