---
/**
 * HeroServiceList — Service Checklist Hero
 * Pattern key: serviceList
 * Section: Hero
 *
 * Headline and CTAs on the left. A clean "what's included" checklist card
 * on the right surfaces key services/features above the fold.
 * Uses `rotatingWords` as the checklist items when provided.
 * Great for trades, professional services, accounting, legal, cleaning, consulting.
 */
import type { HeroData } from '../../../data/sample-data';

interface Props {
  data: HeroData;
}

const { data } = Astro.props;
const {
  eyebrow,
  heading,
  headingAccent,
  description,
  primaryCta,
  secondaryCta,
  trustBadge,
  rotatingWords,
} = data;

let headingBefore = heading;
let headingAfter = '';
if (headingAccent && heading.includes(headingAccent)) {
  const idx = heading.indexOf(headingAccent);
  headingBefore = heading.slice(0, idx);
  headingAfter = heading.slice(idx + headingAccent.length);
}

// Use rotatingWords as checklist items, or fall back to defaults
const serviceItems: string[] = rotatingWords && rotatingWords.length > 0
  ? rotatingWords
  : [
      'Custom website design & development',
      'SEO-optimised from day one',
      'Mobile-first, fast-loading pages',
      'Ongoing support & maintenance',
      'Google Analytics & conversion tracking',
    ];
---

<section class="min-h-[90vh] flex items-center py-20 md:py-28 bg-zinc-50 dark:bg-zinc-950">
  <div class="container mx-auto px-4 md:px-8">
    <div class="grid lg:grid-cols-12 gap-12 lg:gap-20 items-center">

      <!-- LEFT: Copy + CTAs -->
      <div class="lg:col-span-6 text-center lg:text-left">

        <!-- Eyebrow -->
        {eyebrow && (
          <span class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-widest px-4 py-1.5 rounded-full border border-zinc-300 dark:border-zinc-700 text-neutral-600 dark:text-neutral-400 mb-6">
            {eyebrow}
          </span>
        )}

        <!-- Headline -->
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold leading-tight mb-6">
          {headingAccent ? (
            <>
              {headingBefore}
              <span class="text-indigo-600 dark:text-indigo-400"> {headingAccent}</span>
              {headingAfter}
            </>
          ) : (
            heading
          )}
        </h1>

        <!-- Description -->
        <p class="text-lg text-neutral-600 dark:text-neutral-300 leading-relaxed mb-10 max-w-lg mx-auto lg:mx-0">
          {description}
        </p>

        <!-- CTAs -->
        <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start mb-10">
          {primaryCta && (
            <a
              href={primaryCta.url}
              class="group relative inline-flex items-center justify-center overflow-hidden h-14 px-10 font-bold text-white bg-indigo-600 hover:bg-indigo-700 transition-all duration-300 text-lg rounded-lg"
            >
              <span class="transform transition-transform duration-300 group-hover:-translate-x-3">{primaryCta.text}</span>
              <span class="absolute right-6 transform -translate-x-4 opacity-0 transition-all duration-300 group-hover:translate-x-0 group-hover:opacity-100">→</span>
            </a>
          )}
          {secondaryCta && (
            <a
              href={secondaryCta.url}
              class="inline-flex items-center justify-center h-14 px-8 font-bold border-2 border-zinc-300 dark:border-zinc-700 rounded-lg hover:border-zinc-500 dark:hover:border-zinc-500 transition-colors text-lg"
            >
              {secondaryCta.text}
            </a>
          )}
        </div>

        <!-- Trust badge -->
        {trustBadge && (
          <div class="flex items-center gap-3 justify-center lg:justify-start pt-4 border-t border-zinc-200 dark:border-zinc-800">
            <span class="text-xl">{trustBadge.icon}</span>
            <span class="font-bold text-sm text-zinc-900 dark:text-white">{trustBadge.title}</span>
            <span class="text-zinc-400">·</span>
            <span class="text-sm text-zinc-500 dark:text-zinc-400">{trustBadge.subtitle}</span>
          </div>
        )}
      </div>

      <!-- RIGHT: Service checklist card -->
      <div class="lg:col-span-6">
        <div class="bg-white dark:bg-zinc-900 border-2 border-zinc-200 dark:border-zinc-800 rounded-2xl shadow-xl overflow-hidden">

          <!-- Card header -->
          <div class="bg-indigo-600 dark:bg-indigo-700 px-7 py-5">
            <p class="text-xs font-bold uppercase tracking-widest text-indigo-200 mb-1">Everything included</p>
            <h2 class="text-xl font-bold text-white">What you get with every project</h2>
          </div>

          <!-- Checklist items -->
          <ul class="divide-y divide-zinc-100 dark:divide-zinc-800">
            {serviceItems.map((item, i) => (
              <li class="flex items-center gap-4 px-7 py-4 group hover:bg-indigo-50 dark:hover:bg-indigo-950/30 transition-colors">
                <!-- Check circle -->
                <span class="shrink-0 w-7 h-7 rounded-full bg-indigo-100 dark:bg-indigo-900/50 flex items-center justify-center group-hover:bg-indigo-200 dark:group-hover:bg-indigo-900 transition-colors">
                  <svg class="w-4 h-4 text-indigo-600 dark:text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                  </svg>
                </span>
                <span class="text-base font-medium text-zinc-800 dark:text-zinc-200">{item}</span>
              </li>
            ))}
          </ul>

          <!-- Card footer CTA -->
          {primaryCta && (
            <div class="px-7 py-5 bg-zinc-50 dark:bg-zinc-900/50 border-t border-zinc-100 dark:border-zinc-800">
              <a
                href={primaryCta.url}
                class="inline-flex items-center gap-2 text-sm font-bold text-indigo-600 dark:text-indigo-400 hover:text-indigo-700 dark:hover:text-indigo-300 transition-colors group"
              >
                {primaryCta.text}
                <span class="transform transition-transform duration-200 group-hover:translate-x-1">→</span>
              </a>
            </div>
          )}
        </div>
      </div>

    </div>
  </div>
</section>
