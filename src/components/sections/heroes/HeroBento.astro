---
/**
 * HeroBento — Bento Grid Hero
 * Pattern key: bento
 * Section: Hero
 *
 * Modern bento-box grid layout. Content is split across rounded cards:
 * a large headline card, a tall image card, a trust stat card, and a brand accent card.
 * Great for SaaS products, portfolios, and tech brands.
 */
import type { HeroData } from '../../../data/sample-data';

interface Props {
  data: HeroData;
}

const { data } = Astro.props;
const {
  eyebrow,
  heading,
  headingAccent,
  description,
  primaryCta,
  secondaryCta,
  image,
  trustBadge,
} = data;

let headingBefore = heading;
let headingAfter = '';
if (headingAccent && heading.includes(headingAccent)) {
  const idx = heading.indexOf(headingAccent);
  headingBefore = heading.slice(0, idx);
  headingAfter = heading.slice(idx + headingAccent.length);
}
---

<section class="py-16 md:py-24 bg-zinc-100 dark:bg-zinc-950">
  <div class="container mx-auto px-4 md:px-8">

    <!-- Eyebrow above grid -->
    {eyebrow && (
      <div class="mb-6">
        <span class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-zinc-500 dark:text-zinc-400">
          <span class="w-1.5 h-1.5 rounded-full bg-indigo-500" />
          {eyebrow}
        </span>
      </div>
    )}

    <!-- Bento Grid: 3-column base -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 auto-rows-auto">

      <!-- CARD 1: Headline + Description + CTAs (col-span-2, top row) -->
      <div class="md:col-span-2 bg-white dark:bg-zinc-900 rounded-3xl p-8 md:p-10 lg:p-12 border border-zinc-200 dark:border-zinc-800 flex flex-col justify-between min-h-70">
        <h1 class="text-3xl sm:text-4xl md:text-5xl xl:text-6xl font-bold leading-tight mb-4">
          {headingAccent ? (
            <>
              {headingBefore}
              <span class="text-indigo-600 dark:text-indigo-400"> {headingAccent}</span>
              {headingAfter}
            </>
          ) : (
            heading
          )}
        </h1>

        <div>
          <p class="text-base md:text-lg text-zinc-600 dark:text-zinc-400 leading-relaxed mb-7 max-w-lg">
            {description}
          </p>
          <div class="flex flex-wrap gap-3">
            {primaryCta && (
              <a
                href={primaryCta.url}
                class="group inline-flex items-center justify-center gap-2 h-12 px-8 font-bold text-white bg-black dark:bg-white dark:text-black rounded-2xl text-sm transition-all duration-300 hover:bg-zinc-800 dark:hover:bg-zinc-200"
              >
                {primaryCta.text}
                <span class="transform transition-transform duration-300 group-hover:translate-x-1">→</span>
              </a>
            )}
            {secondaryCta && (
              <a
                href={secondaryCta.url}
                class="inline-flex items-center justify-center h-12 px-8 font-bold border-2 border-zinc-200 dark:border-zinc-700 rounded-2xl text-sm hover:border-zinc-400 dark:hover:border-zinc-500 transition-colors"
              >
                {secondaryCta.text}
              </a>
            )}
          </div>
        </div>
      </div>

      <!-- CARD 2: Image (col-span-1, spans 2 rows — tall) -->
      <div class="md:row-span-2 bg-zinc-200 dark:bg-zinc-800 rounded-3xl overflow-hidden min-h-80">
        {image ? (
          <img
            src={image.src}
            alt={image.alt}
            class="w-full h-full object-cover"
            loading="eager"
          />
        ) : (
          <div class="w-full h-full bg-linear-to-br from-indigo-100 to-rose-100 dark:from-indigo-900/40 dark:to-rose-900/40 flex items-center justify-center">
            <span class="text-6xl opacity-30">✦</span>
          </div>
        )}
      </div>

      <!-- CARD 3: Trust stat (indigo accent) -->
      {trustBadge && (
        <div class="bg-indigo-600 dark:bg-indigo-500 rounded-3xl p-7 md:p-8 flex items-center gap-5 text-white">
          <span class="text-5xl shrink-0">{trustBadge.icon}</span>
          <div>
            <div class="font-bold text-2xl leading-tight">{trustBadge.title}</div>
            <div class="text-indigo-200 text-sm mt-0.5">{trustBadge.subtitle}</div>
          </div>
        </div>
      )}

      <!-- CARD 4 (only if no trustBadge — keeps grid from breaking) -->
      {!trustBadge && (
        <div class="bg-zinc-200 dark:bg-zinc-800 rounded-3xl p-7 flex items-center justify-center min-h-25">
          <span class="text-4xl opacity-20">✦</span>
        </div>
      )}

      <!-- CARD 5: Brand / decorative accent card -->
      <div class="bg-zinc-900 dark:bg-zinc-800 rounded-3xl p-7 overflow-hidden relative min-h-25">
        <!-- Dot pattern overlay -->
        <div
          class="absolute inset-0 opacity-[0.08]"
          style="background-image: radial-gradient(circle, #fff 1px, transparent 1px); background-size: 18px 18px;"
        />
        <!-- Glow blob -->
        <div class="absolute -bottom-6 -right-6 w-24 h-24 rounded-full bg-indigo-500/40 blur-2xl" />
        <!-- Content -->
        <div class="relative z-10 h-full flex flex-col justify-between">
          <span class="text-2xl">✦</span>
          <span class="text-xs font-bold uppercase tracking-widest text-zinc-500 mt-8">Est. 2015</span>
        </div>
      </div>

    </div>
  </div>
</section>
