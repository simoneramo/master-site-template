---
/**
 * HeroFullBleedBottom — Full-Bleed with Bottom Info Bar
 * Pattern key: fullBleedBottom
 * Section: Hero
 *
 * Full-viewport background image with dark overlay.
 * Large bold headline on left with eyebrow.
 * Bottom bar with description, trust badge, and CTA buttons.
 */
import type { HeroData } from "../../../data/sample-data";

interface Props {
  data: HeroData;
}

const { data } = Astro.props;
const {
  eyebrow,
  heading,
  headingAccent,
  description,
  primaryCta,
  secondaryCta,
  image,
  trustBadge,
} = data;

// Split heading to highlight accent word(s)
let headingBefore = heading;
let headingAfter = "";
if (headingAccent && heading.includes(headingAccent)) {
  const idx = heading.indexOf(headingAccent);
  headingBefore = heading.slice(0, idx);
  headingAfter = heading.slice(idx + headingAccent.length);
}
---

<section
  class="relative min-h-screen flex flex-col justify-between overflow-hidden"
>
  {/* Background Image with Overlay */}
  <div class="absolute inset-0">
    {
      image ? (
        <img
          src={image.src}
          alt={image.alt}
          class="w-full h-full object-cover"
          loading="eager"
        />
      ) : (
        <div class="w-full h-full bg-zinc-800" />
      )
    }
    {/* Dark overlay gradient */}
    <div class="absolute inset-0 bg-linear-to-r from-black/80 via-black/60 to-black/40"></div>
  </div>

  {/* Main Content */}
  <div class="relative z-10 flex-1 flex items-center">
    <div class="container mx-auto px-4 md:px-8 py-32">
      <div class="max-w-3xl">
        {/* Eyebrow */}
        {
          eyebrow && (
            <span class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-white/80 mb-6">
              <span class="w-1.5 h-1.5 rounded-full bg-indigo-400" />
              {eyebrow}
            </span>
          )
        }

        {/* Headline */}
        <h1
          class="text-5xl sm:text-6xl md:text-7xl font-bold text-white leading-[0.95] tracking-tight lowercase"
        >
          {
            headingAccent ? (
              <>
                {headingBefore}
                <span class="text-indigo-400"> {headingAccent}</span>
                {headingAfter}
              </>
            ) : (
              heading
            )
          }
        </h1>
      </div>
    </div>
  </div>

  {/* Bottom Info Bar */}
  <div class="relative z-10">
    <div class="container mx-auto px-4 md:px-8">
      <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-8 pb-8 md:pb-12">
        
        {/* Left: Description */}
        {
          description && (
            <div class="text-white lg:max-w-md">
              <p class="text-base md:text-lg text-white/90 leading-relaxed">
                {description}
              </p>
            </div>
          )
        }

        {/* Center: Trust Badge */}
        {
          trustBadge && (
            <div class="text-white flex items-center gap-3">
              {trustBadge.icon && <span class="text-2xl">{trustBadge.icon}</span>}
              <div>
                <div class="font-bold text-white">{trustBadge.title}</div>
                <div class="text-sm text-white/70">{trustBadge.subtitle}</div>
              </div>
            </div>
          )
        }

        {/* Right: CTA Buttons */}
        <div class="flex flex-col sm:flex-row gap-3">
          {
            primaryCta && (
              <a
                href={primaryCta.url}
                class="group relative inline-flex items-center justify-center overflow-hidden h-14 px-8 font-bold text-black bg-white rounded-lg transition-all duration-300"
              >
                <span class="transform transition-transform duration-300 group-hover:-translate-x-2">
                  {primaryCta.text}
                </span>
                <span class="absolute right-6 transform -translate-x-4 opacity-0 transition-all duration-300 group-hover:translate-x-0 group-hover:opacity-100">
                  →
                </span>
              </a>
            )
          }
          {
            secondaryCta && (
              <a
                href={secondaryCta.url}
                class="inline-flex items-center justify-center h-14 px-8 font-bold border-2 border-white/60 text-white rounded-lg hover:border-white hover:bg-white/10 transition-colors"
              >
                {secondaryCta.text}
              </a>
            )
          }
        </div>
      </div>
    </div>
  </div>
</section>
