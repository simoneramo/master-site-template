---
/**
 * HeroCentered — Centered Hero
 * Pattern key: centered
 * Section: Hero
 *
 * Full-width centered layout. Eyebrow → Large headline → Description → CTAs.
 * Optional image below the copy block.
 */
import type { HeroData } from "../../../data/sample-data";

interface Props {
  data: HeroData;
}

const { data } = Astro.props;
const {
  eyebrow,
  heading,
  headingAccent,
  description,
  primaryCta,
  secondaryCta,
  image,
  trustBadge,
} = data;

let headingBefore = heading;
let headingAfter = "";
if (headingAccent && heading.includes(headingAccent)) {
  const idx = heading.indexOf(headingAccent);
  headingBefore = heading.slice(0, idx);
  headingAfter = heading.slice(idx + headingAccent.length);
}
---

<section class="py-24 md:py-40">
  <div class="container mx-auto px-4 md:px-8 text-center">
    <!-- Eyebrow -->
    {
      eyebrow && (
        <span class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-widest px-4 py-1.5 rounded-full border border-zinc-300 dark:border-zinc-700 text-neutral-600 dark:text-neutral-400 mb-8">
          {eyebrow}
        </span>
      )
    }

    <!-- Headline -->
    <h1
      class="text-5xl md:text-6xl font-bold leading-tighter mb-8 max-w-3xl mx-auto"
    >
      {
        headingAccent ? (
          <>
            {headingBefore}
            <span class="text-indigo-600 dark:text-indigo-400">
              {" "}{headingAccent}
            </span>
            {headingAfter}
          </>
        ) : (
          heading
        )
      }
    </h1>

    <!-- Description -->
    <p
      class="text-xl font-regular mb-12 text-neutral-600 dark:text-neutral-400 max-w-2xl mx-auto leading-relaxed"
    >
      {description}
    </p>

    <!-- CTAs -->
    <div class="flex flex-col sm:flex-row gap-4 justify-center mb-16">
      {
        primaryCta && (
          <a
            href={primaryCta.url}
            class="group relative inline-flex items-center justify-center overflow-hidden h-14 px-12 font-bold text-white bg-black dark:bg-white dark:text-black transition-all duration-300 text-lg rounded-full hover:bg-zinc-800 dark:hover:bg-zinc-200"
          >
            <span class="transform transition-transform duration-300 group-hover:-translate-x-3">
              {primaryCta.text}
            </span>
            <span class="absolute right-8 transform -translate-x-4 opacity-0 transition-all duration-300 group-hover:translate-x-0 group-hover:opacity-100">
              →
            </span>
          </a>
        )
      }
      {
        secondaryCta && (
          <a
            href={secondaryCta.url}
            class="inline-flex items-center justify-center h-14 px-10 font-bold border-2 border-zinc-300 dark:border-zinc-700 rounded-full hover:border-black dark:hover:border-white transition-colors text-lg"
          >
            {secondaryCta.text}
          </a>
        )
      }
    </div>

    <!-- Trust Badge -->
    {
      trustBadge && (
        <div class="flex items-center justify-center gap-6 mb-16">
          <div class="h-px bg-zinc-200 dark:bg-zinc-800 flex-1 max-w-24" />
          <div class="flex items-center gap-2 text-sm font-bold text-neutral-500 dark:text-neutral-400">
            <span>{trustBadge.icon}</span>
            <span>
              {trustBadge.title} · {trustBadge.subtitle}
            </span>
          </div>
          <div class="h-px bg-zinc-200 dark:bg-zinc-800 flex-1 max-w-24" />
        </div>
      )
    }

    <!-- Image -->
    {
      image && (
        <div class="max-w-5xl mx-auto">
          <img
            src={image.src}
            alt={image.alt}
            class="w-full rounded-2xl shadow-2xl object-cover aspect-video"
            loading="eager"
          />
        </div>
      )
    }
  </div>
</section>
