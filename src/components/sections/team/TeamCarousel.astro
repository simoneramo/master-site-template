---
/**
 * TeamCarousel — Carousel
 * Horizontal carousel of team cards with navigation arrows.
 */
import type { TeamData } from '../../../data/sample-data';

interface Props { data: TeamData; }

const { data } = Astro.props;
const { eyebrow, heading, description, members = [] } = data || {};
---

<section class="py-20 md:py-32 overflow-hidden" x-data="{ current: 0, slides: Math.ceil($refs.track?.children.length / 3) || 1 }">
  <div class="container mx-auto px-4 md:px-8">
    <div class="text-center max-w-2xl mx-auto mb-12">
      {eyebrow && (
        <span class="inline-flex items-center text-xs font-bold uppercase tracking-widest px-4 py-1.5 rounded-full border border-zinc-300 dark:border-zinc-700 text-neutral-600 dark:text-neutral-400 mb-6">
          {eyebrow}
        </span>
      )}
      <h2 class="text-4xl md:text-5xl font-bold mb-4">{heading}</h2>
      {description && <p class="text-lg text-neutral-600 dark:text-neutral-400">{description}</p>}
    </div>

    {/* Carousel Container */}
    <div class="relative">
      {/* Navigation Buttons */}
      <button 
        @click="current = current > 0 ? current - 1 : slides - 1"
        class="absolute left-0 top-1/2 -translate-y-1/2 -translate-x-4 z-10 w-12 h-12 rounded-full bg-white dark:bg-zinc-800 shadow-lg flex items-center justify-center text-neutral-700 dark:text-neutral-300 hover:bg-zinc-50 dark:hover:bg-zinc-700 transition-colors hidden md:flex"
        aria-label="Previous"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
      </button>
      <button 
        @click="current = current < slides - 1 ? current + 1 : 0"
        class="absolute right-0 top-1/2 -translate-y-1/2 translate-x-4 z-10 w-12 h-12 rounded-full bg-white dark:bg-zinc-800 shadow-lg flex items-center justify-center text-neutral-700 dark:text-neutral-300 hover:bg-zinc-50 dark:hover:bg-zinc-700 transition-colors hidden md:flex"
        aria-label="Next"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
      </button>

      {/* Carousel Track */}
      <div class="overflow-hidden">
        <div 
          x-ref="track"
          class="flex transition-transform duration-500 ease-out"
          :style="`transform: translateX(-${current * 100}%)`"
        >
          {members.map((member) => (
            <div class="w-full md:w-1/2 lg:w-1/3 shrink-0 px-4">
              <div class="bg-surface dark:bg-zinc-900/50 rounded-2xl p-6 text-center h-full border border-zinc-200 dark:border-zinc-800">
                {member.photo && (
                  <div class="mb-5 mx-auto w-32 h-32">
                    <img 
                      src={member.photo} 
                      alt={member.name}
                      class="w-full h-full object-cover rounded-full border-4 border-zinc-100 dark:border-zinc-800"
                    />
                  </div>
                )}
                <h3 class="text-lg font-bold mb-1">{member.name}</h3>
                <p class="text-sm font-medium text-neutral-500 dark:text-neutral-400 mb-3">{member.role}</p>
                {member.bio && <p class="text-neutral-600 dark:text-neutral-400 text-sm leading-relaxed mb-4">{member.bio}</p>}
                {member.socials && member.socials.length > 0 && (
                  <div class="flex items-center justify-center gap-2">
                    {member.socials.map((social) => (
                      <a 
                        href={social.url}
                        class="w-8 h-8 rounded-full bg-zinc-100 dark:bg-zinc-800 flex items-center justify-center text-neutral-600 dark:text-neutral-400 hover:bg-zinc-200 dark:hover:bg-zinc-700 transition-colors"
                        aria-label={`${member.name} on ${social.platform}`}
                      >
                        {social.platform === 'LinkedIn' && (
                          <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
                        )}
                        {social.platform === 'Twitter' && (
                          <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                        )}
                        {social.platform === 'Dribbble' && (
                          <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.372 0 0 5.373 0 12s5.372 12 12 12 12-5.373 12-12S18.628 0 12 0zm9.885 11.441c-2.575-.422-4.943-.445-7.103-.073a42.153 42.153 0 00-.767-1.68c2.31-1 4.165-2.358 5.548-4.082a9.863 9.863 0 012.322 5.835zm-3.842-7.282c-1.205 1.554-2.868 2.783-4.986 3.68a46.287 46.287 0 00-3.488-5.438A9.894 9.894 0 0112 2.087c2.275 0 4.368.779 6.043 2.072zM7.527 3.166a44.59 44.59 0 013.537 5.381c-2.43.715-5.331 1.082-8.684 1.105a9.931 9.931 0 015.147-6.486zM2.087 12l.013-.256c3.849-.005 7.169-.448 9.95-1.322.233.475.456.952.67 1.432-3.38 1.057-6.165 3.222-8.337 6.48A9.865 9.865 0 012.087 12zm3.829 7.81c1.969-3.088 4.482-5.098 7.598-6.027a39.137 39.137 0 012.043 7.46c-3.349 1.291-6.953.666-9.641-1.433zm11.586.43a41.098 41.098 0 00-1.92-6.897c1.876-.265 3.94-.196 6.199.196a9.923 9.923 0 01-4.279 6.701z"/></svg>
                        )}
                        {social.platform === 'GitHub' && (
                          <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>
                        )}
                        {!['LinkedIn', 'Twitter', 'Dribbble', 'GitHub'].includes(social.platform) && (
                          <span class="text-xs font-bold">{social.platform.charAt(0)}</span>
                        )}
                      </a>
                    ))}
                  </div>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>

      {/* Mobile Navigation */}
      <div class="flex items-center justify-center gap-4 mt-8 md:hidden">
        <button 
          @click="current = current > 0 ? current - 1 : slides - 1"
          class="w-10 h-10 rounded-full bg-white dark:bg-zinc-800 shadow flex items-center justify-center text-neutral-700 dark:text-neutral-300"
          aria-label="Previous"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
          </svg>
        </button>
        <div class="flex gap-2">
          {members.map((_, i) => (
            <button 
              class="w-2 h-2 rounded-full transition-colors"
              :class={`current === ${i} ? 'bg-zinc-950 dark:bg-white' : 'bg-zinc-300 dark:bg-zinc-700'`}
              @click={`current = ${i}`}
              aria-label={`Go to slide ${i + 1}`}
            />
          ))}
        </div>
        <button 
          @click="current = current < slides - 1 ? current + 1 : 0"
          class="w-10 h-10 rounded-full bg-white dark:bg-zinc-800 shadow flex items-center justify-center text-neutral-700 dark:text-neutral-300"
          aria-label="Next"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </button>
      </div>
    </div>
  </div>
</section>
