---
/**
 * TeamList — Horizontal Roster Rows
 * Each member is a full-width row: avatar left, name/role/bio centre,
 * social links right. Dividers separate rows. Supports initials avatars.
 */
import type { TeamData } from '../../../data/sample-data';

interface Props { data: TeamData; }

const { data } = Astro.props;
const { eyebrow, heading, description, members = [] } = data || {};
---

<section class="py-20 md:py-32">
  <div class="container mx-auto px-4 md:px-8 max-w-4xl">
    <div class="text-center max-w-2xl mx-auto mb-16">
      {eyebrow && (
        <span class="inline-flex items-center text-xs font-bold uppercase tracking-widest px-4 py-1.5 rounded-full border border-zinc-300 dark:border-zinc-700 text-neutral-600 dark:text-neutral-400 mb-6">
          {eyebrow}
        </span>
      )}
      <h2 class="text-4xl md:text-5xl font-bold mb-4">{heading}</h2>
      {description && <p class="text-lg text-neutral-600 dark:text-neutral-400">{description}</p>}
    </div>

    {members && members.length > 0 && (
    <div class="divide-y divide-zinc-200 dark:divide-zinc-800 border-y border-zinc-200 dark:border-zinc-800">
      {members.map((member) => (
        <div class="flex items-center gap-5 md:gap-8 py-6">
          {/* Avatar */}
          <div class="shrink-0 w-16 h-16 md:w-20 md:h-20">
            {member.photo ? (
              <img src={member.photo} alt={member.name} class="w-full h-full object-cover rounded-full" loading="lazy" />
            ) : member.initials ? (
              <div class={`w-full h-full rounded-full flex items-center justify-center text-xl font-bold ${member.colorClass || 'bg-zinc-200 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300'}`}>
                {member.initials}
              </div>
            ) : null}
          </div>

          {/* Details */}
          <div class="flex-1 min-w-0">
            <h3 class="text-lg font-bold leading-tight">{member.name}</h3>
            <p class="text-sm font-medium text-neutral-500 dark:text-neutral-400">{member.role}</p>
            {member.bio && <p class="text-sm text-neutral-600 dark:text-neutral-400 mt-1 hidden sm:block">{member.bio}</p>}
          </div>

          {/* Socials */}
          {(member.socials || member.linkedin) && (
            <div class="shrink-0 flex items-center gap-2">
              {member.linkedin && (
                <a href={member.linkedin} aria-label={`${member.name} on LinkedIn`} class="w-9 h-9 rounded-full bg-zinc-100 dark:bg-zinc-800 flex items-center justify-center text-neutral-600 dark:text-neutral-400 hover:bg-zinc-200 dark:hover:bg-zinc-700 transition-colors">
                  <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M4.98 3.5c0 1.381-1.11 2.5-2.48 2.5s-2.48-1.119-2.48-2.5c0-1.38 1.11-2.5 2.48-2.5s2.48 1.12 2.48 2.5zm.02 4.5h-5v16h5v-16zm7.982 0h-4.968v16h5v-8.306c0-4.613 6.11-4.953 6.11 2.433v5.873h4.972v-9.167c0-7.85-8.835-7.516-11.114-3.56v-3.273z"/></svg>
                </a>
              )}
              {member.socials?.filter(s => s.platform !== 'LinkedIn').map((social) => (
                <a href={social.url} aria-label={`${member.name} on ${social.platform}`} class="w-9 h-9 rounded-full bg-zinc-100 dark:bg-zinc-800 flex items-center justify-center text-neutral-600 dark:text-neutral-400 hover:bg-zinc-200 dark:hover:bg-zinc-700 transition-colors text-xs font-bold">
                  {social.platform.charAt(0)}
                </a>
              ))}
            </div>
          )}
        </div>
      ))}
    </div>
    )}
  </div>
</section>
