---
/**
 * TeamThreeCol — 3-Column Grid
 * Three-column grid of team cards with photos/avatars, names, roles, and social links.
 * Supports both photo-based and initials-based avatars (TinaCMS compatible).
 */
import type { TeamData } from '../../../data/sample-data';

interface Props { data: TeamData; }

const { data } = Astro.props;
const { eyebrow, heading, description, members = [] } = data || {};
---

<section class="py-20 md:py-32">
  <div class="container mx-auto px-4 md:px-8">
    <div class="text-center max-w-2xl mx-auto mb-16">
      {eyebrow && (
        <span class="inline-flex items-center text-xs font-bold uppercase tracking-widest px-4 py-1.5 rounded-full border border-zinc-300 dark:border-zinc-700 text-neutral-600 dark:text-neutral-400 mb-6">
          {eyebrow}
        </span>
      )}
      <h2 class="text-4xl md:text-5xl font-bold mb-4">{heading}</h2>
      {description && <p class="text-lg text-neutral-600 dark:text-neutral-400">{description}</p>}
    </div>

    {members && members.length > 0 && (
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 lg:gap-10">
      {members.map((member) => (
        <div class="group text-center">
          {/* Avatar - Photo or Initials */}
          <div class="relative mb-6 mx-auto w-40 h-40 md:w-48 md:h-48">
            {member.photo ? (
              <img 
                src={member.photo} 
                alt={member.name}
                class="w-full h-full object-cover rounded-full border-4 border-zinc-100 dark:border-zinc-800 group-hover:border-zinc-200 dark:group-hover:border-zinc-700 transition-colors"
              />
            ) : member.initials ? (
              <div class={`w-full h-full rounded-full flex items-center justify-center text-3xl font-bold border-4 border-zinc-100 dark:border-zinc-800 ${member.colorClass || 'bg-zinc-200 dark:bg-zinc-800 text-zinc-700 dark:text-zinc-300'}`}>
                {member.initials}
              </div>
            ) : null}
          </div>
          
          {member.emoji && <div class="text-2xl mb-2">{member.emoji}</div>}
          <h3 class="text-xl font-bold mb-1">{member.name}</h3>
          <p class="text-sm font-medium text-neutral-500 dark:text-neutral-400 mb-3">{member.role}</p>
          {member.bio && <p class="text-neutral-600 dark:text-neutral-400 text-sm leading-relaxed mb-4">{member.bio}</p>}
          
          {/* Social Links */}
          {(member.socials || member.linkedin) && (
            <div class="flex items-center justify-center gap-3">
              {member.linkedin && (
                <a 
                  href={member.linkedin}
                  class="inline-flex items-center gap-2 font-bold text-sm border-b-2 border-black dark:border-white hover:border-transparent transition-colors"
                  aria-label={`${member.name} on LinkedIn`}
                >
                  <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M4.98 3.5c0 1.381-1.11 2.5-2.48 2.5s-2.48-1.119-2.48-2.5c0-1.38 1.11-2.5 2.48-2.5s2.48 1.12 2.48 2.5zm.02 4.5h-5v16h5v-16zm7.982 0h-4.968v16h5v-8.306c0-4.613 6.11-4.953 6.11 2.433v5.873h4.972v-9.167c0-7.85-8.835-7.516-11.114-3.56v-3.273z"/></svg>
                  LinkedIn
                </a>
              )}
              {member.socials?.filter(s => s.platform !== 'LinkedIn').map((social) => (
                <a 
                  href={social.url}
                  class="w-9 h-9 rounded-full bg-zinc-100 dark:bg-zinc-800 flex items-center justify-center text-neutral-600 dark:text-neutral-400 hover:bg-zinc-200 dark:hover:bg-zinc-700 transition-colors"
                  aria-label={`${member.name} on ${social.platform}`}
                >
                  {social.platform === 'Twitter' && (
                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                  )}
                  {social.platform === 'Dribbble' && (
                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.372 0 0 5.373 0 12s5.372 12 12 12 12-5.373 12-12S18.628 0 12 0zm9.885 11.441c-2.575-.422-4.943-.445-7.103-.073a42.153 42.153 0 00-.767-1.68c2.31-1 4.165-2.358 5.548-4.082a9.863 9.863 0 012.322 5.835zm-3.842-7.282c-1.205 1.554-2.868 2.783-4.986 3.68a46.287 46.287 0 00-3.488-5.438A9.894 9.894 0 0112 2.087c2.275 0 4.368.779 6.043 2.072zM7.527 3.166a44.59 44.59 0 013.537 5.381c-2.43.715-5.331 1.082-8.684 1.105a9.931 9.931 0 015.147-6.486zM2.087 12l.013-.256c3.849-.005 7.169-.448 9.95-1.322.233.475.456.952.67 1.432-3.38 1.057-6.165 3.222-8.337 6.48A9.865 9.865 0 012.087 12zm3.829 7.81c1.969-3.088 4.482-5.098 7.598-6.027a39.137 39.137 0 012.043 7.46c-3.349 1.291-6.953.666-9.641-1.433zm11.586.43a41.098 41.098 0 00-1.92-6.897c1.876-.265 3.94-.196 6.199.196a9.923 9.923 0 01-4.279 6.701z"/></svg>
                  )}
                  {social.platform === 'GitHub' && (
                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>
                  )}
                  {!['LinkedIn', 'Twitter', 'Dribbble', 'GitHub'].includes(social.platform) && (
                    <span class="text-xs font-bold">{social.platform.charAt(0)}</span>
                  )}
                </a>
              ))}
            </div>
          )}
        </div>
      ))}
    </div>
    )}
  </div>
</section>
