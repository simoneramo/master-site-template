---
/**
 * ProblemFullWidth — Full-Width Statement
 * Large bold statement spanning full width with supporting bullet points.
 */
import type { ProblemData } from '../../../data/sample-data';

interface Props { data: ProblemData; }

const { data } = Astro.props;
const { eyebrow, heading, description, painPoints } = data;
---

<section class="py-24 md:py-32 bg-surface dark:bg-zinc-900/50">
  <div class="container mx-auto px-4 md:px-8">
    <div class="max-w-5xl mx-auto">
      {eyebrow && (
        <span class="inline-flex items-center text-xs font-bold uppercase tracking-widest px-4 py-1.5 rounded-full border border-zinc-300 dark:border-zinc-700 text-neutral-600 dark:text-neutral-400 mb-6">
          {eyebrow}
        </span>
      )}
      
      {/* Large Statement */}
      <h2 class="text-5xl md:text-6xl lg:text-7xl font-bold leading-tight mb-8">
        {heading}
      </h2>
      
      {description && <p class="text-xl md:text-2xl text-neutral-600 dark:text-neutral-400 mb-12 max-w-3xl">{description}</p>}

      {/* Supporting Points */}
      <div class="grid md:grid-cols-3 gap-6 pt-8 border-t-2 border-zinc-200 dark:border-zinc-800">
        {painPoints.map((point) => (
          <div class="flex gap-3">
            <span class="text-rose-500 text-xl">✕</span>
            <div>
              <h3 class="font-bold mb-1">{point.heading}</h3>
              <p class="text-sm text-neutral-600 dark:text-neutral-400">{point.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
