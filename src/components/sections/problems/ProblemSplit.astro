---
/**
 * ProblemSplit — Split Layout
 * Text left with pain points, relevant problem image on right.
 */
import type { ProblemData } from '../../../data/sample-data';

interface Props { data: ProblemData; }

const { data } = Astro.props;
const { eyebrow, heading, description, painPoints, image } = data;
---

<section class="py-20 md:py-32 bg-zinc-950 text-white dark:bg-white dark:text-black">
  <div class="container mx-auto px-4 md:px-8">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      {/* Content */}
      <div>
        {eyebrow && (
          <span class="inline-flex items-center text-xs font-bold uppercase tracking-widest px-4 py-1.5 rounded-full border border-white/20 dark:border-black/20 text-white/70 dark:text-black/70 mb-6">
            {eyebrow}
          </span>
        )}
        <h2 class="text-4xl md:text-5xl font-bold mb-4">{heading}</h2>
        {description && <p class="text-lg text-white/70 dark:text-black/70 mb-10">{description}</p>}

        <div class="space-y-6">
          {painPoints.map((point) => (
            <div class="flex gap-4 p-4 rounded-xl bg-white/5 dark:bg-black/5 border border-white/10 dark:border-black/10">
              {point.icon && <span class="text-3xl">{point.icon}</span>}
              <div>
                <h3 class="text-lg font-bold mb-1">{point.heading}</h3>
                <p class="text-white/70 dark:text-black/70 text-sm">{point.description}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      {/* Image */}
      <div class="relative">
        {image ? (
          <div class="rounded-2xl overflow-hidden">
            <img 
              src={image.src} 
              alt={image.alt}
              class="w-full h-auto opacity-80"
            />
          </div>
        ) : (
          <div class="aspect-square rounded-2xl bg-white/10 dark:bg-black/10 flex items-center justify-center">
            <span class="text-9xl">⚡</span>
          </div>
        )}
      </div>
    </div>
  </div>
</section>
