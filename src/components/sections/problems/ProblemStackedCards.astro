---
/**
 * ProblemStackedCards — Stacked Pain Cards
 * Vertical stack of full-width cards with progressive visual intensity.
 */
import type { ProblemData } from '../../../data/sample-data';

interface Props { data: ProblemData; }

const { data } = Astro.props;
const { eyebrow, heading, description, painPoints } = data;

// Intensity levels for progressive styling
const intensityClasses = [
  'bg-zinc-100 dark:bg-zinc-900/30 border-zinc-200 dark:border-zinc-800',
  'bg-zinc-200 dark:bg-zinc-900/50 border-zinc-300 dark:border-zinc-700',
  'bg-zinc-300 dark:bg-zinc-900/70 border-zinc-400 dark:border-zinc-600',
  'bg-zinc-950 text-white dark:bg-white dark:text-black border-zinc-950 dark:border-white',
];
---

<section class="py-20 md:py-32 bg-surface dark:bg-zinc-950">
  <div class="container mx-auto px-4 md:px-8">
    <div class="text-center max-w-2xl mx-auto mb-16">
      {eyebrow && (
        <span class="inline-flex items-center text-xs font-bold uppercase tracking-widest px-4 py-1.5 rounded-full border border-zinc-300 dark:border-zinc-700 text-neutral-600 dark:text-neutral-400 mb-6">
          {eyebrow}
        </span>
      )}
      <h2 class="text-4xl md:text-5xl font-bold mb-4">{heading}</h2>
      {description && <p class="text-lg text-neutral-600 dark:text-neutral-400">{description}</p>}
    </div>

    <div class="max-w-3xl mx-auto space-y-4">
      {painPoints.map((point, index) => (
        <div class:list={["rounded-2xl p-6 lg:p-8 border-2 transition-all", intensityClasses[index % intensityClasses.length]]}>
          <div class="flex items-start gap-5">
            {point.icon && (
              <span class="text-4xl shrink-0">{point.icon}</span>
            )}
            <div>
              <h3 class="text-xl lg:text-2xl font-bold mb-2">{point.heading}</h3>
              <p class:list={[index === painPoints.length - 1 ? 'text-white/80 dark:text-black/70' : 'text-neutral-600 dark:text-neutral-400']}>
                {point.description}
              </p>
            </div>
            <span class="text-5xl font-bold opacity-20 ml-auto shrink-0">
              0{index + 1}
            </span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
