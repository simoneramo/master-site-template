---
/**
 * ProblemCenteredIcons — Centered with Icons
 * Centered heading with 3 icon cards below, each showing a pain point.
 */
import type { ProblemData } from '../../../data/sample-data';

interface Props { data: ProblemData; }

const { data } = Astro.props;
const { eyebrow, heading, description, painPoints } = data;
---

<section class="py-20 md:py-32">
  <div class="container mx-auto px-4 md:px-8">
    <div class="text-center max-w-2xl mx-auto mb-16">
      {eyebrow && (
        <span class="inline-flex items-center text-xs font-bold uppercase tracking-widest px-4 py-1.5 rounded-full border border-zinc-300 dark:border-zinc-700 text-neutral-600 dark:text-neutral-400 mb-6">
          {eyebrow}
        </span>
      )}
      <h2 class="text-4xl md:text-5xl font-bold mb-4">{heading}</h2>
      {description && <p class="text-lg text-neutral-600 dark:text-neutral-400">{description}</p>}
    </div>

    <div class="grid md:grid-cols-3 gap-8 max-w-4xl mx-auto">
      {painPoints.map((point, index) => (
        <div class="text-center">
          {point.icon && (
            <div class="w-20 h-20 mx-auto rounded-2xl bg-rose-100 dark:bg-rose-900/30 text-rose-600 dark:text-rose-400 flex items-center justify-center text-4xl mb-6">
              {point.icon}
            </div>
          )}
          <h3 class="text-xl font-bold mb-3">{point.heading}</h3>
          <p class="text-neutral-600 dark:text-neutral-400 text-sm leading-relaxed">
            {point.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
