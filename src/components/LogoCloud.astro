---
const logos = [
    { name: "Astro", icon: "🚀" },
    { name: "Vercel", icon: "▲" },
    { name: "TinaCMS", icon: "🦙" },
    { name: "Tailwind", icon: "🎨" },
    { name: "React", icon: "⚛️" },
];
---

<section class="py-12 md:py-20">
    <div class="mx-auto px-4 md:px-0 max-w-7xl text-center">
        <p
            class="text-xs font-bold text-neutral-500 dark:text-neutral-400 mb-8 uppercase tracking-widest"
        >
            Built with modern, high-performance tech
        </p>
        <div class="flex flex-wrap justify-center items-center gap-8 md:gap-20">
            {
                logos.map((logo) => (
                    <div class="flex items-center gap-3">
                        <span class="text-4xl">{logo.icon}</span>
                        <span class="text-xl font-bold text-neutral-700 dark:text-neutral-300">
                            {logo.name}
                        </span>
                    </div>
                ))
            }
        </div>
    </div>
</section>
